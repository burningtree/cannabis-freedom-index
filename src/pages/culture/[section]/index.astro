---
// One part of the cultural atlas that is made of entries: /culture/language/, /culture/traditions/.
import Base from "../../../layouts/Base.astro";
import CultureCards from "../../../components/CultureCards.astro";
import { CULTURE_SECTIONS, cultureIn } from "../../../lib/culture.js";

export function getStaticPaths() {
  return CULTURE_SECTIONS.filter((s) => s.entries).map((s) => ({ params: { section: s.id }, props: { s } }));
}
const { s } = Astro.props;
const base = import.meta.env.BASE_URL;
const entries = cultureIn(s.id);
// the same entries by country, most entries first: the way in for someone who starts from a place
const byCountry = [...new Set(entries.flatMap((e) => e.countries))]
  .map((c) => ({ c, entries: entries.filter((e) => e.countries.includes(c)) }))
  .sort((a, b) => b.entries.length - a.entries.length || a.c.name.localeCompare(b.c.name));
---
<Base title={`${s.name} · Culture`} description={s.lede}>
  <main class="changes-page culture">
    <div class="page-bar"><a class="back" href={`${base}culture/`}>← Culture</a></div>
    <section class="hero hero-sm">
      <p class="eyebrow">Culture <span>{entries.length} entries</span></p>
      <h1>{s.name}</h1>
      <p class="lede">{s.lede}</p>
      <p class="lede">{s.intro}</p>
    </section>

    <section class="section cu-first">
      {/* Order and view: by importance (the `featured` ranks, then the rest A–Z) or by name, as
          cards or as a compact list. The choice is kept in the browser for the next visit. */}
      <div class="cu-controls" id="cuControls">
        <div class="hist-order" role="group" aria-label="Order of the entries">
          <span class="cu-ctl-label">Order</span>
          <button type="button" data-order="rank" aria-pressed="true">Importance</button>
          <button type="button" data-order="name" aria-pressed="false">Name A–Z</button>
        </div>
        <div class="hist-order" role="group" aria-label="How to show the entries">
          <span class="cu-ctl-label">Show</span>
          <button type="button" data-view="cards" aria-pressed="true">Cards</button>
          <button type="button" data-view="list" aria-pressed="false">List</button>
        </div>
      </div>
      <CultureCards entries={entries} lead id="cuEntries" />
    </section>
    <script is:inline>
      (function () {
        var list = document.getElementById("cuEntries"), box = document.getElementById("cuControls");
        var state = { order: "rank", view: "cards" };
        try { Object.assign(state, JSON.parse(localStorage.getItem("cfi-culture-view") || "{}")); } catch (e) {}
        function apply() {
          var items = Array.prototype.slice.call(list.children);
          items.sort(function (a, b) {
            return state.order === "name" ? a.dataset.name.localeCompare(b.dataset.name) : a.dataset.rank - b.dataset.rank;
          }).forEach(function (li) { list.appendChild(li); });
          // the large first card only makes sense for the most important entry, shown as cards
          list.classList.toggle("cu-lead", state.order === "rank" && state.view === "cards");
          list.classList.toggle("cu-as-list", state.view === "list");
          box.querySelectorAll("[data-order]").forEach(function (b) { b.setAttribute("aria-pressed", String(b.dataset.order === state.order)); });
          box.querySelectorAll("[data-view]").forEach(function (b) { b.setAttribute("aria-pressed", String(b.dataset.view === state.view)); });
        }
        box.addEventListener("click", function (e) {
          var b = e.target.closest("button"); if (!b) return;
          if (b.dataset.order) state.order = b.dataset.order;
          if (b.dataset.view) state.view = b.dataset.view;
          try { localStorage.setItem("cfi-culture-view", JSON.stringify(state)); } catch (e) {}
          apply();
        });
        apply();
      })();
    </script>

    <section class="section">
      <div class="section-head"><div>
        <h2>By country</h2>
        <p class="sub">Where each {s.one} is {s.id === "language" ? "said" : "kept"}. A country's name opens its page in the index.</p>
      </div></div>
      <ul class="cu-by">
        {byCountry.map(({ c, entries }) => (
          <li>
            <a class="cu-place" href={`${base}country/${c.slug}/`}><span class="flag">{c.flag}</span>{c.name}</a>
            <span>{entries.map((e, i) => <>{i > 0 && ", "}<a href={`${base}${e.url}`}>{e.title}</a></>)}</span>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>
