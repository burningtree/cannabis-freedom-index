---
// Culture in the history: the places where the record of laws shows what people thought of
// cannabis and of those who used it. A hand-picked list of history entries, oldest first.
import Base from "../../layouts/Base.astro";
import { changes } from "../../lib/countries.js";

const base = import.meta.env.BASE_URL;
// Places where the history on this site already records culture meeting law. Each must exist.
const threads = [
  ["india-hemp-drugs-commission-1894", "An inquiry of 1,200 witnesses found the habit widespread, and advised against banning it partly because of “the social and religious feeling on the subject”."],
  ["india-bhang-exemption-1961", "India kept bhang out of the world treaty so that it could go on being drunk at Holi."],
  ["nepal-pashupati-distribution-ended-1995", "Until 1995 a temple trust in Kathmandu handed cannabis to holy men at Shivaratri, from the Home Ministry's confiscated stock."],
  ["jamaica-ganja-reform-2015", "Jamaica wrote Rastafari sacramental use into its law."],
  ["transvaal-mine-dagga-survey-1908", "Asked in 1908 whether dagga should be banned, the managers of the Transvaal gold mines mostly said no: use was moderate, and restrictions would keep men from coming to work."],
  ["south-africa-enforcement-compromise-1922", "A month after South Africa banned dagga, police were told to go easy in remote African areas, where an older man's morning pipe was “a custom so deep-rooted as almost to amount to a religious rite”."],
  ["mexico-salazar-marijuana-myth-1938", "A Mexican health official told the Academy of Medicine that the madness of marijuana was a myth, and ended by handing his colleagues cigarettes of it."],
  ["afghanistan-hashish-fertiliser-edicts-1969", "With Western travellers buying, Afghanistan's king issued edicts urging farmers to use fertiliser and grow more hashish."],
  ["south-africa-natal-1870", "One of the first cannabis laws anywhere applied to one group only: Indian labourers in Natal."],
  ["brazil-rio-pango-ban-1830", "Rio de Janeiro's ban of 1830 named the slaves who smoked it."],
  ["egypt-first-ban-1868", "Egypt's first ban has been read as a centralising state's wish to civilise its lower classes."],
].map(([id, text]) => {
  const ch = changes.find((x) => x.id === id);
  if (!ch) throw new Error(`culture/history.astro: there is no history entry "${id}"`);
  return { ch, text };
}).sort((x, y) => x.ch.date.localeCompare(y.ch.date));
---
<Base title="History · Culture" description="Social attitudes, propaganda and counterculture in the history of cannabis law: the entries where the record of laws shows what people thought.">
  <main class="changes-page culture">
    <div class="page-bar"><a class="back" href={`${base}culture/`}>← Culture</a></div>
    <section class="hero hero-sm">
      <p class="eyebrow">Culture <span>{threads.length} entries</span></p>
      <h1>History</h1>
      <p class="lede">The index's <a href={`${base}history/`}>history</a> is a record of laws, but culture shows through it: who a ban was aimed at, what an inquiry heard, which custom officials chose not to touch. A few of the places where it does.</p>
    </section>

    <section class="section cu-first">
      <ol class="culture-threads">
        {threads.map(({ ch, text }) => (
          <li>
            <a href={`${base}history/${ch.id}/`}>
              <time datetime={ch.date}>{ch.date.slice(0, 4)}</time>
              <span>{ch.place.flag} {ch.place.name}</span>
              <p>{text}</p>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Base>
