---
// Culture: the announcement page for the participatory research that is to sit beside the index.
// The index maps laws; this is about the people and beliefs behind them. Nothing is collected
// here yet: the page says what the project asks and shows where the history already touches it.
import Base from "../layouts/Base.astro";
import { changes } from "../lib/countries.js";

const base = import.meta.env.BASE_URL;
// What the project wants to understand, in the owner's own terms.
const themes = [
  ["Attitudes", "What people in a country actually think of cannabis and of those who use it, and how far that is from what the law says."],
  ["Stigma", "Who is judged for using it, by whom, and what it costs them at work, in the family and in public."],
  ["Traditions", "Where cannabis belongs to religion, medicine, farming or celebration, and what happened to those customs under prohibition."],
  ["Obedience and authority", "Why people follow a law they do not believe in, and who they think has the right to decide."],
  ["Resistance", "How people get around a ban, organise against it or simply ignore it, and what they risk."],
  ["Generations", "What changed between grandparents, parents and children, and what did not."],
];
// Places where the history on this site already records culture meeting law. Each must exist.
const threads = [
  ["india-hemp-drugs-commission-1894", "An inquiry of 1,200 witnesses found the habit widespread, and advised against banning it partly because of “the social and religious feeling on the subject”."],
  ["india-bhang-exemption-1961", "India kept bhang out of the world treaty so that it could go on being drunk at Holi."],
  ["nepal-pashupati-distribution-ended-1995", "Until 1995 a temple trust in Kathmandu handed cannabis to holy men at Shivaratri, from the Home Ministry's confiscated stock."],
  ["jamaica-ganja-reform-2015", "Jamaica wrote Rastafari sacramental use into its law."],
  ["transvaal-mine-dagga-survey-1908", "Asked in 1908 whether dagga should be banned, the managers of the Transvaal gold mines mostly said no: use was moderate, and restrictions would keep men from coming to work."],
  ["south-africa-enforcement-compromise-1922", "A month after South Africa banned dagga, police were told to go easy in remote African areas, where an older man's morning pipe was “a custom so deep-rooted as almost to amount to a religious rite”."],
  ["mexico-salazar-marijuana-myth-1938", "A Mexican health official told the Academy of Medicine that the madness of marijuana was a myth, and ended by handing his colleagues cigarettes of it."],
  ["afghanistan-hashish-fertiliser-edicts-1969", "With Western travellers buying, Afghanistan's king issued edicts urging farmers to use fertiliser and grow more hashish."],
  ["south-africa-natal-1870", "One of the first cannabis laws anywhere applied to one group only: Indian labourers in Natal."],
  ["brazil-rio-pango-ban-1830", "Rio de Janeiro's ban of 1830 named the slaves who smoked it."],
  ["egypt-first-ban-1868", "Egypt's first ban has been read as a centralising state's wish to civilise its lower classes."],
].map(([id, text]) => {
  const ch = changes.find((x) => x.id === id);
  if (!ch) throw new Error(`culture.astro: there is no history entry "${id}"`);
  return { ch, text };
}).sort((x, y) => x.ch.date.localeCompare(y.ch.date));
---
<Base title="Culture" description="Culture is a participatory anthropology project beside the Cannabis Freedom Index: how cannabis shapes, and is shaped by, society, through anonymous surveys, personal stories and community research.">
  <main class="changes-page culture">
    <section class="hero hero-sm">
      <p class="eyebrow">Culture <span>in preparation</span></p>
      <h1>The people behind the laws</h1>
      <p class="lede">Culture is a participatory anthropology project exploring how cannabis shapes, and is shaped by, society. Through anonymous surveys, personal stories and community research, it examines cultural attitudes, stigma, traditions, obedience, authority and resistance across different countries and generations.</p>
      <p class="lede">While the Freedom Index maps laws, Culture explores the people, beliefs and social forces behind them.</p>
    </section>

    <section class="section">
      <div class="section-head"><div>
        <h2>What it asks</h2>
        <p class="sub">A score says what a person is allowed to do. It does not say what their neighbours think, what their grandmother grew, or why a law nobody respects is still obeyed.</p>
      </div></div>
      <dl class="culture-themes">
        {themes.map(([name, text]) => <div><dt>{name}</dt><dd>{text}</dd></div>)}
      </dl>
    </section>

    <section class="section">
      <div class="section-head"><div>
        <h2>How it will work</h2>
        <p class="sub">Three kinds of material, gathered from the people who live with these laws. None of it is open yet; this page will say when it is.</p>
      </div></div>
      <dl class="culture-themes three">
        <div><dt>Anonymous surveys</dt><dd>Short sets of questions, the same in every country, so that answers can be compared with each other and with the index.</dd></div>
        <div><dt>Personal stories</dt><dd>Accounts in a person's own words: an arrest, a family argument, a harvest, a ritual.</dd></div>
        <div><dt>Community research</dt><dd>Local knowledge that no statute records, collected and checked by people who know the place.</dd></div>
      </dl>
    </section>

    <section class="section">
      <div class="section-head"><div>
        <h2>Where the history already touches it</h2>
        <p class="sub">The index's <a href={`${base}history/`}>history</a> is a record of laws, but culture shows through it. A few of the places where it does:</p>
      </div></div>
      <ol class="culture-threads">
        {threads.map(({ ch, text }) => (
          <li>
            <a href={`${base}history/${ch.id}/`}>
              <time datetime={ch.date}>{ch.date.slice(0, 4)}</time>
              <span>{ch.place.flag} {ch.place.name}</span>
              <p>{text}</p>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Base>
