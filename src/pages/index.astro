---
import Base from "../layouts/Base.astro";
import DidYouKnow from "../components/DidYouKnow.astro";
import Changes from "../components/Changes.astro";
import { SEGMENTS, DATA_SNAPSHOT, REC_LABEL, REC_ORDER, REC_HELP, MED_LABEL, countries, regions, worldAvg, lastUpdated, formatDate, subunitsOf, places } from "../lib/countries.js";
import { TIERS, tierColor } from "../lib/tiers.js";

const base = import.meta.env.BASE_URL;
const count = (fn) => countries.filter(fn).length;
// 48,000,000 → "48M", 770,000 → "770k"
const compact = (n) => (n >= 1e6 ? `${+(n / 1e6).toPrecision(2)}M` : n >= 1e3 ? `${+(n / 1e3).toPrecision(2)}k` : String(n));
const useNote = (c) => c.use.estimate
  ? `Estimate: no national survey, so the regional median of ${c.use.prevalence}% of people aged 15–64 is assumed`
  : `${c.use.prevalence}% of people aged 15–64 used cannabis in the past year (${c.use.year} survey)`;
const stats = [
  [countries.length, "countries scored"],
  [count((c) => c.raw >= 60), "reach the “Free” tier (60+)"],
  [count((c) => c.raw >= 40), "score 40+: legal to possess and grow, with limits"],
  [count((c) => c.raw < 15), "score under 15: prison is a real risk"],
  [count((c) => c.rec === "death"), "keep the death penalty for cannabis offences", "danger"],
];
const legend = [...TIERS].reverse().map((t, i, arr) => ({
  name: t.name, min: t.min, max: i < arr.length - 1 ? arr[i + 1].min - 1 : 100, i,
}));
const MED_ORDER = ["yes", "limited", "no"];
// What the browser needs for the map: scores only, no prose.
// `ratio` is the share of people who use cannabis divided by the index score: how far use runs
// ahead of freedom. A score below 1 counts as 1, so that a zero does not divide.
const mapData = places.map(({ id, num, name, flag, raw, score, rank, s, use }) =>
  ({ id, num, name, flag, raw, score, rank, s, use: { ...use, ratio: +(use.prevalence / Math.max(raw, 1)).toFixed(2) } }));
// States, provinces and territories of the federations, for the map's "show states" switch.
// Keyed like the shapes in src/data/subunits.geo.json: "us/ca".
const unitData = Object.fromEntries(countries.flatMap((c) => {
  const group = subunitsOf(c.id);
  return group ? group.units.map((u) => [`${c.slug}/${u.id}`, { id: u.id, country: c.id, name: u.name, raw: u.raw, score: u.score, s: u.s, rank: u.rank, of: group.units.length }]) : [];
}));
// Cannabis use on the map: one hue from light to dark, in five steps. Each step starts at `min`.
const USE_SCALES = {
  users: { label: "Cannabis users", steps: [[0, "Under 10k"], [1e4, "10k–100k"], [1e5, "100k–1M"], [1e6, "1M–10M"], [1e7, "10M or more"]] },
  prevalence: { label: "Share who use cannabis", steps: [[0, "Under 1%"], [1, "1–3%"], [3, "3–7%"], [7, "7–15%"], [15, "15% or more"]] },
  ratio: {
    label: "Use relative to freedom",
    steps: [[0, "Under 0.15"], [0.15, "0.15–0.3"], [0.3, "0.3–0.5"], [0.5, "0.5–1"], [1, "1 or more"]],
    note: "Share of people aged 15–64 who use cannabis, divided by the index score. A high value means many people use cannabis where the law gives them little freedom to.",
  },
};
---
<Base description="A 0–100 score of how free cannabis is in every country on Earth, built from six weighted segments of law and practice.">
  <main id="top">
    <section class="hero">
      <p class="eyebrow">Global index · {DATA_SNAPSHOT} edition</p>
      <h1>How free is cannabis,<br>country by country?</h1>
      <p class="lede">One number from 0 to 100 for every country on Earth, measuring personal cannabis freedom: can you carry it, grow it, share it and use it — and what happens to you if you do. The bar is high: 100 means cannabis is treated like tomatoes. Nobody is close.</p>
      <div class="stats">
        {stats.map(([n, label, tone]) => <div class={`stat ${tone ?? ""}`}><div class="big">{n}</div><div class="label">{label}</div></div>)}
      </div>
      <Changes />
    </section>

    <section class="section" id="map">
      <div class="section-head">
        <div>
          <h2>World map</h2>
          <p class="sub" id="mapSub" data-score="Red means prison risk, green means free. Select a country for its full breakdown." data-use="The stronger the blue, the more people use cannabis. Select a country for its full breakdown." data-ratio="The stronger the blue, the further cannabis use runs ahead of the freedom to use it. Select a country for its full breakdown.">Red means prison risk, green means free. Select a country for its full breakdown.</p>
        </div>
        <label class="field">
          <span>Colour by</span>
          <select id="metric">
            <option value="index">Overall index</option>
            {SEGMENTS.map((s, i) => <option value={i}>{s.name}</option>)}
            <option value="users">Cannabis users (number)</option>
            <option value="prevalence">Cannabis users (share of adults)</option>
            <option value="ratio">Share of users ÷ index</option>
          </select>
        </label>
      </div>
      <div class="card map-card">
        <div class="map-wrap" id="mapWrap">
          <svg id="mapSvg" viewBox="0 0 960 480" role="img" aria-label="World map coloured by Cannabis Freedom Index"></svg>
          <div class="map-zoom">
            <button class="icon-btn" id="zoomIn" aria-label="Zoom in">+</button>
            <button class="icon-btn" id="zoomOut" aria-label="Zoom out">−</button>
            <button class="icon-btn" id="zoomReset" aria-label="Reset zoom">⟲</button>
          </div>
          <div class="tooltip" id="tooltip" hidden></div>
          <p class="map-msg" id="mapMsg">Loading map…</p>
        </div>
        <div class="legend" data-legend="score">
          {legend.map((t) => <span><i class="sw" style={`background:var(--t${t.i})`}></i>{t.name} · {t.min}–{t.max}</span>)}
          <span><i class="sw sw-nodata"></i>No data</span>
        </div>
        {Object.entries(USE_SCALES).map(([key, scale]) => (
          <div class="legend" data-legend={key} hidden>
            {scale.steps.map(([, text], i) => <span><i class="sw" style={`background:var(--u${i})`}></i>{text}</span>)}
            <span><i class="sw sw-nodata"></i>No data</span>
            <span class="legend-note">{scale.note ?? "People aged 15–64 who used cannabis in the past year. Figures marked ~ are regional estimates."}</span>
          </div>
        ))}
        <div class="map-under">
          <label class="map-toggle" title="Show the United States, Canada and Australia state by state">
            <input type="checkbox" id="showUnits"> States and provinces
          </label>
        </div>
      </div>
    </section>

    <section class="section" id="rankings">
      <div class="section-head">
        <div>
          <h2>Rankings</h2>
          <p class="sub"><span id="resultCount">{places.length} of {places.length} countries and territories</span></p>
        </div>
        <div class="filters">
          <input type="search" id="search" placeholder="Search country…" aria-label="Search country">
          <select id="region" aria-label="Filter by region">
            <option value="">All regions</option>
            {regions.map((r) => <option>{r}</option>)}
          </select>
          <select id="recFilter" aria-label="Filter by recreational status">
            <option value="">Any status</option>
            {REC_ORDER.map((k) => <option value={k}>{REC_LABEL[k]}</option>)}
          </select>
        </div>
      </div>
      <div class="card table-card">
        <table id="table">
          <thead>
            <tr>
              <th data-sort="rank" class="num" aria-sort="ascending">#</th>
              <th data-sort="name">Country</th>
              <th data-sort="region" class="hide-sm">Region</th>
              <th data-sort="users" class="num-col hide-md" title="People who used cannabis in the past year">Users</th>
              <th data-sort="share" class="num-col hide-md" title="Share of people aged 15–64 who used cannabis in the past year">Share</th>
              <th data-sort="rec" class="hide-sm">Recreational</th>
              <th data-sort="med" class="hide-md">Medical</th>
              <th data-sort="score" class="score-col">Index</th>
            </tr>
          </thead>
          <tbody>
            {places.map((c) => (
              <tr data-id={c.id} data-rank={c.rank ?? c.worldRank - 0.5} data-name={c.name} data-region={c.region}
                  data-rec={REC_ORDER.indexOf(c.rec)} data-med={MED_ORDER.indexOf(c.med)} data-reckey={c.rec} data-users={c.use.users} data-share={c.use.prevalence}>
                <td class="num">{c.rank ?? "–"}</td>
                <td><a class="cname" href={`${base}country/${c.slug}/`}><span class="flag">{c.flag}</span>{c.name}</a>{c.disputed && <span class="tag-disputed" title={c.disputed.note}>disputed</span>}</td>
                <td class="hide-sm">{c.region}</td>
                <td class="num-col hide-md" title={useNote(c)}>{c.use.estimate && <span class="approx">~</span>}{compact(c.use.users)}</td>
                <td class="num-col hide-md" title={useNote(c)}>{c.use.estimate && <span class="approx">~</span>}{c.use.prevalence.toFixed(1)}%</td>
                <td class="hide-sm"><span class={`chip s-${c.rec}`} title={REC_HELP[c.rec]}>{REC_LABEL[c.rec]}</span></td>
                <td class="hide-md"><span class={`chip s-${c.med}`}>{MED_LABEL[c.med]}</span></td>
                <td>
                  <div class="score-cell">
                    <span class="score-val">{c.score}</span>
                    <div class="bar"><i style={`width:${c.raw}%;background:${tierColor(c.raw)}`}></i></div>
                  </div>
                </td>
              </tr>
            ))}
            <tr id="emptyRow" hidden><td colspan="8" class="empty">No countries match these filters.</td></tr>
          </tbody>
        </table>
      </div>
      <p class="table-updated">Last updated: <time datetime={lastUpdated}>{formatDate(lastUpdated)}</time></p>
    </section>

    <section class="section" id="methodology">
      <div class="section-head">
        <div>
          <h2>Methodology</h2>
          <p class="sub">Six segments, each scored 0–10 against fixed levels, combined by weight into a 0–100 index. Half the score is simply whether you may possess and grow; a fifth is how hard users are punished. Rules for industry, products and medical programmes are not scored.</p>
        </div>
      </div>
      <div class="card note-card tomato">
        <h3>🍅 The tomato standard</h3>
        <p>A 10 means no cannabis-specific rule at all: carry any amount, grow a whole field, give it away, buy it anywhere. Every cap, licence, registry and restricted zone costs points, because regulation is counted as unfreedom. Canada lets you carry 30 g and grow four plants — that is legal, but it is not unlimited, so it scores 6 and 4, not 9 and 8. This is why even the most liberal countries land around 50 and the “Free” tier is empty.</p>
      </div>
      <div class="weights" aria-hidden="true">
        {SEGMENTS.map((s) => <div style={`flex:${s.weight}`} title={`${s.name} — ${s.weight}%`}>{s.weight}%</div>)}
      </div>
      <div class="seg-grid">
        {SEGMENTS.map((s) => (
          <div class="card seg">
            <div class="seg-top"><h3>{s.name}</h3><span class="seg-w">{s.weight}%</span></div>
            <p>{s.desc}</p>
            <ul class="anchors">{s.levels.map(([n, t]) => <li><b>{n}</b>{t}</li>)}</ul>
          </div>
        ))}
      </div>
      <div class="card note-card">
        <h3>Read this before relying on it</h3>
        <p>Scores are editorial estimates that blend the written law with how it is enforced in practice. Federal countries (United States, Australia, India) get a single national estimate that hides large internal differences. Scores between the listed levels mean a country sits between two descriptions. Every country has a written explanation and linked sources for each segment — select a country to read them. For many smaller countries the only sources available are secondary summaries, and the explanations say so where a figure could not be confirmed.</p>
        <p>Laws change quickly and this is <strong>not legal advice</strong>. Always check current local law before travelling with, buying or growing cannabis.</p>
      </div>
    </section>

    <DidYouKnow />

  </main>

  <dialog id="detail" class="drawer" aria-label="Country details">
    <div class="drawer-bar">
      <a class="icon-btn" id="dCompare" href={`${base}compare/`} aria-label="Compare with other countries" title="Compare with other countries">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 20V9M12 20V4M19 20v-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
      </a>
      <a class="icon-btn" id="dExpand" href={base} aria-label="Open full page" title="Open full page">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <button class="icon-btn" id="dClose" aria-label="Close">✕</button>
    </div>
    <div class="drawer-inner" id="detailBody"></div>
  </dialog>

  <script type="application/json" id="cfi-data" set:html={JSON.stringify(mapData)} />
  <script type="application/json" id="cfi-units" set:html={JSON.stringify(unitData)} />
  <script type="application/json" id="cfi-use-scales" set:html={JSON.stringify(USE_SCALES)} />
  <script type="application/json" id="cfi-segments" set:html={JSON.stringify(SEGMENTS.map((s) => s.name))} />

  <script>
    import { select, selectAll } from "d3-selection";
    import { geoNaturalEarth1, geoPath } from "d3-geo";
    import { zoom, zoomIdentity } from "d3-zoom";
    import "d3-transition";
    import { feature } from "topojson-client";
    import atlasUrl from "world-atlas/countries-50m.json?url";
    import unitsUrl from "../data/subunits.geo.json?url";
    import territoryShapes from "../data/territories.geo.json";
    import { tierOf, tierColor } from "../lib/tiers.js";

    const base = import.meta.env.BASE_URL;
    const $ = (sel, root = document) => root.querySelector(sel);
    const COUNTRIES = JSON.parse($("#cfi-data").textContent);
    const SEGMENT_NAMES = JSON.parse($("#cfi-segments").textContent);
    const byId = new Map(COUNTRIES.map((c) => [c.id, c]));
    const byNum = new Map(COUNTRIES.filter((c) => c.num != null).map((c) => [c.num, c]));
    // Map features that inherit another entry's score (atlas name or numeric id → country id).
    const ALIASES = { Kosovo: "XK", Somaliland: "XS", "N. Cyprus": "XN", 304: "DK" };

    // ── Map ───────────────────────────────────────────────
    let metric = "index";
    let paths = null;
    const USE_SCALES = JSON.parse($("#cfi-use-scales").textContent);
    const isUse = () => metric in USE_SCALES; // coloured by cannabis use, not by a score
    const metricValue = (c) => (metric === "index" ? c.raw : c.s[+metric] * 10);
    const metricLabel = () => (metric === "index" ? "Index" : SEGMENT_NAMES[+metric]);
    const metricText = (c) => (metric === "index" ? `${c.score} / 100` : `${c.s[+metric]} / 10`);
    const compact = (n) => (n >= 1e6 ? `${+(n / 1e6).toPrecision(2)}M` : n >= 1e3 ? `${+(n / 1e3).toPrecision(2)}k` : String(n));
    // the darkest step whose threshold the country reaches
    const useColor = (c) => {
      const steps = USE_SCALES[metric].steps;
      const v = c.use[metric];
      let i = 0;
      while (i < steps.length - 1 && v >= steps[i + 1][0]) i++;
      return `var(--u${i})`;
    };

    // States and provinces: drawn on request, in place of their federation's single shape.
    const UNITS = JSON.parse($("#cfi-units").textContent);
    const FEDERATIONS = new Set(Object.values(UNITS).map((u) => u.country));
    let unitPaths = null;   // the state shapes, once loaded
    let showUnits = false;
    let drawUnits = null;   // set by initMap: loads and draws the shapes

    function paintMap() {
      if (paths) {
        paths.attr("fill", (d) => (d.id === "010" ? "var(--land)" : !d.c ? "url(#hatch)" : isUse() ? useColor(d.c) : tierColor(metricValue(d.c))));
        // a federation's own shape steps aside while its states are shown
        paths.style("display", (d) => (showUnits && unitPaths && d.c && FEDERATIONS.has(d.c.id) ? "none" : null));
      }
      if (unitPaths) {
        unitPaths.style("display", showUnits ? null : "none");
        // cannabis use is only known nationally, so a state takes its country's colour for those
        unitPaths.attr("fill", (d) => (isUse() ? useColor(byId.get(d.u.country)) : tierColor(metricValue(d.u))));
      }
      const shown = isUse() ? metric : "score";
      document.querySelectorAll("[data-legend]").forEach((el) => { el.hidden = el.dataset.legend !== shown; });
      const sub = $("#mapSub");
      sub.textContent = metric === "ratio" ? sub.dataset.ratio : isUse() ? sub.dataset.use : sub.dataset.score;
    }
    $("#metric").addEventListener("change", (e) => { metric = e.target.value; paintMap(); });
    $("#showUnits").addEventListener("change", async (e) => {
      showUnits = e.target.checked;
      if (showUnits && !unitPaths && drawUnits) {
        try { await drawUnits(); } catch (err) { e.target.checked = showUnits = false; }
      }
      paintMap();
    });

    async function initMap() {
      const svg = select("#mapSvg");
      const msg = $("#mapMsg");
      let world;
      try {
        world = await (await fetch(atlasUrl)).json();
      } catch (err) {
        msg.textContent = "The map could not be loaded. Rankings below still work.";
        return;
      }
      msg.remove();

      const features = feature(world, world.objects.countries).features;
      const ANTARCTICA = "010"; // not a country: drawn as a plain grey shape
      features.forEach((f) => {
        const alias = ALIASES[f.properties.name] || ALIASES[+f.id];
        f.c = alias ? byId.get(alias) : byNum.get(+f.id);
      });

      // Disputed territories the atlas has no shape for (Transnistria, Abkhazia) come from a small
      // file of their own and are drawn last, on top of the country they are carved out of.
      territoryShapes.features.forEach((f) => { f.c = byId.get(f.id); });
      features.push(...territoryShapes.features.filter((f) => f.c));

      const projection = geoNaturalEarth1().fitExtent([[8, 8], [952, 472]], { type: "Sphere" });
      const path = geoPath(projection);

      svg.append("defs").html(
        `<pattern id="hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
           <rect width="5" height="5" fill="var(--nodata)"/><rect width="2" height="5" fill="var(--hatch)"/>
         </pattern>`
      );
      const g = svg.append("g");
      g.append("path").attr("class", "sphere").attr("d", path({ type: "Sphere" }));

      const tip = $("#tooltip");
      const wrap = $("#mapWrap");
      // what the hover box says about a country, or about one of its states (`u`)
      const describe = (d) => {
        const c = d.c;
        if (d.u && !isUse()) {
          const u = d.u, home = byId.get(u.country);
          return `<strong>${home.flag} ${u.name}</strong>
               <div class="row"><span>${metricLabel()}</span><b>${metricText(u)}</b></div>
               <div class="row"><span>Tier</span><b>${tierOf(metricValue(u)).name}</b></div>
               <div class="row"><span>Rank in ${home.name}</span><b>#${u.rank} of ${u.of}</b></div>`;
        }
        if (d.u) return describe({ c: byId.get(d.u.country), properties: d.properties }) + `<div class="row"><span>${d.u.name}</span><b>national figure</b></div>`;
        return c && metric === "ratio"
            ? `<strong>${c.flag} ${c.name}</strong>
               <div class="row"><span>Share ÷ index</span><b>${c.use.estimate ? "~" : ""}${c.use.ratio}</b></div>
               <div class="row"><span>Share aged 15–64</span><b>${c.use.estimate ? "~" : ""}${c.use.prevalence}%</b></div>
               <div class="row"><span>Index</span><b>${c.score} / 100</b></div>`
            : c && isUse()
            ? `<strong>${c.flag} ${c.name}</strong>
               <div class="row"><span>Users</span><b>${c.use.estimate ? "~" : ""}${compact(c.use.users)}</b></div>
               <div class="row"><span>Share aged 15–64</span><b>${c.use.estimate ? "~" : ""}${c.use.prevalence}%</b></div>
               <div class="row"><span>${c.use.estimate ? "Regional estimate" : "Survey year"}</span><b>${c.use.estimate ? "no survey" : c.use.year}</b></div>`
            : c
            ? `<strong>${c.flag} ${c.name}</strong>
               <div class="row"><span>${metricLabel()}</span><b>${metricText(c)}</b></div>
               <div class="row"><span>Tier</span><b>${tierOf(metricValue(c)).name}</b></div>
               <div class="row"><span>World rank</span><b>${c.rank ? "#" + c.rank : "not ranked"}</b></div>`
            : `<strong>${d.properties.name}</strong><div class="row"><span>No data</span></div>`;
      };
      const showTip = (e, d) => {
        tip.innerHTML = describe(d);
        tip.hidden = false;
        const box = wrap.getBoundingClientRect();
        const x = e.clientX - box.left, y = e.clientY - box.top;
        tip.style.left = Math.min(x + 14, box.width - tip.offsetWidth - 8) + "px";
        tip.style.top = Math.max(8, y - tip.offsetHeight - 12) + "px";
      };
      paths = g.selectAll(".country-shape").data(features).join("path")
        .attr("class", (d) => "country-shape" + (d.c ? " has-data" : "") + (d.id === ANTARCTICA ? " land-only" : ""))
        .attr("d", path)
        .on("pointermove", showTip)
        .on("pointerleave", () => (tip.hidden = true))
        .on("click", (e, d) => d.c && openCountry(d.c.id));

      drawUnits = async () => {
        const shapes = (await (await fetch(unitsUrl)).json()).features.filter((f) => UNITS[f.id]);
        shapes.forEach((f) => { f.u = UNITS[f.id]; });
        unitPaths = g.selectAll(".unit-shape").data(shapes).join("path")
          .attr("class", "country-shape unit-shape has-data")
          .attr("d", path)
          .on("pointermove", showTip)
          .on("pointerleave", () => (tip.hidden = true))
          .on("click", (e, d) => openUnit(d.u.country, d.u.id));
      };
      paintMap();
      markActive();

      const z = zoom().scaleExtent([1, 10]).translateExtent([[0, 0], [960, 480]])
        .on("zoom", (e) => g.attr("transform", e.transform));
      svg.call(z);
      $("#zoomIn").onclick = () => svg.transition().duration(250).call(z.scaleBy, 1.8);
      $("#zoomOut").onclick = () => svg.transition().duration(250).call(z.scaleBy, 1 / 1.8);
      $("#zoomReset").onclick = () => svg.transition().duration(250).call(z.transform, zoomIdentity);
    }

    // ── Rankings: the rows are in the HTML; we only filter and reorder them ──
    const tbody = $("#table tbody");
    const rows = [...tbody.querySelectorAll("tr[data-id]")];
    const emptyRow = $("#emptyRow");
    const state = { q: "", region: "", rec: "", sort: "rank", asc: true };
    const norm = (s) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
    const num = (r, k) => +r.dataset[k];
    const sorters = {
      rank: (a, b) => num(a, "rank") - num(b, "rank"),
      score: (a, b) => num(a, "rank") - num(b, "rank"),
      name: (a, b) => a.dataset.name.localeCompare(b.dataset.name),
      region: (a, b) => a.dataset.region.localeCompare(b.dataset.region) || num(a, "rank") - num(b, "rank"),
      rec: (a, b) => num(a, "rec") - num(b, "rec") || num(a, "rank") - num(b, "rank"),
      med: (a, b) => num(a, "med") - num(b, "med") || num(a, "rank") - num(b, "rank"),
      users: (a, b) => num(b, "users") - num(a, "users"), // most users first
      share: (a, b) => num(b, "share") - num(a, "share"), // highest share first
    };

    function applyTable() {
      const q = norm(state.q.trim());
      const sorted = [...rows].sort(sorters[state.sort]);
      if (!state.asc) sorted.reverse();
      let shown = 0;
      sorted.forEach((r) => {
        const ok = (!q || norm(r.dataset.name).includes(q)) &&
          (!state.region || r.dataset.region === state.region) &&
          (!state.rec || r.dataset.reckey === state.rec);
        r.hidden = !ok;
        if (ok) shown++;
        tbody.append(r);
      });
      tbody.append(emptyRow);
      emptyRow.hidden = shown > 0;
      $("#resultCount").textContent = `${shown} of ${rows.length} countries and territories`;
      document.querySelectorAll("#table th").forEach((th) => th.removeAttribute("aria-sort"));
      $(`#table th[data-sort="${state.sort}"]`).setAttribute("aria-sort", state.asc ? "ascending" : "descending");
    }

    $("#search").addEventListener("input", (e) => { state.q = e.target.value; applyTable(); });
    $("#region").addEventListener("change", (e) => { state.region = e.target.value; applyTable(); });
    $("#recFilter").addEventListener("change", (e) => { state.rec = e.target.value; applyTable(); });
    $("#table thead").addEventListener("click", (e) => {
      const th = e.target.closest("th");
      if (!th) return;
      state.asc = state.sort === th.dataset.sort ? !state.asc : true;
      state.sort = th.dataset.sort;
      applyTable();
    });
    // A plain click opens the drawer; modified clicks (new tab etc.) follow the link to the full page.
    tbody.addEventListener("click", (e) => {
      const tr = e.target.closest("tr[data-id]");
      if (!tr || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      openCountry(tr.dataset.id);
    });

    // ── Country drawer: shows the same article as the full country page ──
    const dialog = $("#detail");
    const body = $("#detailBody");
    const pageUrl = (id) => `${base}country/${id.toLowerCase()}/`;
    const cache = new Map();

    // Articles are cached by page address, which also covers states and provinces.
    async function loadArticle(url) {
      if (!cache.has(url)) {
        const html = await (await fetch(url)).text();
        const article = new DOMParser().parseFromString(html, "text/html").querySelector("article.country");
        // The full page shows every explanation; in the drawer they start collapsed.
        article.querySelectorAll("details[open]").forEach((el) => el.removeAttribute("open"));
        cache.set(url, article);
      }
      return cache.get(url).cloneNode(true);
    }
    // Swap the drawer to another view of the same country (a state, or back to national).
    async function showInDrawer(url) {
      try {
        body.replaceChildren(await loadArticle(url));
        $("#dExpand").href = url;
        dialog.scrollTop = 0;
      } catch (err) {
        location.href = url;
      }
    }
    body.addEventListener("change", (e) => {
      const select = e.target.closest("select[data-subunit-select]");
      if (select) showInDrawer(select.value);
    });
    body.addEventListener("click", (e) => {
      const a = e.target.closest("a[data-subunit]");
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      showInDrawer(a.getAttribute("href"));
    });

    function markActive() {
      const id = currentId();
      selectAll(".country-shape").classed("active", (d) => !!id && d.c && d.c.id === id);
    }
    const currentId = () => {
      const m = location.hash.match(/^#\/([A-Z]{2})$/);
      return m && byId.has(m[1]) ? m[1] : null;
    };

    // Open a federation's drawer on one of its states.
    async function openUnit(countryId, unitId) {
      openCountry(countryId);
      await showInDrawer(`${pageUrl(countryId)}${unitId}/`);
    }
    function openCountry(id) {
      if (location.hash !== "#/" + id) history.pushState(null, "", "#/" + id);
      showFromHash();
    }
    async function showFromHash() {
      const id = currentId();
      markActive();
      if (!id) return dialog.open && dialog.close();
      $("#dExpand").href = pageUrl(id);
      $("#dCompare").href = `${base}compare/?c=${id.toLowerCase()}`;
      try {
        const article = await loadArticle(pageUrl(id));
        if (currentId() !== id) return;
        body.replaceChildren(article);
      } catch (err) {
        location.href = pageUrl(id);
        return;
      }
      if (!dialog.open) dialog.showModal();
      dialog.scrollTop = 0;
    }
    // Country links elsewhere on the page (e.g. "Did you know?") open the drawer too.
    document.addEventListener("click", (e) => {
      const a = e.target.closest("a[data-country]");
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      openCountry(a.dataset.country);
    });
    $("#dClose").addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (e) => e.target === dialog && dialog.close());
    dialog.addEventListener("close", () => {
      if (location.hash.startsWith("#/")) history.pushState(null, "", location.pathname + location.search);
      markActive();
    });
    window.addEventListener("hashchange", showFromHash);
    window.addEventListener("popstate", showFromHash);

    initMap();
    showFromHash();
  </script>
</Base>
