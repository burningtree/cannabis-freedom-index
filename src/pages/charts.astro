      const steps = new Map(D.stripes.rows.map(([slug, name, st]) => [slug, { name, st }]));
      const TIERS = [[60, 5, "Free"], [40, 4, "Legal with limits"], [25, 3, "Tolerant"], [15, 2, "Restrictive"], [5, 1, "Prohibition"], [0, 0, "Severe prohibition"]];
      const tierAt = (v) => TIERS.find(([min]) => v >= min);
      const scoreAt = (slug, year) => steps.get(slug)?.st.findLast(([y]) => y <= year)?.[1] ?? 100;
      const tiles = box.querySelectorAll("[data-tilemap]");
