  ["Use and drugs", "Students who find it easy to get (Europe)", "#easy-to-get", (c) => c.datasets.espad_availability?.easy],
  ["Use and drugs", "Cannabis in wastewater (log)", "#wastewater", (c) => logOr(latestSince(c.series.wastewater, "thc_cooh", 2020)?.thc_cooh)],
  ["Use and drugs", "Alcohol drunk per person", "#alcohol", (c) => latestSince(c.series.alcohol, "litres", 2015)?.litres],
  ["Markets and enforcement", "Price of a gram of herb (Europe)", "#price", (c) => latestSince(c.series.prices_europe, "herb_eur", 2018)?.herb_eur],
  ["Markets and enforcement", "THC in herb (Europe)", "#thc-per-euro", (c) => latestSince(c.series.potency_europe, "herb_thc", 2018)?.herb_thc],
  ["Markets and enforcement", "Cannabis shops mapped per person (log)", "map/cannabis-shops-mapped/", (c) => { const r = c.datasets.osm_shops; return r ? Math.log10(1 + perPerson(c, r.shops, 1e6)) : null; }],
  ["Markets and enforcement", "Use or possession offences per person (Europe)", "#punished", (c) => perPerson(c, latestSince(c.series.cannabis_offences, "offences", 2020)?.offences, 1e5)],
  ["Markets and enforcement", "Police contact for drug possession per person", "map/drug-possession-police/", (c) => perPerson(c, latestSince(c.series.police_possession, "persons", 2018)?.persons, 1e5)],
  ["Markets and enforcement", "Treatment entrants who came for cannabis (Europe)", "#punish-or-treat", (c) => c.datasets.treatment?.cannabis_share],
  ["Markets and enforcement", "Clinical trials per person (log)", "#trials", (c) => { const r = c.series.clinical_trials?.at(-1); return r ? Math.log10(1 + (r.to_date / c.population) * 1e6) : null; }],
  ["Markets and enforcement", "Cannabis seized per person (log)", "map/cannabis-seizures/", (c) => { const kg = latestSince(c.series.seizures, "total_kg", 2018)?.total_kg; return kg != null ? Math.log10(1 + perPerson(c, kg, 1e6)) : null; }],
  ["Culture and history", "Cannabis in the news (log)", "#in-the-news", (c) => { const r = latestSince(c.series.news, "share", 2024); return r && r.share > 0 ? Math.log10(r.share) : null; }],
  ["Culture and history", "Christian majority", "#religion", (c) => faithIs(c, "Christians")],
  ["Culture and history", "No religion is the largest group", "#religion", (c) => faithIs(c, "Religiously Unaffiliated")],
  ["Culture and history", "Muslim majority", "#religion", (c) => faithIs(c, "Muslims")],
  ["Culture and history", "Opinion that using marijuana is not immoral", "#opinion", (c) => (c.datasets.pew_marijuana ? c.datasets.pew_marijuana.acceptable + c.datasets.pew_marijuana.not_moral : null)],
  ["Culture and history", "Years under prohibition since 1860", "#stripes", (c) => bannedYears.get(c.id)],
  ["Culture and history", "Year of the first rule on cannabis", "#first-bans", (c) => firstYearOf.get(c.id)],
  ["Culture and history", "Once ruled by Britain", "#empire", (c) => ruledBy(c, "gb")],
  ["Culture and history", "Once ruled by France", "#empire", (c) => ruledBy(c, "fr")],
];
const measures = MEASURES.map(([group, label, href, get]) => {
  const pts = countries.map((c) => ({ x: get(c), y: c.raw })).filter((p) => Number.isFinite(p.x));
  return { group, label, href, n: pts.length, r: corr(pts).r };
}).filter((m) => m.n >= 20 && Number.isFinite(m.r));
const MEASURE_GROUPS = [...new Set(measures.map((m) => m.group))].map((g) => ({ g, list: measures.filter((m) => m.group === g).sort((a, b) => b.r - a.r) }));
// the headline speaks of the measures that cover most of the world; the narrow ones are named after it
const strongest = [...measures].filter((m) => m.n >= 100).sort((a, b) => Math.abs(b.r) - Math.abs(a.r))[0];
const strongestNarrow = [...measures].filter((m) => m.n < 100).sort((a, b) => Math.abs(b.r) - Math.abs(a.r))[0];

// ── When a country looked it up: Wikipedia readers of the cannabis article, by language ──
const WIKI = DATASETS.wikipedia_views;
const wiki = countries.filter((c) => c.series.wikipedia_views?.length).map((c) => {
  const rows = c.series.wikipedia_views;
  const peak = rows.reduce((a, b) => (b.views > a.views ? b : a));
  // the peak against a normal month: the middle month of the whole series
  const base12 = median(rows.map((r) => r.views)) || peak.views;
  // the scored changes in the law since July 2015, to mark on the line
  const laws = changes.filter((ch) => ch.country === c && ch.score && !ch.estimate && String(ch.date) >= "2015-07")
    .map((ch) => ({ t: +String(ch.date).slice(0, 4) + ((+String(ch.date).slice(5, 7) || 6) - 0.5) / 12, title: ch.title, d: Math.round(ch.raw.after - ch.raw.before) }));
  return { c, rows, peak, jump: peak.views / base12, laws, lang: rows[0].language };
}).sort((a, b) => b.jump - a.jump);
const W0w = 2015.5, W1w = Math.max(...wiki.flatMap((w) => w.rows.map((r) => r.year)));
const wx = (t) => pct(t, W0w, W1w);
const wikiPath = (w) => { const top = Math.max(...w.rows.map((r) => r.views)); return w.rows.map((r, i) => `${i ? "L" : "M"}${wx(r.year).toFixed(2)},${(100 - (r.views / top) * 92).toFixed(2)}`).join(""); };
const lawNear = (w) => w.laws.find((l) => Math.abs(l.t - w.peak.year) <= 0.25);
const wikiLead = wiki.find((w) => lawNear(w)) ?? wiki[0];
const monthName = (m) => new Date(`${m}-15`).toLocaleDateString("en-GB", { month: "long", year: "numeric", timeZone: "UTC" });

// ── The words for it: how often books in six languages name the plant and the drug ──
const BOOKS = DATASETS.book_words;
const ROLE = (w) => /^(hemp|hanf|chanvre|canapa|cáñamo|конопля)$/.test(w) ? "plant" : /^(cannabis|каннабис)$/.test(w) ? "cannabis" : /^(marijuana|marihuana|марихуана)$/.test(w) ? "marijuana" : "hashish";
const ROLE_COLOR = { plant: "var(--t4)", cannabis: "var(--u3)", marijuana: "var(--t2)", hashish: "var(--t1)" };
const ROLE_LABEL = { plant: "The plant: hemp, Hanf, chanvre …", cannabis: "Cannabis", marijuana: "Marijuana", hashish: "Hashish" };
const CORPORA = [["en", "English"], ["de", "German"], ["fr", "French"], ["es", "Spanish"], ["it", "Italian"], ["ru", "Russian"]];
const BK0 = 1800, BK1 = 2022;
const bookPanels = CORPORA.map(([code, name]) => {
  const rows = BOOKS.rows.filter((r) => r.corpus === code);
  const words = [...new Set(rows.map((r) => r.word))].map((word) => ({ word, role: ROLE(word), pts: rows.filter((r) => r.word === word).sort((a, b) => a.year - b.year).map((r) => [r.year, r.per_billion]) }));
  // a five-year rolling mean, so a year with few books does not draw a spike
  for (const w of words) w.smooth = w.pts.map(([y], i) => [y, mean(w.pts.slice(Math.max(0, i - 2), i + 3).map(([, v]) => v))]);
  const top = Math.max(...words.flatMap((w) => w.smooth.map(([, v]) => v)));
  for (const w of words) w.d = w.smooth.map(([y, v], i) => `${i ? "L" : "M"}${pct(y, BK0, BK1).toFixed(2)},${(100 - (v / top) * 94).toFixed(2)}`).join("");
  return { code, name, words };
});
const enPanel = bookPanels[0];
const enOf = (role) => enPanel.words.find((w) => w.role === role).smooth;
const overtook = enOf("marijuana").find(([y, v], i) => y > 1900 && v > enOf("plant")[i][1])?.[0];
const hempLead1900 = Math.round(enOf("plant").find(([y]) => y === 1900)[1] / enOf("marijuana").find(([y]) => y === 1900)[1]);

// ── Medicine: registered clinical trials of cannabis medicines ──
const TRIALS = DATASETS.clinical_trials;
const trialYears = Array.from({ length: NOW - 1999 }, (_, i) => 2000 + i).map((y) => ({ y, n: countries.reduce((t, c) => t + (c.series.clinical_trials?.find((r) => r.year === y)?.trials ?? 0), 0) }));
const trialMax = Math.max(...trialYears.map((t) => t.n));
const trialTop = countries.filter((c) => c.series.clinical_trials?.length && c.population > 1e6)
  .map((c) => ({ c, total: c.series.clinical_trials.at(-1).to_date, per: (c.series.clinical_trials.at(-1).to_date / c.population) * 1e6 }))
  .sort((a, b) => b.per - a.per).slice(0, 15);
const trialMostTotal = countries.filter((c) => c.series.clinical_trials?.length).map((c) => ({ c, total: c.series.clinical_trials.at(-1).to_date })).sort((a, b) => b.total - a.total)[0];
const trialCountries = countries.filter((c) => c.series.clinical_trials?.length).length;

// ── One-issue parties: parties founded to legalise cannabis ──
const PARTIES = DATASETS.cannabis_parties;
const partyRows = countries.filter((c) => c.series.cannabis_parties?.length).map((c) => ({ c, list: c.series.cannabis_parties }))
  .sort((a, b) => Math.min(...a.list.map((p) => p.year ?? 9999)) - Math.min(...b.list.map((p) => p.year ?? 9999)));
const partyCount = partyRows.reduce((t, r) => t + r.list.length, 0);
const P0 = 1990;

// ── Punish or treat: cannabis offences and cannabis treatment, per 1,000 people who use it ──
const TREAT = DATASETS.treatment;
const punishTreat = countries.map((c) => {
  const off = latestSince(c.series.cannabis_offences, "offences", 2020), tr = c.datasets.treatment;
  const users = c.use && !c.use.estimate ? c.use.users : 0;
  return off && tr && users ? { c, punish: (off.offences / users) * 1000, treat: (tr.cannabis / users) * 1000, offYear: off.year, trYear: tr.year, share: tr.cannabis_share } : null;
}).filter(Boolean);
const PT0 = -1, PT1 = 3; // 0.1 to 1,000 per 1,000 users, tenfold steps
const ptx = (v) => pct(Math.log10(Math.max(v, 0.1)), PT0, PT1), pty = (v) => 100 - pct(Math.log10(Math.max(v, 0.1)), PT0, PT1);
const punishMore = punishTreat.filter((d) => d.punish > d.treat);
const ptNamed = pickLabels([...punishTreat].sort((a, b) => Math.abs(Math.log10(b.punish / b.treat)) - Math.abs(Math.log10(a.punish / a.treat))).map((d) => ({ key: d.c.id, x: ptx(d.punish), y: pty(d.treat) })), 20);

// ── In the news: the share of each country's news articles that mention cannabis ──
const NEWS = DATASETS.news; // absent until datasets/gdelt-cannabis-news.csv has been fetched
const NEWS_YEAR = NOW - 1; // the latest full year
const newsRows = NEWS ? countries.map((c) => {
  const rows = (c.series.news ?? []).filter((r) => r.year >= 2017 && r.year <= NEWS_YEAR && r.days >= 200);
  const last = rows.find((r) => r.year === NEWS_YEAR);
  return last ? { c, rows, share: last.share } : null;
}).filter(Boolean).sort((a, b) => b.share - a.share) : [];
const newsTop = newsRows.slice(0, 20);
const newsMid = newsRows.length ? median(newsRows.map((n) => n.share)) : 1;
const newsFit = newsRows.length > 20 ? corr(newsRows.map((n) => ({ x: Math.log10(n.share), y: n.c.raw }))) : { r: 0 };
const sparkOf = (rows) => { const top = Math.max(...rows.map((r) => r.share)); return rows.map((r, i) => `${i ? "L" : "M"}${pct(r.year, 2017, NEWS_YEAR).toFixed(1)},${(100 - (r.share / top) * 90).toFixed(1)}`).join(""); };

// ── The sharpest borders: neighbours whose laws differ most ──
// Neighbours as in src/lib/borders.js: their shapes on the site's world map share a border line.
const borderPairs = new Map();
for (const [id, list] of neighboursOf) for (const other of list) {
  const a = byId.get(id), b = byId.get(other), [p, q] = a.raw >= b.raw ? [a, b] : [b, a];
  borderPairs.set(`${p.id}|${q.id}`, { free: p, strict: q, gap: p.raw - q.raw });
}
const borders = [...borderPairs.values()].sort((x, y) => y.gap - x.gap);
const sharpest = borders.slice(0, 16);
const legalLine = borders.filter((b) => b.free.raw >= 40 && b.strict.raw < 15).length;
const sameBand = borders.filter((b) => tierOf(b.free.raw) === tierOf(b.strict.raw)).length;
const BX1 = 60;

// "Canada's", "United States'"
const owner = (name) => `${name}${name.endsWith("s") ? "'" : "'s"}`;

// what the hover cards read, in one block
const chartData = {
