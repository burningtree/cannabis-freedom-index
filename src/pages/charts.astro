  stream: { decades, groups: STREAM.map((g) => [g.label, g.color]), counts: streamCounts },
  moral: Object.fromEntries(moral.map((m) => [m.c.slug, [m.c.flag + " " + m.c.name, m.d.acceptable, m.d.not_moral, m.d.unacceptable, Math.round(m.y), tierOf(m.y).name, REC_LABEL[m.c.rec]]])),
  price: Object.fromEntries(priced.map((p) => [p.c.slug, [p.c.flag + " " + p.c.name, p.y, p.r.year, Math.round(p.x), tierOf(p.x).name]])),
  punish: Object.fromEntries(punished.map((p) => [p.c.slug, [p.c.flag + " " + p.c.name, Math.round(p.rate), p.r.offences, p.r.year, p.c.users ?? p.c.use.users, p.c.use.prevalence]])),
  thc: thcYears.map((t) => [t.year, +t.mg.toFixed(1), +t.th.toFixed(1), +t.pr.toFixed(2), t.rows.length]),
  thcRange: [T0, T1, MG1],
  thcCountries: thcCountries.map((x) => [x.c.slug, `${x.c.flag} ${x.c.name}`, thcYears.flatMap((t) => t.rows.filter((r) => r.c === x.c).map((r) => [t.year, +r.mg.toFixed(1), +r.th.toFixed(1), +r.pr.toFixed(2)]))]),
  hemp: Object.fromEntries(hempGrowers.map((h) => [h.c.slug, [h.c.flag + " " + h.c.name, h.ha, h.r.year, REC_LABEL[h.c.rec], Math.round(h.c.raw)]])),
  research: Object.fromEntries(research.map((r) => [r.c.slug, [r.c.flag + " " + r.c.name, fmtRate(r.per), r.total, Math.round(r.c.raw), tierOf(r.c.raw).name]])),
  easy: Object.fromEntries(easy.map((e) => [e.c.slug, [e.c.flag + " " + e.c.name, e.d.easy, e.d.easy_boys, e.d.easy_girls, Math.round(e.x), tierOf(e.x).name]])),
  sewage: Object.fromEntries(sewage.map((w) => [w.c.slug, [w.c.flag + " " + w.c.name, w.y, w.r.year, w.r.cities, Math.round(w.x), tierOf(w.x).name, w.trend]])),
  sourcing: sourcing.map((r) => [r.year, ...SOURCE_KINDS.map((k) => r[k.id] ?? null)]),
  sourceLabels: SOURCE_KINDS.map((k) => [k.label, k.color]),
