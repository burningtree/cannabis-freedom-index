  ["borders", "The sharpest borders"],
  ["stripes", "Every country, every year"],
  ["first-bans", "The first restrictions"],
  ["waves", "The waves of law"],
  ["empire", "Prohibition and empire"],
  ["stream", "What the history is about"],
  ["flows", "How countries moved"],
  ["since-1961", "From prohibition to the top"],
  ["regions", "Regions over time"],
  ["spread", "How the scores spread"],
  ["opinion-gap", "When opinion moved first"],
  ["mosaic", "Six parts of freedom"],
  ["radar", "The shape of freedom"],
  ["buy-grow", "Buy it or grow it"],
  ["punished", "Who the police record"],
  ["punish-or-treat", "Punish or treat"],
  ["use", "Use and the law"],
  ["teen-trends", "Did prohibition protect children?"],
  ["easy-to-get", "Easy to get"],
  ["wastewater", "What flows beneath"],
  ["alcohol", "Alcohol and cannabis"],
  ["price", "The price of prohibition"],
  ["work-for-a-gram", "One gram, how much work?"],
  ["thc-per-euro", "THC for a euro"],
  ["sourcing", "From friends to shops"],
  ["state-merchant", "The state as merchant"],
  ["hemp", "Criminalising a crop"],
  ["opinion", "The law and the people"],
  ["parties", "One-issue parties"],
  ["religion", "Faith and the law"],
  ["freedom", "Freedom and cannabis freedom"],
  ["corruption", "Corruption and the law"],
  ["state-capacity", "Can a strong state stop it?"],
  ["trials", "Medicine on trial"],
  ["research", "Researching the forbidden plant"],
  ["words-in-books", "The words for it"],
  ["looked-it-up", "When a country looked it up"],
  ...(NEWS ? [["in-the-news", "In the news"]] : []),
  ["what-goes-with-it", "What goes with freedom"],
];
// the page in chapters, most telling first: [title, the first chart of the chapter]
const CHAPTERS = [
  ["The world today", "world"],
  ["How prohibition spread", "stripes"],
  ["The way back", "flows"],
  ["What the law allows", "mosaic"],
  ["The law and use", "use"],
  ["Markets and money", "price"],
  ["Politics and society", "opinion"],
  ["Science, words and attention", "trials"],
  ["Everything together", "what-goes-with-it"],
];
const chapters = CHAPTERS.map(([title, from], i) => {
  const start = sections.findIndex(([id]) => id === from), end = i + 1 < CHAPTERS.length ? sections.findIndex(([id]) => id === CHAPTERS[i + 1][1]) : sections.length;
  return { title, from, items: sections.slice(start, end).map(([id, name]) => ({ id, name, n: sections.findIndex(([x]) => x === id) + 1 })) };
});
const chapterAt = new Map(chapters.map((c) => [c.from, c.title]));
// a chart's number and name for its kicker: "03 · The first restrictions"
const kick = (id) => { const i = sections.findIndex(([x]) => x === id); return `${String(i + 1).padStart(2, "0")} · ${sections[i][1]}`; };
---
<Base title="Charts" description="The Cannabis Freedom Index in charts: how prohibition spread after 1860, the waves of law, when each country first restricted cannabis, which countries changed most since 1961, the regions, the world's people by band, recreational and medical law, use and the law, and how cannabis freedom relates to freedom in general.">
  <main class="changes-page charts-page">
    <section class="hero hero-sm">
      <p class="eyebrow">Charts</p>
      <h1>Cannabis (un)freedom in charts</h1>
      <p class="lede">The index's scores and history, drawn. Every chart is rebuilt from the same files as the rest of the site, so it changes when a law does. Each has a link of its own.</p>
    </section>
    <nav class="ch-toc" aria-label="Charts on this page">
      {chapters.map((ch) => (
        <div class="ch-toc-group">
          <p>{ch.title}</p>
          {ch.items.map((x) => <a href={`#${x.id}`}><b>{String(x.n).padStart(2, "0")}</b>{x.name}</a>)}
        </div>
      ))}
    </nav>

    {chapterAt.has("world") && <h2 class="ch-chapter">{chapterAt.get("world")}</h2>}
    <section class="ch" id="world">
      <p class="ch-kicker"><a href="#world">{kick("world")}</a></p>
      <h2>Prohibition spread in under a century, and has barely receded</h2>
      <p class="ch-dek">The coloured bands are the share of countries in each band of the index, year by year; the line is the world average score on the same 0–100 scale. Switch to population to see the share of the world's people.</p>
      <AverageChart note wide figures={false} />
      <p class="ch-more"><span>Click a year to read it in the history.</span> <a href={`${base}map/`}>Play the years on the map →</a> <a href={`${base}?year=1961#rankings`}>The rankings as they stood in 1961 →</a></p>
    </section>
    {chapterAt.has("tiles") && <h2 class="ch-chapter">{chapterAt.get("tiles")}</h2>}
    <section class="ch" id="tiles">
      <p class="ch-kicker"><a href="#tiles">{kick("tiles")}</a></p>
      <h2>Every country the same size: {tileBanned} of {countries.length} are under prohibition or worse</h2>
      <p class="ch-dek">A map where every country is one square, in roughly its place, so that Malta counts as much as Russia. Coloured by band; move the year to watch the colour drain away after 1900 and come back in patches since 2000.</p>
      <div class="ch-frame ch-tilemap" data-no-preview>
        <div class="ch-tile-year">
          <button type="button" class="ch-tile-play" aria-label="Play the years">▶</button>
          <input type="range" min={S0} max={NOW} value={NOW} step="1" aria-label="Year" />
          <output>{NOW}</output>
          <span class="ch-tile-count"><b>{tileBanned}</b> under prohibition or worse</span>
        </div>
        <div class="ch-tile-grid" style={`--cols:${TCOLS};--rows:${TROWS}`}>
          {tilePlaces.map((t) => (
            <a href={`${base}country/${t.c.slug}/`} data-tilemap={t.c.slug} style={`grid-column:${t.cell[0] + 1};grid-row:${t.cell[1] + 1};--c:${tierColor(t.c.raw)}`} aria-label={`${t.c.name}: ${Math.round(t.c.raw)}`}>{t.c.id}</a>
          ))}
        </div>
        <p class="avg-legend" aria-hidden="true">{TIERS.map((t) => <span><i style={`background:${tierColor(t.min)}`}></i>{t.name}</span>)}</p>
      </div>
      <p class="ch-source">Each country's score at the end of the chosen year, rebuilt from its history; squares placed from the centre of each country's shape on the <a href={`${base}map/`}>world map</a>. Hover a square for the country; click it for its profile.</p>
      <p class="ch-more"><a href={`${base}map/`}>The full map →</a> <a href={`${base}#rankings`}>The rankings →</a></p>
    </section>
    {chapterAt.has("users-treemap") && <h2 class="ch-chapter">{chapterAt.get("users-treemap")}</h2>}
    <section class="ch" id="users-treemap">
      <p class="ch-kicker"><a href="#users-treemap">{kick("users-treemap")}</a></p>
      <h2>{usersShareBanned}% of the world's {Math.round(usersTotal / 1e6)} million people who use cannabis live where it is under prohibition</h2>
      <p class="ch-dek">Each rectangle is a country, sized by how many adults used cannabis in the past year and coloured by its band. Prohibition does not keep the users away; it decides what happens to them.</p>
      <div class="ch-frame ch-treemap" data-no-preview>
        {tiles.map((t) => (
          <a class="ch-tile" href={`${base}country/${t.c.slug}/#datasets`} data-tile={t.c.slug} style={`left:${(t.x / TM_W) * 100}%;top:${(t.y / TM_H) * 100}%;width:${(t.w / TM_W) * 100}%;height:${(t.h / TM_H) * 100}%;--c:${tierColor(t.c.raw)}`}
            aria-label={`${t.c.name}: ${num(t.v)} people who use cannabis`}>
            {t.w * t.h > 22 && <span><b>{t.c.name}</b>{t.w * t.h > 50 && <em>{(t.v / 1e6).toFixed(1)} M</em>}</span>}
          </a>
        ))}
      </div>
      <p class="ch-source">People who used cannabis in the past year, from the <a href={`${base}sources/#dataset-cannabis_use`}>UNODC</a> survey figures and the latest population, including the UNODC's regional estimates where a country has no survey; {userList.length} countries.</p>
      <p class="ch-more"><a href={`${base}map/users/`}>Users on the map →</a> <a href={`${base}map/share-of-adults/`}>Share of adults →</a></p>
    </section>
    {chapterAt.has("law") && <h2 class="ch-chapter">{chapterAt.get("law")}</h2>}
    <section class="ch" id="law">
      <p class="ch-kicker"><a href="#law">{kick("law")}</a></p>
      <h2>{medButBanned} of the {medAny} countries with medical cannabis still ban it for everyone else</h2>
      <p class="ch-dek">Every country in one grid: down, what the law says about adults using cannabis; across, what it says about medical use. The larger the circle, the more countries.</p>
      <div class="ch-frame ch-law" data-no-preview>
        <div class="ch-law-head"><span></span>{MED_ORDER.map((m) => <span>Medical: {MED_LABEL[m]}</span>)}</div>
        {REC_ORDER.map((rec, i) => (
          <div class="ch-law-row">
            <span class="ch-law-name">{REC_LABEL[rec]}</span>
            {MED_ORDER.map((med, j) => {
              const n = lawGrid[i][j].length;
              return n ? (
                <a class="ch-law-cell" href={`${base}map/recreational/`} data-law={`${i},${j}`} aria-label={`${REC_LABEL[rec]} for adults, medical ${MED_LABEL[med].toLowerCase()}: ${n} countries`}>
                  <i style={`--d:${Math.sqrt(n / lawMax)};--c:var(--rec-${rec})`}></i><b>{n}</b>
                </a>
              ) : <span class="ch-law-cell empty">–</span>;
            })}
          </div>
        ))}
      </div>
      <p class="ch-source">The recreational and medical status of each country's profile. Hover a circle for its countries.</p>
      <p class="ch-more"><a href={`${base}map/recreational/`}>Recreational law on the map →</a> <a href={`${base}map/medical/`}>Medical law on the map →</a></p>
    </section>
    {chapterAt.has("borders") && <h2 class="ch-chapter">{chapterAt.get("borders")}</h2>}
    <section class="ch" id="borders">
      <p class="ch-kicker"><a href="#borders">{kick("borders")}</a></p>
      <h2>Walk from {sharpest[0].free.name} into {sharpest[0].strict.name} and the score falls from {Math.round(sharpest[0].free.raw)} to {Math.round(sharpest[0].strict.raw)}: the sharpest borders on Earth</h2>
      <p class="ch-dek">The {sharpest.length} land borders where the cannabis law changes most, out of {borders.length}. Each row is one border: the stricter country on the left, the freer on the right, each dot at its score on one scale from 0 to 60. On {legalLine} borders, one side is legal with limits or freer and the other under prohibition; on {sameBand}, both sides are in the same band.</p>
      <ol class="ch-borders" data-no-preview>
        <li class="ch-borders-axis" aria-hidden="true"><span></span><span class="ch-border-track">{[0, 15, 25, 40, 60].map((t) => <span style={`left:${pct(t, 0, BX1)}%`}>{t}</span>)}</span><span></span></li>
        {sharpest.map((b, i) => (
          <li data-border={i}>
            <a class="ch-border-a" href={`${base}country/${b.strict.slug}/`}>{b.strict.flag} {b.strict.name}</a>
            <span class="ch-border-track">
              <i class="ch-border-gap" style={`left:${pct(b.strict.raw, 0, BX1)}%;width:${pct(b.gap, 0, BX1)}%`}></i>
              <i class="ch-border-dot" style={`left:${pct(Math.min(b.free.raw, BX1), 0, BX1)}%;--c:${tierColor(b.free.raw)}`}></i>
              <i class="ch-border-dot" style={`left:${pct(b.strict.raw, 0, BX1)}%;--c:${tierColor(b.strict.raw)}`}></i>
            </span>
            <a class="ch-border-b" href={`${base}country/${b.free.slug}/`}>{b.free.flag} {b.free.name}</a>
          </li>
        ))}
      </ol>
      <p class="ch-source">Neighbours are countries whose shapes on the site's <a href={`${base}map/`}>world map</a> (Natural Earth, 1:50m) touch; sea borders do not count. Hover a row for both scores; click a country for its profile.</p>
      <p class="ch-more"><a href={`${base}compare/`}>Compare two countries →</a> <a href={`${base}map/visitors/`}>Visitors and foreigners on the map →</a></p>
    </section>
    {chapterAt.has("stripes") && <h2 class="ch-chapter">{chapterAt.get("stripes")}</h2>}
    <section class="ch" id="stripes">
      <p class="ch-kicker"><a href="#stripes">{kick("stripes")}</a></p>
      <h2>Since {S0}, the typical country has spent an estimated {Math.round(medianBanned)} years under cannabis prohibition</h2>
      <p class="ch-dek">One thin stripe for each of the {countries.length} countries, one year at a time from {S0}, coloured by its band. The freest countries today are at the top. {neverFree} fall below 15 points in at least one snapshot. Counts include both endpoints, {S0} and {NOW}, and both prohibition bands.</p>
      <div class="ch-frame ch-stripes" data-no-preview>
        <div class="ch-plot">
          <svg viewBox={`0 0 ${stripeYears} 100`} preserveAspectRatio="none" aria-hidden="true" shape-rendering="crispEdges">
            {stripes.map((s, r) => s.runs.map((run) => <rect x={run.i} width={run.n} y={(r * stripeH).toFixed(3)} height={stripeH.toFixed(3)} style={`fill:var(--t${run.k})`} />))}
          </svg>
          {[1925, 1961].map((y) => <span class="ch-vline strong" style={`left:${pct(y + 0.5, S0, NOW + 1)}%`}><b>{y}</b></span>)}
          <span class="ch-seek" hidden></span>
          <span class="ch-row-mark" hidden></span>
          <a class="ch-stripes-hit" href={`${base}#rankings`} aria-label="Open the country under the pointer"></a>
        </div>
        <div class="ch-x">{[1875, 1900, 1925, 1950, 1975, 2000, 2025].filter((y) => y <= NOW).map((y) => <span class:list={{ last: y > NOW - 5 }} style={`left:${pct(y + 0.5, S0, NOW + 1)}%`}>{y}</span>)}</div>
        <div class="ch-stripes-ends" aria-hidden="true"><span>↑ freest today</span><span>strictest today ↓</span></div>
      </div>
      <p class="ch-source">Each country's score at the end of each year, rebuilt from its history, as in the <a href={`${base}data/#panel`}>yearly data</a>. These are reconstructed scores, including estimated dates and assumed baselines. Madagascar’s early line carries a <a href={`${base}history/madagascar-merina-ban-1787/`}>regional royal smoking ban</a> across the modern country; its continuous nationwide duration is unresolved. Hover a stripe for its country and year; click it for the country's history.</p>
      <p class="ch-more"><a href={`${base}map/`}>Play the years on the map →</a> <a href={`${base}data/#panel`}>Download the yearly scores →</a></p>
    </section>
    {chapterAt.has("first-bans") && <h2 class="ch-chapter">{chapterAt.get("first-bans")}</h2>}
    <section class="ch" id="first-bans">
      <p class="ch-kicker"><a href="#first-bans">{kick("first-bans")}</a></p>
      <h2>Half the world's countries first restricted cannabis between {banQ1} and {banQ3}</h2>
      <p class="ch-dek">Each dot is a country, placed at the year of its first recorded rule on cannabis and coloured by its score today. The middle year is {banMid}. Some came under a colonial power's law before they were countries.</p>
      <div class="ch-frame ch-swarm" data-no-preview>
        {swarms.map((g) => (
          <div class="ch-swarm-row" style={`--lanes:${g.lanes}`}>
            <span class="ch-swarm-name">{g.name}</span>
            <div class="ch-plot">
              {[1900, 1925, 1961, 2000].map((y) => <span class="ch-vline" style={`left:${pct(y, B0, NOW)}%`}></span>)}
              {g.dots.map((d) => (
                <a class="ch-dot" href={`${base}country/${d.c.slug}/#history`} data-first={d.c.slug}
                  style={`left:${pct(d.x, B0, NOW)}%;top:calc(50% + ${d.lane} * var(--lane));--c:${tierColor(d.c.raw)}`}
                  aria-label={`${d.c.name}: first restricted cannabis in ${d.year}`}></a>
              ))}
            </div>
          </div>
        ))}
        <div class="ch-swarm-row ch-swarm-axis"><span></span><div class="ch-x">{[1875, 1900, 1925, 1950, 1975, 2000].map((y) => <span style={`left:${pct(y, B0, NOW)}%`}>{y}</span>)}</div></div>
      </div>
      <p class="ch-source">The first scored entry of each country in the <a href={`${base}history/`}>history</a>; {earlier} older ones are drawn at {B0}, and {undated} countries with no known date are left out. Hover a dot for the law; click it for the country's history.</p>
      <p class="ch-more"><a href={`${base}history/kind/ban/`}>Every first ban and ban →</a> <a href={`${base}history/period/1920s/`}>The 1920s →</a> <a href={`${base}history/period/1960s/`}>The 1960s →</a></p>
    </section>
    {chapterAt.has("waves") && <h2 class="ch-chapter">{chapterAt.get("waves")}</h2>}
    <section class="ch" id="waves">
      <p class="ch-kicker"><a href="#waves">{kick("waves")}</a></p>
      <h2>{waveShare}% of the tightenings came between 1920 and 1961; {easeShare}% of the easings since 2000</h2>
      <p class="ch-dek">Each bar is one year: below the line, recorded changes that made the law harsher; above it, those that eased it. {num(downs)} tightenings and {num(ups)} easings since {W0}.</p>
      <div class="ch-frame ch-waves" data-no-preview>
        <div class="ch-plot">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <line class="ch-axis" x1="0" x2="100" y1="50" y2="50" />
            {waves.map((w) => {
              const x = pct(w.year, W0, NOW + 1), bw = 100 / (NOW - W0 + 1) * 0.72;
              return <>
                {w.up > 0 && <rect x={x} width={bw} y={50 - (w.up / waveMax) * 48} height={(w.up / waveMax) * 48} class="ch-up"><title>{w.year}: {w.up} eased</title></rect>}
                {w.down > 0 && <rect x={x} width={bw} y="50" height={(w.down / waveMax) * 48} class="ch-down"><title>{w.year}: {w.down} tightened</title></rect>}
              </>;
            })}
          </svg>
          <span class="ch-side ch-side-up">Eased</span>
          <span class="ch-side ch-side-down">Tightened</span>
          <div class="ch-hits">
            {waves.map((w) => (w.down || w.up) ? (
              <a href={`${base}history/?from=${w.year}`} data-wave={w.year} style={`left:${pct(w.year, W0, NOW + 1)}%;width:${100 / (NOW - W0 + 1)}%`}
                aria-label={`${w.year}: ${w.down} tightened, ${w.up} eased. Open ${w.year} in the history`}></a>
            ) : null)}
          </div>
          {WAVE_MARKS.map(([y, label]) => <span class:list={["ch-mark", { end: y > 2000 }]} style={`left:${pct(y + 0.4, W0, NOW + 1)}%`}><b>{y}</b> <span>{label}</span></span>)}
        </div>
        <div class="ch-x">{[1880, 1900, 1920, 1940, 1960, 1980, 2000, 2020].map((y) => <span style={`left:${pct(y, W0, NOW + 1)}%`}>{y}</span>)}</div>
      </div>
      <p class="ch-source">From the {num(downs + ups)} dated, scored entries in the <a href={`${base}history/`}>history</a>; estimated first bans are left out. Click a year to read its changes.</p>
      <p class="ch-more"><a href={`${base}history/kind/ban/`}>Every ban →</a> <a href={`${base}history/kind/legalisation/`}>Every legalisation →</a> <a href={`${base}history/period/1930s/`}>The 1930s →</a></p>
    </section>
    {chapterAt.has("empire") && <h2 class="ch-chapter">{chapterAt.get("empire")}</h2>}
    <section class="ch" id="empire">
      <p class="ch-kicker"><a href="#empire">{kick("empire")}</a></p>
      <h2>{bigEmpire.before} of the {bigEmpire.dots.length} former colonies of the {bigEmpire.r.name} had a rule on cannabis before it made one at home</h2>
      <p class="ch-dek">For each former colonial power, a row of its former colonies, each placed at the year of its first recorded rule on cannabis and coloured by its score today; the black line is the year the ruler first restricted cannabis at home. Many of these first rules were the ruler's own law, made for the colony, and stayed on the books after independence.</p>
      <div class="ch-frame ch-swarm ch-empire" data-no-preview>
        {empires.map((e) => (
          <div class="ch-swarm-row" style={`--lanes:${e.lanes}`}>
            <span class="ch-swarm-name">{e.r.name}<small>{e.dots.length} colonies · {e.before} before it</small></span>
            <div class="ch-plot">
              <span class="ch-ruler" style={`left:${pct(e.own, B0, NOW)}%`}><b>{e.own}</b></span>
              {e.dots.map((d) => (
                <a class="ch-dot" href={`${base}country/${d.c.slug}/#history`} data-empire={`${e.r.slug}-${d.c.slug}`}
                  style={`left:${pct(d.x, B0, NOW)}%;top:calc(50% + ${d.lane} * var(--lane));--c:${tierColor(d.c.raw)}`}
                  aria-label={`${d.c.name}: first restricted cannabis in ${d.year}; ${e.r.name} in ${e.own}`}></a>
              ))}
            </div>
          </div>
        ))}
        <div class="ch-swarm-row ch-swarm-axis"><span></span><div class="ch-x">{[1875, 1900, 1925, 1950, 1975, 2000].map((y) => <span style={`left:${pct(y, B0, NOW)}%`}>{y}</span>)}</div></div>
      </div>
      <p class="ch-source">Colonial rulers from {COL.title}; first restrictions from the <a href={`${base}history/`}>history</a>, as in chart {kick("first-bans").slice(0, 2)}. Powers with at least five former colonies with a dated first rule. A country ruled by two powers appears in both rows. <a href={`${base}sources/#dataset-colonial_links`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}history/tag/colonial/`}>Colonial law in the history →</a> <a href={`${base}history/kind/ban/`}>Every first ban →</a></p>
    </section>
    {chapterAt.has("stream") && <h2 class="ch-chapter">{chapterAt.get("stream")}</h2>}
    <section class="ch" id="stream">
      <p class="ch-kicker"><a href="#stream">{kick("stream")}</a></p>
      <h2>The {peakDecade}s fill the history most; this decade, easing outweighs tightening {easeNow} to {tightNow}</h2>
      <p class="ch-dek">Every dated entry in the history, laws and raids, rulings and reports, treaties and books, counted by decade and kind. The wider the stream, the more happened. The 2020s are not over.</p>
      <div class="ch-frame ch-stream" data-no-preview>
        <div class="ch-plot">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {streams.map((g, k) => <path class="ch-stream-band" data-band={k} d={g.d} style={`fill:${g.color}`} />)}
          </svg>
          <div class="ch-hits">
            {decades.map((d, i) => (
              <a href={`${base}history/period/${d}s/`} data-decade={i} style={`left:${i ? sx(i) - 50 / (decades.length - 1) : 0}%;width:${(i && i < decades.length - 1 ? 100 : 50) / (decades.length - 1)}%`}
                aria-label={`The ${d}s: ${decadeTotals[i]} entries. Open the decade in the history`}></a>
            ))}
          </div>
        </div>
        <div class="ch-x">{decades.filter((d) => d % 20 === 0).map((d) => <span class:list={{ first: d === D0, last: d === decades.at(-1) }} style={`left:${sx(decades.indexOf(d))}%`}>{d}s</span>)}</div>
        <p class="ch-legend">{streams.map((g) => <span><i style={`background:${g.color}`}></i>{g.label} <em>{num(g.total)}</em></span>)}</p>
      </div>
      <p class="ch-source">All {num(decadeTotals.reduce((a, b) => a + b, 0))} dated entries of the <a href={`${base}history/`}>history</a> since {D0}, scored or not. Click a decade to read it.</p>
      <p class="ch-more"><a href={`${base}history/kind/enforcement/`}>Raids and enforcement →</a> <a href={`${base}history/kind/medical/`}>Medical cannabis →</a> <a href={`${base}history/kind/international/`}>Treaties →</a></p>
    </section>
    {chapterAt.has("flows") && <h2 class="ch-chapter">{chapterAt.get("flows")}</h2>}
    <section class="ch" id="flows">
      <p class="ch-kicker"><a href="#flows">{kick("flows")}</a></p>
      <h2>Of the {bannedIn1961} countries under prohibition in 1961, {stayedBanned} still are</h2>
      <p class="ch-dek">Every country, followed through four years: {FLOW_YEARS.join(", ")}. Each column stacks the countries by band, the freest on top; each ribbon carries the countries that moved from one band to another, or stayed. Hover a ribbon for its countries.</p>
      <div class="ch-frame ch-flows" data-no-preview>
        <div class="ch-flow-years">{FLOW_YEARS.map((y, i) => <span style={`left:${(i / (FLOW_YEARS.length - 1)) * 100}%`} class:list={{ first: i === 0, last: i === FLOW_YEARS.length - 1 }}>{y}</span>)}</div>
        <div class="ch-plot">
          <svg viewBox={`0 0 ${FW} ${FH}`} preserveAspectRatio="none" aria-hidden="true">
            {ribbons.map((r, i) => <path class="ch-ribbon" data-ribbon={i} d={r.d} style={`fill:var(--t${r.b})`} />)}
            {flowNodes.flat().filter((n) => n.n).map((n) => <rect x={n.x} y={n.y} width={NODE} height={n.h} style={`fill:var(--t${n.k})`} />)}
          </svg>
          {flowNodes[0].filter((n) => n.n).map((n) => <span class="ch-flow-label start" style={`top:${((n.y + n.h / 2) / FH) * 100}%`}>{n.n}</span>)}
          {flowNodes.at(-1).filter((n) => n.n).map((n) => <span class="ch-flow-label end" style={`top:${((n.y + n.h / 2) / FH) * 100}%;color:var(--t${n.k})`}>{TIER_NAMES[n.k]} <b>{n.n}</b></span>)}
        </div>
      </div>
      <p class="ch-source">Scores at the end of each year, rebuilt from the <a href={`${base}history/`}>history</a>; today's is the current score. The 1900 column counts a country with no rule yet as free.</p>
      <p class="ch-more"><a href={`${base}?year=1961#rankings`}>The rankings in 1961 →</a> <a href={`${base}?year=2000#rankings`}>In 2000 →</a></p>
    </section>
    {chapterAt.has("since-1961") && <h2 class="ch-chapter">{chapterAt.get("since-1961")}</h2>}
    <section class="ch" id="since-1961">
      <p class="ch-kicker"><a href="#since-1961">{kick("since-1961")}</a></p>
      <h2>{wasBanned} of today's {TOP} freest countries were under prohibition in 1961</h2>
      <p class="ch-dek">For each of the {TOP} countries with the highest score today: the grey dot is its score at the end of 1961, the year the UN Single Convention asked every country to ban cannabis; the arrow runs to its score now.</p>
      <div class="ch-dumbbell" data-no-preview>
        <div class="ch-db-axis" aria-hidden="true"><span></span><div>{[0, 20, 40, 60, 80, 100].map((t) => <span style={`left:${t}%`}>{t}</span>)}</div><span></span></div>
        <ol>
          {freest.map((f) => {
            const lo = Math.min(f.then, f.now), hi = Math.max(f.then, f.now), up = f.now >= f.then;
            return (
              <li>
                <a href={`${base}country/${f.c.slug}/`}>{f.c.flag} {f.c.name}</a>
                <a class="ch-db-track" href={`${base}country/${f.c.slug}/#history`} data-top={f.c.slug} aria-label={`${f.c.name}: ${Math.round(f.then)} in 1961, ${Math.round(f.now)} today. Open its history`}>
                  {[20, 40, 60, 80].map((t) => <i class="ch-db-grid" style={`left:${t}%`}></i>)}
                  <span class:list={["ch-db-bar", { down: !up }]} style={`left:${lo}%;width:${hi - lo}%`}></span>
                  <span class="ch-db-then" style={`left:${f.then}%`}></span>
                  <span class="ch-db-now" style={`left:${f.now}%;--c:${tierColor(f.now)}`}></span>
                </a>
                <span class="ch-db-num">{f.then >= 98 ? <em>no law</em> : Math.round(f.then)} → <b>{Math.round(f.now)}</b></span>
              </li>
            );
          })}
        </ol>
      </div>
      <p class="ch-source">Scores at the end of each year, rebuilt from each country's history, as in the <a href={`${base}data/#panel`}>yearly data</a>. A score of 100 means no rule on cannabis had been recorded yet. Hover a row for the changes since 1961; click it for the country's history.</p>
      <p class="ch-more"><a href={`${base}#rankings`}>All rankings →</a> <a href={`${base}compare/`}>Compare countries →</a></p>
    </section>
    {chapterAt.has("regions") && <h2 class="ch-chapter">{chapterAt.get("regions")}</h2>}
    <section class="ch" id="regions">
      <p class="ch-kicker"><a href="#regions">{kick("regions")}</a></p>
      <h2>Every region fell to prohibition; {bestBack.name} has come furthest back</h2>
      <p class="ch-dek">The average score of each region's countries since 1860, with the world average in grey behind it.</p>
      <div class="ch-regions" data-no-preview>
        {regions.map((g) => (
          <a class="ch-region" href={`${base}?region=${encodeURIComponent(g.name)}#rankings`} data-region={g.name}>
            <div class="ch-cap"><b>{g.name} <i aria-hidden="true">→</i></b><span><em style={`color:${tierColor(g.now)}`}>{fmt1(g.now)}</em> today · low of {fmt1(g.low)} in {g.lowYear}</span></div>
            <div class="ch-plot">
              <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                {[0, 50, 100].map((t) => <line class="ch-grid" x1="0" x2="100" y1={100 - t} y2={100 - t} />)}
                <path class="ch-world" d={world} />
                <path class="ch-region-line" d={g.path} />
              </svg>
              <span class="ch-seek" hidden></span>
            </div>
            <div class="ch-x">{[1900, 1960, 2020].map((y) => <span style={`left:${pct(y, R0, NOW)}%`}>{y}</span>)}</div>
          </a>
        ))}
      </div>
      <p class="ch-source">Each country counts the same; click a region for its rankings. {regions.map((g) => `${g.name} ${g.n}`).join(", ")} countries.</p>
    </section>
    {chapterAt.has("spread") && <h2 class="ch-chapter">{chapterAt.get("spread")}</h2>}
    <section class="ch" id="spread">
      <p class="ch-kicker"><a href="#spread">{kick("spread")}</a></p>
      <h2>A world that started at 100 now piles up near {peak2020}</h2>
      <p class="ch-dek">How the {countries.length} countries' scores were spread out in each year: the higher the ridge, the more countries had that score. In {RIDGE_YEARS[0]} almost every country sat at 100, with no rule on cannabis; by {RIDGE_YEARS[6]} the mass had moved to the left. The small rise on the right since is the reforms.</p>
      <div class="ch-frame ch-ridges" data-no-preview>
        <svg class="ch-ridge-defs" aria-hidden="true" width="0" height="0">
          <defs>
            <linearGradient id="ridgeFill" x1="0" x2="1" y1="0" y2="0">
              <stop offset="0" style="stop-color:var(--t0)" /><stop offset=".05" style="stop-color:var(--t1)" /><stop offset=".15" style="stop-color:var(--t2)" />
              <stop offset=".25" style="stop-color:var(--t3)" /><stop offset=".4" style="stop-color:var(--t4)" /><stop offset=".6" style="stop-color:var(--t5)" /><stop offset="1" style="stop-color:var(--t5)" />
            </linearGradient>
          </defs>
        </svg>
        <div class="ch-ridge-wrap">
          <div class="ch-ridge-years" aria-hidden="true">{ridges.map((r, i) => <span style={`top:${(i + RIDGE_OVERLAP) * ridgeRow}%`}>{r.year}</span>)}</div>
          <div class="ch-plot">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              {[0, 25, 50, 75, 100].map((t) => <line class="ch-grid" x1={t} x2={t} y1="0" y2="100" />)}
              {ridges.map((r, i) => { const p = ridgePath(r, i); return <g class="ch-ridge" data-ridge={i}><path class="ch-ridge-area" d={p.area} /><path class="ch-ridge-line" d={p.line} /></g>; })}
            </svg>
            {ridges.map((r, i) => (
              <a class="ch-ridge-hit" href={`${base}?year=${r.year}#rankings`} data-ridge={i} style={`top:${(i + RIDGE_OVERLAP - 1) * ridgeRow}%;height:${ridgeRow}%`} aria-label={`${r.year}: average ${r.mean.toFixed(1)}. Open the rankings of ${r.year}`}></a>
            ))}
          </div>
        </div>
        <div class="ch-ridge-x"><span></span><div class="ch-x">{[0, 25, 50, 75, 100].map((t) => <span class:list={{ first: t === 0, last: t === 100 }} style={`left:${t}%`}>{t}</span>)}</div></div>
        <p class="ch-axis-label">Score</p>
      </div>
      <p class="ch-source">Each country's score at the end of the year, smoothed over about {BW} points. Hover a year for its average; click it for the rankings as they stood then.</p>
      <p class="ch-more"><a href={`${base}?year=1961#rankings`}>The rankings in 1961 →</a> <a href={`${base}about/`}>How the score is made →</a></p>
    </section>
    {chapterAt.has("opinion-gap") && <h2 class="ch-chapter">{chapterAt.get("opinion-gap")}</h2>}
    <section class="ch" id="opinion-gap">
      <p class="ch-kicker"><a href="#opinion-gap">{kick("opinion-gap")}</a></p>
      <h2>Americans who want cannabis legal rose from {pollFirst.legal}% in {pollFirst.year} to {pollLast.legal}% in {pollLast.year}; the US score went from {Math.round(usScore[0].score)} to {Math.round(usThen)}</h2>
      <p class="ch-dek">Two lines on one scale of 0 to 100. The green line: the share of American adults who tell Gallup that "the use of marijuana should be made legal". The plain line: the score of the United States on this index, year by year. Opinion passed half in {majority?.year}; the law has moved far less. The marks are the changes in the US history that moved its score.</p>
      <div class="ch-frame ch-opinion-gap" data-no-preview>
        <div class="ch-y">{[0, 25, 50, 75, 100].map((t) => <span style={`top:${100 - t}%`}>{t}</span>)}</div>
        <div class="ch-plot">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {[0, 25, 50, 75, 100].map((t) => <line class="ch-grid" x1="0" x2="100" y1={100 - t} y2={100 - t} />)}
            <line class="ch-half" x1="0" x2="100" y1="50" y2="50" />
            <path class="ch-line opinion" d={pollPath} />
            <path class="ch-line us-score" d={usPath} />
          </svg>
          {usMarks.map((m) => <a class="ch-us-mark" href={`${base}history/${m.id}/`} data-usmark={usMarks.indexOf(m)} style={`left:${ox(m.year + 0.5)}%`} aria-label={`${m.year}: ${m.title}`}></a>)}
          {polls.map((p, i) => <span class="ch-poll" data-poll={i} style={`left:${ox(+p.date.slice(0, 4) + (+p.date.slice(5, 7) - 0.5) / 12)}%;top:${100 - p.legal}%`} tabindex="0" aria-label={`${p.date}: ${p.legal}% say legal`}></span>)}
          <span class="ch-line-label opinion" style={`left:${ox(+pollLast.date.slice(0, 4))}%;top:${100 - pollLast.legal}%`}>Say it should be legal</span>
          <span class="ch-line-label us-score" style={`left:${ox(NOW)}%;top:${100 - usa.raw}%`}>US score</span>
        </div>
        <div class="ch-x">{[1970, 1980, 1990, 2000, 2010, 2020].map((y) => <span style={`left:${ox(y)}%`}>{y}</span>)}</div>
      </div>
      <p class="ch-source">{GALLUP.title}; the US score as in the <a href={`${base}data/#panel`}>yearly data</a>. Hover a dot for a poll, a mark for a change in the law; click a mark for its story.</p>
      <p class="ch-more"><a href={`${base}country/us/#history`}>The US history →</a> <a href={`${base}country/us/`}>The states of the US →</a></p>
    </section>
    {chapterAt.has("mosaic") && <h2 class="ch-chapter">{chapterAt.get("mosaic")}</h2>}
    <section class="ch" id="mosaic">
      <p class="ch-kicker"><a href="#mosaic">{kick("mosaic")}</a></p>
      <h2>Freedom comes in parts: the score of every country, taken apart into its six</h2>
      <p class="ch-dek">Each column is a country, the freest on the left; each row is one part of the score, coloured from red (0) to green (10). Read across a row to see which freedoms come first: {segOpen[0].n} countries score 4 or more on {segOpen[0].seg.name.toLowerCase()}, {segOpen.at(-1).n} on {segOpen.at(-1).seg.name.toLowerCase()}.</p>
      <div class="ch-frame ch-mosaic" data-no-preview>
        {SEGMENTS.map((seg, i) => (
          <div class="ch-mosaic-row">
            <span class="ch-mosaic-name">{seg.name}</span>
            <div class="ch-mosaic-cells">
              {mosaic.map((c) => <a href={`${base}country/${c.slug}/`} data-cell={`${c.slug}|${i}`} style={`background:${segColor(c.s[i])}`} aria-label={`${c.name}, ${seg.name}: ${c.s[i]} of 10`}></a>)}
            </div>
          </div>
        ))}
        <div class="ch-mosaic-row ch-mosaic-axis"><span></span><div><span>Freest</span><span>{mosaic.length} countries by score →</span><span>Strictest</span></div></div>
      </div>
      <p class="ch-source">The six parts of the score, each from 0 to 10, as on each country's profile; <a href={`${base}about/`}>how they are scored</a>.</p>
      <p class="ch-more"><a href={`${base}map/possession/`}>Possession on the map →</a> <a href={`${base}map/cultivation/`}>Growing →</a> <a href={`${base}map/access/`}>Access →</a></p>
    </section>
    {chapterAt.has("radar") && <h2 class="ch-chapter">{chapterAt.get("radar")}</h2>}
    <section class="ch" id="radar">
      <p class="ch-kicker"><a href="#radar">{kick("radar")}</a></p>
      <h2>The {RADAR.length} freest countries draw {radarShapes} different shapes: being free means different things</h2>
      <p class="ch-dek">The six parts of the score of the {RADAR.length} freest countries, each drawn as a shape: the further out a corner, the freer that part. The dotted shape is the world average. Some shapes repeat: neighbours that wrote the same law draw the same figure.</p>
      <div class="ch-radars" data-no-preview>
        {RADAR.map((c) => (
          <a class="ch-radar" href={`${base}country/${c.slug}/`} data-radar={c.slug}>
            <svg viewBox="0 0 100 100" aria-hidden="true">
              {[2.5, 5, 7.5, 10].map((v) => <polygon class="ch-radar-ring" points={radarShape(SEGMENTS.map(() => v))} />)}
              {SEGMENTS.map((_, i) => { const [x, y] = radarPoint(i, 10); return <line class="ch-radar-ring" x1="50" y1="50" x2={x} y2={y} />; })}
              <polygon class="ch-radar-avg" points={radarShape(segAvg)} />
              <polygon class="ch-radar-shape" points={radarShape(c.s)} style={`--c:${tierColor(c.raw)}`} />
            </svg>
            <span class="ch-radar-name">{c.flag} {c.name} <b>{Math.round(c.raw)}</b></span>
          </a>
        ))}
      </div>
      <p class="ch-radar-key">{SEGMENTS.map((seg, i) => <span>{["↑", "↗", "↘", "↓", "↙", "↖"][i]} {seg.name}</span>)}</p>
      <p class="ch-source">The parts of each score, 0 to 10, as on the profiles. Hover a shape for its numbers; click it for the country.</p>
      <p class="ch-more"><a href={`${base}#rankings`}>All rankings →</a> <a href={`${base}compare/`}>Compare any countries →</a></p>
    </section>
    {chapterAt.has("buy-grow") && <h2 class="ch-chapter">{chapterAt.get("buy-grow")}</h2>}
    <section class="ch" id="buy-grow">
      <p class="ch-kicker"><a href="#buy-grow">{kick("buy-grow")}</a></p>
      <h2>Legal to grow is not legal to buy: {growFirst.length} countries treat growing far more gently than buying, {buyFirst.length} the other way round</h2>
      <p class="ch-dek">Two parts of each country's score, each from 0 to 10. Across: whether adults can get cannabis from a shop, a club or a pharmacy. Up: whether they may grow their own. Each bubble holds the countries with the same pair, and its colour is their average band. Top left are the countries that leave growing to people; bottom right, those that sell it but keep the plant itself under the state.</p>
      <div class="ch-frame ch-buygrow" data-no-preview>
        <div class="ch-y">{Array.from({ length: SEG_MAX + 1 }, (_, i) => i).filter((t) => t % 2 === 0).map((t) => <span style={`top:${100 - pct(t, 0, SEG_MAX)}%`}>{t}</span>)}</div>
        <div class="ch-plot">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {Array.from({ length: SEG_MAX + 1 }, (_, i) => i).filter((t) => t % 2 === 0).map((t) => <><line class="ch-grid" x1="0" x2="100" y1={100 - pct(t, 0, SEG_MAX)} y2={100 - pct(t, 0, SEG_MAX)} /><line class="ch-grid" y1="0" y2="100" x1={pct(t, 0, SEG_MAX)} x2={pct(t, 0, SEG_MAX)} /></>)}
            <line class="ch-diag" x1="0" y1="100" x2="100" y2="0" />
          </svg>
          <span class="ch-corner tl">Grow, not buy</span>
          <span class="ch-corner br">Buy, not grow</span>
          {bubbleList.map((b, i) => (
            <span class="ch-bubble" data-bubble={i} tabindex="0" style={`left:${pct(b.x, 0, SEG_MAX)}%;top:${100 - pct(b.y, 0, SEG_MAX)}%;--d:${(10 + 46 * Math.sqrt(b.list.length / bubbleMax)).toFixed(1)}px;--c:${tierColor(b.mean)}`}
              aria-label={`Access ${b.x}, growing ${b.y}: ${b.list.map((c) => c.name).join(", ")}`}>{b.list.length > 1 ? <b>{b.list.length}</b> : <em>{b.list[0].name}</em>}</span>
          ))}
        </div>
        <div class="ch-x">{Array.from({ length: SEG_MAX + 1 }, (_, i) => i).filter((t) => t % 2 === 0).map((t) => <span class:list={{ first: t === 0 }} style={`left:${pct(t, 0, SEG_MAX)}%`}>{t}</span>)}</div>
        <p class="ch-axis-label">Access: buying, clubs and pharmacies, 0–10. Up: growing your own, 0–10</p>
      </div>
      <p class="ch-source">The access and cultivation parts of each country's score, as on its profile; <a href={`${base}about/`}>how the parts are scored</a>. A far gentler treatment means three points or more apart: {growFirst.map((c) => c.name).join(", ")}{buyFirst.length ? `; the other way: ${buyFirst.map((c) => c.name).join(", ")}` : ""}. Hover a bubble for its countries.</p>
      <p class="ch-more"><a href={`${base}map/cultivation/`}>Growing on the map →</a> <a href={`${base}map/access/`}>Access on the map →</a> <a href={`${base}map/clubs/`}>Cannabis clubs →</a></p>
    </section>
    {chapterAt.has("punished") && <h2 class="ch-chapter">{chapterAt.get("punished")}</h2>}
    <section class="ch" id="punished">
      <p class="ch-kicker"><a href="#punished">{kick("punished")}</a></p>
      <h2>{punished[0].c.name} records {Math.round(punished[0].rate)} offences of cannabis use or possession for every 1,000 people who use it; {punished.at(-1).c.name}, {fmtRate(punished.at(-1).rate)}</h2>
      <p class="ch-dek">How often the law reaches the people who use cannabis: offences of using or possessing cannabis for one's own use that the police record in a year, divided by the number of adults who used it in the past year. Cannabis only, and only use or possession: not dealing or growing for sale, and not other drugs. An offence is not a conviction: depending on the country it may end in a fine, a caution, treatment or a criminal case, and some countries count offenders rather than offences. A {punishSpread}-fold gap, with laws on paper that often look alike.</p>
      <ol class="ch-bars" data-no-preview>
        {punished.map((p) => (
          <li>
            <a href={`${base}country/${p.c.slug}/#datasets`} data-punish={p.c.slug}>
              <span class="ch-bar-name">{p.c.flag} {p.c.name}</span>
              <span class="ch-bar-track"><span class="ch-bar" style={`width:${(p.rate / punishMax) * 100}%;--c:${tierColor(p.c.raw)}`}></span></span>
              <span class="ch-bar-num">{fmtRate(p.rate)}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="ch-source">Offences: {OFF.title}, latest year since 2020. Users: the <a href={`${base}sources/#dataset-cannabis_use`}>UNODC</a> estimate of adults who used cannabis in the past year. Bars coloured by the country's band. Countries record and define offences differently, so read the order, not the decimals. <a href={`${base}sources/#dataset-cannabis_offences`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}map/cannabis-offences-europe/`}>Offences on the map →</a> <a href={`${base}map/drug-possession-police/`}>Possession arrests worldwide →</a></p>
    </section>
    {chapterAt.has("punish-or-treat") && <h2 class="ch-chapter">{chapterAt.get("punish-or-treat")}</h2>}
    <section class="ch" id="punish-or-treat">
      <p class="ch-kicker"><a href="#punish-or-treat">{kick("punish-or-treat")}</a></p>
      <h2>Punish or treat: in {punishMore.length} of {punishTreat.length} European countries, the police record more cannabis offences than people enter treatment for cannabis</h2>
      <p class="ch-dek">Each dot is a country, both figures per 1,000 people who use cannabis. Across: offences of cannabis use or possession the police record. Up: people who enter drug treatment mainly for cannabis. Above the diagonal a country treats more than it records; below it, it records more than it treats. Some of those in treatment were sent there by a court. Both scales rise tenfold at each line.</p>
      <div class="ch-frame ch-scatter ch-wide-y ch-ptreat" data-no-preview>
        <div class="ch-y">{[0.1, 1, 10, 100, 1000].map((t) => <span style={`top:${pty(t)}%`}>{num(t)}</span>)}</div>
        <div class="ch-plot">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {[0.1, 1, 10, 100, 1000].map((t) => <><line class="ch-grid" x1="0" x2="100" y1={pty(t)} y2={pty(t)} /><line class="ch-grid" y1="0" y2="100" x1={ptx(t)} x2={ptx(t)} /></>)}
            <line class="ch-diag" x1="0" y1="100" x2="100" y2="0" />
          </svg>
          <span class="ch-corner tl">Treats more than it punishes</span>
          <span class="ch-corner br">Punishes more than it treats</span>
          {punishTreat.map((d) => (
            <a class:list={["ch-dot", { named: ptNamed.has(d.c.id), left: ptx(d.punish) > 75 }]} href={`${base}country/${d.c.slug}/#datasets`} data-ptreat={d.c.slug}
              style={`left:${ptx(d.punish)}%;top:${pty(d.treat)}%;--c:${tierColor(d.c.raw)}`} aria-label={`${d.c.name}: ${d.punish.toFixed(1)} offences and ${d.treat.toFixed(1)} treatment entrants per 1,000 users`}>
              {ptNamed.has(d.c.id) && <span>{d.c.name}</span>}
            </a>
          ))}
        </div>
        <div class="ch-x">{[0.1, 1, 10, 100, 1000].map((t, i) => <span class:list={{ first: i === 0, last: t === 1000 }} style={`left:${ptx(t)}%`}>{num(t)}</span>)}</div>
        <p class="ch-axis-label">Offences of cannabis use or possession per 1,000 people who use it</p>
      </div>
      <p class="ch-source">Offences: {OFF.title}, latest year since 2020. Treatment: {TREAT.title}. Users: the <a href={`${base}sources/#dataset-cannabis_use`}>UNODC</a> survey figures. Countries count both differently; read the pattern, not the decimals.</p>
      <p class="ch-more"><a href={`${base}map/cannabis-treatment/`}>Treatment on the map →</a> <a href={`${base}map/cannabis-offences-europe/`}>Offences on the map →</a></p>
    </section>
    {chapterAt.has("use") && <h2 class="ch-chapter">{chapterAt.get("use")}</h2>}
    <section class="ch" id="use">
      <p class="ch-kicker"><a href="#use">{kick("use")}</a></p>
      <h2>Where the law is milder, more people say they use cannabis: {fmt1(useHigh.median)}% against {fmt1(useLow.median)}%</h2>
      <p class="ch-dek">Each dot is a country, in the column of its band, at the share of adults who used cannabis in the past year. The bar is each band's middle value. Countries often eased the law where use was already common, and use is more readily admitted where it is legal, so this shows no cause.</p>
      <div class="ch-frame ch-use" data-no-preview>
        <div class="ch-y">{useTicks.map((t) => <span style={`top:${uOf(t)}%`}>{t}%</span>)}</div>
        <div class="ch-plot">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {useTicks.map((t) => <line class="ch-grid" x1="0" x2="100" y1={uOf(t)} y2={uOf(t)} />)}
          </svg>
          {useBands.map((b, i) => {
            const cx = ((i + 0.5) / useBands.length) * 100;
            return <>
              <span class="ch-median" style={`left:${cx}%;top:${uOf(b.median)}%`}><b>{fmt1(b.median)}%</b></span>
              {b.placed.map((p) => (
                <a class="ch-dot" href={`${base}country/${p.c.slug}/#datasets`} data-use={p.c.slug}
                  style={`left:calc(${cx}% + ${p.lane} * var(--lane));top:${uOf(p.y)}%;--c:${tierColor(b.t.min)}`}
                  aria-label={`${p.c.name}: ${p.y}% of adults used cannabis in the past year`}></a>
              ))}
            </>;
          })}
        </div>
        <div class="ch-use-x">{useBands.map((b) => <span><b>{b.t.name}</b><small>{b.dots.length} countries</small></span>)}</div>
      </div>
      <p class="ch-source">Past-year use among adults from the <a href={`${base}sources/#dataset-cannabis_use`}>UNODC</a>, the latest survey of each country; {used.length} countries with a survey, estimates left out.</p>
      <p class="ch-more"><a href={`${base}map/share-of-adults/`}>Use on the map →</a> <a href={`${base}map/youth-cannabis-use/`}>Use among young people →</a></p>
    </section>
    {chapterAt.has("teen-trends") && <h2 class="ch-chapter">{chapterAt.get("teen-trends")}</h2>}
    <section class="ch" id="teen-trends">
      <p class="ch-kicker"><a href="#teen-trends">{kick("teen-trends")}</a></p>
      <h2>Fewer European teenagers try cannabis than twenty years ago: {fmt1(teenAvg.at(-1)[1])}% in 2024, down from {fmt1(teenPeak[1])}% in {teenPeak[0]}</h2>
      <p class="ch-dek">Each line is a country: the share of students aged 15 to 16 who have ever used cannabis, in every ESPAD school survey since 1995. The thick line is the average of the {steady.length} countries surveyed in every wave since 2003. Coloured are the countries whose cannabis score rose most since 2003, by the index's bands. The fall came under strict and relaxed laws alike; this shows no cause.</p>
      <div class="ch-frame ch-teen" data-no-preview>
        <div class="ch-y">{[0, 10, 20, 30, 40, 50].map((t) => <span style={`top:${ty(t)}%`}>{t}%</span>)}</div>
        <div class="ch-plot">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {[0, 10, 20, 30, 40, 50].map((t) => <line class="ch-grid" x1="0" x2="100" y1={ty(t)} y2={ty(t)} />)}
            {teen.map((t) => <path class="ch-teen-line" data-teen={t.c.slug} d={teenPath(t.pts)} />)}
            {teenEased.map((t) => <path class="ch-teen-line eased" data-teen={t.c.slug} d={teenPath(t.pts)} style={`stroke:${tierColor(t.c.raw)}`} />)}
            <path class="ch-teen-avg" d={teenPath(teenAvg)} />
          </svg>
          {teenEased.map((t) => <span class="ch-teen-label" style={`left:100%;top:${ty(t.pts.at(-1)[1])}%;color:${tierColor(t.c.raw)}`}>{t.c.name}</span>)}
          <span class="ch-teen-label avg" style={`left:100%;top:${ty(teenAvg.at(-1)[1])}%`}>Average</span>
          <span class="ch-seek" hidden></span>
          <span class="ch-teen-dot" hidden></span>
          <a class="ch-teen-hit" href={`${base}map/students-tried-cannabis/`} aria-label="Open the country under the pointer"></a>
        </div>
        <div class="ch-x">{WAVES.map((y) => <span class:list={{ first: y === 1995, last: y === 2024 }} style={`left:${tx(y)}%`}>{y}</span>)}</div>
      </div>
      <p class="ch-source">{ESPL.title}. Germany is Bavaria only. <a href={`${base}sources/#dataset-espad_lifetime`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}map/students-tried-cannabis/`}>On the map, back to 1995 →</a> <a href={`${base}map/easy-to-get/`}>Easy to get →</a></p>
    </section>
    {chapterAt.has("easy-to-get") && <h2 class="ch-chapter">{chapterAt.get("easy-to-get")}</h2>}
    <section class="ch" id="easy-to-get">
      <p class="ch-kicker"><a href="#easy-to-get">{kick("easy-to-get")}</a></p>
      <h2>{easyStrict >= easyMild * 0.85 ? "Prohibition does not keep cannabis out of reach" : "Where the law is harsher, cannabis is harder to get"}: {fmt1(easyStrict)}% of 15–16-year-olds call it easy to get under prohibition, {fmt1(easyMild)}% elsewhere</h2>
      <p class="ch-dek">Each dot is a European country in the 2024 ESPAD school survey: across, its cannabis score; up, the share of students aged 15 to 16 who say cannabis would be fairly or very easy to get. {easyTop.map((e) => e.c.name).join(", ")} top the list at about {Math.round(easyTop[0].y)}%, under laws that differ.</p>
      <div class="ch-frame ch-scatter" data-no-preview>
        <div class="ch-y">{[0, 10, 20, 30, 40, 50].map((t) => <span style={`top:${100 - pct(t, 0, EY1)}%`}>{t}%</span>)}</div>
        <div class="ch-plot ch-plot-short">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {[0, 10, 20, 30, 40, 50].map((t) => <line class="ch-grid" x1="0" x2="100" y1={100 - pct(t, 0, EY1)} y2={100 - pct(t, 0, EY1)} />)}
            <line class="ch-fit" x1="0" x2="100" y1={100 - pct(easyFit.cut, 0, EY1)} y2={100 - pct(easyFit.cut + easyFit.slope * EX1, 0, EY1)} />
          </svg>
          {easy.map((e) => (
            <a class:list={["ch-dot", { named: easyNamed.has(e.c.id), left: e.x > EX1 * 0.75 }]} href={`${base}country/${e.c.slug}/#datasets`} data-easy={e.c.slug}
              style={`left:${pct(e.x, 0, EX1)}%;top:${100 - pct(e.y, 0, EY1)}%;--c:${tierColor(e.x)}`} aria-label={`${e.c.name}: ${e.y}% say easy to get, score ${Math.round(e.x)}`}>
              {easyNamed.has(e.c.id) && <span>{e.c.name}</span>}
            </a>
          ))}
        </div>
        <div class="ch-x">{Array.from({ length: EX1 / 10 + 1 }, (_, i) => i * 10).map((t) => <span class:list={{ first: t === 0, last: t === EX1 }} style={`left:${pct(t, 0, EX1)}%`}>{t}</span>)}</div>
        <p class="ch-axis-label">Cannabis score</p>
      </div>
      <p class="ch-source">{ESPAD.title}; {easy.length} countries; r = {easyFit.r.toFixed(2)}. <a href={`${base}sources/#dataset-espad_availability`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}map/easy-to-get/`}>Easy to get, on the map →</a> <a href={`${base}history/tag/youth/`}>Young people in the history →</a></p>
    </section>
    {chapterAt.has("wastewater") && <h2 class="ch-chapter">{chapterAt.get("wastewater")}</h2>}
    <section class="ch" id="wastewater">
      <p class="ch-kicker"><a href="#wastewater">{kick("wastewater")}</a></p>
      <h2>Sewage tells what surveys don't: {owner(sewageTop.c.name)} cities flush out {Math.round(sewageTop.y / sewageLow.y)} times as much cannabis as {owner(sewageLow.c.name)}</h2>
      <p class="ch-dek">Each dot is a country: across, its cannabis score; up, THC-COOH, the substance the body makes from cannabis, measured in city sewage for a week, in milligrams a day per 1,000 people, latest year since 2020. The scale rises tenfold at each line. It measures what is used, not what people admit, though not how many use it; one city may stand for a whole country.</p>
      <div class="ch-frame ch-scatter ch-wide-y" data-no-preview>
        <div class="ch-y">{[10, 30, 100, 300, 1000].map((t) => <span style={`top:${wy(t)}%`}>{num(t)}</span>)}</div>
        <div class="ch-plot ch-plot-short">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {[10, 30, 100, 300, 1000].map((t) => <line class="ch-grid" x1="0" x2="100" y1={wy(t)} y2={wy(t)} />)}
            <line class="ch-fit" x1="0" x2="100" y1={wy(10 ** sewageFit.cut)} y2={wy(10 ** (sewageFit.cut + sewageFit.slope * WX1))} />
          </svg>
          {sewage.map((w) => (
            <a class:list={["ch-dot", { named: sewageNamed.has(w.c.id), left: w.x > WX1 * 0.75 }]} href={`${base}country/${w.c.slug}/#datasets`} data-sewage={w.c.slug}
              style={`left:${pct(w.x, 0, WX1)}%;top:${wy(w.y)}%;--c:${tierColor(w.x)}`} aria-label={`${w.c.name}: ${w.y} mg a day per 1,000 people, score ${Math.round(w.x)}`}>
              {sewageNamed.has(w.c.id) && <span>{w.c.name}</span>}
            </a>
          ))}
        </div>
        <div class="ch-x">{Array.from({ length: WX1 / 10 + 1 }, (_, i) => i * 10).map((t) => <span class:list={{ first: t === 0, last: t === WX1 }} style={`left:${pct(t, 0, WX1)}%`}>{t}</span>)}</div>
        <p class="ch-axis-label">Cannabis score</p>
      </div>
      <p class="ch-source">{WW.title}; {sewage.length} countries; cities averaged by the people each plant serves. <a href={`${base}sources/#dataset-wastewater`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}map/wastewater/`}>Wastewater on the map →</a> <a href={`${base}map/share-of-adults/`}>What surveys say →</a> <a href={`${base}map/cannabis-seizures/`}>Seizures on the map →</a></p>
    </section>
    {chapterAt.has("alcohol") && <h2 class="ch-chapter">{chapterAt.get("alcohol")}</h2>}
    <section class="ch" id="alcohol">
      <p class="ch-kicker"><a href="#alcohol">{kick("alcohol")}</a></p>
      <h2>Alcohol is normal, cannabis is criminal: in {heavyBanned.length} countries people drink 8 litres of pure alcohol a year or more, and cannabis is banned</h2>
      <p class="ch-dek">Each dot is a country: across, the litres of pure alcohol drunk a year per person aged 15 or over (the WHO's estimate); up, its cannabis score. The shaded corner holds the heavy-drinking countries where cannabis is under prohibition.</p>
      <div class="ch-frame ch-scatter" data-no-preview>
        <div class="ch-y">{[0, 20, 40, 60].map((t) => <span style={`top:${100 - pct(t, 0, AY1)}%`}>{t}</span>)}</div>
        <div class="ch-plot ch-plot-short">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <rect class="ch-quad" x={pct(8, 0, AX1)} y={100 - pct(15, 0, AY1)} width={100 - pct(8, 0, AX1)} height={pct(15, 0, AY1)} />
            {[0, 20, 40, 60].map((t) => <line class="ch-grid" x1="0" x2="100" y1={100 - pct(t, 0, AY1)} y2={100 - pct(t, 0, AY1)} />)}
          </svg>
          <span class="ch-quad-label" style={`left:${pct(8, 0, AX1)}%;top:${100 - pct(15, 0, AY1)}%`}>Drink a lot, ban cannabis</span>
          {drink.map((d) => (
            <a class:list={["ch-dot", { named: drinkNamed.has(d.c.id), left: d.x > AX1 * 0.75 }]} href={`${base}country/${d.c.slug}/#datasets`} data-drink={d.c.slug}
              style={`left:${pct(d.x, 0, AX1)}%;top:${100 - pct(Math.min(d.y, AY1), 0, AY1)}%;--c:${tierColor(d.y)}`} aria-label={`${d.c.name}: ${d.x} litres, score ${Math.round(d.y)}`}>
              {drinkNamed.has(d.c.id) && <span>{d.c.name}</span>}
            </a>
          ))}
        </div>
        <div class="ch-x">{Array.from({ length: AX1 / 2 + 1 }, (_, i) => i * 2).map((t) => <span class:list={{ first: t === 0, last: t === AX1 }} style={`left:${pct(t, 0, AX1)}%`}>{t}</span>)}</div>
        <p class="ch-axis-label">Litres of pure alcohol a year per person aged 15+</p>
      </div>
      <p class="ch-source">{ALC.title}, latest year since 2015; {drink.length} countries. <a href={`${base}sources/#dataset-alcohol`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}map/alcohol/`}>Alcohol on the map →</a> <a href={`${base}map/share-of-adults/`}>Cannabis use on the map →</a></p>
    </section>
    {chapterAt.has("price") && <h2 class="ch-chapter">{chapterAt.get("price")}</h2>}
    <section class="ch" id="price">
      <p class="ch-kicker"><a href="#price">{kick("price")}</a></p>
      <h2>{Math.abs(priceFit.r) < 0.3 ? "A harsher law does not make cannabis dearer" : priceFit.r < 0 ? "Where the law is harsher, cannabis costs more" : "Where the law is milder, cannabis costs more"}: €{priceStrict.toFixed(2)} a gram under prohibition, €{priceMild.toFixed(2)} elsewhere</h2>
      <p class="ch-dek">Each dot is a European country: across, its cannabis score; up, the typical street price of a gram of herb in the latest year reported. If prohibition worked by making cannabis scarce, the dots on the left would sit higher.</p>
      <div class="ch-frame ch-scatter" data-no-preview>
        <div class="ch-y">{Array.from({ length: PY1 / 5 + 1 }, (_, i) => i * 5).map((t) => <span style={`top:${100 - pct(t, 0, PY1)}%`}>€{t}</span>)}</div>
        <div class="ch-plot ch-plot-short">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {Array.from({ length: PY1 / 5 + 1 }, (_, i) => i * 5).map((t) => <line class="ch-grid" x1="0" x2="100" y1={100 - pct(t, 0, PY1)} y2={100 - pct(t, 0, PY1)} />)}
            <line class="ch-fit" x1="0" x2="100" y1={100 - pct(priceFit.cut, 0, PY1)} y2={100 - pct(priceFit.cut + priceFit.slope * PX1, 0, PY1)} />
          </svg>
          {priced.map((p) => (
            <a class:list={["ch-dot", { named: priceNamed.has(p.c.id), left: p.x > PX1 * 0.8 }]} href={`${base}country/${p.c.slug}/#datasets`} data-price={p.c.slug}
              style={`left:${pct(p.x, 0, PX1)}%;top:${100 - pct(p.y, 0, PY1)}%;--c:${tierColor(p.x)}`} aria-label={`${p.c.name}: €${p.y} a gram, score ${Math.round(p.x)}`}>
              {priceNamed.has(p.c.id) && <span>{p.c.name}</span>}
            </a>
          ))}
        </div>
        <div class="ch-x">{Array.from({ length: PX1 / 10 + 1 }, (_, i) => i * 10).map((t) => <span class:list={{ first: t === 0, last: t === PX1 }} style={`left:${pct(t, 0, PX1)}%`}>{t}</span>)}</div>
        <p class="ch-axis-label">Cannabis score</p>
      </div>
      <p class="ch-source">{PRICES.title}; {priced.length} countries with a price since 2018; r = {priceFit.r.toFixed(2)}. <a href={`${base}sources/#dataset-prices_europe`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}map/cannabis-price-europe/`}>Prices on the map →</a> <a href={`${base}map/thc-potency-europe/`}>Potency on the map →</a></p>
    </section>
    {chapterAt.has("work-for-a-gram") && <h2 class="ch-chapter">{chapterAt.get("work-for-a-gram")}</h2>}
    <section class="ch" id="work-for-a-gram">
      <p class="ch-kicker"><a href="#work-for-a-gram">{kick("work-for-a-gram")}</a></p>
      <h2>On the minimum wage, a gram of cannabis costs {Math.round(workGram[0].minutes)} minutes of work in {workGram[0].c.name} and {Math.round(workGram.at(-1).minutes)} in {workGram.at(-1).c.name}</h2>
      <p class="ch-dek">The street price of a gram of herb, divided by what the national minimum wage pays for an hour of full-time work (a month's wage over 173 hours). The bar's colour is the country's band: prices follow wages and markets more than the law.</p>
      <ol class="ch-bars" data-no-preview>
        {workGram.map((w) => (
          <li>
            <a href={`${base}country/${w.c.slug}/#datasets`} data-work={w.c.slug}>
              <span class="ch-bar-name">{w.c.flag} {w.c.name}</span>
              <span class="ch-bar-track"><span class="ch-bar" style={`width:${(w.minutes / workMax) * 100}%;--c:${tierColor(w.c.raw)}`}></span></span>
              <span class="ch-bar-num">{Math.round(w.minutes)} min</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="ch-source">Prices: {PRICES.title}, latest year since 2018. Wages: {MW.title}, January of the latest year. Countries without a national minimum wage, such as Austria, Italy and Sweden, are left out. <a href={`${base}sources/#dataset-minimum_wage`}>About the wage data</a>.</p>
      <p class="ch-more"><a href={`${base}map/cannabis-price-europe/`}>Prices on the map →</a> <a href={`${base}map/minimum-wage/`}>Minimum wages on the map →</a></p>
    </section>
    {chapterAt.has("thc-per-euro") && <h2 class="ch-chapter">{chapterAt.get("thc-per-euro")}</h2>}
    <section class="ch" id="thc-per-euro">
      <p class="ch-kicker"><a href="#thc-per-euro">{kick("thc-per-euro")}</a></p>
      <h2>{Math.abs(mgChange) < 0.15 ? `Stronger herb, dearer gram: a euro still buys about ${Math.round(mgNow)} mg of THC, as in ${T0}` : `A euro bought ${Math.round(mgThen)} mg of THC around ${T0}; now it buys ${Math.round(mgNow)} mg`}</h2>
      <p class="ch-dek">In Europe, herb went from about {fmt1(thThen)}% THC to {fmt1(thNow)}%, and a gram from €{prThen.toFixed(2)} to €{prNow.toFixed(2)}, so the amount of the drug a euro buys has {mgChange > 0.15 ? "grown" : mgChange < -0.15 ? "shrunk" : "hardly changed"}. The bold line is the middle of the countries reporting both figures each year, first and last three years averaged for the headline; the faint lines are the countries.</p>
      <div class="ch-frame ch-thc" data-no-preview>
        <div class="ch-y">{Array.from({ length: MG1 / 10 + 1 }, (_, i) => i * 10).filter((t) => t % (MG1 > 60 ? 20 : 10) === 0).map((t) => <span style={`top:${mgOf(t)}%`}>{t}</span>)}</div>
        <div class="ch-plot">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {Array.from({ length: MG1 / 10 + 1 }, (_, i) => i * 10).filter((t) => t % (MG1 > 60 ? 20 : 10) === 0).map((t) => <line class="ch-grid" x1="0" x2="100" y1={mgOf(t)} y2={mgOf(t)} />)}
            {thcCountries.map((x) => <path class="ch-thc-country" data-thc={x.c.slug} d={thcLine(x.pts)} />)}
            <path class="ch-thc-area" d={`${thcMedianPath}L100,100L0,100Z`} />
            <path class="ch-thc-median" d={thcMedianPath} />
          </svg>
          <span class="ch-seek" hidden></span>
          <span class="ch-teen-dot ch-thc-dot" hidden></span>
          <a class="ch-thc-hit" href={`${base}map/thc-potency-europe/`} aria-label="Open the country under the pointer"></a>
        </div>
        <div class="ch-x">{thcYears.filter((t) => t.year % 4 === 0).map((t) => <span class:list={{ first: t.year === T0, last: t.year === T1 }} style={`left:${pct(t.year, T0, T1)}%`}>{t.year}</span>)}</div>
        <p class="ch-axis-label">Milligrams of THC a euro buys, in herb</p>
      </div>
      <p class="ch-source">{POTENCY.publisher} figures for the per cent THC in herb and its street price per gram; a gram at 10% THC holds 100 mg. <a href={`${base}sources/#dataset-potency_europe`}>Potency</a> and <a href={`${base}sources/#dataset-prices_europe`}>prices</a>.</p>
      <p class="ch-more"><a href={`${base}map/thc-potency-europe/`}>Potency on the map →</a> <a href={`${base}map/cannabis-price-europe/`}>Prices on the map →</a></p>
    </section>
    {chapterAt.has("sourcing") && <h2 class="ch-chapter">{chapterAt.get("sourcing")}</h2>}
    <section class="ch" id="sourcing">
      <p class="ch-kicker"><a href="#sourcing">{kick("sourcing")}</a></p>
      <h2>In Canada, buying from friends fell from {firstOf("social").social}% to {lastOf("social").social}% of users after legalisation; legal shops rose to {lastOf("legal").legal}%</h2>
      <p class="ch-dek">Each column is a year of the Canadian Cannabis Survey: the usual source of cannabis of people who used it in the past year. Legal sales began in October 2018, after that year's survey; illegal sellers fell from {firstOf("illegal").illegal}% to {lastOf("illegal").illegal}%.</p>
      <div class="ch-frame ch-sourcing" data-no-preview>
        <div class="ch-cols">
          {sourcing.map((r) => {
            const total = SOURCE_KINDS.reduce((t, k) => t + (r[k.id] ?? 0), 0);
            return (
              <a class="ch-col" href={`${base}country/ca/#datasets`} data-source={r.year} aria-label={`${r.year}: ${SOURCE_KINDS.map((k) => `${k.label} ${r[k.id] ?? "–"}%`).join(", ")}`}>
                <span class="ch-col-stack">
                  {SOURCE_KINDS.map((k) => r[k.id] ? <i style={`height:${(r[k.id] / total) * 100}%;background:${k.color}`}>{r[k.id] >= 8 && <b>{r[k.id]}%</b>}</i> : null)}
                </span>
                <span class="ch-col-year">{r.year}</span>
              </a>
            );
          })}
        </div>
        <p class="ch-legend">{SOURCE_KINDS.map((k) => <span><i style={`background:${k.color}`}></i>{k.label}</span>)}</p>
      </div>
      <p class="ch-source">{SOURCING.title}. <a href={`${base}sources/#dataset-canada_sourcing`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}country/ca/#history`}>Canada's history →</a> <a href={`${base}history/canada-cannabis-act-2018/`}>The Cannabis Act of 2018 →</a></p>
    </section>
    {chapterAt.has("state-merchant") && <h2 class="ch-chapter">{chapterAt.get("state-merchant")}</h2>}
    <section class="ch" id="state-merchant">
      <p class="ch-kicker"><a href="#state-merchant">{kick("state-merchant")}</a></p>
      <h2>As legal buying rose to {lastOf("legal").legal}%, Canada's governments came to take {billion(revenue.at(-1).revenue)} a year from cannabis</h2>
      <p class="ch-dek">Two panels on one timeline. Above, the share of people who use cannabis who usually buy it legally, and who get it from friends and family. Below, what the provinces' cannabis authorities earned plus the excise and sales taxes, by fiscal year from April; Statistics Canada's series starts in 2021. The two moved together; the taxes did not cause the shift.</p>
      <div class="ch-frame ch-merchant" data-no-preview>
        <div class="ch-merchant-panel">
          <div class="ch-y">{[0, 25, 50, 75].map((t) => <span style={`top:${100 - t}%`}>{t}%</span>)}</div>
          <div class="ch-plot">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              {[0, 25, 50, 75].map((t) => <line class="ch-grid" x1="0" x2="100" y1={100 - t} y2={100 - t} />)}
              <path class="ch-line legal" d={sourcing.filter((r) => r.legal != null).map((r, i) => `${i ? "L" : "M"}${cx(r.year)},${100 - r.legal}`).join("")} />
              <path class="ch-line social" d={sourcing.map((r, i) => `${i ? "L" : "M"}${cx(r.year)},${100 - r.social}`).join("")} />
            </svg>
            <span class="ch-line-label legal" style={`left:${cx(lastOf("legal").year)}%;top:${100 - lastOf("legal").legal}%`}>Legal</span>
            <span class="ch-line-label social" style={`left:${cx(lastOf("social").year)}%;top:${100 - lastOf("social").social}%`}>Friends and family</span>
          </div>
        </div>
        <div class="ch-merchant-panel ch-merchant-bars">
          <div class="ch-y">{[0, 1, 2].map((t) => <span style={`top:${100 - (t * 1e6 / (Math.ceil(revMax / 1e6) * 1e6)) * 100}%`}>{t ? `$${t}bn` : "0"}</span>)}</div>
          <div class="ch-plot">
            {revenue.map((r) => (
              <a class="ch-rev" href={`${base}sources/#dataset-canada_revenue`} data-revenue={revenue.indexOf(r)} style={`left:${cx(r.year)}%;height:${(r.revenue / (Math.ceil(revMax / 1e6) * 1e6)) * 100}%`}
                aria-label={`${r.fiscal_year}: ${billion(r.revenue)}`}><b>{(r.revenue / 1e6).toFixed(1)}</b></a>
            ))}
          </div>
        </div>
        <div class="ch-merchant-x"><span></span><div class="ch-x">{Array.from({ length: C1 - C0 }, (_, i) => C0 + i).map((y) => <span style={`left:${cx(y)}%`}>{y}</span>)}</div></div>
      </div>
      <p class="ch-source">{SOURCING.title}; {REVENUE.title}, in Canadian dollars. <a href={`${base}sources/#dataset-canada_revenue`}>About the revenue data</a>.</p>
      <p class="ch-more"><a href={`${base}country/ca/`}>Canada's profile →</a> <a href={`${base}history/kind/legalisation/`}>Every legalisation →</a></p>
    </section>
    {chapterAt.has("hemp") && <h2 class="ch-chapter">{chapterAt.get("hemp")}</h2>}
    <section class="ch" id="hemp">
      <p class="ch-kicker"><a href="#hemp">{kick("hemp")}</a></p>
      <h2>{hempBanned.length} of the {hempGrowers.length} countries that farm hemp ban cannabis for adults; they grow {hempBannedShare}% of it</h2>
      <p class="ch-dek">The same plant, grown for fibre and seed on {num(Math.round(hempTotal / 1000) * 1000)} hectares, is a crime when it is grown to smoke. Each bar is a country's hemp fields in the latest year reported, on a scale where each step is ten times the last; the colour is its law for adults.</p>
      <ol class="ch-bars ch-bars-log" data-no-preview>
        <li class="ch-bars-axis" aria-hidden="true"><span></span><span class="ch-bar-track">{HA_LOG.map((v) => <span style={`left:${haOf(v)}%`}>{num(v)}</span>)}</span><span></span></li>
        {hempGrowers.map((h) => (
          <li>
            <a href={`${base}country/${h.c.slug}/#datasets`} data-hemp={h.c.slug}>
              <span class="ch-bar-name">{h.c.flag} {h.c.name}</span>
              <span class="ch-bar-track"><span class="ch-bar" style={`width:${haOf(h.ha)}%;--c:var(--rec-${h.c.rec})`}></span></span>
              <span class="ch-bar-num">{num(h.ha)}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="ch-legend ch-rec-legend">{REC_ORDER.map((k) => <span><i style={`background:var(--rec-${k})`}></i>{REC_LABEL[k]}</span>)}</p>
      <p class="ch-source">{HEMP.title}; hectares of hemp, latest year since 2019. <a href={`${base}sources/#dataset-hemp`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}map/hemp-grown/`}>Hemp on the map →</a> <a href={`${base}history/kind/hemp/`}>Hemp in the history →</a></p>
    </section>
    {chapterAt.has("opinion") && <h2 class="ch-chapter">{chapterAt.get("opinion")}</h2>}
    <section class="ch" id="opinion">
      <p class="ch-kicker"><a href="#opinion">{kick("opinion")}</a></p>
      <h2>In {mostAccepting.c.name}, {mostAccepting.x}% don't call using cannabis immoral; {acceptedBanned.length ? `in ${acceptedBanned.length} more countries at least 40% don't, yet the law stays strict` : "the law follows opinion only loosely"}</h2>
      <p class="ch-dek">Each dot is one of the {moral.length} countries in a 2025 Pew survey: across, the share of adults who say using marijuana is morally acceptable or not a moral issue; up, its cannabis score. Top right, the law and opinion are both relaxed; bottom right, people have moved on and the law has not.</p>
      <div class="ch-frame ch-scatter ch-opinion" data-no-preview>
        <div class="ch-y">{[0, 20, 40, 60].map((t) => <span style={`top:${100 - pct(t, 0, moralY1)}%`}>{t}</span>)}</div>
        <div class="ch-plot">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <rect class="ch-quad" x={pct(40, 0, 80)} y={100 - pct(25, 0, moralY1)} width={100 - pct(40, 0, 80)} height={pct(25, 0, moralY1)} />
            {[0, 20, 40, 60].map((t) => <line class="ch-grid" x1="0" x2="100" y1={100 - pct(t, 0, moralY1)} y2={100 - pct(t, 0, moralY1)} />)}
          </svg>
          <span class="ch-quad-label" style={`left:${pct(40, 0, 80)}%;top:${100 - pct(25, 0, moralY1)}%`}>Accepted, still restricted</span>
          {moral.map((m) => (
            <a class:list={["ch-dot", { named: moralNamed.has(m.c.id), left: m.x > 55 }]} href={`${base}country/${m.c.slug}/#datasets`} data-moral={m.c.slug}
              style={`left:${pct(m.x, 0, 80)}%;top:${100 - pct(m.y, 0, moralY1)}%;--c:${tierColor(m.y)}`} aria-label={`${m.c.name}: ${m.x}% accepting, score ${Math.round(m.y)}`}>
              {moralNamed.has(m.c.id) && <span>{m.c.name}</span>}
            </a>
          ))}
        </div>
        <div class="ch-x">{[0, 20, 40, 60, 80].map((t) => <span class:list={{ first: t === 0, last: t === 80 }} style={`left:${pct(t, 0, 80)}%`}>{t}%</span>)}</div>
        <p class="ch-axis-label">Say using marijuana is acceptable or not a moral issue</p>
      </div>
      <p class="ch-source">{PEW.title}; {PEW.when}. <a href={`${base}sources/#dataset-pew_marijuana`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}map/marijuana-morality/`}>The survey on the map →</a> <a href={`${base}survey/`}>Our own survey →</a></p>
    </section>
    {chapterAt.has("parties") && <h2 class="ch-chapter">{chapterAt.get("parties")}</h2>}
    <section class="ch" id="parties">
      <p class="ch-kicker"><a href="#parties">{kick("parties")}</a></p>
      <h2>A party for one issue: {partyCount} parties founded to legalise cannabis in {partyRows.length} countries</h2>
      <p class="ch-dek">Political parties founded to legalise cannabis, as Wikidata records them: a dot where each was founded, a line while it lasted. Wikidata is far from complete: countries with such parties may be missing.</p>
      <div class="ch-frame ch-parties" data-no-preview>
        {partyRows.map((r) => (
          <div class="ch-party-row">
            <span class="ch-party-name">{r.c.flag} {r.c.name}</span>
            <div class="ch-party-plot">
              {[2000, 2010, 2020].map((y) => <span class="ch-vline" style={`left:${pct(y, P0, NOW)}%`}></span>)}
              {r.list.map((p, i) => p.year ? (
                <a class="ch-party" href={`https://www.wikidata.org/wiki/${p.wikidata}`} target="_blank" rel="noopener noreferrer" data-party={`${r.c.slug}-${i}`}
                  style={`left:${pct(p.year, P0, NOW)}%;width:${pct(p.dissolved ?? NOW, P0, NOW) - pct(p.year, P0, NOW)}%;top:${8 + i * 9}px`} aria-label={`${p.party}, founded ${p.year}`}><i></i></a>
              ) : null)}
            </div>
          </div>
        ))}
        <div class="ch-party-row ch-swarm-axis"><span></span><div class="ch-x">{[1990, 2000, 2010, 2020].map((y) => <span class:list={{ first: y === 1990 }} style={`left:${pct(y, P0, NOW)}%`}>{y}</span>)}</div></div>
      </div>
      <p class="ch-source">{PARTIES.title}; parties without a recorded founding year are left off the timeline. Click a dot for its Wikidata entry. <a href={`${base}sources/#dataset-cannabis_parties`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}history/kind/debate/`}>Debates and campaigns in the history →</a></p>
    </section>
    {chapterAt.has("religion") && <h2 class="ch-chapter">{chapterAt.get("religion")}</h2>}
    <section class="ch" id="religion">
      <p class="ch-kicker"><a href="#religion">{kick("religion")}</a></p>
      <h2>Faith and the law: no Muslim-majority country scores above {Math.round(muslim.max.raw)}; the freest are mostly Christian or have no majority faith</h2>
      <p class="ch-dek">Each dot is a country, in the row of its largest religious group (Pew's 2020 estimate) and placed along the row by its cannabis score. The bar is each group's middle. Religion is one force among many: colonial law, wealth and the year a country met the drug treaties all play a part.</p>
      <div class="ch-frame ch-faith" data-no-preview>
        {faiths.map((f) => (
          <div class="ch-swarm-row" style={`--lanes:${f.lanes}`}>
            <span class="ch-swarm-name">{f.label}<small>{f.list.length} countries · middle {fmt1(f.median)}</small></span>
            <div class="ch-plot">
              {[0, 15, 25, 40].map((t) => <span class="ch-vline" style={`left:${pct(t, 0, FX1)}%`}></span>)}
              <span class="ch-faith-median" style={`left:${pct(f.median, 0, FX1)}%`}></span>
              {f.placed.map((p) => (
                <a class="ch-dot" href={`${base}country/${p.c.slug}/`} data-faith={p.c.slug}
                  style={`left:${pct(Math.min(p.c.raw, FX1), 0, FX1)}%;top:calc(50% + ${p.lane} * var(--lane));--c:${tierColor(p.c.raw)}`} aria-label={`${p.c.name}: ${Math.round(p.c.raw)}`}></a>
              ))}
            </div>
          </div>
        ))}
        <div class="ch-swarm-row ch-swarm-axis"><span></span><div class="ch-x">{[0, 15, 25, 40, 60].map((t) => <span class:list={{ first: t === 0, last: t === 60 }} style={`left:${pct(t, 0, FX1)}%`}>{t}</span>)}</div></div>
      </div>
      <p class="ch-source">{REL.title}; the score as on the <a href={`${base}#rankings`}>rankings</a>. Groups with no country in the lead are left out. <a href={`${base}sources/#dataset-religion`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}map/recreational/`}>Recreational law, with the death penalty →</a> <a href={`${base}culture/`}>The culture atlas →</a></p>
    </section>
    {chapterAt.has("freedom") && <h2 class="ch-chapter">{chapterAt.get("freedom")}</h2>}
    <section class="ch" id="freedom">
      <p class="ch-kicker"><a href="#freedom">{kick("freedom")}</a></p>
      <h2>Freedom in general predicts cannabis freedom {strength} (r = {r.toFixed(2)})</h2>
      <p class="ch-dek">Each dot is a country: across, its score in the Human Freedom Index; up, its cannabis score. The line is the best straight fit. The countries furthest above it are freer for cannabis than their general freedom would suggest; those furthest below, less free.</p>
      <div class="ch-frame ch-scatter" data-no-preview>
        <div class="ch-y">{[0, 20, 40, 60].map((t) => <span style={`top:${yOf(t)}%`}>{t}</span>)}</div>
        <div class="ch-plot">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {[0, 20, 40, 60].map((t) => <line class="ch-grid" x1="0" x2="100" y1={yOf(t)} y2={yOf(t)} />)}
            <line class="ch-fit" x1={fitLine[0][0]} x2={fitLine[1][0]} y1={fitLine[0][1]} y2={fitLine[1][1]} />
          </svg>
          {pairs.map((p) => (
            <a class:list={["ch-dot", { named: outliers.has(p.c.id), left: p.x > 8.2 }]} href={`${base}country/${p.c.slug}/#datasets`} data-dot={pairs.indexOf(p)} style={`left:${pct(p.x, X0, X1)}%;top:${yOf(p.y)}%;--c:${tierColor(p.y)}`}
              aria-label={`${p.c.name}: Human Freedom Index ${p.x.toFixed(2)}, cannabis score ${Math.round(p.y)}`}>
              {outliers.has(p.c.id) && <span>{p.c.name}</span>}
            </a>
          ))}
        </div>
        <div class="ch-x">{[4, 5, 6, 7, 8, 9].map((x) => <span style={`left:${pct(x, X0, X1)}%`}>{x}</span>)}</div>
        <p class="ch-axis-label">Human Freedom Index, 0–10</p>
      </div>
      <p class="ch-source">{HFI.title}, {HFI.when}; {pairs.length} countries scored by both. <a href={`${base}sources/#dataset-hfi`}>About the dataset</a>. The cannabis scale is cut at 70: no country scores higher.</p>
      <p class="ch-more"><a href={`${base}map/human-freedom/`}>The Human Freedom Index on the map →</a> <a href={`${base}map/civil-liberties/`}>Civil liberties since 1900 →</a></p>
    </section>
    {chapterAt.has("corruption") && <h2 class="ch-chapter">{chapterAt.get("corruption")}</h2>}
    <section class="ch" id="corruption">
      <p class="ch-kicker"><a href="#corruption">{kick("corruption")}</a></p>
      <h2>{graftFit.r > 0.3 ? "The cleaner the state, the milder the cannabis law" : "Corruption and the cannabis law go together only loosely"}: severe prohibition sits where corruption scores {Math.round(severeCpi)} of 100, milder laws at {Math.round(freeCpi)}</h2>
      <p class="ch-dek">Each dot is a country: across, Transparency International's Corruption Perceptions Index, from 0 (highly corrupt) to 100 (very clean); up, its cannabis score. Where police and courts are thought corrupt, a harsh law also gives officials something to sell: a blind eye.</p>
      <div class="ch-frame ch-scatter" data-no-preview>
        <div class="ch-y">{[0, 20, 40, 60].map((t) => <span style={`top:${100 - pct(t, 0, 60)}%`}>{t}</span>)}</div>
        <div class="ch-plot ch-plot-short">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {[0, 20, 40, 60].map((t) => <line class="ch-grid" x1="0" x2="100" y1={100 - pct(t, 0, 60)} y2={100 - pct(t, 0, 60)} />)}
            <line class="ch-fit" x1="0" x2="100" y1={100 - pct(graftFit.cut, 0, 60)} y2={100 - pct(graftFit.cut + graftFit.slope * 100, 0, 60)} />
          </svg>
          {graft.map((d) => (
            <a class:list={["ch-dot", { named: graftNamed.has(d.c.id), left: d.x > 78 }]} href={`${base}country/${d.c.slug}/#datasets`} data-graft={d.c.slug}
              style={`left:${d.x}%;top:${100 - pct(Math.min(d.y, 60), 0, 60)}%;--c:${tierColor(d.y)}`} aria-label={`${d.c.name}: ${d.x} of 100, score ${Math.round(d.y)}`}>
              {graftNamed.has(d.c.id) && <span>{d.c.name}</span>}
            </a>
          ))}
        </div>
        <div class="ch-x">{[0, 20, 40, 60, 80, 100].map((t) => <span class:list={{ first: t === 0, last: t === 100 }} style={`left:${t}%`}>{t}</span>)}</div>
        <p class="ch-axis-label">Corruption Perceptions Index: 0 highly corrupt, 100 very clean</p>
      </div>
      <p class="ch-source">{CPI.title}, latest year; {graft.length} countries; r = {graftFit.r.toFixed(2)}. <a href={`${base}sources/#dataset-corruption`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}map/corruption/`}>Corruption on the map →</a> <a href={`${base}map/enforcement/`}>Enforcement on the map →</a></p>
    </section>
    {chapterAt.has("state-capacity") && <h2 class="ch-chapter">{chapterAt.get("state-capacity")}</h2>}
    <section class="ch" id="state-capacity">
      <p class="ch-kicker"><a href="#state-capacity">{kick("state-capacity")}</a></p>
      <h2>{capFit.r > 0.3 ? "The more capable the state, the more cannabis is used, not less" : capFit.r < -0.3 ? "More capable states see less cannabis use" : "How capable a state is says little about how much cannabis its people use"} (r = {capFit.r.toFixed(2)})</h2>
      <p class="ch-dek">Each dot is a country: across, the World Bank's measure of government effectiveness, 0 to 100; up, the share of adults who used cannabis in the past year; colour, its band. Even the strongest states do not keep use down: among the most effective ones, {strongStrict.length} under prohibition and {strongMild.length} with milder laws sit across the same range. Richer countries also survey more, and people there admit use more readily.</p>
      <div class="ch-frame ch-scatter ch-wide-y" data-no-preview>
        <div class="ch-y">{Array.from({ length: CY1 / 5 + 1 }, (_, i) => i * 5).map((t) => <span style={`top:${100 - pct(t, 0, CY1)}%`}>{t}%</span>)}</div>
        <div class="ch-plot ch-plot-short">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {Array.from({ length: CY1 / 5 + 1 }, (_, i) => i * 5).map((t) => <line class="ch-grid" x1="0" x2="100" y1={100 - pct(t, 0, CY1)} y2={100 - pct(t, 0, CY1)} />)}
            <line class="ch-fit" x1="0" x2="100" y1={100 - pct(capFit.cut, 0, CY1)} y2={100 - pct(capFit.cut + capFit.slope * 100, 0, CY1)} />
          </svg>
          {capacity.map((d) => (
            <a class:list={["ch-dot", { named: capNamed.has(d.c.id), left: d.x > 78 }]} href={`${base}country/${d.c.slug}/#datasets`} data-capacity={d.c.slug}
              style={`left:${d.x}%;top:${100 - pct(d.y, 0, CY1)}%;--c:${tierColor(d.c.raw)}`} aria-label={`${d.c.name}: effectiveness ${Math.round(d.x)}, use ${d.y}%`}>
              {capNamed.has(d.c.id) && <span>{d.c.name}</span>}
            </a>
          ))}
        </div>
        <div class="ch-x">{[0, 20, 40, 60, 80, 100].map((t) => <span class:list={{ first: t === 0, last: t === 100 }} style={`left:${t}%`}>{t}</span>)}</div>
        <p class="ch-axis-label">Government effectiveness, World Bank, 0–100</p>
      </div>
      <p class="ch-source">{GE.title}, latest year; past-year use from the <a href={`${base}sources/#dataset-cannabis_use`}>UNODC</a>, estimates left out; {capacity.length} countries. Survey years differ from country to country.</p>
      <p class="ch-more"><a href={`${base}map/government-effectiveness/`}>Government effectiveness on the map →</a> <a href={`${base}map/share-of-adults/`}>Use on the map →</a></p>
    </section>
    {chapterAt.has("trials") && <h2 class="ch-chapter">{chapterAt.get("trials")}</h2>}
    <section class="ch" id="trials">
      <p class="ch-kicker"><a href="#trials">{kick("trials")}</a></p>
      <h2>Medicine on trial: {trialTop[0].c.name} tests cannabis medicines most per person, {trialMostTotal.c.name} most of all ({num(trialMostTotal.total)} studies)</h2>
      <p class="ch-dek">Registered clinical studies of cannabis, CBD, THC and cannabinoid medicines, {trialCountries} countries. Left: the studies that started each year, counted once for each country with a site. Right: the {trialTop.length} countries of over a million people with the most per million people, coloured by band.</p>
      <div class="ch-trials" data-no-preview>
        <div class="ch-trial-years">
          <div class="ch-trial-cols">
            {trialYears.map((t) => <span data-trialyear={t.y} style={`height:${(t.n / trialMax) * 100}%`} tabindex="0" aria-label={`${t.y}: ${t.n}`}></span>)}
          </div>
          <div class="ch-trial-x"><span>2000</span><span>2010</span><span>{NOW}</span></div>
        </div>
        <ol class="ch-bars" data-no-preview>
          {trialTop.map((t) => (
            <li>
              <a href={`${base}country/${t.c.slug}/#datasets`} data-trialtop={t.c.slug}>
                <span class="ch-bar-name">{t.c.flag} {t.c.name}</span>
                <span class="ch-bar-track"><span class="ch-bar" style={`width:${(t.per / trialTop[0].per) * 100}%;--c:${tierColor(t.c.raw)}`}></span></span>
                <span class="ch-bar-num">{t.per.toFixed(1)}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <p class="ch-source">{TRIALS.title}; a study with sites in several countries counts in each, and studies not yet started are left out. Bars: studies per million people, all years. <a href={`${base}sources/#dataset-clinical_trials`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}map/clinical-trials/`}>Trials on the map →</a> <a href={`${base}map/medical/`}>Medical law on the map →</a> <a href={`${base}history/kind/medical/`}>Medical cannabis in the history →</a></p>
    </section>
    {chapterAt.has("research") && <h2 class="ch-chapter">{chapterAt.get("research")}</h2>}
    <section class="ch" id="research">
      <p class="ch-kicker"><a href="#research">{kick("research")}</a></p>
      <h2>Countries in the band {resHigh.t.name.toLowerCase()} publish {Math.round(resHigh.median / resLow.median)} times as much cannabis research per person as those under {resLow.t.name.toLowerCase()}</h2>
      <p class="ch-dek">Each dot is a country of over a million people, in the column of its band, at the number of scientific papers on cannabis it published a year, per million people, {P_YEARS[0]}–{P_YEARS[1]}. The scale rises tenfold at each line. Rich countries publish more of everything, and many legalised for other reasons, so this is no proof that prohibition stifles science.</p>
      <div class="ch-frame ch-use ch-research" data-no-preview>
        <div class="ch-y">{Array.from({ length: RL1 - RL0 + 1 }, (_, i) => RL0 + i).map((e) => <span style={`top:${rOf(10 ** e)}%`}>{10 ** e < 1 ? 10 ** e : num(10 ** e)}</span>)}</div>
        <div class="ch-plot">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {Array.from({ length: RL1 - RL0 + 1 }, (_, i) => RL0 + i).map((e) => <line class="ch-grid" x1="0" x2="100" y1={rOf(10 ** e)} y2={rOf(10 ** e)} />)}
          </svg>
          {resBands.map((b, i) => {
            const cx = ((i + 0.5) / resBands.length) * 100;
            return <>
              <span class="ch-median" style={`left:${cx}%;top:${rOf(b.median)}%`}><b>{fmtRate(b.median)}</b></span>
              {b.placed.map((p) => (
                <a class="ch-dot" href={`${base}country/${p.r.c.slug}/#datasets`} data-research={p.r.c.slug}
                  style={`left:calc(${cx}% + ${p.lane} * var(--lane));top:${p.y}%;--c:${tierColor(b.t.min)}`}
                  aria-label={`${p.r.c.name}: ${fmtRate(p.r.per)} cannabis papers a year per million people`}></a>
              ))}
            </>;
          })}
        </div>
        <div class="ch-use-x">{resBands.map((b) => <span><b>{b.t.name}</b><small>{b.dots.length} countries</small></span>)}</div>
      </div>
      <p class="ch-source">{PAPERS.title}; papers counted by the country of their authors. <a href={`${base}sources/#dataset-research_papers`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}map/cannabis-research/`}>Research on the map →</a> <a href={`${base}history/kind/culture/`}>Culture and science in the history →</a></p>
    </section>
    {chapterAt.has("words-in-books") && <h2 class="ch-chapter">{chapterAt.get("words-in-books")}</h2>}
    <section class="ch" id="words-in-books">
      <p class="ch-kicker"><a href="#words-in-books">{kick("words-in-books")}</a></p>
      <h2>In 1900, English books named hemp {hempLead1900} times as often as marijuana; marijuana overtook it in {overtook}</h2>
      <p class="ch-dek">How often printed books named the plant and the drug, each language on its own scale, 1800 to 2022, smoothed over five years. Green is the old word for the crop (hemp, Hanf, chanvre, canapa, cáñamo, конопля); blue is cannabis, orange marijuana, red hashish. The crop faded from print as the drug arrived.</p>
      <div class="ch-books" data-no-preview>
        {bookPanels.map((p, k) => (
          <div class="ch-book" data-book={k}>
            <span class="ch-book-name">{p.name}</span>
            <span class="ch-book-plot">
              <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                {[1850, 1900, 1950, 2000].map((y) => <line class="ch-grid" x1={pct(y, BK0, BK1)} x2={pct(y, BK0, BK1)} y1="0" y2="100" />)}
                {p.words.map((w) => <path class="ch-book-line" d={w.d} style={`stroke:${ROLE_COLOR[w.role]}`} />)}
              </svg>
              <span class="ch-seek" hidden></span>
            </span>
            <span class="ch-book-x"><span>1800</span><span>1900</span><span>2022</span></span>
          </div>
        ))}
      </div>
      <p class="ch-legend">{Object.entries(ROLE_LABEL).map(([role, label]) => <span><i style={`background:${ROLE_COLOR[role]}`}></i>{label}</span>)}</p>
      <p class="ch-source">{BOOKS.title}; occurrences per billion words, all spellings of a word summed. "Hemp" also means rope and cloth; the scanned books are not a random sample of what was printed. <a href={`${base}sources/#dataset-book_words`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}culture/language/`}>Words for cannabis in the culture atlas →</a> <a href={`${base}history/kind/hemp/`}>Hemp in the history →</a></p>
    </section>
    {chapterAt.has("looked-it-up") && <h2 class="ch-chapter">{chapterAt.get("looked-it-up")}</h2>}
    <section class="ch" id="looked-it-up">
      <p class="ch-kicker"><a href="#looked-it-up">{kick("looked-it-up")}</a></p>
      <h2>When {wikiLead.c.name}'s law moved, its people looked it up: {Math.round(wikiLead.jump)} times the usual readers of the cannabis article in {monthName(wikiLead.peak.month)}</h2>
      <p class="ch-dek">Monthly readers of the Wikipedia article on cannabis in {wiki.length} languages spoken mainly in one country, each line on its own scale; the ticks are that country's changes in the law. Curiosity spikes when the law is in the news, and fades.</p>
      <div class="ch-wiki" data-no-preview>
        {wiki.map((w) => (
          <a class="ch-wiki-cell" href={`${base}country/${w.c.slug}/#history`} data-wiki={w.c.slug}>
            <span class="ch-wiki-name">{w.c.flag} {w.c.name} <small>{w.lang} · peak {(w.jump).toFixed(1)}× a normal month</small></span>
            <span class="ch-wiki-plot">
              <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                <path class="ch-wiki-area" d={`${wikiPath(w)}L100,100L0,100Z`} />
                <path class="ch-wiki-line" d={wikiPath(w)} />
              </svg>
              {w.laws.map((l) => <i class="ch-wiki-law" style={`left:${wx(l.t)}%;--c:${l.d > 0 ? "var(--t5)" : "var(--t1)"}`}></i>)}
            </span>
          </a>
        ))}
      </div>
      <p class="ch-wiki-x"><span>2015</span><span>2020</span><span>{Math.floor(W1w)}</span></p>
      <p class="ch-source">{WIKI.title}; people only, not bots. German is also read in Austria and Switzerland, Dutch in Belgium. Green ticks eased the law, red ones tightened it. <a href={`${base}sources/#dataset-wikipedia_views`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}history/kind/legalisation/`}>Every legalisation →</a> <a href={`${base}history/period/2020s/`}>The 2020s →</a></p>
    </section>
    {NEWS && newsRows.length > 0 && (
    <section class="ch" id="in-the-news">
      <p class="ch-kicker"><a href="#in-the-news">{kick("in-the-news")}</a></p>
      <h2>{newsTop[0].c.name}'s press talks about cannabis most: {(newsTop[0].share / newsMid).toFixed(0)} times the share of a typical country's news in {NEWS_YEAR}</h2>
      <p class="ch-dek">Of all the online news GDELT monitors from each country's own sites, the share of articles that mention cannabis or marijuana in {NEWS_YEAR}, the {newsTop.length} highest of {newsRows.length} countries. Beside each, its share year by year since 2017. Attention, not opinion: a crackdown makes news as much as a reform. Across all countries, attention and the score go together with r = {newsFit.r.toFixed(2)}.</p>
      <ol class="ch-bars ch-news" data-no-preview>
        {newsTop.map((n) => (
          <li>
            <a href={`${base}country/${n.c.slug}/#datasets`} data-news={n.c.slug}>
              <span class="ch-bar-name">{n.c.flag} {n.c.name}</span>
              <span class="ch-bar-track"><span class="ch-bar" style={`width:${(n.share / newsTop[0].share) * 100}%;--c:${tierColor(n.c.raw)}`}></span></span>
              <svg class="ch-news-spark" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d={sparkOf(n.rows)} /></svg>
              <span class="ch-bar-num">{n.share.toFixed(3)}%</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="ch-source">{NEWS.title}; years with fewer than 200 days of data left out. <a href={`${base}sources/#dataset-news`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}map/in-the-news/`}>News attention on the map →</a> <a href="#looked-it-up">Wikipedia readers →</a></p>
    </section>
    )}
    {chapterAt.has("what-goes-with-it") && <h2 class="ch-chapter">{chapterAt.get("what-goes-with-it")}</h2>}
    <section class="ch" id="what-goes-with-it">
      <p class="ch-kicker"><a href="#what-goes-with-it">{kick("what-goes-with-it")}</a></p>
      <h2>Across the world, {strongest.label.replace(/ \(.*\)$/, "").toLowerCase()} goes with cannabis freedom most closely (r = {strongest.r.toFixed(2)}); in fewer countries, {strongestNarrow.label.replace(/ \(.*\)$/, "").toLowerCase()} does even more (r = {strongestNarrow.r.toFixed(2)})</h2>
      <p class="ch-dek">How closely each of {measures.length} measures moves with the cannabis score across the countries that have it: 1 would mean they rise together exactly, −1 that one falls as the other rises, 0 no link at all. A yes-or-no measure, such as a Muslim majority, counts 1 for yes. A link is not a cause, and many of these measures move with each other; those marked Europe cover few countries. Click a bar for its chart or map.</p>
      <ol class="ch-corr" data-no-preview>
        {MEASURE_GROUPS.map(({ g, list }) => <>
          <li class="ch-corr-group">{g}</li>
          {list.map((m) => (
          <li>
            <a href={m.href.startsWith("#") ? m.href : `${base}${m.href}`} data-measure={measures.indexOf(m)}>
              <span class="ch-bar-name">{m.label} <small>{m.n}</small></span>
              <span class="ch-corr-track"><i class="ch-corr-zero"></i><span class="ch-corr-bar" style={`${m.r >= 0 ? `left:50%;width:${m.r * 50}%` : `right:50%;width:${-m.r * 50}%`};--c:${m.r >= 0 ? "var(--t5)" : "var(--t1)"}`}></span></span>
              <span class="ch-bar-num">{m.r > 0 ? "+" : "−"}{Math.abs(m.r).toFixed(2)}</span>
            </a>
          </li>
          ))}
        </>)}
        <li class="ch-corr-axis" aria-hidden="true"><span></span><span class="ch-corr-track"><span style="left:0">−1</span><span style="left:50%">0</span><span style="left:100%">+1</span></span><span></span></li>
      </ol>
      <p class="ch-source">Pearson's correlation between each measure and the cannabis score, over the countries with both figures, at least 20; the latest year of each. Measures marked log are on a log scale. Hover a bar for how many countries it covers.</p>
      <p class="ch-more"><a href={`${base}map/income/`}>Income on the map →</a> <a href={`${base}sources/#datasets`}>All the datasets →</a></p>
    </section>
  </main>
  <script type="application/json" id="ch-data" set:html={JSON.stringify(chartData)} />
  <script>
    // Hover cards: the detail behind a bar, a row, a region or a dot. The marks are links, so a
    // click (or a tap) leads on to the page the card describes.
    const D = JSON.parse(document.getElementById("ch-data").textContent);
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
    const tip = document.createElement("div");
    tip.className = "ch-tip";
    tip.hidden = true;
    document.body.append(tip);
    const place = (e) => {
      const w = tip.offsetWidth, h = tip.offsetHeight;
      let x = e.clientX + 16, y = e.clientY + 16;
      if (x + w > innerWidth - 8) x = Math.max(8, e.clientX - 16 - w);
      if (y + h > innerHeight - 8) y = Math.max(8, e.clientY - 16 - h);
      tip.style.left = `${x}px`;
      tip.style.top = `${y}px`;
    };
    const card = (el, html) => {
      el.addEventListener("pointerenter", (e) => { tip.innerHTML = html(e); tip.hidden = false; place(e); });
      el.addEventListener("pointermove", place);
      el.addEventListener("pointerleave", () => { tip.hidden = true; });
    };
    const signed = (d) => `${d > 0 ? "+" : "−"}${Math.abs(d)}`;

    // the waves: a year's changes
    document.querySelectorAll("[data-wave]").forEach((a) => card(a, () => {
      const y = a.dataset.wave, w = D.waves[y];
      return `<b>${y}</b><span class="ch-tip-sub">${w.down} tightened · ${w.up} eased</span><ul>`
        + w.items.map(([flag, title, d]) => `<li><em class="${d > 0 ? "up" : "down"}">${signed(d)}</em>${flag} ${esc(title)}</li>`).join("")
        + `</ul>${w.more ? `<span class="ch-tip-sub">and ${w.more} more</span>` : ""}<span class="ch-tip-go">Open ${y} in the history →</span>`;
    }));

    // the top fifteen: how each got there
    document.querySelectorAll("[data-top]").forEach((a) => card(a, () => {
      const steps = D.top[a.dataset.top], name = a.closest("li").querySelector("a").textContent;
      return `<b>${esc(name)}</b><span class="ch-tip-sub">Changes since 1961</span><ul>`
        + (steps.length ? steps.slice(0, 6).map(([y, title, b, af]) => `<li><em>${y}</em><span>${esc(title)} <i>${b} → ${af}</i></span></li>`).join("") : "<li>No dated change recorded since 1961</li>")
        + `</ul><span class="ch-tip-go">Open its history →</span>`;
    }));

    // the regions: the year under the pointer
    document.querySelectorAll("[data-region]").forEach((a) => {
      const plot = a.querySelector(".ch-plot"), seek = a.querySelector(".ch-seek"), values = D.regions[a.dataset.region];
      const html = (e) => {
        const box = plot.getBoundingClientRect(), i = Math.round(Math.min(1, Math.max(0, (e.clientX - box.left) / box.width)) * (values.length - 1));
        seek.style.left = `${(i / (values.length - 1)) * 100}%`;
        seek.hidden = false;
        return `<b>${esc(a.dataset.region)} · ${D.regions.from + i}</b><span class="ch-tip-row">Region average<em>${values[i].toFixed(1)}</em></span>`
          + `<span class="ch-tip-row">World average<em>${D.regions.world[i].toFixed(1)}</em></span><span class="ch-tip-go">Rankings for ${esc(a.dataset.region)} →</span>`;
      };
      card(plot, html);
      plot.addEventListener("pointermove", (e) => { tip.innerHTML = html(e); });
      plot.addEventListener("pointerleave", () => { seek.hidden = true; });
    });

    // the first restrictions: the law and the country's score now
    document.querySelectorAll("[data-first]").forEach((a) => card(a, () => {
      const [name, year, title, score, tier] = D.firsts[a.dataset.first];
      return `<b>${esc(name)} · ${year}</b><span>${esc(title)}</span><span class="ch-tip-row">Score today<em>${score} · ${esc(tier)}</em></span><span class="ch-tip-go">Open its history →</span>`;
    }));

    // the law grid: the countries in a cell
    document.querySelectorAll("[data-law]").forEach((a) => card(a, () => {
      const [i, j] = a.dataset.law.split(",").map(Number), list = D.law[i][j];
      return `<b>${esc(D.lawNames.rec[i])} · medical ${esc(D.lawNames.med[j].toLowerCase())}</b><span class="ch-tip-sub">${list.length} countries</span>`
        + `<span class="ch-tip-list">${list.slice(0, 40).map(esc).join(", ")}${list.length > 40 ? ` and ${list.length - 40} more` : ""}</span><span class="ch-tip-go">Recreational law on the map →</span>`;
    }));

    // use and the law: the survey behind a dot
    document.querySelectorAll("[data-use]").forEach((a) => card(a, () => {
      const [name, prev, year, score, tier] = D.use[a.dataset.use];
      return `<b>${esc(name)}</b><span class="ch-tip-row">Used cannabis in the past year<em>${prev}%</em></span>${year ? `<span class="ch-tip-row">Survey<em>${year}</em></span>` : ""}`
        + `<span class="ch-tip-row">Score today<em>${score} · ${esc(tier)}</em></span><span class="ch-tip-go">Open its datasets →</span>`;
    }));

    // the stripes: the country and year under the pointer
    {
      const box = document.querySelector(".ch-stripes .ch-plot"), hit = box.querySelector(".ch-stripes-hit");
      const seek = box.querySelector(".ch-seek"), mark = box.querySelector(".ch-row-mark"), rows = D.stripes.rows;
      const at = (e) => {
        const r = box.getBoundingClientRect();
        const row = Math.min(rows.length - 1, Math.max(0, Math.floor(((e.clientY - r.top) / r.height) * rows.length)));
        const span = rows[0][2].at(-1)[0] - D.stripes.from + 1, years = Math.max(span, new Date().getFullYear() - D.stripes.from + 1);
        const year = D.stripes.from + Math.min(years - 1, Math.max(0, Math.floor(((e.clientX - r.left) / r.width) * years)));
        const [slug, name, steps, banned] = rows[row], score = steps.findLast(([y]) => y <= year)[1];
        const changed = steps.filter(([y]) => y > D.stripes.from).length;
        seek.style.left = `${((year - D.stripes.from + 0.5) / years) * 100}%`;
        mark.style.top = `${(row / rows.length) * 100}%`;
        mark.style.height = `${100 / rows.length}%`;
        seek.hidden = mark.hidden = false;
        hit.href = `${D.base}country/${slug}/#history`;
        return `<b>${esc(name)} · ${year}</b><span class="ch-tip-row">Score that year<em>${score}</em></span><span class="ch-tip-row">Annual snapshots below 15<em>${banned}</em></span>`
          + `<span class="ch-tip-sub">${changed} changes in its score since ${D.stripes.from}</span><span class="ch-tip-go">Open its history →</span>`;
      };
      card(hit, at);
      hit.addEventListener("pointermove", (e) => { tip.innerHTML = at(e); });
      hit.addEventListener("pointerleave", () => { seek.hidden = mark.hidden = true; });
    }

    // the stream: a decade's entries by kind
    document.querySelectorAll("[data-decade]").forEach((a) => card(a, () => {
      const i = +a.dataset.decade, d = D.stream.decades[i];
      const rows = D.stream.groups.map(([label, color], k) => [label, color, D.stream.counts[k][i]]).reverse();
      return `<b>The ${d}s</b>` + rows.map(([label, color, n]) => `<span class="ch-tip-row"><i class="ch-key" style="background:${color}"></i>${esc(label)}<em>${n}</em></span>`).join("")
        + `<span class="ch-tip-go">Read the ${d}s in the history →</span>`;
    }));

    // the ridges: a year's average
    document.querySelectorAll(".ch-ridge-hit").forEach((a) => {
      const g = document.querySelector(`.ch-ridge[data-ridge="${a.dataset.ridge}"]`);
      a.addEventListener("pointerenter", () => g.classList.add("on"));
      a.addEventListener("pointerleave", () => g.classList.remove("on"));
      card(a, () => {
        const [year, avg, at100] = D.ridges[+a.dataset.ridge];
        return `<b>${year}</b><span class="ch-tip-row">Average score<em>${avg}</em></span><span class="ch-tip-row">Countries with no rule yet<em>${at100}</em></span><span class="ch-tip-go">The rankings in ${year} →</span>`;
      });
    });

    // the law and the people
    document.querySelectorAll("[data-moral]").forEach((a) => card(a, () => {
      const [name, ok, notMoral, wrong, score, tier, rec] = D.moral[a.dataset.moral];
      return `<b>${esc(name)}</b><span class="ch-tip-row">Morally acceptable<em>${ok}%</em></span><span class="ch-tip-row">Not a moral issue<em>${notMoral}%</em></span>`
        + `<span class="ch-tip-row">Morally unacceptable<em>${wrong}%</em></span><span class="ch-tip-row">Score today<em>${score} · ${esc(tier)}</em></span><span class="ch-tip-sub">For adults: ${esc(rec)}</span><span class="ch-tip-go">Open its datasets →</span>`;
    }));
    // the price of prohibition
    document.querySelectorAll("[data-price]").forEach((a) => card(a, () => {
      const [name, eur, year, score, tier] = D.price[a.dataset.price];
      return `<b>${esc(name)}</b><span class="ch-tip-row">A gram of herb, ${year}<em>€${eur.toFixed(2)}</em></span><span class="ch-tip-row">Score today<em>${score} · ${esc(tier)}</em></span><span class="ch-tip-go">Open its datasets →</span>`;
    }));
    // who gets punished
    document.querySelectorAll("[data-punish]").forEach((a) => card(a, () => {
      const [name, rate, offences, year, users, prev] = D.punish[a.dataset.punish];
      return `<b>${esc(name)}</b><span class="ch-tip-row">Use or possession offences, ${year}<em>${offences.toLocaleString("en-GB")}</em></span><span class="ch-tip-row">People who use cannabis<em>${users.toLocaleString("en-GB")}</em></span>`
        + `<span class="ch-tip-row">Offences per 1,000 users<em>${rate}</em></span><span class="ch-tip-sub">${prev}% of adults used it in the past year. Cannabis only; not dealing</span><span class="ch-tip-go">Open its datasets →</span>`;
    }));
    // THC for a euro: the line nearest the pointer, a country's or the middle one
    {
      const hit = document.querySelector(".ch-thc-hit"), plot = hit.parentElement;
      const seek = plot.querySelector(".ch-seek"), dot = plot.querySelector(".ch-thc-dot"), median = plot.querySelector(".ch-thc-median");
      const [X0, X1, Y1] = D.thcRange;
      const valueAt = (pts, year) => {
        for (let k = 0; k < pts.length - 1; k++) {
          const [a, va] = pts[k], [b, vb] = pts[k + 1];
          if (year >= a && year <= b) return va + ((vb - va) * (year - a)) / (b - a);
        }
        return pts.length && Math.abs(pts[0][0] - year) < 0.6 ? pts[0][1] : null;
      };
      const medianPts = D.thc.map(([y, mg]) => [y, mg]);
      let lit = null;
      const clear = () => { if (lit) lit.classList.remove("on"); lit = null; median.classList.remove("on"); plot.classList.remove("lit"); };
      const show = (e) => {
        const r = plot.getBoundingClientRect();
        const year = X0 + ((e.clientX - r.left) / r.width) * (X1 - X0), value = (1 - (e.clientY - r.top) / r.height) * Y1;
        let best = null, gap = Math.abs(valueAt(medianPts, year) - value) - 1.5; // the middle line wins a near tie
        for (const [slug, name, pts] of D.thcCountries) {
          const v = valueAt(pts, year);
          if (v != null && Math.abs(Math.min(v, Y1) - value) < gap) { gap = Math.abs(Math.min(v, Y1) - value); best = [slug, name, pts]; }
        }
        clear();
        plot.classList.add("lit");
        const year0 = Math.round(Math.min(X1, Math.max(X0, year)));
