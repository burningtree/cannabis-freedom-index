              style={`left:${pct(p.x, 0, PX1)}%;top:${100 - pct(p.y, 0, PY1)}%;--c:${tierColor(p.x)}`} aria-label={`${p.c.name}: €${p.y} a gram, score ${Math.round(p.x)}`}>
              {priceNamed.has(p.c.id) && <span>{p.c.name}</span>}
            </a>
          ))}
        </div>
        <div class="ch-x">{Array.from({ length: PX1 / 10 + 1 }, (_, i) => i * 10).map((t) => <span class:list={{ first: t === 0, last: t === PX1 }} style={`left:${pct(t, 0, PX1)}%`}>{t}</span>)}</div>
        <p class="ch-axis-label">Cannabis score</p>
