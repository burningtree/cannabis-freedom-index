        <div class="ch-y">{Array.from({ length: PY1 / 5 + 1 }, (_, i) => i * 5).map((t) => <span style={`top:${100 - pct(t, 0, PY1)}%`}>€{t}</span>)}</div>
        <div class="ch-plot ch-plot-short">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {Array.from({ length: PY1 / 5 + 1 }, (_, i) => i * 5).map((t) => <line class="ch-grid" x1="0" x2="100" y1={100 - pct(t, 0, PY1)} y2={100 - pct(t, 0, PY1)} />)}
            <line class="ch-fit" x1="0" x2="100" y1={100 - pct(priceFit.cut, 0, PY1)} y2={100 - pct(priceFit.cut + priceFit.slope * PX1, 0, PY1)} />
