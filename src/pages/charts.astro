  drink: Object.fromEntries(drink.map((d) => [d.c.slug, [d.c.flag + " " + d.c.name, d.x, d.r.year, Math.round(d.y), tierOf(d.y).name]])),
  capacity: Object.fromEntries(capacity.map((d) => [d.c.slug, [d.c.flag + " " + d.c.name, Math.round(d.x), d.y, d.c.use.year ?? null, Math.round(d.c.raw), tierOf(d.c.raw).name]])),
  teen: teen.map((t) => [t.c.slug, t.c.flag + " " + t.c.name, t.pts]),
  teenAvg: teenAvg.map(([y, v]) => [y, +v.toFixed(1)]),
  ribbons: ribbons.map((r) => [FLOW_YEARS[r.col], FLOW_YEARS[r.col + 1], TIER_NAMES[r.a], TIER_NAMES[r.b], r.list.slice(0, 30).map((c) => `${c.flag} ${c.name}`), r.list.length]),
