---
// Charts: the index's data drawn as a handful of charts, each with its finding as a headline, its
// source and a link of its own (/charts/#waves). Everything is worked out at build time and drawn
// as SVG shapes with HTML labels, as in the homepage chart, so the page needs no script to read.
// Every chart leads on: a year to the history, a country to its profile, a region to the rankings,
// a dataset to its map. A small script at the end adds hover cards with the detail behind a mark.
import Base from "../layouts/Base.astro";
import AverageChart from "../components/AverageChart.astro";
import { countries, changes, DATA_SNAPSHOT, REC_LABEL, REC_ORDER, MED_LABEL } from "../lib/countries.js";
import { panelRows, mapRows } from "../lib/exports.js";
import { TIERS, tierColor, tierOf } from "../lib/tiers.js";
import { DATASETS } from "../lib/datasets.js";

const base = import.meta.env.BASE_URL;
const NOW = +DATA_SNAPSHOT;
const byId = new Map(countries.map((c) => [c.id, c]));
const pct = (v, lo, hi) => ((v - lo) / (hi - lo)) * 100;
const num = (n) => n.toLocaleString("en-GB");
const fmt1 = (v) => v.toFixed(1);

// ── 2. The waves of law: recorded changes per year that tightened or eased the law ──
const W0 = 1860;
const waves = Array.from({ length: NOW - W0 + 1 }, (_, i) => ({ year: W0 + i, down: 0, up: 0, items: [] }));
for (const ch of changes) {
  if (!ch.score || ch.estimate || !ch.country || ch.country.territory) continue;
  const year = +String(ch.date).slice(0, 4);
  if (year < W0) continue;
  const d = ch.raw.after - ch.raw.before;
  if (d < 0) waves[year - W0].down++; else if (d > 0) waves[year - W0].up++;
  // for the hover card: the year's changes, the biggest first
  if (d) waves[year - W0].items.push([ch.country.flag, ch.title, Math.round(d)]);
}
for (const w of waves) w.items.sort((a, b) => Math.abs(b[2]) - Math.abs(a[2]));
const waveMax = Math.max(...waves.map((w) => Math.max(w.down, w.up)));
const downs = waves.reduce((a, w) => a + w.down, 0), ups = waves.reduce((a, w) => a + w.up, 0);
const downsBetween = (a, b) => waves.filter((w) => w.year >= a && w.year <= b).reduce((s, w) => s + w.down, 0);
const upsSince = (a) => waves.filter((w) => w.year >= a).reduce((s, w) => s + w.up, 0);
const waveShare = Math.round((downsBetween(1920, 1961) / downs) * 100);
const easeShare = Math.round((upsSince(2000) / ups) * 100);
const WAVE_MARKS = [[1925, "Geneva convention"], [1961, "Single Convention"], [2012, "Colorado, Washington"]];

// scores at the end of a year, by country
const scoreIn = (year) => new Map(panelRows.filter((r) => r.year === year && byId.has(r.id)).map((r) => [r.id, r.score]));

// ── 3. Where today's freest countries stood in 1961 ──
const in1961 = scoreIn(1961);
const TOP = 15;
const freest = [...countries].sort((a, b) => b.raw - a.raw).slice(0, TOP).map((c) => ({ c, then: in1961.get(c.id), now: c.raw,
  // the dated changes that took it there, for the hover card
  steps: changes.filter((ch) => ch.country === c && ch.score && !ch.estimate && +String(ch.date).slice(0, 4) > 1961)
    .map((ch) => [+String(ch.date).slice(0, 4), ch.title, Math.round(ch.raw.before), Math.round(ch.raw.after)]).reverse() }));
const wasBanned = freest.filter((f) => f.then < 15).length; // prohibition or severe prohibition in 1961

// ── 4. Regions over time: the average score of each region's countries, year by year ──
const REGIONS = ["Europe", "North America", "South America", "Africa", "Asia", "Oceania"];
const R0 = 1860;
const yearsR = Array.from({ length: NOW - R0 + 1 }, (_, i) => R0 + i);
const regionRows = new Map(REGIONS.map((r) => [r, yearsR.map(() => ({ sum: 0, n: 0 }))]));
const worldRow = yearsR.map(() => ({ sum: 0, n: 0 }));
for (const r of mapRows) { // from 1800; the published panel starts in 1900
  const c = byId.get(r.id);
  if (!c || r.year < R0) continue;
  const cell = regionRows.get(c.region)?.[r.year - R0];
  if (cell) { cell.sum += r.score; cell.n++; }
  worldRow[r.year - R0].sum += r.score; worldRow[r.year - R0].n++;
}
const linePath = (cells) => cells.map((cell, i) => `${i ? "L" : "M"}${pct(R0 + i, R0, NOW).toFixed(2)},${(100 - cell.sum / cell.n).toFixed(2)}`).join("");
const regions = REGIONS.map((name) => {
  const cells = regionRows.get(name), values = cells.map((x) => x.sum / x.n);
  const low = Math.min(...values), lowYear = R0 + values.indexOf(low), now = values.at(-1);
  return { name, n: countries.filter((c) => c.region === name).length, path: linePath(cells), now, low, lowYear, back: now - low,
    values: values.map((v) => Math.round(v * 10) / 10) };
});
const world = linePath(worldRow);
const bestBack = [...regions].sort((a, b) => b.back - a.back)[0];

// ── 5. General freedom and cannabis freedom ──
const HFI = DATASETS.hfi;
const pairs = countries.filter((c) => c.datasets.hfi).map((c) => ({ c, x: c.datasets.hfi.human, y: c.raw }));
const mean = (a) => a.reduce((s, v) => s + v, 0) / a.length;
const mx = mean(pairs.map((p) => p.x)), my = mean(pairs.map((p) => p.y));
const sxy = pairs.reduce((s, p) => s + (p.x - mx) * (p.y - my), 0), sxx = pairs.reduce((s, p) => s + (p.x - mx) ** 2, 0), syy = pairs.reduce((s, p) => s + (p.y - my) ** 2, 0);
const r = sxy / Math.sqrt(sxx * syy), slope = sxy / sxx, cut = my - slope * mx;
for (const p of pairs) p.res = p.y - (cut + slope * p.x);
const X0 = 3, X1 = 9.5, Y1 = 70; // no country scores above 70
const yOf = (v) => 100 - pct(v, 0, Y1);
// the countries furthest from the line are named, the furthest first, unless a name would land on one already shown
const outliers = new Set();
const shownAt = [];
for (const p of [...pairs].sort((a, b) => Math.abs(b.res) - Math.abs(a.res))) {
  if (outliers.size >= 10) break;
  const x = pct(p.x, X0, X1), y = yOf(p.y);
  if (shownAt.some(([sx, sy]) => Math.abs(sx - x) < 14 && Math.abs(sy - y) < 5)) continue;
  outliers.add(p.c.id);
  shownAt.push([x, y]);
}
const fitLine = [X0, X1].map((x) => [pct(x, X0, X1), yOf(cut + slope * x)]);
const strength = Math.abs(r) < 0.3 ? "only weakly" : Math.abs(r) < 0.7 ? "moderately" : "strongly";

// ── First restrictions: the year each country first limited cannabis, by region ──
// A country's first scored entry is its first rule (changes.yaml starts every place at 100).
// Estimated first bans have no known year and are counted apart.
const B0 = 1850;
const firsts = countries.map((c) => ({ c, ch: changes.findLast((ch) => ch.country === c && ch.score) })).filter((f) => f.ch);
const undated = firsts.filter((f) => f.ch.estimate).length;
const dated = firsts.filter((f) => !f.ch.estimate).map((f) => ({ ...f, year: +String(f.ch.date).slice(0, 4) }));
const banYears = dated.map((f) => f.year).sort((a, b) => a - b);
const quart = (q) => banYears[Math.floor((banYears.length - 1) * q)];
const [banQ1, banMid, banQ3] = [quart(0.25), quart(0.5), quart(0.75)];
// a beeswarm per region: dots side by side in a year's slot, stacked up and down when they would touch
const SLOT = 2.1; // years a dot takes up at full width
const swarms = REGIONS.map((name) => {
  const placed = [];
  for (const f of dated.filter((f) => f.c.region === name).sort((a, b) => a.year - b.year)) {
    const x = Math.max(f.year, B0);
    for (let k = 0; ; k++) {
      const lane = k % 2 ? (k + 1) / 2 : -k / 2;
      if (!placed.some((p) => p.lane === lane && Math.abs(p.x - x) < SLOT)) { placed.push({ ...f, x, lane }); break; }
    }
  }
  const lanes = Math.max(1, ...placed.map((p) => Math.abs(p.lane)));
  return { name, dots: placed, lanes };
});
const earlier = dated.filter((f) => f.year < B0).length;

// ── The world's people by the band they live under today ──
const worldPop = countries.reduce((s, c) => s + c.population, 0);
const peopleBands = TIERS.map((t) => {
  const inBand = countries.filter((c) => tierOf(c.raw) === t).sort((a, b) => b.population - a.population);
  return { t, pop: inBand.reduce((s, c) => s + c.population, 0), n: inBand.length, top: inBand.slice(0, 5) };
});
// 100 squares, each 1% of the world's people, shared out by largest remainder
{
  const exact = peopleBands.map((b) => (b.pop / worldPop) * 100);
  peopleBands.forEach((b, i) => (b.cells = Math.floor(exact[i])));
  const left = 100 - peopleBands.reduce((s, b) => s + b.cells, 0);
  [...peopleBands.keys()].sort((a, b) => (exact[b] % 1) - (exact[a] % 1)).slice(0, left).forEach((i) => peopleBands[i].cells++);
  peopleBands.forEach((b, i) => (b.share = exact[i]));
}
const cells = peopleBands.flatMap((b, i) => Array.from({ length: b.cells }, () => i));
const bannedShare = Math.round(peopleBands.filter((b) => b.t.min < 15).reduce((s, b) => s + b.share, 0));
const billions = (n) => n >= 1e9 ? `${(n / 1e9).toFixed(1)} billion` : `${Math.round(n / 1e6)} million`;

// ── Recreational and medical law, side by side ──
const MED_ORDER = ["yes", "limited", "no"];
const lawGrid = REC_ORDER.map((rec) => MED_ORDER.map((med) => countries.filter((c) => c.rec === rec && c.med === med)));
const lawMax = Math.max(...lawGrid.flat().map((g) => g.length));
const medButBanned = countries.filter((c) => c.med !== "no" && (c.rec === "illegal" || c.rec === "death")).length;
const medAny = countries.filter((c) => c.med !== "no").length;

// ── Cannabis use by band: does a harsher law go with less use? ──
const used = countries.filter((c) => c.use && Number.isFinite(c.use.prevalence) && !c.use.estimate);
const useBands = TIERS.slice().reverse().map((t) => ({ t, dots: used.filter((c) => tierOf(c.raw) === t).sort((a, b) => a.use.prevalence - b.use.prevalence) }))
  .filter((b) => b.dots.length);
const median = (a) => { const s = [...a].sort((x, y) => x - y), m = s.length >> 1; return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2; };
useBands.forEach((b) => (b.median = median(b.dots.map((c) => c.use.prevalence))));
const U1 = Math.ceil(Math.max(...used.map((c) => c.use.prevalence)) / 5) * 5;
const uOf = (v) => 100 - pct(v, 0, U1);
const useTicks = Array.from({ length: U1 / 5 + 1 }, (_, i) => i * 5);
const useLow = useBands.find((b) => b.t.min === 5) ?? useBands[0], useHigh = useBands.at(-1);
// spread each band's dots sideways so they don't hide each other: a small swarm around the column's centre
for (const b of useBands) {
  const placed = [];
  for (const c of b.dots) {
    const y = c.use.prevalence;
    for (let k = 0; ; k++) {
      const lane = k % 2 ? (k + 1) / 2 : -k / 2;
      if (!placed.some((p) => p.lane === lane && Math.abs(p.y - y) < U1 * 0.022)) { placed.push({ c, y, lane }); break; }
    }
  }
  b.placed = placed;
}

// ── Every country, every year: a stripe per country, coloured by its band year by year ──
// Like the warming stripes: one thin row per country, the freest today at the top.
const S0 = 1860;
const stripeYears = NOW - S0 + 1;
const scoresOf = new Map(countries.map((c) => [c.id, new Array(stripeYears).fill(null)]));
for (const row of mapRows) if (row.year >= S0 && scoresOf.has(row.id)) scoresOf.get(row.id)[row.year - S0] = row.score;
const tierIdx = (v) => TIERS.length - 1 - TIERS.findIndex((t) => v >= t.min); // 0 severe … 5 free, as --t0…--t5
const stripes = countries.map((c) => {
  const sc = scoresOf.get(c.id).map((v, i, a) => v ?? a[i - 1] ?? 100);
  // runs of one band, so the SVG needs one shape per run, not per year
  const runs = [];
  sc.forEach((v, i) => { const k = tierIdx(v); if (runs.at(-1)?.k === k) runs.at(-1).n++; else runs.push({ i, n: 1, k }); });
  // the years its score changed, for the hover card: [year, score]
  const steps = sc.map((v, i) => [S0 + i, Math.round(v)]).filter(([, v], i, a) => i === 0 || v !== a[i - 1][1]);
  return { c, runs, steps, banned: sc.filter((v) => v < 15).length };
});
const stripeH = 100 / stripes.length;
const neverFree = stripes.filter((s) => s.banned > 0).length;
const medianBanned = median(stripes.map((s) => s.banned));

// ── How the scores spread: the distribution of country scores, year by year, as a ridgeline ──
const RIDGE_YEARS = [1860, 1900, 1920, 1930, 1940, 1950, 1961, 1975, 1990, 2005, NOW];
const BW = 3.5; // smoothing, in score points
const kde = (vals) => Array.from({ length: 101 }, (_, x) => vals.reduce((s, v) => s + Math.exp(-(((x - v) / BW) ** 2) / 2), 0) / vals.length);
const ridges = RIDGE_YEARS.map((year) => {
  const vals = stripes.map((s) => s.steps.findLast(([y]) => y <= year)?.[1] ?? 100);
  return { year, d: kde(vals), mean: mean(vals), n100: vals.filter((v) => v >= 98).length };
});
const ridgeMax = Math.max(...ridges.flatMap((r) => r.d.slice(0, 96))); // the pile at 100 before any law would flatten the rest
const RIDGE_OVERLAP = 2.4; // a ridge may rise this many rows above its baseline
const ridgeRow = 100 / (RIDGE_YEARS.length - 1 + RIDGE_OVERLAP);
const ridgePath = (r, i) => {
  const base = (i + RIDGE_OVERLAP) * ridgeRow;
  const pts = r.d.map((v, x) => `${x},${(base - Math.min(1, v / ridgeMax) * ridgeRow * RIDGE_OVERLAP).toFixed(2)}`);
  return { area: `M0,${base}L${pts.join("L")}L100,${base}Z`, line: `M${pts.join("L")}`, base };
};
const peak2020 = ridges.at(-1).d.indexOf(Math.max(...ridges.at(-1).d));

// ── What the history is about, decade by decade: a streamgraph of its entries by kind ──
const STREAM = [
  { id: "tightening", label: "Bans and tightening", cats: ["ban", "tightening", "death"], color: "var(--t1)" },
  { id: "enforcement", label: "Enforcement", cats: ["enforcement"], color: "var(--t0)" },
  { id: "easing", label: "Easing and legalisation", cats: ["easing", "legalisation"], color: "var(--t5)" },
  { id: "medical", label: "Medical and hemp", cats: ["medical", "hemp"], color: "var(--t4)" },
  { id: "debate", label: "Debate and culture", cats: ["debate", "culture"], color: "var(--t3)" },
  { id: "law", label: "Treaties and other law", cats: ["international", "other"], color: "var(--muted)" },
];
const D0 = 1860, decades = Array.from({ length: Math.floor(NOW / 10) - D0 / 10 + 1 }, (_, i) => D0 + i * 10);
const streamCounts = STREAM.map((g) => decades.map((d) => changes.filter((ch) => g.cats.includes(ch.category) && !ch.estimate && +String(ch.date).slice(0, 4) >= d && +String(ch.date).slice(0, 4) < d + 10).length));
const decadeTotals = decades.map((_, i) => streamCounts.reduce((s, row) => s + row[i], 0));
const streamMax = Math.max(...decadeTotals);
// centred on the middle line (a "silhouette" stream), each decade at the middle of its span
const sx = (i) => (i / (decades.length - 1)) * 100;
const smooth = (pts) => pts.map(([x, y], i) => {
  if (!i) return `M${x},${y}`;
  const [px, py] = pts[i - 1], mx = (px + x) / 2;
  return `C${mx},${py} ${mx},${y} ${x},${y}`;
}).join("");
const streams = (() => {
  let below = decadeTotals.map((t) => 50 - (t / streamMax) * 48);
  return STREAM.map((g, k) => {
    const top = below.map((b, i) => b + (streamCounts[k][i] / streamMax) * 96);
    const upper = smooth(top.map((y, i) => [sx(i), y.toFixed(2)]));
    const lower = smooth(below.map((y, i) => [sx(i), y.toFixed(2)]).reverse()).replace(/^M/, "L");
    const shape = { ...g, d: upper + lower + "Z", total: streamCounts[k].reduce((a, b) => a + b, 0) };
    below = top;
    return shape;
  });
})();
const peakDecade = decades[decadeTotals.indexOf(streamMax)];
const easeNow = streamCounts[2].at(-1) + streamCounts[3].at(-1), tightNow = streamCounts[0].at(-1) + streamCounts[1].at(-1);

// names beside scatter dots, the most telling first, unless one would land on a name already
// shown: points [{ key, x, y (both in %) }], returns the keys to name
const pickLabels = (points, max = 40) => {
  const shown = [], keys = new Set();
  for (const p of points) {
    if (keys.size >= max) break;
    if (shown.some(([sx2, sy2]) => Math.abs(sx2 - p.x) < 13 && Math.abs(sy2 - p.y) < 5)) continue;
    keys.add(p.key);
    shown.push([p.x, p.y]);
  }
  return keys;
};

// ── The law and the people: what people think of using cannabis (Pew), against the law ──
const PEW = DATASETS.pew_marijuana;
const moral = countries.filter((c) => c.datasets.pew_marijuana).map((c) => {
  const d = c.datasets.pew_marijuana;
  return { c, x: d.acceptable + d.not_moral, y: c.raw, d };
});
const moralY1 = 60;
const acceptedBanned = moral.filter((m) => m.x >= 40 && m.y < 25);
const mostAccepting = [...moral].sort((a, b) => b.x - a.x)[0];
const moralNamed = pickLabels([...moral].sort((a, b) => b.x - a.x).map((m) => ({ key: m.c.id, x: pct(m.x, 0, 80), y: 100 - pct(m.y, 0, moralY1) })));

// ── The price of prohibition: euros per gram of herb in Europe, against the score ──
const PRICES = DATASETS.prices_europe, POTENCY = DATASETS.potency_europe;
const latestSince = (rows, field, since) => rows?.findLast((r) => r[field] != null && r.year >= since);
const priced = countries.map((c) => ({ c, r: latestSince(c.series.prices_europe, "herb_eur", 2018) })).filter((p) => p.r).map((p) => ({ ...p, x: p.c.raw, y: p.r.herb_eur }));
const corr = (pts) => {
  const mx2 = mean(pts.map((p) => p.x)), my2 = mean(pts.map((p) => p.y));
  const sxy2 = pts.reduce((s2, p) => s2 + (p.x - mx2) * (p.y - my2), 0), sxx2 = pts.reduce((s2, p) => s2 + (p.x - mx2) ** 2, 0), syy2 = pts.reduce((s2, p) => s2 + (p.y - my2) ** 2, 0);
  return { r: sxy2 / Math.sqrt(sxx2 * syy2), slope: sxy2 / sxx2, cut: my2 - (sxy2 / sxx2) * mx2 };
};
const priceFit = corr(priced);
const PX1 = Math.ceil(Math.max(...priced.map((p) => p.x)) / 10) * 10, PY1 = Math.ceil(Math.max(...priced.map((p) => p.y)) / 5) * 5;
const priceMedian = (pred) => median(priced.filter(pred).map((p) => p.y));
const priceStrict = priceMedian((p) => p.x < 15), priceMild = priceMedian((p) => p.x >= 15);
const priceNamed = pickLabels([...priced].sort((a, b) => Math.abs(b.y - median(priced.map((q) => q.y))) - Math.abs(a.y - median(priced.map((q) => q.y)))).map((p) => ({ key: p.c.id, x: pct(p.x, 0, PX1), y: 100 - pct(p.y, 0, PY1) })));

// ── Who gets punished: cannabis offences recorded per 1,000 people who use it ──
const OFF = DATASETS.cannabis_offences;
const punished = countries.map((c) => ({ c, r: latestSince(c.series.cannabis_offences, "offences", 2020) }))
  .filter((p) => p.r && c_users(p.c) > 0).map((p) => ({ ...p, rate: (p.r.offences / c_users(p.c)) * 1000 })).sort((a, b) => b.rate - a.rate);
function c_users(c) { return c.use && !c.use.estimate ? c.use.users : 0; }
const punishMax = punished[0].rate;
const punishSpread = Math.round(punished[0].rate / punished.at(-1).rate);

// ── Stronger, cheaper: how much THC a euro buys in Europe, year by year ──
// A gram at p% THC holds p × 10 mg; a euro buys that divided by the price.
const thcYears = [];
for (let y = 2002; y <= NOW; y++) {
  const rows = countries.map((c) => {
    const pr = c.series.prices_europe?.find((r) => r.year === y)?.herb_eur, th = c.series.potency_europe?.find((r) => r.year === y)?.herb_thc;
    return pr && th ? { c, mg: (th * 10) / pr, th, pr } : null;
  }).filter(Boolean);
  if (rows.length >= 5) thcYears.push({ year: y, rows, mg: median(rows.map((r) => r.mg)), th: median(rows.map((r) => r.th)), pr: median(rows.map((r) => r.pr)) });
}
const T0 = thcYears[0].year, T1 = thcYears.at(-1).year;
const MG1 = Math.ceil(Math.max(...thcYears.map((t) => t.mg)) * 1.6 / 10) * 10;
const mgOf = (v) => 100 - pct(Math.min(v, MG1), 0, MG1);
const thcLine = (pts) => pts.map(([x, v], i) => `${i ? "L" : "M"}${pct(x, T0, T1).toFixed(2)},${mgOf(v).toFixed(2)}`).join("");
const thcMedianPath = thcLine(thcYears.map((t) => [t.year, t.mg]));
// a faint line for each country with at least five years of both figures
const thcCountries = [...new Set(thcYears.flatMap((t) => t.rows.map((r) => r.c)))]
  .map((c) => ({ c, pts: thcYears.flatMap((t) => t.rows.filter((r) => r.c === c).map((r) => [t.year, r.mg])) })).filter((x) => x.pts.length >= 5);
const thcFirst = thcYears.slice(0, 3), thcLast = thcYears.slice(-3);
const mgThen = mean(thcFirst.map((t) => t.mg)), mgNow = mean(thcLast.map((t) => t.mg));
const thThen = mean(thcFirst.map((t) => t.th)), thNow = mean(thcLast.map((t) => t.th));
const prThen = mean(thcFirst.map((t) => t.pr)), prNow = mean(thcLast.map((t) => t.pr));
const mgChange = mgNow / mgThen - 1;

// ── Criminalising a crop: countries that grow hemp commercially, and their law on cannabis ──
const HEMP = DATASETS.hemp;
const hempGrowers = countries.map((c) => ({ c, r: latestSince(c.series.hemp, "hemp_ha", 2019) })).filter((h) => h.r?.hemp_ha > 0)
  .map((h) => ({ ...h, ha: h.r.hemp_ha })).sort((a, b) => b.ha - a.ha);
const hempTotal = hempGrowers.reduce((s2, h) => s2 + h.ha, 0);
const hempBanned = hempGrowers.filter((h) => h.c.rec === "illegal" || h.c.rec === "death");
const hempBannedShare = Math.round((hempBanned.reduce((s2, h) => s2 + h.ha, 0) / hempTotal) * 100);
const HA_LOG = [10, 100, 1000, 10000, 100000];
const haOf = (v) => pct(Math.log10(Math.max(v, 10)), 1, Math.log10(Math.max(...hempGrowers.map((h) => h.ha)) * 1.3));

// ── Researching the forbidden plant: cannabis papers a year per million people ──
const PAPERS = DATASETS.research_papers;
const P_YEARS = [NOW - 5, NOW - 1]; // the last five full years
const research = countries.map((c) => {
  const rows = (c.series.research_papers ?? []).filter((r) => r.year >= P_YEARS[0] && r.year <= P_YEARS[1]);
  const per = rows.reduce((s2, r) => s2 + r.papers, 0) / 5 / (c.population / 1e6);
  return { c, per, total: rows.reduce((s2, r) => s2 + r.papers, 0) };
}).filter((r) => r.per > 0 && r.c.population > 1e6);
const resBands = TIERS.slice().reverse().map((t) => ({ t, dots: research.filter((r) => tierOf(r.c.raw) === t).sort((a, b) => a.per - b.per) })).filter((b) => b.dots.length);
resBands.forEach((b) => (b.median = median(b.dots.map((r) => r.per))));
const RL0 = -2, RL1 = Math.ceil(Math.log10(Math.max(...research.map((r) => r.per))));
const rOf = (v) => 100 - pct(Math.log10(Math.max(v, 10 ** RL0)), RL0, RL1);
for (const b of resBands) {
  const placed = [];
  for (const r of b.dots) {
    const y = rOf(r.per);
    for (let k = 0; ; k++) {
      const lane = k % 2 ? (k + 1) / 2 : -k / 2;
      if (!placed.some((q) => q.lane === lane && Math.abs(q.y - y) < 2.2)) { placed.push({ r, y, lane }); break; }
    }
  }
  b.placed = placed;
}
const resLow = resBands[0], resHigh = resBands.at(-1);
const fmtRate = (v) => (v < 0.1 ? v.toFixed(2) : v < 10 ? v.toFixed(1) : String(Math.round(v)));

// ── Easy to get: students who say cannabis is easy to obtain (ESPAD), against the law ──
const ESPAD = DATASETS.espad_availability;
const easy = countries.filter((c) => c.datasets.espad_availability).map((c) => ({ c, x: c.raw, y: c.datasets.espad_availability.easy, d: c.datasets.espad_availability }));
const easyFit = corr(easy);
const EX1 = Math.ceil(Math.max(...easy.map((e) => e.x)) / 10) * 10, EY1 = 50;
const easyStrict = median(easy.filter((e) => e.x < 15).map((e) => e.y)), easyMild = median(easy.filter((e) => e.x >= 15).map((e) => e.y));
const easyTop = [...easy].sort((a, b) => b.y - a.y).slice(0, 3);
const easyNamed = pickLabels([...easy].sort((a, b) => Math.abs(b.y - median(easy.map((q) => q.y))) - Math.abs(a.y - median(easy.map((q) => q.y)))).map((e) => ({ key: e.c.id, x: pct(e.x, 0, EX1), y: 100 - pct(e.y, 0, EY1) })));

// ── What flows beneath: cannabis in city wastewater, against the law ──
const WW = DATASETS.wastewater;
const sewage = countries.map((c) => ({ c, r: latestSince(c.series.wastewater, "thc_cooh", 2020) })).filter((w) => w.r && w.r.thc_cooh > 0)
  .map((w) => ({ ...w, x: w.c.raw, y: w.r.thc_cooh, trend: w.c.series.wastewater.filter((r) => r.year >= 2018).map((r) => [r.year, r.thc_cooh]) }));
const WL0 = 1, WL1 = 3; // 10 to 1,000 mg
const wy = (v) => 100 - pct(Math.log10(Math.max(v, 10 ** WL0)), WL0, WL1);
const WX1 = Math.ceil(Math.max(...sewage.map((w) => w.x)) / 10) * 10;
const sewageFit = corr(sewage.map((w) => ({ x: w.x, y: Math.log10(w.y) })));
const sewageNamed = pickLabels([...sewage].sort((a, b) => b.y - a.y).map((w) => ({ key: w.c.id, x: pct(w.x, 0, WX1), y: wy(w.y) })));
const sewageTop = [...sewage].sort((a, b) => b.y - a.y)[0], sewageLow = [...sewage].sort((a, b) => a.y - b.y)[0];

// ── Canada after legalisation: where people get cannabis, and what governments earn ──
const SOURCING = DATASETS.canada_sourcing, REVENUE = DATASETS.canada_revenue;
const canada = countries.find((c) => c.id === "CA");
const sourcing = canada.series.canada_sourcing ?? [];
const SOURCE_KINDS = [
  { id: "legal", label: "Legal store or website", color: "var(--t5)" },
  { id: "grown", label: "Grew their own", color: "var(--t4)" },
  { id: "social", label: "Friends and family", color: "var(--t3)" },
  { id: "other", label: "Other", color: "var(--muted)" },
  { id: "illegal", label: "Illegal seller", color: "var(--t1)" },
];
const firstOf = (k) => sourcing.find((r) => r[k] != null), lastOf = (k) => sourcing.findLast((r) => r[k] != null);
const revenue = canada.series.canada_revenue ?? [];
const C0 = 2018, C1 = Math.max(sourcing.at(-1)?.year ?? 2024, revenue.at(-1)?.year ?? 2024) + 1;
const cx = (y) => pct(y + 0.5, C0, C1);
const revMax = Math.max(...revenue.map((r) => r.revenue));
const billion = (thousands) => `C$${(thousands / 1e6).toFixed(1)} billion`;

// ── Prohibition and empire: when former colonies first restricted cannabis, beside their rulers ──
const COL = DATASETS.colonial_links;
const firstYearOf = new Map(dated.map((f) => [f.c.id, f.year]));
const rulers = new Map();
for (const c of countries) {
  const codes = (c.datasets.colonial_links?.colonizers ?? "").split(" ").filter(Boolean);
  for (const code of codes) {
    const ruler = countries.find((x) => x.slug === code);
    if (!ruler || !firstYearOf.has(c.id)) continue;
    if (!rulers.has(ruler)) rulers.set(ruler, []);
    rulers.get(ruler).push({ c, year: firstYearOf.get(c.id) });
  }
}
const empires = [...rulers].filter(([r, list]) => list.length >= 5 && firstYearOf.has(r.id))
  .map(([r, list]) => {
    const own = firstYearOf.get(r.id), sorted = list.sort((a, b) => a.year - b.year);
    const placed = [];
    for (const f of sorted) {
      const x = Math.max(f.year, B0);
      for (let k = 0; ; k++) {
        const lane = k % 2 ? (k + 1) / 2 : -k / 2;
        if (!placed.some((p) => p.lane === lane && Math.abs(p.x - x) < SLOT)) { placed.push({ ...f, x, lane }); break; }
      }
    }
    return { r, own, dots: placed, lanes: Math.max(1, ...placed.map((p) => Math.abs(p.lane))), before: list.filter((f) => f.year < own).length, gap: median(list.map((f) => f.year - own)) };
  }).sort((a, b) => b.dots.length - a.dots.length);
const bigEmpire = empires[0];

// "Canada's", "United States'"
const owner = (name) => `${name}${name.endsWith("s") ? "'" : "'s"}`;

// what the hover cards read, in one block
const chartData = {
  base,
  waves: Object.fromEntries(waves.filter((w) => w.items.length).map((w) => [w.year, { down: w.down, up: w.up, items: w.items.slice(0, 6), more: Math.max(0, w.items.length - 6) }])),
  top: Object.fromEntries(freest.map((f) => [f.c.slug, f.steps])),
  regions: { from: R0, world: worldRow.map((x) => Math.round((x.sum / x.n) * 10) / 10), ...Object.fromEntries(regions.map((g) => [g.name, g.values])) },
  firsts: Object.fromEntries(dated.map((f) => [f.c.slug, [f.c.flag + " " + f.c.name, f.year, f.ch.title, Math.round(f.c.raw), tierOf(f.c.raw).name]])),
  people: peopleBands.map((b) => [b.t.name, +b.share.toFixed(1), billions(b.pop), b.n, b.top.map((c) => `${c.flag} ${c.name}`)]),
  law: lawGrid.map((row) => row.map((g) => g.map((c) => c.flag + " " + c.name))),
  lawNames: { rec: REC_ORDER.map((k) => REC_LABEL[k]), med: MED_ORDER.map((k) => MED_LABEL[k]) },
  use: Object.fromEntries(used.map((c) => [c.slug, [c.flag + " " + c.name, c.use.prevalence, c.use.year ?? null, Math.round(c.raw), tierOf(c.raw).name]])),
  stripes: { from: S0, rows: stripes.map((s) => [s.c.slug, s.c.flag + " " + s.c.name, s.steps, s.banned]) },
  ridges: ridges.map((r) => [r.year, +r.mean.toFixed(1), r.n100]),
  stream: { decades, groups: STREAM.map((g) => [g.label, g.color]), counts: streamCounts },
  moral: Object.fromEntries(moral.map((m) => [m.c.slug, [m.c.flag + " " + m.c.name, m.d.acceptable, m.d.not_moral, m.d.unacceptable, Math.round(m.y), tierOf(m.y).name, REC_LABEL[m.c.rec]]])),
  price: Object.fromEntries(priced.map((p) => [p.c.slug, [p.c.flag + " " + p.c.name, p.y, p.r.year, Math.round(p.x), tierOf(p.x).name]])),
  punish: Object.fromEntries(punished.map((p) => [p.c.slug, [p.c.flag + " " + p.c.name, Math.round(p.rate), p.r.offences, p.r.year, p.c.users ?? p.c.use.users, p.c.use.prevalence]])),
  thc: thcYears.map((t) => [t.year, +t.mg.toFixed(1), +t.th.toFixed(1), +t.pr.toFixed(2), t.rows.length]),
  hemp: Object.fromEntries(hempGrowers.map((h) => [h.c.slug, [h.c.flag + " " + h.c.name, h.ha, h.r.year, REC_LABEL[h.c.rec], Math.round(h.c.raw)]])),
  research: Object.fromEntries(research.map((r) => [r.c.slug, [r.c.flag + " " + r.c.name, fmtRate(r.per), r.total, Math.round(r.c.raw), tierOf(r.c.raw).name]])),
  easy: Object.fromEntries(easy.map((e) => [e.c.slug, [e.c.flag + " " + e.c.name, e.d.easy, e.d.easy_boys, e.d.easy_girls, Math.round(e.x), tierOf(e.x).name]])),
  sewage: Object.fromEntries(sewage.map((w) => [w.c.slug, [w.c.flag + " " + w.c.name, w.y, w.r.year, w.r.cities, Math.round(w.x), tierOf(w.x).name, w.trend]])),
  sourcing: sourcing.map((r) => [r.year, ...SOURCE_KINDS.map((k) => r[k.id] ?? null)]),
  sourceLabels: SOURCE_KINDS.map((k) => [k.label, k.color]),
  revenue: revenue.map((r) => [r.fiscal_year, r.revenue, r.net_income, r.federal_excise, r.provincial_excise, r.taxes - r.federal_excise - r.provincial_excise, r.sales]),
  empire: Object.fromEntries(empires.flatMap((e) => e.dots.map((d) => [`${e.r.slug}-${d.c.slug}`, [d.c.flag + " " + d.c.name, d.year, e.r.name, e.own]]))),
  dots: pairs.map((p) => [p.c.flag + " " + p.c.name, +p.x.toFixed(2), Math.round(p.y), tierOf(p.y).name, Math.round(p.res)]),
};

const sections = [
  ["world", "The world since 1860"],
  ["people", "The world's people"],
  ["stripes", "Every country, every year"],
  ["waves", "The waves of law"],
  ["first-bans", "The first restrictions"],
  ["empire", "Prohibition and empire"],
  ["since-1961", "From prohibition to the top"],
  ["regions", "Regions over time"],
  ["spread", "How the scores spread"],
  ["law", "Recreational and medical"],
  ["opinion", "The law and the people"],
  ["easy-to-get", "Easy to get"],
  ["use", "Use and the law"],
  ["wastewater", "What flows beneath"],
  ["punished", "Who gets punished"],
  ["price", "The price of prohibition"],
  ["thc-per-euro", "THC for a euro"],
  ["sourcing", "From friends to shops"],
  ["state-merchant", "The state as merchant"],
  ["freedom", "Freedom and cannabis freedom"],
  ["hemp", "Criminalising a crop"],
  ["research", "Researching the forbidden plant"],
  ["stream", "What the history is about"],
];
// the page in chapters, most telling first: [title, the first chart of the chapter]
const CHAPTERS = [
  ["The world today", "world"],
  ["How prohibition spread", "waves"],
  ["The way back", "since-1961"],
  ["The law and daily life", "law"],
  ["Prohibition and the market", "punished"],
  ["One country after legalisation: Canada", "sourcing"],
  ["Freedom, crops and science", "freedom"],
];
const chapters = CHAPTERS.map(([title, from], i) => {
  const start = sections.findIndex(([id]) => id === from), end = i + 1 < CHAPTERS.length ? sections.findIndex(([id]) => id === CHAPTERS[i + 1][1]) : sections.length;
  return { title, from, items: sections.slice(start, end).map(([id, name]) => ({ id, name, n: sections.findIndex(([x]) => x === id) + 1 })) };
});
const chapterAt = new Map(chapters.map((c) => [c.from, c.title]));
// a chart's number and name for its kicker: "03 · The first restrictions"
const kick = (id) => { const i = sections.findIndex(([x]) => x === id); return `${String(i + 1).padStart(2, "0")} · ${sections[i][1]}`; };
---
<Base title="Charts" description="The Cannabis Freedom Index in charts: how prohibition spread after 1860, the waves of law, when each country first restricted cannabis, which countries changed most since 1961, the regions, the world's people by band, recreational and medical law, use and the law, and how cannabis freedom relates to freedom in general.">
  <main class="changes-page charts-page">
    <section class="hero hero-sm">
      <p class="eyebrow">Charts</p>
      <h1>Cannabis (un)freedom in charts</h1>
      <p class="lede">The index's scores and history, drawn. Every chart is rebuilt from the same files as the rest of the site, so it changes when a law does. Each has a link of its own.</p>
    </section>
    <nav class="ch-toc" aria-label="Charts on this page">
      {chapters.map((ch) => (
        <div class="ch-toc-group">
          <p>{ch.title}</p>
          {ch.items.map((x) => <a href={`#${x.id}`}><b>{String(x.n).padStart(2, "0")}</b>{x.name}</a>)}
        </div>
      ))}
    </nav>

    {chapterAt.has("world") && <h2 class="ch-chapter">{chapterAt.get("world")}</h2>}
    <section class="ch" id="world">
      <p class="ch-kicker"><a href="#world">{kick("world")}</a></p>
      <h2>Prohibition spread in under a century, and has barely receded</h2>
      <p class="ch-dek">The coloured bands are the share of countries in each band of the index, year by year; the line is the world average score on the same 0–100 scale. Switch to population to see the share of the world's people.</p>
      <AverageChart note wide figures={false} />
      <p class="ch-more"><span>Click a year to read it in the history.</span> <a href={`${base}map/`}>Play the years on the map →</a> <a href={`${base}?year=1961#rankings`}>The rankings as they stood in 1961 →</a></p>
    </section>

    {chapterAt.has("people") && <h2 class="ch-chapter">{chapterAt.get("people")}</h2>}
    <section class="ch" id="people">
      <p class="ch-kicker"><a href="#people">{kick("people")}</a></p>
      <h2>{bannedShare} in every 100 people live under prohibition or worse</h2>
      <p class="ch-dek">The world's {billions(worldPop)} people as 100 squares, each one per cent, coloured by the band their country is in today.</p>
      <div class="ch-people">
        <div class="ch-waffle" role="img" aria-label={peopleBands.filter((b) => b.cells).map((b) => `${b.t.name} ${b.share.toFixed(0)}%`).join(", ")}>
          {cells.map((k) => <a href={`${base}map/`} data-people={k} style={`--c:${tierColor(peopleBands[k].t.min)}`} aria-hidden="true" tabindex="-1"></a>)}
        </div>
        <ol class="ch-people-list">
          {peopleBands.map((b, k) => b.n > 0 && (
            <li data-people={k}>
              <i style={`background:${tierColor(b.t.min)}`}></i>
              <span><b>{b.t.name}</b><small>{b.n} countries{b.top.length ? ` · ${b.top.slice(0, 3).map((c) => c.name).join(", ")}` : ""}</small></span>
              <em>{b.share < 1 && b.share > 0 ? "<1" : Math.round(b.share)}%</em>
            </li>
          ))}
        </ol>
      </div>
      <p class="ch-source">Populations from the <a href={`${base}sources/#dataset-population`}>population dataset</a>, latest year; recognised countries only.</p>
      <p class="ch-more"><a href={`${base}map/`}>The bands on the map →</a> <a href={`${base}map/users/`}>Where the users are →</a></p>
    </section>

    {chapterAt.has("stripes") && <h2 class="ch-chapter">{chapterAt.get("stripes")}</h2>}
    <section class="ch" id="stripes">
      <p class="ch-kicker"><a href="#stripes">{kick("stripes")}</a></p>
      <h2>Since {S0}, the typical country has spent an estimated {Math.round(medianBanned)} years under cannabis prohibition</h2>
      <p class="ch-dek">One thin stripe for each of the {countries.length} countries, one year at a time from {S0}, coloured by its band. The freest countries today are at the top. {neverFree} fall below 15 points in at least one snapshot. Counts include both endpoints, {S0} and {NOW}, and both prohibition bands.</p>
      <div class="ch-frame ch-stripes" data-no-preview>
        <div class="ch-plot">
          <svg viewBox={`0 0 ${stripeYears} 100`} preserveAspectRatio="none" aria-hidden="true" shape-rendering="crispEdges">
            {stripes.map((s, r) => s.runs.map((run) => <rect x={run.i} width={run.n} y={(r * stripeH).toFixed(3)} height={stripeH.toFixed(3)} style={`fill:var(--t${run.k})`} />))}
          </svg>
          {[1925, 1961].map((y) => <span class="ch-vline strong" style={`left:${pct(y + 0.5, S0, NOW + 1)}%`}><b>{y}</b></span>)}
          <span class="ch-seek" hidden></span>
          <span class="ch-row-mark" hidden></span>
          <a class="ch-stripes-hit" href={`${base}#rankings`} aria-label="Open the country under the pointer"></a>
        </div>
        <div class="ch-x">{[1875, 1900, 1925, 1950, 1975, 2000, 2025].filter((y) => y <= NOW).map((y) => <span class:list={{ last: y > NOW - 5 }} style={`left:${pct(y + 0.5, S0, NOW + 1)}%`}>{y}</span>)}</div>
        <div class="ch-stripes-ends" aria-hidden="true"><span>↑ freest today</span><span>strictest today ↓</span></div>
      </div>
      <p class="ch-source">Each country's score at the end of each year, rebuilt from its history, as in the <a href={`${base}data/#panel`}>yearly data</a>. These are reconstructed scores, including estimated dates and assumed baselines. Madagascar’s early line carries a <a href={`${base}history/madagascar-merina-ban-1787/`}>regional royal smoking ban</a> across the modern country; its continuous nationwide duration is unresolved. Hover a stripe for its country and year; click it for the country's history.</p>
      <p class="ch-more"><a href={`${base}map/`}>Play the years on the map →</a> <a href={`${base}data/#panel`}>Download the yearly scores →</a></p>
    </section>

    {chapterAt.has("waves") && <h2 class="ch-chapter">{chapterAt.get("waves")}</h2>}
    <section class="ch" id="waves">
      <p class="ch-kicker"><a href="#waves">{kick("waves")}</a></p>
      <h2>{waveShare}% of the tightenings came between 1920 and 1961; {easeShare}% of the easings since 2000</h2>
      <p class="ch-dek">Each bar is one year: below the line, recorded changes that made the law harsher; above it, those that eased it. {num(downs)} tightenings and {num(ups)} easings since {W0}.</p>
      <div class="ch-frame ch-waves">
        <div class="ch-plot">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <line class="ch-axis" x1="0" x2="100" y1="50" y2="50" />
            {waves.map((w) => {
              const x = pct(w.year, W0, NOW + 1), bw = 100 / (NOW - W0 + 1) * 0.72;
              return <>
                {w.up > 0 && <rect x={x} width={bw} y={50 - (w.up / waveMax) * 48} height={(w.up / waveMax) * 48} class="ch-up"><title>{w.year}: {w.up} eased</title></rect>}
                {w.down > 0 && <rect x={x} width={bw} y="50" height={(w.down / waveMax) * 48} class="ch-down"><title>{w.year}: {w.down} tightened</title></rect>}
              </>;
            })}
          </svg>
          <span class="ch-side ch-side-up">Eased</span>
          <span class="ch-side ch-side-down">Tightened</span>
          <div class="ch-hits">
            {waves.map((w) => (w.down || w.up) ? (
              <a href={`${base}history/?from=${w.year}`} data-wave={w.year} style={`left:${pct(w.year, W0, NOW + 1)}%;width:${100 / (NOW - W0 + 1)}%`}
                aria-label={`${w.year}: ${w.down} tightened, ${w.up} eased. Open ${w.year} in the history`}></a>
            ) : null)}
          </div>
          {WAVE_MARKS.map(([y, label]) => <span class:list={["ch-mark", { end: y > 2000 }]} style={`left:${pct(y + 0.4, W0, NOW + 1)}%`}><b>{y}</b> <span>{label}</span></span>)}
        </div>
        <div class="ch-x">{[1880, 1900, 1920, 1940, 1960, 1980, 2000, 2020].map((y) => <span style={`left:${pct(y, W0, NOW + 1)}%`}>{y}</span>)}</div>
      </div>
      <p class="ch-source">From the {num(downs + ups)} dated, scored entries in the <a href={`${base}history/`}>history</a>; estimated first bans are left out. Click a year to read its changes.</p>
      <p class="ch-more"><a href={`${base}history/kind/ban/`}>Every ban →</a> <a href={`${base}history/kind/legalisation/`}>Every legalisation →</a> <a href={`${base}history/period/1930s/`}>The 1930s →</a></p>
    </section>

    {chapterAt.has("first-bans") && <h2 class="ch-chapter">{chapterAt.get("first-bans")}</h2>}
    <section class="ch" id="first-bans">
      <p class="ch-kicker"><a href="#first-bans">{kick("first-bans")}</a></p>
      <h2>Half the world's countries first restricted cannabis between {banQ1} and {banQ3}</h2>
      <p class="ch-dek">Each dot is a country, placed at the year of its first recorded rule on cannabis and coloured by its score today. The middle year is {banMid}. Some came under a colonial power's law before they were countries.</p>
      <div class="ch-frame ch-swarm" data-no-preview>
        {swarms.map((g) => (
          <div class="ch-swarm-row" style={`--lanes:${g.lanes}`}>
            <span class="ch-swarm-name">{g.name}</span>
            <div class="ch-plot">
              {[1900, 1925, 1961, 2000].map((y) => <span class="ch-vline" style={`left:${pct(y, B0, NOW)}%`}></span>)}
              {g.dots.map((d) => (
                <a class="ch-dot" href={`${base}country/${d.c.slug}/#history`} data-first={d.c.slug}
                  style={`left:${pct(d.x, B0, NOW)}%;top:calc(50% + ${d.lane} * var(--lane));--c:${tierColor(d.c.raw)}`}
                  aria-label={`${d.c.name}: first restricted cannabis in ${d.year}`}></a>
              ))}
            </div>
          </div>
        ))}
        <div class="ch-swarm-row ch-swarm-axis"><span></span><div class="ch-x">{[1875, 1900, 1925, 1950, 1975, 2000].map((y) => <span style={`left:${pct(y, B0, NOW)}%`}>{y}</span>)}</div></div>
      </div>
      <p class="ch-source">The first scored entry of each country in the <a href={`${base}history/`}>history</a>; {earlier} older ones are drawn at {B0}, and {undated} countries with no known date are left out. Hover a dot for the law; click it for the country's history.</p>
      <p class="ch-more"><a href={`${base}history/kind/ban/`}>Every first ban and ban →</a> <a href={`${base}history/period/1920s/`}>The 1920s →</a> <a href={`${base}history/period/1960s/`}>The 1960s →</a></p>
    </section>

    {chapterAt.has("empire") && <h2 class="ch-chapter">{chapterAt.get("empire")}</h2>}
    <section class="ch" id="empire">
      <p class="ch-kicker"><a href="#empire">{kick("empire")}</a></p>
      <h2>{bigEmpire.before} of the {bigEmpire.dots.length} former colonies of the {bigEmpire.r.name} had a rule on cannabis before it made one at home</h2>
      <p class="ch-dek">For each former colonial power, a row of its former colonies, each placed at the year of its first recorded rule on cannabis and coloured by its score today; the black line is the year the ruler first restricted cannabis at home. Many of these first rules were the ruler's own law, made for the colony, and stayed on the books after independence.</p>
      <div class="ch-frame ch-swarm ch-empire" data-no-preview>
        {empires.map((e) => (
          <div class="ch-swarm-row" style={`--lanes:${e.lanes}`}>
            <span class="ch-swarm-name">{e.r.name}<small>{e.dots.length} colonies · {e.before} before it</small></span>
            <div class="ch-plot">
              <span class="ch-ruler" style={`left:${pct(e.own, B0, NOW)}%`}><b>{e.own}</b></span>
              {e.dots.map((d) => (
                <a class="ch-dot" href={`${base}country/${d.c.slug}/#history`} data-empire={`${e.r.slug}-${d.c.slug}`}
                  style={`left:${pct(d.x, B0, NOW)}%;top:calc(50% + ${d.lane} * var(--lane));--c:${tierColor(d.c.raw)}`}
                  aria-label={`${d.c.name}: first restricted cannabis in ${d.year}; ${e.r.name} in ${e.own}`}></a>
              ))}
            </div>
          </div>
        ))}
        <div class="ch-swarm-row ch-swarm-axis"><span></span><div class="ch-x">{[1875, 1900, 1925, 1950, 1975, 2000].map((y) => <span style={`left:${pct(y, B0, NOW)}%`}>{y}</span>)}</div></div>
      </div>
      <p class="ch-source">Colonial rulers from {COL.title}; first restrictions from the <a href={`${base}history/`}>history</a>, as in chart {kick("first-bans").slice(0, 2)}. Powers with at least five former colonies with a dated first rule. A country ruled by two powers appears in both rows. <a href={`${base}sources/#dataset-colonial_links`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}history/tag/colonial/`}>Colonial law in the history →</a> <a href={`${base}history/kind/ban/`}>Every first ban →</a></p>
    </section>

    {chapterAt.has("since-1961") && <h2 class="ch-chapter">{chapterAt.get("since-1961")}</h2>}
    <section class="ch" id="since-1961">
      <p class="ch-kicker"><a href="#since-1961">{kick("since-1961")}</a></p>
      <h2>{wasBanned} of today's {TOP} freest countries were under prohibition in 1961</h2>
      <p class="ch-dek">For each of the {TOP} countries with the highest score today: the grey dot is its score at the end of 1961, the year the UN Single Convention asked every country to ban cannabis; the arrow runs to its score now.</p>
      <div class="ch-dumbbell">
        <div class="ch-db-axis" aria-hidden="true"><span></span><div>{[0, 20, 40, 60, 80, 100].map((t) => <span style={`left:${t}%`}>{t}</span>)}</div><span></span></div>
        <ol>
          {freest.map((f) => {
            const lo = Math.min(f.then, f.now), hi = Math.max(f.then, f.now), up = f.now >= f.then;
            return (
              <li>
                <a href={`${base}country/${f.c.slug}/`}>{f.c.flag} {f.c.name}</a>
                <a class="ch-db-track" data-no-preview href={`${base}country/${f.c.slug}/#history`} data-top={f.c.slug} aria-label={`${f.c.name}: ${Math.round(f.then)} in 1961, ${Math.round(f.now)} today. Open its history`}>
                  {[20, 40, 60, 80].map((t) => <i class="ch-db-grid" style={`left:${t}%`}></i>)}
                  <span class:list={["ch-db-bar", { down: !up }]} style={`left:${lo}%;width:${hi - lo}%`}></span>
                  <span class="ch-db-then" style={`left:${f.then}%`}></span>
                  <span class="ch-db-now" style={`left:${f.now}%;--c:${tierColor(f.now)}`}></span>
                </a>
                <span class="ch-db-num">{f.then >= 98 ? <em>no law</em> : Math.round(f.then)} → <b>{Math.round(f.now)}</b></span>
              </li>
            );
          })}
        </ol>
      </div>
      <p class="ch-source">Scores at the end of each year, rebuilt from each country's history, as in the <a href={`${base}data/#panel`}>yearly data</a>. A score of 100 means no rule on cannabis had been recorded yet. Hover a row for the changes since 1961; click it for the country's history.</p>
      <p class="ch-more"><a href={`${base}#rankings`}>All rankings →</a> <a href={`${base}compare/`}>Compare countries →</a></p>
    </section>

    {chapterAt.has("regions") && <h2 class="ch-chapter">{chapterAt.get("regions")}</h2>}
    <section class="ch" id="regions">
      <p class="ch-kicker"><a href="#regions">{kick("regions")}</a></p>
      <h2>Every region fell to prohibition; {bestBack.name} has come furthest back</h2>
      <p class="ch-dek">The average score of each region's countries since 1860, with the world average in grey behind it.</p>
      <div class="ch-regions">
        {regions.map((g) => (
          <a class="ch-region" href={`${base}?region=${encodeURIComponent(g.name)}#rankings`} data-region={g.name}>
            <div class="ch-cap"><b>{g.name} <i aria-hidden="true">→</i></b><span><em style={`color:${tierColor(g.now)}`}>{fmt1(g.now)}</em> today · low of {fmt1(g.low)} in {g.lowYear}</span></div>
            <div class="ch-plot">
              <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                {[0, 50, 100].map((t) => <line class="ch-grid" x1="0" x2="100" y1={100 - t} y2={100 - t} />)}
                <path class="ch-world" d={world} />
                <path class="ch-region-line" d={g.path} />
              </svg>
              <span class="ch-seek" hidden></span>
            </div>
            <div class="ch-x">{[1900, 1960, 2020].map((y) => <span style={`left:${pct(y, R0, NOW)}%`}>{y}</span>)}</div>
          </a>
        ))}
      </div>
      <p class="ch-source">Each country counts the same; click a region for its rankings. {regions.map((g) => `${g.name} ${g.n}`).join(", ")} countries.</p>
    </section>

    {chapterAt.has("spread") && <h2 class="ch-chapter">{chapterAt.get("spread")}</h2>}
    <section class="ch" id="spread">
      <p class="ch-kicker"><a href="#spread">{kick("spread")}</a></p>
      <h2>A world that started at 100 now piles up near {peak2020}</h2>
      <p class="ch-dek">How the {countries.length} countries' scores were spread out in each year: the higher the ridge, the more countries had that score. In {RIDGE_YEARS[0]} almost every country sat at 100, with no rule on cannabis; by {RIDGE_YEARS[6]} the mass had moved to the left. The small rise on the right since is the reforms.</p>
      <div class="ch-frame ch-ridges" data-no-preview>
        <svg class="ch-ridge-defs" aria-hidden="true" width="0" height="0">
          <defs>
            <linearGradient id="ridgeFill" x1="0" x2="1" y1="0" y2="0">
              <stop offset="0" style="stop-color:var(--t0)" /><stop offset=".05" style="stop-color:var(--t1)" /><stop offset=".15" style="stop-color:var(--t2)" />
              <stop offset=".25" style="stop-color:var(--t3)" /><stop offset=".4" style="stop-color:var(--t4)" /><stop offset=".6" style="stop-color:var(--t5)" /><stop offset="1" style="stop-color:var(--t5)" />
            </linearGradient>
          </defs>
        </svg>
        <div class="ch-ridge-wrap">
          <div class="ch-ridge-years" aria-hidden="true">{ridges.map((r, i) => <span style={`top:${(i + RIDGE_OVERLAP) * ridgeRow}%`}>{r.year}</span>)}</div>
          <div class="ch-plot">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              {[0, 25, 50, 75, 100].map((t) => <line class="ch-grid" x1={t} x2={t} y1="0" y2="100" />)}
              {ridges.map((r, i) => { const p = ridgePath(r, i); return <g class="ch-ridge" data-ridge={i}><path class="ch-ridge-area" d={p.area} /><path class="ch-ridge-line" d={p.line} /></g>; })}
            </svg>
            {ridges.map((r, i) => (
              <a class="ch-ridge-hit" href={`${base}?year=${r.year}#rankings`} data-ridge={i} style={`top:${(i + RIDGE_OVERLAP - 1) * ridgeRow}%;height:${ridgeRow}%`} aria-label={`${r.year}: average ${r.mean.toFixed(1)}. Open the rankings of ${r.year}`}></a>
            ))}
          </div>
        </div>
        <div class="ch-ridge-x"><span></span><div class="ch-x">{[0, 25, 50, 75, 100].map((t) => <span class:list={{ first: t === 0, last: t === 100 }} style={`left:${t}%`}>{t}</span>)}</div></div>
        <p class="ch-axis-label">Score</p>
      </div>
      <p class="ch-source">Each country's score at the end of the year, smoothed over about {BW} points. Hover a year for its average; click it for the rankings as they stood then.</p>
      <p class="ch-more"><a href={`${base}?year=1961#rankings`}>The rankings in 1961 →</a> <a href={`${base}about/`}>How the score is made →</a></p>
    </section>

    {chapterAt.has("law") && <h2 class="ch-chapter">{chapterAt.get("law")}</h2>}
    <section class="ch" id="law">
      <p class="ch-kicker"><a href="#law">{kick("law")}</a></p>
      <h2>{medButBanned} of the {medAny} countries with medical cannabis still ban it for everyone else</h2>
      <p class="ch-dek">Every country in one grid: down, what the law says about adults using cannabis; across, what it says about medical use. The larger the circle, the more countries.</p>
      <div class="ch-frame ch-law" data-no-preview>
        <div class="ch-law-head"><span></span>{MED_ORDER.map((m) => <span>Medical: {MED_LABEL[m]}</span>)}</div>
        {REC_ORDER.map((rec, i) => (
          <div class="ch-law-row">
            <span class="ch-law-name">{REC_LABEL[rec]}</span>
            {MED_ORDER.map((med, j) => {
              const n = lawGrid[i][j].length;
              return n ? (
                <a class="ch-law-cell" href={`${base}map/recreational/`} data-law={`${i},${j}`} aria-label={`${REC_LABEL[rec]} for adults, medical ${MED_LABEL[med].toLowerCase()}: ${n} countries`}>
                  <i style={`--d:${Math.sqrt(n / lawMax)};--c:var(--rec-${rec})`}></i><b>{n}</b>
                </a>
              ) : <span class="ch-law-cell empty">–</span>;
            })}
          </div>
        ))}
      </div>
      <p class="ch-source">The recreational and medical status of each country's profile. Hover a circle for its countries.</p>
      <p class="ch-more"><a href={`${base}map/recreational/`}>Recreational law on the map →</a> <a href={`${base}map/medical/`}>Medical law on the map →</a></p>
    </section>

    {chapterAt.has("opinion") && <h2 class="ch-chapter">{chapterAt.get("opinion")}</h2>}
    <section class="ch" id="opinion">
      <p class="ch-kicker"><a href="#opinion">{kick("opinion")}</a></p>
      <h2>In {mostAccepting.c.name}, {mostAccepting.x}% don't call using cannabis immoral; {acceptedBanned.length ? `in ${acceptedBanned.length} more countries at least 40% don't, yet the law stays strict` : "the law follows opinion only loosely"}</h2>
      <p class="ch-dek">Each dot is one of the {moral.length} countries in a 2025 Pew survey: across, the share of adults who say using marijuana is morally acceptable or not a moral issue; up, its cannabis score. Top right, the law and opinion are both relaxed; bottom right, people have moved on and the law has not.</p>
      <div class="ch-frame ch-scatter ch-opinion" data-no-preview>
        <div class="ch-y">{[0, 20, 40, 60].map((t) => <span style={`top:${100 - pct(t, 0, moralY1)}%`}>{t}</span>)}</div>
        <div class="ch-plot">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <rect class="ch-quad" x={pct(40, 0, 80)} y={100 - pct(25, 0, moralY1)} width={100 - pct(40, 0, 80)} height={pct(25, 0, moralY1)} />
            {[0, 20, 40, 60].map((t) => <line class="ch-grid" x1="0" x2="100" y1={100 - pct(t, 0, moralY1)} y2={100 - pct(t, 0, moralY1)} />)}
          </svg>
          <span class="ch-quad-label" style={`left:${pct(40, 0, 80)}%;top:${100 - pct(25, 0, moralY1)}%`}>Accepted, still restricted</span>
          {moral.map((m) => (
            <a class:list={["ch-dot", { named: moralNamed.has(m.c.id), left: m.x > 55 }]} href={`${base}country/${m.c.slug}/#datasets`} data-moral={m.c.slug}
              style={`left:${pct(m.x, 0, 80)}%;top:${100 - pct(m.y, 0, moralY1)}%;--c:${tierColor(m.y)}`} aria-label={`${m.c.name}: ${m.x}% accepting, score ${Math.round(m.y)}`}>
              {moralNamed.has(m.c.id) && <span>{m.c.name}</span>}
            </a>
          ))}
        </div>
        <div class="ch-x">{[0, 20, 40, 60, 80].map((t) => <span class:list={{ first: t === 0, last: t === 80 }} style={`left:${pct(t, 0, 80)}%`}>{t}%</span>)}</div>
        <p class="ch-axis-label">Say using marijuana is acceptable or not a moral issue</p>
      </div>
      <p class="ch-source">{PEW.title}; {PEW.when}. <a href={`${base}sources/#dataset-pew_marijuana`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}map/marijuana-morality/`}>The survey on the map →</a> <a href={`${base}survey/`}>Our own survey →</a></p>
    </section>

    {chapterAt.has("easy-to-get") && <h2 class="ch-chapter">{chapterAt.get("easy-to-get")}</h2>}
    <section class="ch" id="easy-to-get">
      <p class="ch-kicker"><a href="#easy-to-get">{kick("easy-to-get")}</a></p>
      <h2>{easyStrict >= easyMild * 0.85 ? "Prohibition does not keep cannabis out of reach" : "Where the law is harsher, cannabis is harder to get"}: {fmt1(easyStrict)}% of 15–16-year-olds call it easy to get under prohibition, {fmt1(easyMild)}% elsewhere</h2>
      <p class="ch-dek">Each dot is a European country in the 2024 ESPAD school survey: across, its cannabis score; up, the share of students aged 15 to 16 who say cannabis would be fairly or very easy to get. {easyTop.map((e) => e.c.name).join(", ")} top the list at about {Math.round(easyTop[0].y)}%, under laws that differ.</p>
      <div class="ch-frame ch-scatter" data-no-preview>
        <div class="ch-y">{[0, 10, 20, 30, 40, 50].map((t) => <span style={`top:${100 - pct(t, 0, EY1)}%`}>{t}%</span>)}</div>
        <div class="ch-plot ch-plot-short">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {[0, 10, 20, 30, 40, 50].map((t) => <line class="ch-grid" x1="0" x2="100" y1={100 - pct(t, 0, EY1)} y2={100 - pct(t, 0, EY1)} />)}
            <line class="ch-fit" x1="0" x2="100" y1={100 - pct(easyFit.cut, 0, EY1)} y2={100 - pct(easyFit.cut + easyFit.slope * EX1, 0, EY1)} />
          </svg>
          {easy.map((e) => (
            <a class:list={["ch-dot", { named: easyNamed.has(e.c.id), left: e.x > EX1 * 0.75 }]} href={`${base}country/${e.c.slug}/#datasets`} data-easy={e.c.slug}
              style={`left:${pct(e.x, 0, EX1)}%;top:${100 - pct(e.y, 0, EY1)}%;--c:${tierColor(e.x)}`} aria-label={`${e.c.name}: ${e.y}% say easy to get, score ${Math.round(e.x)}`}>
              {easyNamed.has(e.c.id) && <span>{e.c.name}</span>}
            </a>
          ))}
        </div>
        <div class="ch-x">{Array.from({ length: EX1 / 10 + 1 }, (_, i) => i * 10).map((t) => <span class:list={{ first: t === 0, last: t === EX1 }} style={`left:${pct(t, 0, EX1)}%`}>{t}</span>)}</div>
        <p class="ch-axis-label">Cannabis score</p>
      </div>
      <p class="ch-source">{ESPAD.title}; {easy.length} countries; r = {easyFit.r.toFixed(2)}. <a href={`${base}sources/#dataset-espad_availability`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}map/easy-to-get/`}>Easy to get, on the map →</a> <a href={`${base}history/tag/youth/`}>Young people in the history →</a></p>
    </section>

    {chapterAt.has("use") && <h2 class="ch-chapter">{chapterAt.get("use")}</h2>}
    <section class="ch" id="use">
      <p class="ch-kicker"><a href="#use">{kick("use")}</a></p>
      <h2>Where the law is milder, more people say they use cannabis: {fmt1(useHigh.median)}% against {fmt1(useLow.median)}%</h2>
      <p class="ch-dek">Each dot is a country, in the column of its band, at the share of adults who used cannabis in the past year. The bar is each band's middle value. Countries often eased the law where use was already common, and use is more readily admitted where it is legal, so this shows no cause.</p>
      <div class="ch-frame ch-use" data-no-preview>
        <div class="ch-y">{useTicks.map((t) => <span style={`top:${uOf(t)}%`}>{t}%</span>)}</div>
        <div class="ch-plot">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {useTicks.map((t) => <line class="ch-grid" x1="0" x2="100" y1={uOf(t)} y2={uOf(t)} />)}
          </svg>
          {useBands.map((b, i) => {
            const cx = ((i + 0.5) / useBands.length) * 100;
            return <>
              <span class="ch-median" style={`left:${cx}%;top:${uOf(b.median)}%`}><b>{fmt1(b.median)}%</b></span>
              {b.placed.map((p) => (
                <a class="ch-dot" href={`${base}country/${p.c.slug}/#datasets`} data-use={p.c.slug}
                  style={`left:calc(${cx}% + ${p.lane} * var(--lane));top:${uOf(p.y)}%;--c:${tierColor(b.t.min)}`}
                  aria-label={`${p.c.name}: ${p.y}% of adults used cannabis in the past year`}></a>
              ))}
            </>;
          })}
        </div>
        <div class="ch-use-x">{useBands.map((b) => <span><b>{b.t.name}</b><small>{b.dots.length} countries</small></span>)}</div>
      </div>
      <p class="ch-source">Past-year use among adults from the <a href={`${base}sources/#dataset-cannabis_use`}>UNODC</a>, the latest survey of each country; {used.length} countries with a survey, estimates left out.</p>
      <p class="ch-more"><a href={`${base}map/share-of-adults/`}>Use on the map →</a> <a href={`${base}map/youth-cannabis-use/`}>Use among young people →</a></p>
    </section>

    {chapterAt.has("wastewater") && <h2 class="ch-chapter">{chapterAt.get("wastewater")}</h2>}
    <section class="ch" id="wastewater">
      <p class="ch-kicker"><a href="#wastewater">{kick("wastewater")}</a></p>
      <h2>Sewage tells what surveys don't: {owner(sewageTop.c.name)} cities flush out {Math.round(sewageTop.y / sewageLow.y)} times as much cannabis as {owner(sewageLow.c.name)}</h2>
      <p class="ch-dek">Each dot is a country: across, its cannabis score; up, THC-COOH, the substance the body makes from cannabis, measured in city sewage for a week, in milligrams a day per 1,000 people, latest year since 2020. The scale rises tenfold at each line. It measures what is used, not what people admit, though not how many use it; one city may stand for a whole country.</p>
      <div class="ch-frame ch-scatter ch-wide-y" data-no-preview>
        <div class="ch-y">{[10, 30, 100, 300, 1000].map((t) => <span style={`top:${wy(t)}%`}>{num(t)}</span>)}</div>
        <div class="ch-plot ch-plot-short">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {[10, 30, 100, 300, 1000].map((t) => <line class="ch-grid" x1="0" x2="100" y1={wy(t)} y2={wy(t)} />)}
            <line class="ch-fit" x1="0" x2="100" y1={wy(10 ** sewageFit.cut)} y2={wy(10 ** (sewageFit.cut + sewageFit.slope * WX1))} />
          </svg>
          {sewage.map((w) => (
            <a class:list={["ch-dot", { named: sewageNamed.has(w.c.id), left: w.x > WX1 * 0.75 }]} href={`${base}country/${w.c.slug}/#datasets`} data-sewage={w.c.slug}
              style={`left:${pct(w.x, 0, WX1)}%;top:${wy(w.y)}%;--c:${tierColor(w.x)}`} aria-label={`${w.c.name}: ${w.y} mg a day per 1,000 people, score ${Math.round(w.x)}`}>
              {sewageNamed.has(w.c.id) && <span>{w.c.name}</span>}
            </a>
          ))}
        </div>
        <div class="ch-x">{Array.from({ length: WX1 / 10 + 1 }, (_, i) => i * 10).map((t) => <span class:list={{ first: t === 0, last: t === WX1 }} style={`left:${pct(t, 0, WX1)}%`}>{t}</span>)}</div>
        <p class="ch-axis-label">Cannabis score</p>
      </div>
      <p class="ch-source">{WW.title}; {sewage.length} countries; cities averaged by the people each plant serves. <a href={`${base}sources/#dataset-wastewater`}>About the dataset</a>.</p>
      <p class="ch-more"><a href={`${base}map/wastewater/`}>Wastewater on the map →</a> <a href={`${base}map/share-of-adults/`}>What surveys say →</a> <a href={`${base}map/cannabis-seizures/`}>Seizures on the map →</a></p>
    </section>

    {chapterAt.has("punished") && <h2 class="ch-chapter">{chapterAt.get("punished")}</h2>}
    <section class="ch" id="punished">
      <p class="ch-kicker"><a href="#punished">{kick("punished")}</a></p>
