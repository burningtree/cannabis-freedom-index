      const X0 = 1995, X1 = 2024, Y1 = 50;
      // a country's value at any year, between its waves; null outside them
      const at = (pts, year) => {
        for (let k = 0; k < pts.length - 1; k++) {
          const [a, va] = pts[k], [b, vb] = pts[k + 1];
          if (year >= a && year <= b) return va + ((vb - va) * (year - a)) / (b - a);
