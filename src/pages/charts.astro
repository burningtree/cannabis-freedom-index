  ["Freedom and the state", "Clean public sector (corruption index)", "#corruption", (c) => latestSince(c.series.corruption, "cpi", 2020)?.cpi],
  ["Freedom and the state", "Government effectiveness", "#state-capacity", (c) => latestSince(c.series.government_effectiveness, "score", 2020)?.score],
  ["Wealth and development", "Income per person (log)", "map/income/", (c) => logOr(latestSince(c.series.gdp, "gdp_ppp", 2018)?.gdp_ppp)],
  ["Wealth and development", "People using the internet", "map/internet/", (c) => dev(c, "internet")],
  ["Wealth and development", "Living in towns and cities", "map/internet/", (c) => dev(c, "urban")],
  ["Wealth and development", "Aged 65 or over", "map/internet/", (c) => dev(c, "aged_65")],
