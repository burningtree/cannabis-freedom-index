  </main>
  <script type="application/json" id="ch-data" set:html={JSON.stringify(chartData)} />
  <script>
    // Hover cards: the detail behind a bar, a row, a region or a dot. The marks are links, so a
    // click (or a tap) leads on to the page the card describes.
    const D = JSON.parse(document.getElementById("ch-data").textContent);
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
    const tip = document.createElement("div");
    tip.className = "ch-tip";
    tip.hidden = true;
    document.body.append(tip);
    const place = (e) => {
      const w = tip.offsetWidth, h = tip.offsetHeight;
      let x = e.clientX + 16, y = e.clientY + 16;
      if (x + w > innerWidth - 8) x = Math.max(8, e.clientX - 16 - w);
      if (y + h > innerHeight - 8) y = Math.max(8, e.clientY - 16 - h);
      tip.style.left = `${x}px`;
      tip.style.top = `${y}px`;
    };
    const card = (el, html) => {
      el.addEventListener("pointerenter", (e) => { tip.innerHTML = html(e); tip.hidden = false; place(e); });
      el.addEventListener("pointermove", place);
      el.addEventListener("pointerleave", () => { tip.hidden = true; });
    };
    const signed = (d) => `${d > 0 ? "+" : "−"}${Math.abs(d)}`;

    // the waves: a year's changes
    document.querySelectorAll("[data-wave]").forEach((a) => card(a, () => {
      const y = a.dataset.wave, w = D.waves[y];
      return `<b>${y}</b><span class="ch-tip-sub">${w.down} tightened · ${w.up} eased</span><ul>`
        + w.items.map(([flag, title, d]) => `<li><em class="${d > 0 ? "up" : "down"}">${signed(d)}</em>${flag} ${esc(title)}</li>`).join("")
        + `</ul>${w.more ? `<span class="ch-tip-sub">and ${w.more} more</span>` : ""}<span class="ch-tip-go">Open ${y} in the history →</span>`;
    }));

    // the top fifteen: how each got there
    document.querySelectorAll("[data-top]").forEach((a) => card(a, () => {
      const steps = D.top[a.dataset.top], name = a.closest("li").querySelector("a").textContent;
      return `<b>${esc(name)}</b><span class="ch-tip-sub">Changes since 1961</span><ul>`
        + (steps.length ? steps.slice(0, 6).map(([y, title, b, af]) => `<li><em>${y}</em><span>${esc(title)} <i>${b} → ${af}</i></span></li>`).join("") : "<li>No dated change recorded since 1961</li>")
        + `</ul><span class="ch-tip-go">Open its history →</span>`;
    }));

    // the regions: the year under the pointer
    document.querySelectorAll("[data-region]").forEach((a) => {
      const plot = a.querySelector(".ch-plot"), seek = a.querySelector(".ch-seek"), values = D.regions[a.dataset.region];
      const html = (e) => {
        const box = plot.getBoundingClientRect(), i = Math.round(Math.min(1, Math.max(0, (e.clientX - box.left) / box.width)) * (values.length - 1));
        seek.style.left = `${(i / (values.length - 1)) * 100}%`;
        seek.hidden = false;
        return `<b>${esc(a.dataset.region)} · ${D.regions.from + i}</b><span class="ch-tip-row">Region average<em>${values[i].toFixed(1)}</em></span>`
          + `<span class="ch-tip-row">World average<em>${D.regions.world[i].toFixed(1)}</em></span><span class="ch-tip-go">Rankings for ${esc(a.dataset.region)} →</span>`;
      };
      card(plot, html);
      plot.addEventListener("pointermove", (e) => { tip.innerHTML = html(e); });
      plot.addEventListener("pointerleave", () => { seek.hidden = true; });
    });

    // the first restrictions: the law and the country's score now
    document.querySelectorAll("[data-first]").forEach((a) => card(a, () => {
      const [name, year, title, score, tier] = D.firsts[a.dataset.first];
      return `<b>${esc(name)} · ${year}</b><span>${esc(title)}</span><span class="ch-tip-row">Score today<em>${score} · ${esc(tier)}</em></span><span class="ch-tip-go">Open its history →</span>`;
    }));

    // the people: a band's share and its largest countries
    document.querySelectorAll("[data-people]").forEach((el) => {
      const k = +el.dataset.people, [name, share, pop, n, top] = D.people[k];
      const mark = (on) => document.querySelectorAll(`[data-people="${k}"]`).forEach((x) => x.classList.toggle("on", on));
      el.addEventListener("pointerenter", () => mark(true));
      el.addEventListener("pointerleave", () => mark(false));
      if (el.tagName === "A") card(el, () => `<b>${esc(name)}</b><span class="ch-tip-row">Share of the world's people<em>${share}%</em></span><span class="ch-tip-row">People<em>${pop}</em></span>`
        + `<span class="ch-tip-sub">${n} countries${top.length ? `, the largest ${top.map(esc).join(", ")}` : ""}</span><span class="ch-tip-go">See the bands on the map →</span>`);
    });

    // the law grid: the countries in a cell
    document.querySelectorAll("[data-law]").forEach((a) => card(a, () => {
      const [i, j] = a.dataset.law.split(",").map(Number), list = D.law[i][j];
      return `<b>${esc(D.lawNames.rec[i])} · medical ${esc(D.lawNames.med[j].toLowerCase())}</b><span class="ch-tip-sub">${list.length} countries</span>`
        + `<span class="ch-tip-list">${list.slice(0, 40).map(esc).join(", ")}${list.length > 40 ? ` and ${list.length - 40} more` : ""}</span><span class="ch-tip-go">Recreational law on the map →</span>`;
    }));

    // use and the law: the survey behind a dot
    document.querySelectorAll("[data-use]").forEach((a) => card(a, () => {
      const [name, prev, year, score, tier] = D.use[a.dataset.use];
      return `<b>${esc(name)}</b><span class="ch-tip-row">Used cannabis in the past year<em>${prev}%</em></span>${year ? `<span class="ch-tip-row">Survey<em>${year}</em></span>` : ""}`
        + `<span class="ch-tip-row">Score today<em>${score} · ${esc(tier)}</em></span><span class="ch-tip-go">Open its datasets →</span>`;
    }));

    // the stripes: the country and year under the pointer
    {
      const box = document.querySelector(".ch-stripes .ch-plot"), hit = box.querySelector(".ch-stripes-hit");
      const seek = box.querySelector(".ch-seek"), mark = box.querySelector(".ch-row-mark"), rows = D.stripes.rows;
      const at = (e) => {
        const r = box.getBoundingClientRect();
        const row = Math.min(rows.length - 1, Math.max(0, Math.floor(((e.clientY - r.top) / r.height) * rows.length)));
        const span = rows[0][2].at(-1)[0] - D.stripes.from + 1, years = Math.max(span, new Date().getFullYear() - D.stripes.from + 1);
        const year = D.stripes.from + Math.min(years - 1, Math.max(0, Math.floor(((e.clientX - r.left) / r.width) * years)));
        const [slug, name, steps, banned] = rows[row], score = steps.findLast(([y]) => y <= year)[1];
        const changed = steps.filter(([y]) => y > D.stripes.from).length;
        seek.style.left = `${((year - D.stripes.from + 0.5) / years) * 100}%`;
        mark.style.top = `${(row / rows.length) * 100}%`;
        mark.style.height = `${100 / rows.length}%`;
        seek.hidden = mark.hidden = false;
        hit.href = `${D.base}country/${slug}/#history`;
        return `<b>${esc(name)} · ${year}</b><span class="ch-tip-row">Score that year<em>${score}</em></span><span class="ch-tip-row">Annual snapshots below 15<em>${banned}</em></span>`
          + `<span class="ch-tip-sub">${changed} changes in its score since ${D.stripes.from}</span><span class="ch-tip-go">Open its history →</span>`;
      };
      card(hit, at);
      hit.addEventListener("pointermove", (e) => { tip.innerHTML = at(e); });
      hit.addEventListener("pointerleave", () => { seek.hidden = mark.hidden = true; });
    }

    // the stream: a decade's entries by kind
    document.querySelectorAll("[data-decade]").forEach((a) => card(a, () => {
      const i = +a.dataset.decade, d = D.stream.decades[i];
      const rows = D.stream.groups.map(([label, color], k) => [label, color, D.stream.counts[k][i]]).reverse();
      return `<b>The ${d}s</b>` + rows.map(([label, color, n]) => `<span class="ch-tip-row"><i class="ch-key" style="background:${color}"></i>${esc(label)}<em>${n}</em></span>`).join("")
        + `<span class="ch-tip-go">Read the ${d}s in the history →</span>`;
    }));

    // the ridges: a year's average
    document.querySelectorAll(".ch-ridge-hit").forEach((a) => {
      const g = document.querySelector(`.ch-ridge[data-ridge="${a.dataset.ridge}"]`);
      a.addEventListener("pointerenter", () => g.classList.add("on"));
      a.addEventListener("pointerleave", () => g.classList.remove("on"));
      card(a, () => {
        const [year, avg, at100] = D.ridges[+a.dataset.ridge];
        return `<b>${year}</b><span class="ch-tip-row">Average score<em>${avg}</em></span><span class="ch-tip-row">Countries with no rule yet<em>${at100}</em></span><span class="ch-tip-go">The rankings in ${year} →</span>`;
      });
    });

    // the law and the people
    document.querySelectorAll("[data-moral]").forEach((a) => card(a, () => {
      const [name, ok, notMoral, wrong, score, tier, rec] = D.moral[a.dataset.moral];
      return `<b>${esc(name)}</b><span class="ch-tip-row">Morally acceptable<em>${ok}%</em></span><span class="ch-tip-row">Not a moral issue<em>${notMoral}%</em></span>`
        + `<span class="ch-tip-row">Morally unacceptable<em>${wrong}%</em></span><span class="ch-tip-row">Score today<em>${score} · ${esc(tier)}</em></span><span class="ch-tip-sub">For adults: ${esc(rec)}</span><span class="ch-tip-go">Open its datasets →</span>`;
    }));
    // the price of prohibition
    document.querySelectorAll("[data-price]").forEach((a) => card(a, () => {
      const [name, eur, year, score, tier] = D.price[a.dataset.price];
      return `<b>${esc(name)}</b><span class="ch-tip-row">A gram of herb, ${year}<em>€${eur.toFixed(2)}</em></span><span class="ch-tip-row">Score today<em>${score} · ${esc(tier)}</em></span><span class="ch-tip-go">Open its datasets →</span>`;
    }));
    // who gets punished
    document.querySelectorAll("[data-punish]").forEach((a) => card(a, () => {
      const [name, rate, offences, year, users, prev] = D.punish[a.dataset.punish];
      return `<b>${esc(name)}</b><span class="ch-tip-row">Offences recorded, ${year}<em>${offences.toLocaleString("en-GB")}</em></span><span class="ch-tip-row">People who use cannabis<em>${users.toLocaleString("en-GB")}</em></span>`
        + `<span class="ch-tip-row">Offences per 1,000 users<em>${rate}</em></span><span class="ch-tip-sub">${prev}% of adults used it in the past year</span><span class="ch-tip-go">Open its datasets →</span>`;
    }));
    // stronger, cheaper: the year under the pointer
    {
      const hit = document.querySelector(".ch-thc-hit"), plot = hit.parentElement, seek = plot.querySelector(".ch-seek");
      const at = (e) => {
        const r = plot.getBoundingClientRect(), i = Math.round(Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)) * (D.thc.length - 1));
        const [year, mg, th, pr, n] = D.thc[i];
        seek.style.left = `${(i / (D.thc.length - 1)) * 100}%`;
        seek.hidden = false;
        return `<b>${year}</b><span class="ch-tip-row">THC a euro buys<em>${mg} mg</em></span><span class="ch-tip-row">THC in herb<em>${th}%</em></span><span class="ch-tip-row">Price of a gram<em>€${pr.toFixed(2)}</em></span>`
          + `<span class="ch-tip-sub">The middle of ${n} countries</span><span class="ch-tip-go">Potency on the map →</span>`;
      };
      card(hit, at);
      hit.addEventListener("pointermove", (e) => { tip.innerHTML = at(e); });
      hit.addEventListener("pointerleave", () => { seek.hidden = true; });
    }
    // criminalising a crop
    document.querySelectorAll("[data-hemp]").forEach((a) => card(a, () => {
      const [name, ha, year, rec, score] = D.hemp[a.dataset.hemp];
      return `<b>${esc(name)}</b><span class="ch-tip-row">Hemp grown, ${year}<em>${ha.toLocaleString("en-GB")} ha</em></span><span class="ch-tip-row">Cannabis for adults<em>${esc(rec)}</em></span><span class="ch-tip-row">Score today<em>${score}</em></span><span class="ch-tip-go">Open its datasets →</span>`;
    }));
    // research
    document.querySelectorAll("[data-research]").forEach((a) => card(a, () => {
      const [name, per, total, score, tier] = D.research[a.dataset.research];
      return `<b>${esc(name)}</b><span class="ch-tip-row">Papers a year per million people<em>${per}</em></span><span class="ch-tip-row">Papers in five years<em>${total.toLocaleString("en-GB")}</em></span><span class="ch-tip-row">Score today<em>${score} · ${esc(tier)}</em></span><span class="ch-tip-go">Open its datasets →</span>`;
    }));

    // easy to get
    document.querySelectorAll("[data-easy]").forEach((a) => card(a, () => {
      const [name, all, boys, girls, score, tier] = D.easy[a.dataset.easy];
      return `<b>${esc(name)}</b><span class="ch-tip-row">Students who say it is easy to get<em>${all.toFixed(1)}%</em></span><span class="ch-tip-row">Boys · girls<em>${boys.toFixed(0)}% · ${girls.toFixed(0)}%</em></span>`
        + `<span class="ch-tip-row">Score today<em>${score} · ${esc(tier)}</em></span><span class="ch-tip-go">Open its datasets →</span>`;
    }));
    // wastewater, with the country's years
    document.querySelectorAll("[data-sewage]").forEach((a) => card(a, () => {
      const [name, mg, year, cities, score, tier, trend] = D.sewage[a.dataset.sewage];
      return `<b>${esc(name)}</b><span class="ch-tip-row">THC-COOH, ${year}<em>${mg} mg</em></span><span class="ch-tip-sub">a day per 1,000 people, ${cities} ${cities === 1 ? "city" : "cities"}</span>`
        + (trend.length > 1 ? `<span class="ch-tip-sub">${trend.map(([y, v]) => `${y}: ${Math.round(v)}`).join(" · ")}</span>` : "")
        + `<span class="ch-tip-row">Score today<em>${score} · ${esc(tier)}</em></span><span class="ch-tip-go">Open its datasets →</span>`;
    }));
    // sourcing: a year's sources
    document.querySelectorAll("[data-source]").forEach((a) => card(a, () => {
      const row = D.sourcing.find((r) => r[0] === +a.dataset.source);
      return `<b>${row[0]}</b>` + D.sourceLabels.map(([label, color], k) => `<span class="ch-tip-row"><i class="ch-key" style="background:${color}"></i>${esc(label)}<em>${row[k + 1] ?? "–"}${row[k + 1] == null ? "" : "%"}</em></span>`).join("")
        + `<span class="ch-tip-go">Canada's datasets →</span>`;
    }));
    // empire: a former colony beside its ruler
    document.querySelectorAll("[data-empire]").forEach((a) => card(a, () => {
      const [name, year, ruler, own] = D.empire[a.dataset.empire];
      const gap = year - own;
      return `<b>${esc(name)} · ${year}</b><span class="ch-tip-row">${esc(ruler)} at home<em>${own}</em></span><span class="ch-tip-sub">${gap === 0 ? "The same year" : `${Math.abs(gap)} years ${gap < 0 ? "before" : "after"} ${esc(ruler)}`}</span><span class="ch-tip-go">Open its history →</span>`;
    }));
    // the state as merchant: a fiscal year's revenue
    document.querySelectorAll("[data-revenue]").forEach((a) => card(a, () => {
      const [fy, total, net, fed, prov, other, sales] = D.revenue[+a.dataset.revenue];
      const bn = (v) => `C$${(v / 1e6).toFixed(2)} bn`;
      return `<b>${fy}</b><span class="ch-tip-row">To governments, in all<em>${bn(total)}</em></span><span class="ch-tip-row">Profit of the cannabis authorities<em>${bn(net)}</em></span>`
        + `<span class="ch-tip-row">Federal excise<em>${bn(fed)}</em></span><span class="ch-tip-row">Provincial excise<em>${bn(prov)}</em></span><span class="ch-tip-row">Sales taxes and other<em>${bn(other)}</em></span>`
        + `<span class="ch-tip-sub">Sales by the authorities: ${bn(sales)}</span><span class="ch-tip-go">About the data →</span>`;
    }));

    // the scatter: a country's two scores
    document.querySelectorAll("[data-dot]").forEach((a) => card(a, () => {
      const [name, hfi, score, tier, res] = D.dots[+a.dataset.dot];
      return `<b>${esc(name)}</b><span class="ch-tip-row">Human Freedom Index<em>${hfi.toFixed(2)}</em></span><span class="ch-tip-row">Cannabis score<em>${score} · ${esc(tier)}</em></span>`
        + `<span class="ch-tip-sub">${Math.abs(res) < 3 ? "About where its general freedom suggests" : `${Math.abs(res)} points ${res > 0 ? "freer" : "less free"} for cannabis than the line suggests`}</span><span class="ch-tip-go">Open its datasets →</span>`;
    }));
  </script>
</Base>
