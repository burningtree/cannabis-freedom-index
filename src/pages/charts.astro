    document.querySelectorAll("[data-ptreat]").forEach((a) => card(a, () => {
      const [name, punish, treat, oy, ty, share, score, tier] = D.punishTreat[a.dataset.ptreat];
      return `<b>${esc(name)}</b><span class="ch-tip-sub">per 1,000 people who use cannabis</span><span class="ch-tip-row">Offences recorded, ${oy}<em>${punish}</em></span><span class="ch-tip-row">Entering treatment for cannabis, ${ty}<em>${treat}</em></span>`
        + `<span class="ch-tip-sub">${share}% of all who entered drug treatment came for cannabis</span><span class="ch-tip-row">Score<em>${score} · ${esc(tier)}</em></span><span class="ch-tip-go">Open its datasets →</span>`;
    }));

    // in the news
    document.querySelectorAll("[data-news]").forEach((a) => card(a, () => {
      const [name, share, rows, score, tier] = D.news[a.dataset.news];
      return `<b>${esc(name)}</b><span class="ch-tip-sub">share of the country's news articles mentioning cannabis</span>` + rows.map(([y, v]) => `<span class="ch-tip-row">${y}<em>${v.toFixed(3)}%</em></span>`).join("")
        + `<span class="ch-tip-row">Score<em>${score} · ${esc(tier)}</em></span><span class="ch-tip-go">Open its datasets →</span>`;
    }));

    // the sharpest borders
    document.querySelectorAll("[data-border]").forEach((li) => card(li, () => {
      const [a, as, at, b, bs, bt, gap] = D.borders[+li.dataset.border];
      return `<b>${esc(a)} | ${esc(b)}</b><span class="ch-tip-row">${esc(a)}<em>${as} · ${esc(at)}</em></span><span class="ch-tip-row">${esc(b)}<em>${bs} · ${esc(bt)}</em></span><span class="ch-tip-row">Gap across the border<em>${gap} points</em></span>`;
    }));
    // the scatter: a country's two scores
    document.querySelectorAll("[data-dot]").forEach((a) => card(a, () => {
      const [name, hfi, score, tier, res] = D.dots[+a.dataset.dot];
      return `<b>${esc(name)}</b><span class="ch-tip-row">Human Freedom Index<em>${hfi.toFixed(2)}</em></span><span class="ch-tip-row">Cannabis score<em>${score} · ${esc(tier)}</em></span>`
        + `<span class="ch-tip-sub">${Math.abs(res) < 3 ? "About where its general freedom suggests" : `${Math.abs(res)} points ${res > 0 ? "freer" : "less free"} for cannabis than the line suggests`}</span><span class="ch-tip-go">Open its datasets →</span>`;
    }));
  </script>
</Base>
