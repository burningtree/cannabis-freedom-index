        }
        const [slug, name, pts] = best;
        lit = plot.querySelector(`.ch-thc-country[data-thc="${slug}"]`);
        lit.classList.add("on");
        const p = pts.reduce((a, b) => (Math.abs(b[0] - year) < Math.abs(a[0] - year) ? b : a));
        seek.style.left = dot.style.left = `${((p[0] - X0) / (X1 - X0)) * 100}%`;
        dot.style.top = `${(1 - Math.min(p[1], Y1) / Y1) * 100}%`;
        seek.hidden = dot.hidden = false;
        hit.href = `${D.base}country/${slug}/#datasets`;
        const first = pts[0], last = pts.at(-1);
        return `<b>${esc(name)} · ${p[0]}</b><span class="ch-tip-row">THC a euro buys<em>${p[1]} mg</em></span><span class="ch-tip-row">THC in herb<em>${p[2]}%</em></span><span class="ch-tip-row">Price of a gram<em>€${p[3].toFixed(2)}</em></span>`
          + `<span class="ch-tip-sub">${first[0]}: ${first[1]} mg · ${last[0]}: ${last[1]} mg</span><span class="ch-tip-go">Open its datasets →</span>`;
      };
      card(hit, show);
