<Base title="Reefer Madness · Exhibition 001" description="Exhibition 001, Reefer Madness: the invention of a monster. The original trailer, the claims and their verdicts, the machinery of a moral panic, the exploitation films, the people sentenced, the panic's export abroad, the film's afterlife, and an evidence room of sourced documents.">
  <main class="rm">
    <nav class="rm-tickets" aria-label="Rooms of the exhibition">
      <a class="rm-ticket rm-ticket-home" href={`${base}exhibitions/`}>Exhibitions</a>
      <a class="rm-ticket" href="#programme"><b>·</b>Programme</a>
      {ROOMS.map(([id, no, name]) => <a class="rm-ticket" href={`#${id}`}><b>{no}</b>{name}</a>)}
    </nav>
    <!-- once past the entrance: where you are, and the rooms in brief -->
    <nav class="rm-now" aria-label="You are here">
      <a class="rm-now-title" href="#programme">Reefer Madness</a>
      <span class="rm-now-room" aria-live="polite"><b>·</b><span>Programme</span></span>
      <ol class="rm-now-rooms">
        {ROOMS.map(([id, no, name]) => <li><a href={`#${id}`} data-room={id} title={name} aria-label={`Room ${no}, ${name}`}>{no}</a></li>)}
      </ol>
      <i class="rm-now-bar" aria-hidden="true"></i>
    </nav>

    <!-- The entrance: the title and the original trailer -->
    <section class="rm-hero" aria-labelledby="rm-title">
      <div class="rm-curtain left" aria-hidden="true"></div>
      <div class="rm-curtain right" aria-hidden="true"></div>
      <header class="rm-marquee">
        <p class="rm-marquee-top">Exhibition 001 · Propaganda</p>
        <h1 id="rm-title">Reefer Madness</h1>
        <p class="rm-marquee-sub">The invention of a monster</p>
      </header>
      <figure class="rm-trailer">
        <div class="rm-trailer-screen">
          <video class="rm-trailer-video" src={`${base}exhibitions/reefer-madness/trailer.mp4`} poster={`${base}exhibitions/reefer-madness/trailer-poster.jpg`} autoplay muted loop playsinline preload="metadata" aria-label="The original trailer of Reefer Madness">
            <track kind="subtitles" srclang="en" label="English" src={`${base}exhibitions/reefer-madness/trailer.en.vtt`} default />
          </video>
          <p class="rm-trailer-cc" aria-live="off"></p>
          <div class="rm-grain" aria-hidden="true"></div>
          <div class="rm-trailer-controls">
            <button type="button" class="rm-trailer-ctl" data-ctl="play" aria-pressed="true">❚❚ Pause</button>
            <input type="range" class="rm-trailer-seek" min="0" max="116" step="0.1" value="0" aria-label="Position in the trailer" />
            <span class="rm-trailer-time" aria-hidden="true">0:00 / 1:56</span>
            <button type="button" class="rm-trailer-ctl" data-ctl="cc" aria-pressed="true" aria-label="English subtitles">CC</button>
