// the phrase chart, drawn at build time
const PH = (() => {
  const W = 1000, H = 300, L = 40, R = 14, T = 74, B = 30, max = 26;
  const n = PHRASE.values.length;
  const x = (i) => L + (i / (n - 1)) * (W - L - R), y = (v) => T + (1 - v / max) * (H - T - B);
  const line = PHRASE.values.map((v, i) => `${i ? "L" : "M"}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join("");
  return { W, H, L, R, T, B, x, y, line, area: `${line}L${x(n - 1)},${H - B}L${L},${H - B}Z`, ticks: [0, 10, 20], years: [1960, 1970, 1980, 1990, 2000, 2010, 2020],
    // labels in rows above the line, so they never cross: [row, anchored at the end]
    marks: STRIP.filter((f) => f.marked).map((f) => ({ year: +f.year, title: f.title, cx: x(+f.year - PHRASE.from), cy: y(PHRASE.values[+f.year - PHRASE.from]), ...({ 1972: { row: 1, end: false }, 1998: { row: 0, end: true }, 2003: { row: 1, end: false }, 2005: { row: 2, end: false } })[+f.year] })) };
})();

