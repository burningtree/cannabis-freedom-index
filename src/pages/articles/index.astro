---
// Every history entry that has a full article, oldest first. Reached from the numbers on the
// home page; it is not in the menu.
import Base from "../../layouts/Base.astro";
import Articles from "../../components/Articles.astro";
import { articles } from "../../lib/countries.js";
---
<Base title="Articles" description={`${articles.size} moments in the history of cannabis law told in full, from the first bans and treaties to the newest laws.`}>
  <main class="changes-page">
    <section class="hero hero-sm">
      <p class="eyebrow">History</p>
      <h1>Articles</h1>
      <p class="lede">{articles.size} moments from the history told in full, oldest first: what the law was, what changed, and what it meant for the score. Every one belongs to an entry in the <a href={`${import.meta.env.BASE_URL}history/`}>history</a>.</p>
    </section>
    <Articles />
  </main>
</Base>
