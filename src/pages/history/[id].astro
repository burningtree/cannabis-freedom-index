---
import Base from "../../layouts/Base.astro";
import ScoreChange from "../../components/ScoreChange.astro";
import { changes, formatDate, changeDate } from "../../lib/countries.js";
import { tierColor } from "../../lib/tiers.js";

export function getStaticPaths() {
  return changes.map((ch, i) => ({ params: { id: ch.id }, props: { ch, newer: changes[i - 1], older: changes[i + 1] } }));
}

const { ch, newer, older } = Astro.props;
const base = import.meta.env.BASE_URL;
const c = ch.country;
const diff = (seg) => seg.after - seg.before;
---
<Base title={ch.title} description={ch.score ? `${ch.title}: ${c.name} moved from ${ch.score.before} to ${ch.score.after} on the Cannabis Freedom Index. ${ch.description}` : `${ch.title}. ${ch.description}`}>
  <main class="change-page">
    <div class="page-bar">
      <a class="back" href={`${base}history/`}>← History</a>
      {c && <a class="btn" href={`${base}country/${c.slug}/`}>{c.flag} {c.name} in full</a>}
    </div>

    <article class="change-detail">
      <p class="eyebrow"><span title={ch.kind.help}>{ch.kind.emoji} {ch.kind.label}</span> · <time datetime={ch.date}>{changeDate(ch)}</time> · {ch.place.name}</p>
      <h1>{ch.title}</h1>
      <p class="lede">{ch.description}</p>
      <p class={`confidence c-${ch.confidence.key}`}><span aria-hidden="true">{ch.confidence.mark}</span> <strong>{ch.confidence.label}.</strong> {ch.confidence.help}.{ch.score ? " The score before the change is an editorial estimate." : ""}</p>
      <p class="change-source">{ch.sources.length > 1 ? "Sources" : "Source"}:</p>
      <ul class="srcs change-srcs">
        {ch.sources.map(([label, url]) => <li><a href={url} target="_blank" rel="noopener noreferrer">{label}</a></li>)}
      </ul>

      {ch.score && (
        <Fragment>
          <h2 class="d-h">Index score</h2>
          <ScoreChange score={ch.score} />

          <h2 class="d-h">Score by segment</h2>
          <table class="change-table">
            <thead>
              <tr><th scope="col">Segment</th><th scope="col">Before</th><th scope="col">After</th><th scope="col">Change</th></tr>
            </thead>
            <tbody>
              {ch.segments.map((seg) => (
                <tr class={diff(seg) === 0 ? "same" : ""}>
                  <th scope="row">{seg.name}<small>{seg.weight}% of the index</small></th>
                  <td><span class="dot" style={`background:${tierColor(seg.before * 10)}`}></span>{seg.before}</td>
                  <td><span class="dot" style={`background:${tierColor(seg.after * 10)}`}></span>{seg.after}</td>
                  <td>{diff(seg) === 0
                    ? "—"
                    : <span class={`delta ${diff(seg) > 0 ? "up" : "down"}`}>{diff(seg) > 0 ? "+" : "−"}{Math.abs(diff(seg))}</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="change-note">Segments are scored from 0 to 10. {ch.latest ? `The scores after the change are ${c.name}'s current scores.` : `${c.name}'s scores have changed again since.`}</p>
        </Fragment>
      )}
      {!ch.score && <p class="change-note">{c ? `Listed for context. No score change is recorded for ${c.name} here.` : "International agreements are listed for context. They bind governments, not people, so they move no country's score by themselves."}</p>}

      {ch.estimate && <p class="change-note">This entry is an estimate. No first law is recorded for {c.name}, so its first restrictions are assumed to have come at some point between {ch.window[0]} and {ch.window[1]}. On the charts the change is spread evenly across those years.</p>}
    </article>

    <nav class="pager" aria-label="Other entries">
      {newer
        ? <a href={`${base}history/${newer.id}/`}><small>Newer · {changeDate(newer)}</small><span>{newer.place.flag} {newer.title}</span></a>
        : <span></span>}
      {older
        ? <a class="next" href={`${base}history/${older.id}/`}><small>Older · {changeDate(older)}</small><span>{older.place.flag} {older.title}</span></a>
        : <span></span>}
    </nav>
  </main>
</Base>
