---
import Base from "../../layouts/Base.astro";
import { render } from "astro:content";
import { Picture } from "astro:assets";
import { changes, articles, countries, changeDate, formatDate, REC_LABEL, REC_HELP, MED_LABEL, MED_HELP } from "../../lib/countries.js";
import { tierOf, tierColor } from "../../lib/tiers.js";
import { sourceTuple } from "../../lib/sources.js";
import SourceCitation from "../../components/SourceCitation.astro";

// One history entry: what happened, large; the score before and after when it moved one; how
// each segment moved; the sources; and, beside it, the country today and its entries around this one.

export function getStaticPaths() {
  return changes.map((ch, i) => ({ params: { id: ch.id }, props: { ch, newer: changes[i - 1], older: changes[i + 1] } }));
}

const { ch, newer, older } = Astro.props;
const base = import.meta.env.BASE_URL;
const c = ch.country;
const diff = (seg) => seg.after - seg.before;
// the long read, when this entry has one: articles/<id>.md
const article = articles.get(ch.id);
const Article = article ? (await render(article)).Content : null;
// The entry's own sources, then the article's, each work/address once.
const sources = [...ch.sources, ...(article?.data.sources ?? []).map(sourceTuple)].filter((x, i, all) => all.findIndex((other) => other[3] === x[3]) === i);
// The country's other entries closest in time to this one, for the side panel.
// An entry tied to no country gets the international entries instead: the treaties in order.
const own = changes.filter((x) => x.country === c && !x.estimate);
const at = own.indexOf(ch);
const nearby = c ? own.slice(Math.max(0, at - 3), at + 4) : own.slice(Math.max(0, at - 5), at + 6);
---
<Base type="article" title={ch.title} description={ch.score ? `${ch.title}: ${c.name} moved from ${ch.score.before} to ${ch.score.after} on the Cannabis Freedom Index. ${ch.description}` : `${ch.title}. ${ch.description}`}>
  <main class="change-page ev">
    <div class="page-bar">
      <a class="back" href={`${base}history/`}>← History</a>
    </div>

    <header class={`ev-top${ch.score ? "" : " ev-plain"}`}>
      <div>
        <p class="eyebrow"><a href={`${base}history/kind/${ch.category}/`} title={ch.kind.help}>{ch.kind.emoji} {ch.kind.label}</a> <span><time datetime={ch.date}>{changeDate(ch)}</time></span> <span>{c ? <a href={`${base}country/${c.slug}/`}>{c.flag} {c.name}</a> : ch.place.name}</span></p>
        <h1>{ch.title}</h1>
        <p class="lede">{ch.description}</p>
      </div>
      {ch.score && (
        <div class="ev-move" aria-label={`Index score from ${ch.score.before} to ${ch.score.after}`}>
          <p class="ev-label">Index score</p>
          <p class="ev-figures">
            <b style={`--c:${tierColor(ch.score.before)}`}>{ch.score.before}</b>
            <span aria-hidden="true">→</span>
            <b style={`--c:${tierColor(ch.score.after)}`}>{ch.score.after}</b>
          </p>
          <p class={`ev-delta delta ${ch.score.after >= ch.score.before ? "up" : "down"}`}>{ch.score.after >= ch.score.before ? "+" : "−"}{Math.abs(ch.score.after - ch.score.before)} {Math.abs(ch.score.after - ch.score.before) === 1 ? "point" : "points"}</p>
        </div>
      )}
    </header>

    <div class="ev-body">
    <article class="ev-main">
      {article && (
        <section class="ev-article">
          <p class="ev-label">The story{article.data.model && <span class="ev-by"> · written by {article.data.model}{article.data.written && <>, <time datetime={article.data.written.toISOString().slice(0, 10)}>{formatDate(article.data.written.toISOString().slice(0, 10))}</time></>}</span>}</p>
          {article.data.image && (
            <figure>
              <Picture src={article.data.image.src} alt={article.data.image.alt} formats={["webp"]} widths={[480, 800, 1280]} sizes="(max-width: 900px) 100vw, 760px" />
              <figcaption>{article.data.image.caption} <span>{article.data.image.credit_url ? <a href={article.data.image.credit_url} target="_blank" rel="noopener noreferrer">{article.data.image.credit}</a> : article.data.image.credit}</span></figcaption>
            </figure>
          )}
          <div class="prose"><Article /></div>
        </section>
      )}
      {ch.score && (
        <section>
          <h2 class="d-h">Score by segment <span>0 to 10</span></h2>
          <ol class="ev-segs">
            {ch.segments.map((seg) => (
              <li class={diff(seg) === 0 ? "same" : ""}>
                <div class="ev-seg-top">
                  <span>{seg.name} <small>· {seg.weight}%</small></span>
                  <b>{seg.before} <i aria-hidden="true">→</i> {seg.after}{diff(seg) !== 0 && <em class={`delta ${diff(seg) > 0 ? "up" : "down"}`}>{diff(seg) > 0 ? "+" : "−"}{Math.abs(diff(seg))}</em>}</b>
                </div>
                <div class="ev-track" aria-hidden="true">
                  <i style={`width:${seg.after * 10}%;background:${tierColor(seg.after * 10)}`}></i>
                  <span style={`left:calc(${seg.before * 10}% - 1px)`} title={`Before: ${seg.before}`}></span>
                </div>
              </li>
            ))}
          </ol>
          <p class="change-note">The bar shows the score after the change; the tick marks where it stood before. {ch.latest ? `The scores after the change are ${c.name}'s current scores.` : `${c.name}'s scores have changed again since.`}</p>
        </section>
      )}
      {!ch.score && c && <p class="change-note">Listed for context. No score change is recorded for {c.name} here.</p>}
      {ch.estimate && <p class="change-note">This entry is an estimate. No first law is recorded for {c.name}, so its first restrictions are assumed to have come at some point between {ch.window[0]} and {ch.window[1]}. On the charts the change is spread evenly across those years.</p>}

      <section>
        <h2 class="d-h">{sources.length > 1 ? "Sources" : "Source"}</h2>
        <ul class="srcs change-srcs">
          {sources.map((source) => <SourceCitation source={source} archive />)}
        </ul>
        <p class={`confidence c-${ch.confidence.key}`}><span aria-hidden="true">{ch.confidence.mark}</span> <strong>{ch.confidence.label}.</strong> {ch.confidence.help}.{ch.score ? " The score before the change is an editorial estimate." : ""}</p>
      </section>
    </article>

      <aside class="ev-rail" aria-label={c ? `About ${c.name}` : "International entries"}>
        {c ? (
        <section class="ev-country" style={`--c:${tierColor(c.raw)}`}>
          <p class="ev-label">{c.region} · today</p>
          <a class="ev-name" href={`${base}country/${c.slug}/`}><span class="flag">{c.flag}</span>{c.name}</a>
          <p class="d-num"><b>{c.score}</b><span>/100</span></p>
          <div class="d-meter" aria-hidden="true"><i style={`width:${c.raw}%`}></i></div>
          <p class="ev-tier">{tierOf(c.raw).name} <small>{c.disputed ? "Not ranked: disputed territory" : `#${c.rank} of ${countries.length}`}</small></p>
          <div class="d-chips">
            <span class={`chip s-${c.rec}`} title={REC_HELP[c.rec]}>Recreational: {REC_LABEL[c.rec]}</span>
            <span class={`chip s-${c.med}`} title={MED_HELP[c.med]}>Medical: {MED_LABEL[c.med]}</span>
          </div>
          <p class="ca-note">{c.note}</p>
          <a class="ev-open" href={`${base}country/${c.slug}/`}>Open {c.name} →</a>
        </section>
        ) : (
        <section class="ev-country ev-intl">
          <p class="ev-label">Tied to no country</p>
          <p class="ev-name"><span class="flag">{ch.place.flag}</span>International</p>
          <p class="ca-note">Treaties and decisions of international bodies set the rules countries work within. They bind governments, not people, so they move no score until a national law follows.</p>
        </section>
        )}

        {nearby.length > 1 && (
          <section class="ev-more">
            <h2 class="ev-label">{c ? `More from ${c.name}` : "The treaties in order"}</h2>
            <ol>
              {nearby.map((x) => (
                <li class={x === ch ? "current" : undefined}>
                  {x === ch
                    ? <span><time datetime={x.date}>{changeDate(x)}</time><b>{x.title}</b></span>
                    : <a href={`${base}history/${x.id}/`}><time datetime={x.date}>{changeDate(x)}</time><b>{x.title}</b></a>}
                </li>
              ))}
            </ol>
            {own.length > nearby.length && <p class="ca-all"><a href={c ? `${base}country/${c.slug}/` : `${base}history/kind/international/`}>{c ? `All ${own.length} entries for ${c.name}` : "All international entries"} →</a></p>}
          </section>
        )}
      </aside>
    </div>

    <nav class="pager" aria-label="Other entries">
      {newer
        ? <a href={`${base}history/${newer.id}/`}><small>Newer · {changeDate(newer)}</small><span>{newer.place.flag} {newer.title}</span></a>
        : <span></span>}
      {older
        ? <a class="next" href={`${base}history/${older.id}/`}><small>Older · {changeDate(older)}</small><span>{older.place.flag} {older.title}</span></a>
        : <span></span>}
    </nav>
  </main>
</Base>
