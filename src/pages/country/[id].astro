---
import Base from "../../layouts/Base.astro";
import CountryArticle from "../../components/CountryArticle.astro";
import { countries, places } from "../../lib/countries.js";
import { countrySeo } from "../../lib/seo.js";

export function getStaticPaths() {
  return places.map((c) => ({ params: { id: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const base = import.meta.env.BASE_URL;
// a disputed territory has no rank, so no neighbours to page to
const prev = c.rank ? countries[c.rank - 2] : null;
const next = c.rank ? countries[c.rank] : null;
const seo = countrySeo(c, Astro.site);
---
<Base title={c.name} seoTitle={seo.seoTitle} description={seo.description} jsonld={seo.jsonld} type="article">
  <main class="country-page">
    <div class="page-bar">
      <a class="back" href={`${base}#rankings`}>← All countries</a>
      <a class="btn" href={`${base}compare/?c=${c.slug}`}>Compare with other countries</a>
    </div>
    <CountryArticle c={c} />
    <nav class="pager" aria-label="Neighbouring countries by rank">
      {prev
        ? <a href={`${base}country/${prev.slug}/`}><small>#{prev.rank} · ranked higher</small><span>{prev.flag} {prev.name}</span></a>
        : <span></span>}
      {next
        ? <a class="next" href={`${base}country/${next.slug}/`}><small>#{next.rank} · ranked lower</small><span>{next.flag} {next.name}</span></a>
        : <span></span>}
    </nav>
  </main>
  <script>
    // On a full page the state/province picker simply navigates.
    document.addEventListener("change", (e) => {
      const select = e.target.closest("select[data-subunit-select]");
      if (select) location.href = select.value;
    });
  </script>
</Base>
