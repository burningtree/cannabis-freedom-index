---
// Every change made to the site, newest first, in pages (src/components/ChangelogPage.astro); this
// is the first page, with the uncommitted changes of a local build above the commits. Each commit
// opens a page showing exactly what changed (src/lib/gitlog.js). The changes to countries' scores
// alone are on /score-changes/.
import ChangelogPage from "../../components/ChangelogPage.astro";
import { reloadUncommitted } from "../../lib/gitlog.js";

if (import.meta.env.DEV) {
  Astro.response.headers.set("Cache-Control", "no-store");
  reloadUncommitted();
}
---
<ChangelogPage n={1} />
