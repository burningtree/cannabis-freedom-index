---
// Every change made to the site, newest first: one row per commit, with what it did in plain words.
// Each opens a page showing exactly what changed (src/lib/gitlog.js). The changes to countries'
// scores alone are on /score-changes/.
import Base from "../../layouts/Base.astro";
import UncommittedReload from "../../components/UncommittedReload.astro";
import { commits, reloadUncommitted, summaryOf } from "../../lib/gitlog.js";
import { formatDate } from "../../lib/countries.js";

if (import.meta.env.DEV) {
  Astro.response.headers.set("Cache-Control", "no-store");
  reloadUncommitted();
}
const local = commits.find((c) => c.local);
const base = import.meta.env.BASE_URL;
// grouped by month, newest first
const months = [];
for (const c of commits) {
  const m = c.date.slice(0, 7);
  if (months.at(-1)?.m !== m) months.push({ m, label: new Date(`${m}-15`).toLocaleDateString("en-GB", { month: "long", year: "numeric" }), items: [] });
  months.at(-1).items.push(c);
}
---
<Base title="Changelog" description="Every change made to the Cannabis Freedom Index, its data and its texts, newest first, each with exactly what changed.">
  <main class="changes-page gl">
    <section class="hero hero-sm">
      <p class="eyebrow">Changelog <span>{commits.length} changes</span></p>
      <h1>Every change, and what exactly changed</h1>
      <p class="lede">Everything done to the index, newest first: new history, rescored countries, rewritten articles, new datasets and changes to the site itself. Open one to see it word by word. Only the changes that moved a country's score are on <a href={`${base}score-changes/`}>Score changes</a>.</p>
      {import.meta.env.DEV && local && <UncommittedReload at={local.date} />}
    </section>
    {months.map((g) => (
      <section class="section gl-month">
        <h2 class="d-h">{g.label} <span>{g.items.length} {g.items.length === 1 ? "change" : "changes"}</span></h2>
        <ol class="gl-list">
          {g.items.map((c) => (
            <li class:list={{ "gl-local": c.local }}>
              <a href={`${base}changelog/${c.short}/`}>
                <time datetime={c.date}>{formatDate(c.date.slice(0, 10))}</time>
                <b>{c.subject}</b>
                <span class="gl-sum">{summaryOf(c).map(([n, what]) => <span><em>{n}</em> {what}</span>)}</span>
                <span class="gl-lines"><ins>+{c.add.toLocaleString("en-GB")}</ins> <del>−{c.del.toLocaleString("en-GB")}</del></span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </main>
</Base>
