---
import Base from "../layouts/Base.astro";
import { SEGMENTS, CONTEXT_NAMES, REC_LABEL, MED_LABEL, countries, places, estimateNote, segAvg } from "../lib/countries.js";
import { flatLatestPricesFor } from "../lib/prices.js";
import { SHOW_PRICES } from "../lib/config.js";
import { PLANTING_STATUS, STATUS_SECTIONS, PLANTING_TRADE } from "../lib/segment-ids.js";
import { DATASETS } from "../lib/datasets.js";
import { viewByMetric } from "../lib/map-views.js";
import { GROUPS, groupOf, POLARITY, CHART_OF } from "../lib/dataset-text.js";
import { neighboursOf } from "../lib/borders.js";

const light = places.map(({ id, slug, name, flag, region, raw, score, rank, s, rec, med, territory }) =>
  ({ id, slug, name, flag, region, raw, score, rank, s, rec, med, kind: territory?.label, fe: estimateNote(places.find((x) => x.id === id)), prices: SHOW_PRICES ? flatLatestPricesFor(id) : {}, nb: neighboursOf.get(id) ?? [] }));
const meta = {
  segments: SEGMENTS.map((s) => ({ name: s.name, weight: s.weight })),
  context: CONTEXT_NAMES,
  planting: PLANTING_STATUS,
  plantingTrade: PLANTING_TRADE,
  sections: STATUS_SECTIONS,
  rec: REC_LABEL,
  med: MED_LABEL,
  total: countries.length,
  // the outside datasets, in the groups of the profiles' Datasets tab: [id, name, group, polarity, its map or chart]
  datasets: GROUPS.flatMap((g) => Object.values(DATASETS).filter((d) => d.profile && groupOf(d) === g)
    .map((d) => [d.id, d.name, g, POLARITY[d.id] ?? 0, d.map ? `map/${viewByMetric[`data:${d.id}`].slug}/` : CHART_OF[d.id] ? `charts/#${CHART_OF[d.id]}` : `sources/#dataset-${d.id}`])),
  avg: countries.reduce((t, c) => t + c.raw, 0) / countries.length,
  avgSeg: segAvg.map((v) => +v.toFixed(2)),
};
const presets = [
  ["The legal six", "CA,UY,ZA,CZ,DE,MT"],
  ["Western Europe", "NL,ES,PT,DE,FR"],
  ["North America", "CA,US,MX"],
  ["Harshest regimes", "SG,SA,ID,PH"],
  ["A sharp border", "ZA,ZW,NA,MZ,BW"],
  ["Germany and its neighbours", "DE,PL,CZ,FR,NL,DK"],
  ["Southeast Asia", "TH,MY,SG,ID,PH,VN"],
];
---
<Base title="Compare countries" description={`Compare cannabis freedom scores${SHOW_PRICES ? ", prices" : ""}, rules and sources for several countries side by side.`}>
  <main class="compare-page">
    <section class="hero hero-sm">
      <p class="eyebrow">Compare</p>
      <h1>Compare countries side by side</h1>
      <p class="lede">Pick up to six countries to see their scores over time, the shape of their laws{SHOW_PRICES && ", latest sourced prices"}, exact rules and sources, and every outside dataset that covers them, side by side. The address bar updates as you go, so a comparison can be shared as a link.</p>
    </section>

    <div class="cmp-controls">
      <label class="field cmp-add">
        <span>Add a country</span>
        <input type="search" id="cmpInput" list="cmpList" placeholder="Start typing a name…" autocomplete="off">
        <datalist id="cmpList">
          {places.map((c) => <option value={c.name}></option>)}
        </datalist>
      </label>
      <label class="cmp-toggle"><input type="checkbox" id="cmpText" checked> Show explanations and sources</label>
      <button class="btn" id="cmpClear" hidden>Clear all</button>
    </div>
    <p class="cmp-msg" id="cmpMsg" role="status"></p>

    <div class="cmp-empty card" id="cmpEmpty">
      <h3>Nothing selected yet</h3>
      <p>Add countries above, or start from one of these:</p>
      <div class="cmp-presets">
        {presets.map(([label, ids]) => <a class="btn" href={`?c=${ids.toLowerCase()}`} data-preset={ids}>{label}</a>)}
      </div>
    </div>

    <div class="cmp-visuals" id="cmpVisuals" hidden>
      <figure class="card cmp-fig">
        <figcaption><b>The score since 1900</b><span>Each country's score at the end of each year, rebuilt from its history; dots mark the changes. Hover for a year.</span></figcaption>
        <div class="cmp-time" id="cmpTime"></div>
      </figure>
      <figure class="card cmp-fig">
        <figcaption><b>The shape of the law</b><span>The six parts of the score, 0 to 10 each; the dotted shape is the world average.</span></figcaption>
        <div class="cmp-radar" id="cmpRadar"></div>
      </figure>
    </div>

    <div class="card cmp-card" id="cmpCard" hidden>
      <table class="cmp" id="cmpTable"></table>
    </div>
    <div class="cmp-tip" id="cmpTip" hidden></div>
  </main>

  <script type="application/json" id="cmp-data" set:html={JSON.stringify(light)} />
  <script type="application/json" id="cmp-meta" set:html={JSON.stringify(meta)} />

  <script>
    import { tierOf, tierColor } from "../lib/tiers.js";

    const base = import.meta.env.BASE_URL;
    const MAX = 6;
    const $ = (sel) => document.querySelector(sel);
    const COUNTRIES = JSON.parse($("#cmp-data").textContent);
    const META = JSON.parse($("#cmp-meta").textContent);
    const byId = new Map(COUNTRIES.map((c) => [c.id, c]));
    const norm = (s) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().trim();
    const byName = new Map(COUNTRIES.map((c) => [norm(c.name), c]));
    const esc = (s) => String(s).replace(/[&<>"]/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[ch]));

    // one colour per place in the comparison, in the order they were added
    const HUES = ["#4e8fd6", "#e8833a", "#4fae6a", "#d9534f", "#a77bca", "#d6b53c"];
    const hue = (id) => HUES[selected.indexOf(id) % HUES.length];
    const SEG_IDS = ["possession", "cultivation", "enforcement", "sharing", "consumption", "access"];
    const BAND = ["Severe prohibition", "Prohibition", "Restrictive", "Tolerant", "Legal with limits", "Free"];
    const band = (v) => (v >= 60 ? 5 : v >= 40 ? 4 : v >= 25 ? 3 : v >= 15 ? 2 : v >= 5 ? 1 : 0);

    let selected = [];
    const details = new Map(); // id → explanations, fetched on demand

    // ── State ↔ URL ───────────────────────────────────────
    function readUrl() {
      const raw = new URLSearchParams(location.search).get("c") || "";
      selected = [...new Set(raw.toUpperCase().split(",").filter((id) => byId.has(id)))].slice(0, MAX);
    }
    function writeUrl() {
      const q = selected.length ? "?c=" + selected.map((id) => id.toLowerCase()).join(",") : "";
      history.replaceState(null, "", location.pathname + q);
    }
    function say(text) { $("#cmpMsg").textContent = text; }

    function add(id) {
      if (selected.includes(id)) return say(`${byId.get(id).name} is already in the comparison.`);
      if (selected.length >= MAX) return say(`You can compare up to ${MAX} countries. Remove one to add another.`);
      selected.push(id);
      say("");
      update();
    }
    function remove(id) {
      selected = selected.filter((x) => x !== id);
      say("");
      update();
    }

    async function loadDetails(id) {
      if (!details.has(id)) {
        const res = await fetch(`${base}api/${id.toLowerCase()}.json`);
        details.set(id, await res.json());
      }
    }

    // ── Rendering ─────────────────────────────────────────
    const bar = (v10) => `<div class="bar"><i style="width:${v10 * 10}%;background:${tierColor(v10 * 10)}"></i></div>`;
    const sources = (entry) => entry.src.length
      ? `<ul class="srcs">${entry.src.map(([label, url]) => `<li><a href="${esc(url)}" target="_blank" rel="noopener noreferrer">${esc(label)}</a></li>`).join("")}</ul>`
      : "";
    // seeds and clones carry a status chip each, above the text
    const plantingChip = (what, set, key, i) => `<span class="chip s-${set[key].tone}" title="${esc(set[key].help[i])}">${what}: ${set[key].label}</span>`;
    const statusChips = (entry) => entry.seeds ? `<div class="d-chips">${plantingChip("Seeds", META.planting, entry.seeds, 0)}${plantingChip("Seed sales", META.plantingTrade, entry.seeds_trade, 0)}${plantingChip("Clones", META.planting, entry.clones, 1)}${plantingChip("Clone sales", META.plantingTrade, entry.clones_trade, 1)}</div>` : "";
    const clubsChip = (entry) => entry.status ? `<div class="d-chips"><span class="chip s-${META.sections[entry.kind].statuses[entry.status].tone}" title="${esc(META.sections[entry.kind].statuses[entry.status].help)}">${META.sections[entry.kind].chip}: ${META.sections[entry.kind].statuses[entry.status].label}</span></div>` : "";
    const prose = (entry) => entry ? `${statusChips(entry)}${clubsChip(entry)}<p class="cmp-text">${esc(entry.t)}</p>${sources(entry)}` : "";
    const priceCell = (p) => p
      ? `<div class="cmp-val"><b>$${p.usd.toFixed(2)}</b><span>/g</span></div><div class="cmp-sub">${p.price} ${p.currency}/g · ${p.date}</div>`
      : `<span class="cmp-sub">No data</span>`;
    // Mark the highest value in a row, unless everyone ties.
    const bestOf = (values) => {
      const max = Math.max(...values);
      return values.length > 1 && values.some((v) => v !== max) ? max : null;
    };

    // The difference from the first country, under a figure in every later column: "+2.2 pt vs 🇨🇿"
    // with the change in per cent where it helps. `better` is 1 when higher is freer, -1 when higher
    // is harsher, 0 when neither; it colours the difference. `like` is the first figure as written,
    // whose decimals and unit the difference follows.
    const diff = (v, ref, c0, better = 0, like = "") => {
      if (!Number.isFinite(v) || !Number.isFinite(ref)) return "";
      const d = v - ref;
      const decimals = (String(like).match(/\.(\d+)/)?.[1].length) ?? (Number.isInteger(ref) && Number.isInteger(v) ? 0 : 1);
      const unit = /%\s*$/.test(like) ? " pt" : "";
      if (Math.abs(d) < 10 ** -decimals / 2) return `<span class="cmp-diff same" title="The same as ${esc(c0.name)}">=</span>`;
      const tone = better === 0 ? (d > 0 ? " more" : " less") : (d > 0) === (better > 0) ? " up" : " down";
      const text = `${d > 0 ? "▲" : "▼"} ${Math.abs(d).toLocaleString("en-GB", { minimumFractionDigits: decimals, maximumFractionDigits: decimals })}${unit}`;
      const rel = ref !== 0 && !unit ? `, ${d > 0 ? "+" : "−"}${Math.abs(Math.round((d / ref) * 100)).toLocaleString("en-GB")}%` : "";
      return `<span class="cmp-diff${tone}" title="${d > 0 ? "Higher" : "Lower"} than ${esc(c0.name)} by ${text.slice(2)}${rel}">${text}</span>`;
    };

    // years under prohibition (score under 15) from 1860, from the yearly scores; null until loaded
    function yearsBanned(id) {
      const sc = details.get(id)?.scores;
      if (!sc) return null;
      const now = new Date().getFullYear();
      let n = 0;
      for (let y = 1860; y <= now; y++) if ((sc.findLast(([yy]) => yy <= y)?.[1] ?? 100) < 15) n++;
      return n;
    }
    const spark = (pts, colour) => {
      if (!pts || pts.length < 2) return "";
      const xs = pts.map((p) => p[0]), vs = pts.map((p) => p[1]), x0 = Math.min(...xs), x1 = Math.max(...xs), top = Math.max(...vs) || 1;
      const d = pts.map(([x, v], i) => `${i ? "L" : "M"}${(((x - x0) / (x1 - x0 || 1)) * 100).toFixed(1)},${(30 - (v / top) * 26).toFixed(1)}`).join("");
      return `<svg class="cmp-spark" viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true"><path d="${d}" style="stroke:${colour}" /></svg><div class="cmp-spark-x"><span>${Math.floor(x0)}</span><span>${Math.floor(x1)}</span></div>`;
    };

    // ── The score over time and the shape of the law ─────
    function drawVisuals(cs) {
      const now = new Date().getFullYear(), X0 = 1900;
      const at = (sc, y) => sc.findLast(([yy]) => yy <= y)?.[1] ?? 100;
      const x = (y) => ((y - X0) / (now - X0)) * 100, yv = (v) => 100 - v;
      const lines = cs.map((c) => {
        const sc = details.get(c.id)?.scores;
        if (!sc) return "";
        const pts = [];
        let prev = at(sc, X0);
        pts.push(`M0,${yv(prev)}`);
        for (const [yy, v] of sc) if (yy > X0) { pts.push(`H${x(yy).toFixed(2)}V${yv(v)}`); prev = v; }
        pts.push("H100");
        return `<path class="cmp-time-line" d="${pts.join("")}" style="stroke:${hue(c.id)}" />`;
      }).join("");
      const dots = cs.map((c) => (details.get(c.id)?.changes ?? []).filter((ch) => +ch[0].slice(0, 4) >= X0)
        .map((ch) => `<i class="cmp-time-dot" style="left:${x(+ch[0].slice(0, 4) + 0.5)}%;top:${yv(ch[3])}%;background:${hue(c.id)}"></i>`).join("")).join("");
      $("#cmpTime").innerHTML = `<div class="cmp-time-y">${[0, 25, 50, 75, 100].map((t) => `<span style="top:${100 - t}%">${t}</span>`).join("")}</div>`
        + `<div class="cmp-time-plot"><svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">${[0, 15, 25, 40, 60, 100].map((t) => `<line x1="0" x2="100" y1="${yv(t)}" y2="${yv(t)}" class="cmp-time-grid" />`).join("")}${lines}</svg>${dots}<span class="cmp-time-seek" hidden></span></div>`
        + `<div class="cmp-time-x">${[1900, 1925, 1950, 1975, 2000, 2025].filter((y) => y <= now).map((y) => `<span style="left:${x(y)}%">${y}</span>`).join("")}</div>`;
      const plot = $("#cmpTime .cmp-time-plot"), seek = plot.querySelector(".cmp-time-seek"), tip = $("#cmpTip");
      plot.addEventListener("pointermove", (e) => {
        const r = plot.getBoundingClientRect(), y = Math.round(X0 + ((e.clientX - r.left) / r.width) * (now - X0));
        seek.style.left = `${x(y)}%`; seek.hidden = false;
        tip.innerHTML = `<b>${y}</b>` + cs.map((c) => {
          const d = details.get(c.id); if (!d) return "";
          const v = at(d.scores, y), ch = d.changes.filter((h) => +h[0].slice(0, 4) === y);
          return `<span class="cmp-tip-row"><i style="background:${hue(c.id)}"></i>${esc(c.name)}<em>${Math.round(v)} · ${BAND[band(v)]}</em></span>` + ch.map((h) => `<span class="cmp-tip-sub">${esc(h[1])}</span>`).join("");
        }).join("");
        tip.hidden = false;
        const w = tip.offsetWidth, h = tip.offsetHeight;
        tip.style.left = `${Math.min(innerWidth - w - 8, e.clientX + 16)}px`;
        tip.style.top = `${e.clientY + h + 24 > innerHeight ? e.clientY - h - 12 : e.clientY + 16}px`;
      });
      plot.addEventListener("pointerleave", () => { seek.hidden = true; tip.hidden = true; });
      // the radar: six corners, one shape per country over the world average
      const pt = (i, v) => { const a = -Math.PI / 2 + (i * 2 * Math.PI) / 6; return [50 + Math.cos(a) * 38 * (v / 10), 50 + Math.sin(a) * 38 * (v / 10)]; };
      const shape = (vals) => vals.map((v, i) => pt(i, v).map((n) => n.toFixed(2)).join(",")).join(" ");
      const labels = META.segments.map((seg, i) => { const [lx, ly] = pt(i, 12.2); return `<span class="cmp-radar-label" style="left:${lx}%;top:${ly}%">${esc(seg.name)}</span>`; }).join("");
      $("#cmpRadar").innerHTML = `<div class="cmp-radar-box"><svg viewBox="0 0 100 100" aria-hidden="true">${[2.5, 5, 7.5, 10].map((v) => `<polygon class="cmp-radar-ring" points="${shape([v, v, v, v, v, v])}" />`).join("")}`
        + [0, 1, 2, 3, 4, 5].map((i) => { const [a, b] = pt(i, 10); return `<line class="cmp-radar-ring" x1="50" y1="50" x2="${a}" y2="${b}" />`; }).join("")
        + (META.avgSeg ? `<polygon class="cmp-radar-avg" points="${shape(META.avgSeg)}" />` : "")
        + cs.map((c) => `<polygon class="cmp-radar-shape" points="${shape(c.s)}" style="--c:${hue(c.id)}"><title>${esc(c.name)}: ${c.s.join(", ")}</title></polygon>`).join("") + `</svg>${labels}</div>`;
    }

    function render() {
      const cs = selected.map((id) => byId.get(id));
      const showText = $("#cmpText").checked;
      const row = (label, cells, cls = "") =>
        `<tr class="${cls}"><th scope="row">${label}</th>${cells.map((html) => `<td>${html}</td>`).join("")}</tr>`;

      const head = `<thead><tr><th scope="col"><span class="visually-hidden">Segment</span></th>${cs.map((c) => `
        <th scope="col">
          <div class="cmp-head">
            <i class="cmp-hue" style="background:${hue(c.id)}"></i><span class="flag">${c.flag}</span>
            <a href="${base}country/${c.slug}/">${esc(c.name)}</a>
            <button class="cmp-x" data-remove="${c.id}" aria-label="Remove ${esc(c.name)}">✕</button>
          </div>
        </th>`).join("")}</tr></thead>`;

      const bestScore = bestOf(cs.map((c) => c.score));
      const rows = [
        row("Index", cs.map((c) => `
          <div class="cmp-score${c.score === bestScore ? " best" : ""}"><b>${c.score}</b><span>/ 100</span>${c !== cs[0] ? diff(c.score, cs[0].score, cs[0], 1, "0") : `<span class="cmp-ref">compared with</span>`}</div>
          <div class="bar"><i style="width:${c.raw}%;background:${tierColor(c.raw)}"></i></div>
          <div class="cmp-sub">${tierOf(c.raw).name}</div>${c.fe ? `<div class="cmp-sub">${esc(c.fe)}</div>` : ""}`), "cmp-index"),
        row("World rank", cs.map((c) => (c.rank ? `#${c.rank} <span class="cmp-sub">of ${META.total}</span>` : `<span class="cmp-sub">not ranked: ${c.kind}</span>`))),
        row("Recreational", cs.map((c) => `<span class="chip s-${c.rec}">${META.rec[c.rec]}</span>`)),
        row("Medical", cs.map((c) => `<span class="chip s-${c.med}">${META.med[c.med]}</span>`)),
        row("Years under prohibition<small>since 1860, scoring under 15</small>", cs.map((c) => { const y = yearsBanned(c.id); return y == null ? `<span class="cmp-sub">…</span>` : `<div class="cmp-val"><b>${y}</b><span> years</span>${c !== cs[0] ? diff(y, yearsBanned(cs[0].id), cs[0], -1, "0") : ""}</div>`; })),
        row("First rule on cannabis", cs.map((c) => { const ch = details.get(c.id)?.changes?.[0]; return ch ? `<div class="cmp-val"><b>${ch[0].slice(0, 4)}</b></div><div class="cmp-sub"><a href="${base}history/${ch[4]}/">${esc(ch[1])}</a></div>` : `<span class="cmp-sub">${details.has(c.id) ? "No dated rule" : "…"}</span>`; })),
        row("Land neighbours", cs.map((c) => c.nb.length ? `<div class="cmp-nb">${c.nb.map((id) => byId.get(id)).filter(Boolean).sort((a, b) => b.raw - a.raw).map((n) => `<button type="button" data-add="${n.id}" title="Add ${esc(n.name)} to the comparison" ${selected.includes(n.id) ? "disabled" : ""}><i style="background:${tierColor(n.raw)}"></i>${n.flag} ${esc(n.name)} <b>${n.score}</b></button>`).join("")}</div>` : `<span class="cmp-sub">None by land</span>`)),
      ];
      if (showText) rows.push(row("In short", cs.map((c) => `<p class="cmp-text">${esc(details.get(c.id)?.note ?? "")}</p>`)));

      const priceRows = [
        ["Street flower", "street"],
        ["Medical flower", "medical"],
      ].filter(([, key]) => cs.some((c) => c.prices[key]));
      if (priceRows.length) {
        rows.push(`<tr class="cmp-divider"><th colspan="${cs.length + 1}">Latest prices · per gram</th></tr>`);
        priceRows.forEach(([label, key]) => rows.push(row(label, cs.map((c) => priceCell(c.prices[key])))));
      }

      rows.push(`<tr class="cmp-divider"><th colspan="${cs.length + 1}">Scored segments</th></tr>`);
      META.segments.forEach((seg, i) => {
        const best = bestOf(cs.map((c) => c.s[i]));
        rows.push(row(`${seg.name}<small>${seg.weight}% of the index</small>`, cs.map((c) => `
          <div class="cmp-val${c.s[i] === best ? " best" : ""}"><b>${c.s[i]}</b><span>/10</span>${c !== cs[0] ? diff(c.s[i], cs[0].s[i], cs[0], 1, "0") : ""}</div>
          ${bar(c.s[i])}
          ${showText ? prose(details.get(c.id)?.segments[i]) : ""}`)));
      });

      if (showText) {
        rows.push(`<tr class="cmp-divider"><th colspan="${cs.length + 1}">More context — not part of the score</th></tr>`);
        META.context.forEach((name, i) => {
          const cells = cs.map((c) => prose(details.get(c.id)?.context[i]));
          // a section that none of the chosen countries has (the death penalty, usually) is left out
          if (cells.some(Boolean)) rows.push(row(name, cells));
        });
      }

      // the outside datasets: every one that covers at least one of the countries, in its group
      if (cs.some((c) => details.get(c.id)?.datasets)) {
        let group = null;
        for (const [id, name, g, polarity, href] of META.datasets) {
          const cells = cs.map((c) => details.get(c.id)?.datasets?.[id]);
          if (!cells.some(Boolean)) continue;
          if (g !== group) { rows.push(`<tr class="cmp-divider"><th colspan="${cs.length + 1}">Datasets · ${g} — not part of the score</th></tr>`); group = g; }
          // the highest figure is marked; for a dataset where higher is harsher, the lowest
          const nums = cells.map((x) => x?.[3]).filter((v) => Number.isFinite(v));
          const mark = nums.length > 1 && new Set(nums).size > 1 ? (polarity < 0 ? Math.min(...nums) : Math.max(...nums)) : null;
          rows.push(row(`<a href="${base}${href}">${esc(name)}</a>`, cs.map((c, k) => {
            const x = cells[k];
            if (!x) return `<span class="cmp-sub">${details.has(c.id) ? "No figure" : "…"}</span>`;
            const [big, words, year, v, pts, st] = x;
            const first = cells[0];
            return `<div class="cmp-val${polarity && v === mark ? " best" : ""}"><b>${esc(big)}</b>${k > 0 && first ? diff(v, first[3], cs[0], polarity, first[0]) : ""}</div><div class="cmp-sub">${esc(words)}${year ? ` · ${Number.isInteger(year) ? year : Math.floor(year)}` : ""}</div>`
              + spark(pts, hue(c.id)) + (st ? `<div class="cmp-stand" title="Higher than ${st.below}% of ${st.n} countries"><i style="left:${st.at * 100}%;background:${hue(c.id)}"></i></div><div class="cmp-sub">higher than ${st.below}% of ${st.n}</div>` : "");
          })));
        }
      }

      drawVisuals(cs);
      const table = $("#cmpTable");
      table.style.setProperty("--cols", cs.length);
      table.innerHTML = head + `<tbody>${rows.join("")}</tbody>`;
    }

    async function update() {
      writeUrl();
      const any = selected.length > 0;
      $("#cmpEmpty").hidden = any;
      $("#cmpCard").hidden = !any;
      $("#cmpVisuals").hidden = !any;
      $("#cmpClear").hidden = !any;
      if (!any) return;
      render(); // scores first; history, datasets and text fill in once loaded
      const before = selected.join();
      try {
        await Promise.all(selected.map(loadDetails));
      } catch (err) {
        return say("The history, datasets and explanations could not be loaded. Scores are still shown.");
      }
      if (selected.join() === before) render();
    }

    // ── Events ────────────────────────────────────────────
    const input = $("#cmpInput");
    function tryAdd() {
      const c = byName.get(norm(input.value));
      if (!c) return false;
      input.value = "";
      add(c.id);
      return true;
    }
    input.addEventListener("input", (e) => {
      // Picking from the list adds at once. While typing, wait if a longer name could still
      // follow ("Niger" → "Nigeria", "Guinea" → "Guinea-Bissau"); Enter confirms the short one.
      const typing = e.inputType === "insertText" || e.inputType === "insertCompositionText";
      const q = norm(input.value);
      const longer = COUNTRIES.some((c) => norm(c.name) !== q && norm(c.name).startsWith(q));
      if (!(typing && longer)) tryAdd();
    });
    input.addEventListener("keydown", (e) => {
      if (e.key !== "Enter") return;
      e.preventDefault();
      if (tryAdd()) return;
      // Not an exact name: accept a unique prefix match.
      const q = norm(input.value);
      const hits = q ? COUNTRIES.filter((c) => norm(c.name).startsWith(q)) : [];
      if (hits.length === 1) { input.value = ""; add(hits[0].id); }
      else say(hits.length ? "Several countries match — pick one from the list." : "No country matches that name.");
    });
    $("#cmpTable").addEventListener("click", (e) => {
      const btn = e.target.closest("[data-remove]");
      if (btn) remove(btn.dataset.remove);
      const plus = e.target.closest("[data-add]");
      if (plus) add(plus.dataset.add);
    });
    $("#cmpText").addEventListener("change", update);
    $("#cmpClear").addEventListener("click", () => { selected = []; say(""); update(); });
    document.querySelectorAll("[data-preset]").forEach((a) => a.addEventListener("click", (e) => {
      e.preventDefault();
      selected = a.dataset.preset.split(",");
      update();
    }));

    readUrl();
    update();
  </script>
</Base>
