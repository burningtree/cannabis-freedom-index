---
// State of Cannabis: the results of the current survey edition. Everything shown is a count read
// from survey/results-<year>.json; the filter buttons switch between the groups counted there.
// The page is in the main menu, after History.
import Base from "../../layouts/Base.astro";
import { survey, results, counted } from "../../lib/survey.js";
import { countries } from "../../lib/countries.js";
import { tierColor } from "../../lib/tiers.js";

const base = import.meta.env.BASE_URL;
const num = (n) => n.toLocaleString("en-GB");
const byId = new Map(countries.map((c) => [c.id, c]));
const sections = survey.sections
  .map((s) => ({ ...s, questions: counted.filter((q) => q.section === s.id && q.type !== "country" && results.questions[q.id]) }))
  .filter((s) => s.questions.length);
const pct = (count, n) => (n ? Math.round((count / n) * 100) : 0);

// ── Law against experience: one dot per country described often enough ──
const places = results.territories.map((t) => ({ ...t, c: byId.get(t.country) })).filter((t) => t.c);
const maxScore = Math.max(60, ...places.map((t) => t.c.score));
const maxPrice = Math.max(5, Math.ceil(Math.max(0, ...places.map((t) => t.price ?? 0)) / 5) * 5);
const W = 340, H = 240, PAD = { l: 34, r: 12, t: 12, b: 30 };
const plots = [
  { id: "acceptance", title: "Social acceptance", sub: "1 condemned, 5 fully accepted", lo: 1, hi: 5, ticks: [1, 2, 3, 4, 5] },
  { id: "enforcement", title: "Enforcement in practice", sub: "1 ignored, 5 strict", lo: 1, hi: 5, ticks: [1, 2, 3, 4, 5] },
  { id: "price", title: "Price of a gram", sub: "median, US dollars", lo: 0, hi: maxPrice, ticks: [0, maxPrice / 2, maxPrice] },
].map((p) => {
  const pts = places.filter((t) => t[p.id] != null);
  const x = (s) => PAD.l + (s / maxScore) * (W - PAD.l - PAD.r);
  const y = (v) => H - PAD.b - ((v - p.lo) / (p.hi - p.lo)) * (H - PAD.t - PAD.b);
  // plain correlation between the index score and what respondents report
  const mx = pts.reduce((a, t) => a + t.c.score, 0) / pts.length, my = pts.reduce((a, t) => a + t[p.id], 0) / pts.length;
  const cov = pts.reduce((a, t) => a + (t.c.score - mx) * (t[p.id] - my), 0);
  const r = cov / Math.sqrt(pts.reduce((a, t) => a + (t.c.score - mx) ** 2, 0) * pts.reduce((a, t) => a + (t[p.id] - my) ** 2, 0));
  // a correlation needs a few countries to mean anything
  return { ...p, pts, x, y, r: pts.length >= 3 && Number.isFinite(r) ? r : null };
});
const fmt = (v) => (v == null ? "–" : v.toFixed(1));
// shown in place of the country charts and table until a country has enough descriptions
const need = results.thresholds.territory;
const waiting = `No country has been described by ${need} ${need === 1 ? "person" : "people"} yet, which is the least we publish. ${num(results.observations)} ${results.observations === 1 ? "place has" : "places have"} been described so far, in ${results.countries_described} ${results.countries_described === 1 ? "country" : "countries"}.`;
---
<Base title={survey.title} description={`${survey.title}: an anonymous, community survey of how people use, grow and think about cannabis, set against the law in each country.`}>
  <main class="changes-page survey">
    <div class="sv-hero">
      <section class="hero hero-sm">
        <p class="eyebrow">Culture <span>{survey.edition} edition</span></p>
        <h1>State of Cannabis</h1>
        <p class="lede">An anonymous, yearly survey of how people use, grow and think about cannabis, and of what the places they know are really like. The index measures the law; this measures the life lived under it.</p>
        <p class="front-go"><a class="go solid" href={`${base}survey/take/`} id="svTake">Take the survey <span aria-hidden="true">→</span></a> <a class="go" href={`${base}culture/`}>About the project</a></p>
      </section>
      {/* Filled in by the script below when this browser holds a survey key; empty for everyone else. */}
      <aside class="sv-mine" id="svMine" data-edition={survey.edition} hidden></aside>
    </div>

    {results.mock && (
      <p class="sv-mock" role="note"><strong>Sample data.</strong> {survey.open ? "The survey has just opened and the first answers have not been counted yet." : "The survey has not opened yet."} Every number on this page was generated by a script to show how the results will look; none of it is a finding.</p>
    )}

    <dl class="hist-stats">
      <div><dt>Respondents</dt><dd>{num(results.respondents)}</dd></div>
      <div><dt>Countries they live in</dt><dd>{results.countries_lived}</dd></div>
      <div><dt>Places described</dt><dd>{num(results.observations)}</dd></div>
      <div><dt>Countries described</dt><dd>{results.countries_described}</dd></div>
    </dl>

    {!results.mock && results.respondents < results.thresholds.segment && (
      <p class="sv-mock" role="note"><strong>Early days.</strong> {results.respondents === 1 ? "One person has" : `${num(results.respondents)} people have`} answered so far. The charts below show their answers, but nothing can be read from so few. Country figures appear once {need} people have described the same country.</p>
    )}

    <p class="sv-note">People chose to answer this survey; nobody was sampled. The figures describe the {num(results.respondents)} people who took part, most of whom use cannabis, and not the population of any country. A group is shown only when at least {results.thresholds.segment} people are in it, and a country only when at least {results.thresholds.territory} people described it.</p>

    {/* While the numbers are invented, the word SAMPLE lies across the results (the charts and
        the country table, nothing else) and stays in the bar that follows the reader down. */}
    <div class="sv-results">
    {results.mock && <div class="sv-watermark" aria-hidden="true"></div>}
    <div class="sv-filter" id="svFilter" role="group" aria-label="Show answers from">
      {results.mock && <strong class="sv-sample-tag">Sample data, not findings</strong>}
      <span>Answers from</span>
      {results.segments.map((s, i) => (
        <button type="button" class:list={["sv-seg", { on: i === 0 }]} data-seg={s.id} aria-pressed={i === 0 ? "true" : "false"}>{s.label} <small>{num(s.n)}</small></button>
      ))}
    </div>

    {sections.map((s) => (
      <section class="section sv-section" id={s.id}>
        <div class="section-head"><div>
          <h2>{s.title}</h2>
          <p class="sub">{s.intro}</p>
        </div></div>
        <div class="sv-grid">
          {s.questions.map((q) => {
            const r = results.questions[q.id], n = r.n.all;
            const options = q.type === "scale" ? [1, 2, 3, 4, 5].map((k) => [String(k), String(k)]) : Object.entries(q.options);
            return (
              <article class:list={["sv-q", `sv-is-${q.type}`]} data-q={q.id}>
                <h3>{q.text}</h3>
                <p class="sv-meta">{q.type === "multi" && "Several answers possible · "}<span data-n>{num(n)}</span> answers{q.type === "scale" && <> · average <b data-mean>{r.mean.all?.toFixed(1)}</b> of 5</>}</p>
                {q.type === "scale" ? (
                  <>
                    <div class="sv-stack" role="img" aria-label={`Distribution of answers from 1 (${q.low}) to 5 (${q.high})`}>
                      {options.map(([k]) => <span data-o={k} style={`flex-grow:${r.counts.all[k]}`} title={`${k}: ${pct(r.counts.all[k], n)}%`}><b>{pct(r.counts.all[k], n)}%</b></span>)}
                    </div>
                    <p class="sv-ends"><span>1 · {q.low}</span><span>{q.high} · 5</span></p>
                  </>
                ) : (
                  <ul class="sv-bars">
                    {options.map(([k, label]) => (
                      <li data-o={k}>
                        <span class="sv-label">{label}</span>
                        <span class="sv-track"><i style={`width:${pct(r.counts.all[k], n)}%`}></i></span>
                        <span class="sv-pct">{pct(r.counts.all[k], n)}%</span>
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            );
          })}
        </div>
      </section>
    ))}

    <section class="section" id="law-and-life">
      <div class="section-head"><div>
        <h2>The law against the experience</h2>
        <p class="sub">Each dot is a country, placed by its <a href={`${base}#rankings`}>index score</a> from left (strict) to right (free) and by what the people who described it reported. Where the dots follow a line, life follows the law; where they scatter, it does not.</p>
      </div></div>
      {places.length === 0 && <p class="sv-empty-note">{waiting}</p>}
      <div class="sv-plots" hidden={places.length === 0}>
        {plots.map((p) => (
          <figure>
            <figcaption><b>{p.title}</b><span>{p.sub}</span></figcaption>
            <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${p.title} against index score, ${p.pts.length} countries`}>
              {p.ticks.map((t) => <><line class="sv-gridline" x1={PAD.l} x2={W - PAD.r} y1={p.y(t)} y2={p.y(t)} /><text class="sv-tick" x={PAD.l - 6} y={p.y(t) + 3} text-anchor="end">{t}</text></>)}
              {[0, maxScore / 2, maxScore].map((t) => <text class="sv-tick" x={p.x(t)} y={H - 10} text-anchor="middle">{Math.round(t)}</text>)}
              {p.pts.map((t) => (
                <a href={`${base}country/${t.c.slug}/`}>
                  <circle cx={p.x(t.c.score)} cy={p.y(t[p.id])} r={Math.max(2.5, Math.sqrt(t.n) / 2.2)} style={`--c:${tierColor(t.c.score)}`}>
                    <title>{`${t.c.name}: index ${t.c.score}, ${p.title.toLowerCase()} ${fmt(t[p.id])} (${t.n} people)`}</title>
                  </circle>
                </a>
              ))}
            </svg>
            <p class="sv-meta">Index score →{p.r != null && ` · correlation ${p.r.toFixed(2)}`} · {p.pts.length} {p.pts.length === 1 ? "country" : "countries"}</p>
          </figure>
        ))}
      </div>
    </section>

    <section class="section" id="places">
      <div class="section-head"><div>
        <h2>Places, as described</h2>
        <p class="sub">What residents and visitors reported about each country, beside its score. Scales run from 1 to 5. Prices are the median reported for a gram of flower, converted to US dollars at the European Central Bank rates of {results.rates_date}.</p>
      </div></div>
      {places.length === 0 && <p class="sv-empty-note">{waiting}</p>}
      <div class="sv-table-wrap" hidden={places.length === 0}>
        <table class="src-table sv-table">
          <thead><tr><th>Country</th><th class="num">Index</th><th class="num">People</th><th class="num">Accepted</th><th class="num">Enforced</th><th class="num">Easy to get</th><th class="num">Used openly</th><th class="num">Gram</th></tr></thead>
          <tbody>
            {places.map((t) => (
              <tr>
                <td><a href={`${base}country/${t.c.slug}/`}>{t.c.flag} {t.c.name}</a></td>
                <td class="num"><span class="sv-score" style={`--c:${tierColor(t.c.score)}`}>{t.c.score}</span></td>
                <td class="num">{num(t.n)}</td>
                <td class="num">{fmt(t.acceptance)}</td>
                <td class="num">{fmt(t.enforcement)}</td>
                <td class="num">{fmt(t.access)}</td>
                <td class="num">{pct(t.public.open ?? 0, t.n)}%</td>
                <td class="num">{t.price == null ? "–" : `$${t.price.toFixed(1)}`}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    </div>

    <section class="section" id="method">
      <div class="section-head"><div>
        <h2>How it works</h2>
      </div></div>
      <dl class="culture-themes">
        <div><dt>Anonymous</dt><dd>No account, no email, no cookie. Answers are signed with a random key made in your browser and kept there, and encrypted so that only you and the project can read them.</dd></div>
        <div><dt>Yours to change</dt><dd>The key stays with you, so you can come back to <a href={`${base}survey/me/`}>your submissions</a>, correct them or delete them. Nobody else can.</dd></div>
        <div><dt>Counted, not listed</dt><dd>Only counts are published, and only for groups large enough to hide in. Free-text answers are read by the researchers and never published as they stand.</dd></div>
        <div><dt>Open</dt><dd>The questionnaire, the counting code and the <a href={`${base}data/survey.json`}>counted results</a> are public, so anyone can check a figure or reuse it. The same core questions return every year.</dd></div>
      </dl>
    </section>
  </main>

  <script type="application/json" id="svData" set:html={JSON.stringify({ questions: results.questions })}></script>
  <script is:inline>
    // "Your answers": shown only to a browser that holds a survey key. Read straight from its
    // storage; nothing is asked of any server.
    (function () {
      var box = document.getElementById("svMine");
      try {
        var key = localStorage.getItem("cfi-survey-key");
        if (!/^[0-9a-f]{64}$/.test(key || "")) return;
        var items = (JSON.parse(localStorage.getItem("cfi-survey-" + box.dataset.edition + "-mine") || "null") || {}).items || [];
        var places = items.filter(function (i) { return i.type === "observation"; }).length;
        var sent = items.length && items.every(function (i) { return i.relays > 0; });
        var when = items.length ? new Date(Math.max.apply(null, items.map(function (i) { return i.updated; })) * 1000).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" }) : "";
        box.innerHTML = '<h2>Your answers</h2>' + (items.length
          ? '<p>You answered on ' + when + (places ? " and described " + places + " place" + (places === 1 ? "" : "s") : "") + ".</p>" +
            '<p class="sv-meta">' + (sent ? "Submitted" : "Kept in this browser, not sent") + "</p>"
          : "<p>This browser has a survey key but no answers stored under it.</p>") +
          '<p class="sv-actions"><a class="go" href="me/">Your submissions →</a></p>' +
          '<p class="sv-small">Found by a key kept in this browser only. You can change or delete what you submitted.</p>';
        box.hidden = false;
        if (items.length) document.getElementById("svTake").firstChild.textContent = "Change your answers ";
      } catch (e) {}
    })();

    // Filter buttons: redraw every bar from the counts of the chosen group.
    (function () {
      var data = JSON.parse(document.getElementById("svData").textContent).questions;
      var filter = document.getElementById("svFilter");
      var fmt = function (n) { return n.toLocaleString("en-GB"); };
      filter.addEventListener("click", function (e) {
        var btn = e.target.closest("button[data-seg]");
        if (!btn) return;
        var seg = btn.dataset.seg;
        filter.querySelectorAll("button").forEach(function (b) { b.classList.toggle("on", b === btn); b.setAttribute("aria-pressed", b === btn ? "true" : "false"); });
        document.querySelectorAll(".sv-q").forEach(function (el) {
          var q = data[el.dataset.q], n = q.n[seg] || 0, counts = q.counts[seg] || {};
          el.classList.toggle("sv-empty", !n);
          el.querySelector("[data-n]").textContent = fmt(n);
          var mean = el.querySelector("[data-mean]");
          if (mean) mean.textContent = q.mean[seg] != null ? q.mean[seg].toFixed(1) : "–";
          el.querySelectorAll("[data-o]").forEach(function (row) {
            var p = n ? Math.round(((counts[row.dataset.o] || 0) / n) * 100) : 0;
            if (row.tagName === "LI") { row.querySelector("i").style.width = p + "%"; row.querySelector(".sv-pct").textContent = p + "%"; }
            else { row.style.flexGrow = counts[row.dataset.o] || 0; row.title = row.dataset.o + ": " + p + "%"; row.querySelector("b").textContent = p + "%"; }
          });
        });
      });
    })();
  </script>
</Base>
