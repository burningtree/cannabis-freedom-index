---
// State of Cannabis: the questionnaire. Built from survey/<year>.yaml; the script at the bottom
// shows one section at a time, hides questions that do not apply, keeps a draft in the browser
// and, on "Submit", hands the answers to src/lib/survey-client.js. Someone who has already submitted gets their
// answers back to edit.
import Base from "../../layouts/Base.astro";
import { survey, submitConfig, currencyOf } from "../../lib/survey.js";
import Question from "../../components/Question.astro";

const base = import.meta.env.BASE_URL;
const cond = (x) => (x.if ? JSON.stringify(x.if) : undefined);
---
<Base title={`Take the survey: ${survey.title}`} description="Answer the State of Cannabis survey: anonymous, no account, about ten minutes. Describe how you use, grow or think about cannabis, and what the countries you know are like.">
  <main class="changes-page survey sv-take">
    <section class="hero hero-sm">
      <p class="eyebrow"><a href={`${base}survey/`}>State of Cannabis</a> <span>{survey.edition} edition</span></p>
      <h1>Take the survey</h1>
    </section>

    {!submitConfig.open && (
      <p class="sv-mock" role="note" id="svClosed"><strong>Not open yet.</strong> You can go through the whole questionnaire. Pressing Submit keeps your answers in this browser and sends nothing; you can send them once the survey opens.</p>
    )}

    <form id="svForm" class="sv-form" novalidate data-config={JSON.stringify(submitConfig)} data-currency={JSON.stringify(currencyOf)}>
      <ol class="sv-steps" id="svSteps" aria-label="Sections"></ol>

      <section class="sv-step" data-step="start" data-title="Start">
        <h2>Before you begin</h2>
        <ul class="sv-points">
          <li>It takes about ten minutes. Every question except four is optional, and whole sections are skipped when they do not apply to you.</li>
          <li>There is no account, no email and no cookie. A draft is kept in this browser only, so you can come back to it.</li>
          <li>You can change or delete your answers later, from this browser.</li>
          <li>People who have never used cannabis are as welcome as people who grow it.</li>
          <li>Only counts are published. What you write in text boxes is read by the researchers and never published as it stands.</li>
        </ul>
        <p class="sv-editing" id="svEditing" hidden></p>
        <label class="sv-check"><input type="checkbox" id="svAdult" /> <span>I am 18 or older and I am answering for myself.</span></label>
      </section>

      {survey.sections.map((s) => (
        <section class="sv-step" data-step={s.id} data-title={s.title} data-if={cond(s)} hidden>
          <h2>{s.title}</h2>
          <p class="sub">{s.intro}</p>
          {s.questions.map((q) => <Question q={q} />)}
        </section>
      ))}

      <section class="sv-step" data-step="places" data-title={survey.territory.title} hidden>
        <h2>{survey.territory.title}</h2>
        <p class="sub">{survey.territory.intro}</p>
        <div id="svPlaces"></div>
        <p><button type="button" class="go" id="svAddPlace">+ Add a place</button></p>
        <template id="svPlaceTpl">
          <fieldset class="sv-place">
            <legend>Place <span data-nr></span> <button type="button" class="sv-remove" data-remove>Remove</button></legend>
            {survey.territory.questions.map((q) => <Question q={q} />)}
          </fieldset>
        </template>
      </section>

      <section class="sv-step" data-step="send" data-title="Submit" hidden>
        <h2>Submit</h2>
        <p class="sub" id="svSummary"></p>
        <h3>What happens when you press the button</h3>
        <ul class="sv-points">
          <li>The first time, your browser makes a random key and keeps it in its own storage. It is a pseudonym: it carries no name, email or account, and nobody can tell whose it is.</li>
          <li>Your personal answers and each place you described are signed with that key and encrypted so that only you and this project can read them. They are sent to public <a href="https://nostr.com/" target="_blank" rel="noopener noreferrer">Nostr</a> relays, which store them. A relay, like any server, can see the address you connect from; use a VPN or Tor if that matters to you.</li>
          <li>Because the key stays in this browser, you can come back to <a href={`${base}survey/me/`}>your submissions</a> to change or delete them. Everything signed with one key belongs together, so your places are linked to your personal answers, but not to you.</li>
          <li>If you clear this browser's data without backing the key up, your answers stay in the survey and you can no longer change them.</li>
        </ul>
        <p><button type="submit" class="go solid" id="svSubmit">Submit survey <span aria-hidden="true">→</span></button></p>
        <div id="svResult" class="sv-result" aria-live="polite"></div>
      </section>

      <p class="sv-nav">
        <button type="button" class="go" id="svBack" hidden>← Back</button>
        <button type="button" class="go solid" id="svNext">Start <span aria-hidden="true">→</span></button>
        <span class="sv-error" id="svError" role="alert"></span>
      </p>
    </form>
  </main>

  <script>
    const form = document.getElementById("svForm");
    const cfg = JSON.parse(form.dataset.config);
    const DRAFT = `cfi-survey-${cfg.edition}`;
    const $ = (sel, root = form) => root.querySelector(sel);
    const $$ = (sel, root = form) => [...root.querySelectorAll(sel)];
    const steps = $$(".sv-step");
    const places = document.getElementById("svPlaces");
    const error = document.getElementById("svError");
    let current = 0;

    // ── Reading the answers out of a block of questions ──
    // Questions that do not apply (data-off) and sections that are skipped (data-skip) are left
    // out, unless `everything` is set, which is how the conditions themselves are evaluated.
    function read(root, everything = false) {
      const out = {};
      for (const el of $$(".sv-field", root)) {
        if (!everything && el.closest('[data-off="1"], [data-skip="1"]')) continue;
        const id = el.dataset.q, type = el.dataset.type;
        if (type === "multi") { const v = $$("input:checked", el).map((i) => i.value); if (v.length) out[id] = v; }
        else if (type === "single") { const v = $("input:checked", el)?.value; if (v) out[id] = v; }
        else if (type === "scale") { const v = $("input:checked", el)?.value; if (v) out[id] = +v; }
        else if (type === "number") { const v = parseFloat($("input", el).value.replace(/\s/g, "").replace(",", ".")); if (v > 0) out[id] = v; }
        // a currency says nothing without the price it belongs to
        else if (type === "currency") { if (parseFloat($(".sv-number", root)?.value.replace(",", ".")) > 0) out[id] = $("select", el).value; }
        else { const v = $("select, textarea", el).value.trim(); if (v) out[id] = v; }
      }
      return out;
    }
    function write(root, answers) {
      for (const el of $$(".sv-field", root)) {
        const v = answers[el.dataset.q];
        if (v == null) continue;
        const values = [].concat(v).map(String);
        if (["multi", "single", "scale"].includes(el.dataset.type)) for (const i of $$("input", el)) i.checked = values.includes(i.value);
        else $("select, textarea, input", el).value = v;
      }
    }
    const own = steps.filter((s) => !["start", "places", "send"].includes(s.dataset.step));
    const personal = () => Object.assign({}, ...own.map((s) => read(s)));
    const described = () => $$(".sv-place", places).map((el) => ({ id: el.dataset.id, answers: read(el) })).filter((p) => p.answers.country);

    // ── Conditions: `data-if` holds {question: [options]}; any match shows the element ──
    function applies(el, answers) {
      if (!el.dataset.if) return true;
      return Object.entries(JSON.parse(el.dataset.if)).some(([q, options]) => [].concat(answers[q] ?? []).some((v) => options.includes(v)));
    }
    function refresh() {
      const answers = Object.assign({}, ...own.map((s) => read(s, true)));
      for (const el of $$(".sv-field[data-if]")) { const on = applies(el, answers); el.hidden = !on; el.dataset.off = on ? "" : "1"; }
      for (const s of steps) s.dataset.skip = applies(s, answers) ? "" : "1";
      drawSteps();
    }

    // ── Steps ──
    const active = () => steps.filter((s) => !s.dataset.skip);
    function drawSteps() {
      const list = document.getElementById("svSteps"), on = active();
      list.innerHTML = on.map((s, i) => `<li${s === steps[current] ? ' aria-current="step"' : ""}${on.indexOf(steps[current]) > i ? ' class="done"' : ""}><span>${String(i + 1).padStart(2, "0")}</span> ${s.dataset.title}</li>`).join("");
    }
    function show(step) {
      current = steps.indexOf(step);
      steps.forEach((s) => (s.hidden = s !== step));
      const on = active(), i = on.indexOf(step);
      document.getElementById("svBack").hidden = i === 0;
      const next = document.getElementById("svNext");
      next.hidden = i === on.length - 1;
      next.firstChild.textContent = i === 0 ? "Start " : on[i + 1]?.dataset.step === "send" ? "Review and submit " : "Next ";
      error.textContent = "";
      if (step.dataset.step === "send") {
        const a = Object.keys(personal()).length, p = described().length;
        document.getElementById("svSummary").textContent = `You answered ${a} question${a === 1 ? "" : "s"} and described ${p} place${p === 1 ? "" : "s"}.`;
      }
      drawSteps();
      form.scrollIntoView({ block: "start" });
    }
    // a section may be left only when its required questions are answered
    function missing(step) {
      if (step.dataset.step === "start") return document.getElementById("svAdult").checked ? null : "Please confirm that you are 18 or older.";
      const blocks = step.dataset.step === "places" ? $$(".sv-place", places).filter((p) => Object.keys(read(p)).length) : [step];
      for (const b of blocks) {
        const got = read(b);
        const need = $$('.sv-field[data-required]', b).find((el) => !el.hidden && got[el.dataset.q] == null);
        if (need) { need.scrollIntoView({ block: "center" }); return `Please answer: ${need.dataset.label}`; }
      }
      return null;
    }
    document.getElementById("svNext").addEventListener("click", () => {
      const problem = missing(steps[current]);
      if (problem) { error.textContent = problem; return; }
      refresh();
      const on = active();
      show(on[on.indexOf(steps[current]) + 1]);
    });
    document.getElementById("svBack").addEventListener("click", () => { const on = active(); show(on[on.indexOf(steps[current]) - 1]); });

    // ── Places: a repeatable block ──
    let placeCount = 0;
    function addPlace(answers, id) {
      const node = document.getElementById("svPlaceTpl").content.cloneNode(true);
      const n = ++placeCount;
      // radio groups must not be shared between two places
      for (const i of $$("input[name]", node)) i.name = `${i.name}__${n}`;
      for (const l of $$("[for]", node)) l.htmlFor = `${l.htmlFor}__${n}`;
      for (const i of $$("[id]", node)) i.id = `${i.id}__${n}`;
      for (const i of $$("[aria-labelledby]", node)) i.setAttribute("aria-labelledby", `${i.getAttribute("aria-labelledby")}__${n}`);
      places.append(node);
      // the id under which this place is stored and, later, replaced
      places.lastElementChild.dataset.id = id ?? [...crypto.getRandomValues(new Uint8Array(6))].map((b) => b.toString(16).padStart(2, "0")).join("");
      if (answers) write(places.lastElementChild, answers);
      renumber();
    }
    const renumber = () => $$(".sv-place", places).forEach((p, i) => ($("[data-nr]", p).textContent = i + 1));
    document.getElementById("svAddPlace").addEventListener("click", () => addPlace());
    places.addEventListener("click", (e) => { if (e.target.closest("[data-remove]")) { e.target.closest(".sv-place").remove(); renumber(); save(); } });

    // ── Draft, in this browser only ──
    function save() {
      try { localStorage.setItem(DRAFT, JSON.stringify({ adult: document.getElementById("svAdult").checked, answers: personal(), places: $$(".sv-place", places).map((el) => ({ id: el.dataset.id, answers: read(el) })) })); } catch {}
    }
    // What was submitted from this browser before, if anything (written by survey-client.js).
    function submitted() { try { return JSON.parse(localStorage.getItem(`cfi-survey-${cfg.edition}-mine`) ?? "null")?.items ?? []; } catch { return []; } }
    function restore() {
      try {
        let d = JSON.parse(localStorage.getItem(DRAFT) ?? "null");
        const before = submitted();
        if (before.length) {
          // editing: start from what was submitted, unless a newer draft is in progress
          d ??= { adult: true, answers: before.find((i) => i.type === "response")?.answers ?? {}, places: before.filter((i) => i.type === "observation").map((i) => ({ id: i.id, answers: i.answers })) };
          const note = document.getElementById("svEditing");
          note.hidden = false;
          note.innerHTML = `You have already submitted from this browser. You are <strong>editing those answers</strong>: submitting again replaces them. <a href="../me/">Your submissions →</a>`;
        }
        if (!d) return;
        document.getElementById("svAdult").checked = Boolean(d.adult);
        for (const s of steps) write(s, d.answers ?? {});
        for (const p of d.places ?? []) addPlace(p.answers ?? p, p.id);
      } catch {}
    }
    form.addEventListener("change", () => { refresh(); save(); });
    form.addEventListener("input", (e) => { if (e.target.matches("textarea, .sv-number")) save(); });
    // Choosing a country suggests its currency for the price, until the respondent picks one.
    const CURRENCY = JSON.parse(form.dataset.currency);
    places.addEventListener("change", (e) => {
      const block = e.target.closest(".sv-place"), money = block && $('[data-type="currency"] select', block);
      if (!money) return;
      if (e.target === money) money.dataset.chosen = "1";
      else if (e.target.name?.startsWith("country") && !money.dataset.chosen && !$(".sv-number", block).value) money.value = CURRENCY[e.target.value] ?? "USD";
    });

    // ── Submit ──
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const button = document.getElementById("svSubmit"), result = document.getElementById("svResult");
      button.disabled = true;
      result.textContent = "Signing…";
      try {
        const client = await import("../../lib/survey-client.js");
        const live = client.effective(cfg);
        const now = Math.floor(Date.now() / 1000);
        const items = [{ type: "response", id: "response", answers: personal() }, ...described().map((p) => ({ type: "observation", id: p.id, answers: p.answers }))];
        // places that were submitted before and are no longer in the form are removed
        const gone = client.mine(live).items.filter((old) => !items.some((i) => i.id === old.id));
        for (const i of items) { i.event = client.sign(live, i); i.updated = now; i.relays = 0; }
        const removals = gone.map((old) => client.sign(live, old, true));
        client.remember(live, { items });
        try { localStorage.removeItem(DRAFT); } catch {}
        const parts = `${items.length} part${items.length === 1 ? "" : "s"}`;
        if (!live.open) {
          result.innerHTML = `<p><strong>Saved in this browser. Nothing was sent.</strong> The survey is not open yet, so your ${parts} ${items.length === 1 ? "is" : "are"} signed and waiting here. You can send from your submissions once it opens.</p><p><a class="go solid" href="../me/">Your submissions →</a></p>`;
          button.hidden = true;
          return;
        }
        result.textContent = "Sending…";
        const sent = await client.publish(live, [...items.map((i) => i.event), ...removals, ...(gone.length ? [client.deletion(live, gone.map((g) => g.event))] : [])]);
        items.forEach((i, k) => (i.relays = sent[k].relays));
        client.remember(live, { items });
        if (items.every((i) => i.relays > 0)) {
          result.innerHTML = `<p><strong>Thank you.</strong> Your ${parts} ${items.length === 1 ? "is" : "are"} stored on ${Math.min(...items.map((i) => i.relays))} of ${live.relays.length} relay${live.relays.length === 1 ? "" : "s"}. You can change or delete what you sent at any time from this browser.</p><p><a class="go solid" href="../me/">Your submissions →</a> <a class="go" href="../">See the results</a></p>`;
          button.hidden = true;
        } else {
          result.innerHTML = `<p><strong>Not sent.</strong> No relay accepted ${items.filter((i) => !i.relays).length} of the ${parts}${sent.find((r) => r.error) ? ` (${sent.find((r) => r.error).error})` : ""}. They are saved in this browser; try again here or from <a href="../me/">your submissions</a>.</p>`;
          button.disabled = false;
        }
      } catch (err) {
        result.textContent = `Something went wrong: ${err.message}. Your answers are still in this browser.`;
        button.disabled = false;
      }
    });

    try { if (JSON.parse(localStorage.getItem("cfi-survey-test") ?? "null")?.relays?.length) { const b = document.getElementById("svClosed"); if (b) b.innerHTML = "<strong>Test mode.</strong> Answers are sent to the relays set under <code>cfi-survey-test</code> in this browser's storage."; } } catch {}
    restore();
    if (!$$(".sv-place", places).length) addPlace();
    refresh();
    // "Edit" links from /survey/me/ open the form where the editing is to happen:
    // #edit the first section of the report, #place-<id> that place, #place-new a fresh one.
    const target = location.hash.slice(1);
    if (submitted().length && target === "edit") show(own[0]);
    else if (submitted().length && target.startsWith("place-")) {
      show(steps.find((s) => s.dataset.step === "places"));
      let block = $$(".sv-place", places).find((p) => p.dataset.id === target.slice(6));
      if (target === "place-new") { if (Object.keys(read(places.lastElementChild)).length) addPlace(); block = places.lastElementChild; }
      block?.scrollIntoView({ block: "start" });
      block?.classList.add("sv-focus");
    } else show(steps[0]);
  </script>
</Base>
