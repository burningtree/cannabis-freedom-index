---
// State of Cannabis: the questionnaire. Built from survey/<year>.yaml; the script at the bottom
// shows one section at a time, hides questions that do not apply, keeps a draft in the browser
// and, on "Submit", hands the answers to src/lib/survey-client.js. Someone who has already submitted gets their
// answers back to edit.
import Base from "../../layouts/Base.astro";
import { survey, submitConfig, currencyOf } from "../../lib/survey.js";
import Question from "../../components/Question.astro";
import { countries, subunitsOf } from "../../lib/countries.js";

const base = import.meta.env.BASE_URL;
// the states and provinces asked for when a federation is chosen: { US: [[id, name], …] }
const regions = Object.fromEntries(countries.filter((c) => subunitsOf(c.id)).map((c) => [c.id, subunitsOf(c.id).units.map((u) => [u.id, u.name]).sort((a, b) => a[1].localeCompare(b[1]))]));
const cond = (x) => (x.if ? JSON.stringify(x.if) : undefined);
---
<Base title={`Take the survey: ${survey.title}`} description="Answer the State of Cannabis survey: no account, encrypted, about ten minutes. Describe how you use, grow or think about cannabis, and what the countries you know are like.">
  <main class="changes-page survey sv-take">
    <section class="hero hero-sm">
      <p class="eyebrow"><a href={`${base}survey/`}>State of Cannabis</a> <span>{survey.edition} edition</span></p>
      <h1>Take the survey</h1>
    </section>

    {!submitConfig.open && (
      <p class="sv-mock" role="note" id="svClosed"><strong>Not open yet.</strong> You can go through the whole questionnaire. Pressing Submit keeps your answers in this browser and sends nothing; you can send them once the survey opens.</p>
    )}

    <form id="svForm" class="sv-form" novalidate data-config={JSON.stringify(submitConfig)} data-currency={JSON.stringify(currencyOf)} data-regions={JSON.stringify(regions)} data-cities={`${base}survey-cities/`}>
      <ol class="sv-steps" id="svSteps" aria-label="Sections"></ol>

      <section class="sv-step" data-step="start" data-title="Start">
        <h2>What this is</h2>
        <div class="sv-about">
          <p>State of Cannabis is a yearly survey run by the Cannabis Freedom Index. The index scores what the law allows in every country. This survey asks the people who live under those laws about the rest: what they do, what they believe, and what they see around them.</p>
          <p>It is for everyone, whether you use cannabis, grow it, study it or have never touched it. The answers are counted and <a href={`${base}survey/`}>published openly</a> each year, beside each country's score, so that law and life can be compared. <a href={`${base}culture/stories/`}>More about the project →</a></p>
        </div>
        <h3>Before you begin</h3>
        <ul class="sv-points">
          <li>It takes about ten minutes. Almost every question is optional, and whole sections are skipped when they do not apply to you.</li>
          <li>There are three parts: a yearly survey about you, reports on places you know, and prices you know. You can do any of them, and add places and prices later.</li>
          <li>There is no account, no email and no cookie, and your answers are stored encrypted under a random key. That makes the survey pseudonymous, not perfectly anonymous: a rare combination of country, age and experience can still narrow down who answered, so leave out anything you would not want guessed.</li>
          <li>A draft is kept in this browser only, so you can come back to it.</li>
          <li>You can change or delete your answers later, from this browser.</li>
          <li>People who have never used cannabis are as welcome as people who grow it.</li>
          <li>Only counts are published. What you write in text boxes is read by the researchers and never published as it stands.</li>
        </ul>
        <p class="sv-editing" id="svEditing" hidden></p>
        <label class="sv-check"><input type="checkbox" id="svAdult" /> <span>I am {survey.min_age} or older and I am answering for myself.</span></label>
      </section>

      {survey.sections.map((s) => (
        <section class="sv-step" data-step={s.id} data-title={s.title} data-if={cond(s)} hidden>
          <h2>{s.title}</h2>
          <p class="sub">{s.intro}</p>
          {s.questions.map((q) => <Question q={q} />)}
        </section>
      ))}

      {/* The two repeatable kinds of report: places, then prices. Each block is its own entry. */}
      {[["places", "place", survey.territory], ["prices", "price", survey.prices]].map(([step, noun, part]) => (
        <section class="sv-step" data-step={step} data-title={part.title} hidden>
          <h2>{part.title}</h2>
          <p class="sub">{part.intro}</p>
          <div class="sv-blocks" data-holder={step}></div>
          <p><button type="button" class="go" data-add={step}>+ Add a {noun}</button></p>
          <template data-tpl={step}>
            <fieldset class="sv-place" data-kind={step}>
              <legend><span class="sv-noun">{noun}</span> <span data-nr></span> <button type="button" class="sv-remove" data-remove>Remove</button></legend>
              {part.questions.map((q) => <Question q={q} />)}
            </fieldset>
          </template>
        </section>
      ))}

      <section class="sv-step" data-step="send" data-title="Submit" hidden>
        <h2>Submit</h2>
        <p class="sub" id="svSummary"></p>
        <h3>What happens when you press the button</h3>
        <ul class="sv-points">
          <li>The first time, your browser makes a random key and keeps it in its own storage. It is a pseudonym: it carries no name, email or account, and nobody can tell whose it is.</li>
          <li>Your survey, each place report and each price are signed with that key and encrypted so that only you and this project can read them. They are sent to public <a href="https://nostr.com/" target="_blank" rel="noopener noreferrer">Nostr</a> relays, which store them. A relay, like any server, can see the address you connect from; use a VPN or Tor if that matters to you.</li>
          <li>Because the key stays in this browser, you can come back to <a href={`${base}survey/me/`}>your submissions</a> to change or delete them. Deleting replaces each message with an empty one and asks every relay to remove it; most do, but a relay that does not may keep an encrypted copy. Everything signed with one key belongs together, so your places and prices are linked to your survey answers, though not to your name.</li>
          <li>If you clear this browser's data without backing the key up, your answers stay in the survey and you can no longer change them.</li>
        </ul>
        <p><button type="submit" class="go solid" id="svSubmit">Submit survey <span aria-hidden="true">→</span></button></p>
        <div id="svResult" class="sv-result" aria-live="polite"></div>
      </section>

      <p class="sv-credit">City suggestions come from <a href="https://github.com/datasets/world-cities" target="_blank" rel="noopener noreferrer">world-cities</a>, built on <a href="https://www.geonames.org/" target="_blank" rel="noopener noreferrer">GeoNames</a> (CC BY 4.0).</p>
      <p class="sv-nav">
        <button type="button" class="go" id="svBack" hidden>← Back</button>
        <button type="button" class="go solid" id="svNext">Start <span aria-hidden="true">→</span></button>
        <span class="sv-error" id="svError" role="alert"></span>
      </p>
    </form>
  </main>

  <script>
    const form = document.getElementById("svForm");
    const cfg = JSON.parse(form.dataset.config);
    const DRAFT = `cfi-survey-${cfg.edition}`;
    const $ = (sel, root = form) => root.querySelector(sel);
    const $$ = (sel, root = form) => [...root.querySelectorAll(sel)];
    const steps = $$(".sv-step");
    // The repeatable reports: where their blocks live, what they are stored as, and the question
    // that makes a block count (an untouched block is not a report).
    const REPEATS = [
      { step: "places", type: "observation", key: "country", noun: "place" },
      { step: "prices", type: "price", key: "p_country", noun: "price" },
    ].map((r) => ({ ...r, holder: form.querySelector(`[data-holder="${r.step}"]`), tpl: form.querySelector(`[data-tpl="${r.step}"]`) }));
    const repeat = (step) => REPEATS.find((r) => r.step === step);
    const error = document.getElementById("svError");
    let current = 0;

    // ── Reading the answers out of a block of questions ──
    // Questions that do not apply (data-off) and sections that are skipped (data-skip) are left
    // out, unless `everything` is set, which is how the conditions themselves are evaluated.
    function read(root, everything = false) {
      const out = {};
      for (const el of $$(".sv-field", root)) {
        if (!everything && el.closest('[data-off="1"], [data-skip="1"]')) continue;
        const id = el.dataset.q, type = el.dataset.type;
        if (type === "multi") { const v = $$("input:checked", el).map((i) => i.value); if (v.length) out[id] = v; }
        else if (type === "single") { const v = $("input:checked", el)?.value; if (v) out[id] = v; }
        else if (type === "scale") { const v = $("input:checked", el)?.value; if (v) out[id] = +v; }
        else if (type === "number") { const v = parseFloat($("input", el).value.replace(/\s/g, "").replace(",", ".")); if (v > 0) out[id] = v; }
        // a currency says nothing without the price it belongs to
        else if (type === "city") { const v = $("input", el).value.trim(); if (v) out[id] = v; }
        else if (type === "currency") { if (parseFloat($(".sv-number", root)?.value.replace(",", ".")) > 0) out[id] = $("select", el).value; }
        else { const v = $("select, textarea", el).value.trim(); if (v) out[id] = v; }
      }
      return out;
    }
    function write(root, answers) {
      for (const el of $$(".sv-field", root)) {
        const v = answers[el.dataset.q];
        if (v == null) continue;
        const values = [].concat(v).map(String);
        if (el.dataset.type === "region") fillRegion(el, el.closest(".sv-place") ?? root); // its options depend on the country just written
        if (["multi", "single", "scale"].includes(el.dataset.type)) for (const i of $$("input", el)) i.checked = values.includes(i.value);
        else $("select, textarea, input", el).value = v;
      }
    }
    const own = steps.filter((s) => !["start", "places", "prices", "send"].includes(s.dataset.step));
    const personal = () => Object.assign({}, ...own.map((s) => read(s)));
    const blocksOf = (r) => $$(".sv-place", r.holder);
    // every filled-in report, of both kinds, ready to be stored
    const reports = (r) => blocksOf(r).map((el) => ({ type: r.type, id: el.dataset.id, answers: read(el) })).filter((x) => x.answers[r.key]);
    const allReports = () => REPEATS.flatMap(reports);

    // ── State and city: both depend on the country chosen beside them ──
    const REGIONS = JSON.parse(form.dataset.regions), CITIES = form.dataset.cities;
    const scopeOf = (el) => el.closest(".sv-place") ?? el.closest(".sv-step");
    const countryIn = (scope, of) => $(`.sv-field[data-q="${of}"] select`, scope)?.value ?? "";
    const cityLists = new Map(); // country → promise of [[city, state], …], fetched once
    const citiesOf = (country) => {
      if (!cityLists.has(country)) cityLists.set(country, fetch(`${CITIES}${country}.json`).then((r) => (r.ok ? r.json() : [])).catch(() => []));
      return cityLists.get(country);
    };
    // the state question lists the states of the chosen country, and is asked only for a federation
    function fillRegion(field, scope) {
      const country = countryIn(scope, field.dataset.of), list = REGIONS[country], select = $("select", field);
      if (select.dataset.country !== country) {
        select.dataset.country = country;
        select.innerHTML = '<option value="">Choose…</option>' + (list ?? []).map(([id, name]) => `<option value="${id}">${name}</option>`).join("");
      }
      field.hidden = !list;
      field.dataset.off = list ? "" : "1";
    }
    // the city box suggests that country's cities, narrowed to the chosen state where there is one
    async function fillCities(field, scope) {
      const country = countryIn(scope, field.dataset.of);
      field.hidden = !country;
      field.dataset.off = country ? "" : "1";
      if (!country) return;
      const state = $('.sv-field[data-type="region"] select', scope), stateName = state?.selectedOptions[0]?.value ? state.selectedOptions[0].textContent : "";
      const list = (await citiesOf(country)).filter(([, sub]) => !stateName || sub === stateName);
      const seen = new Set();
      $("datalist", field).innerHTML = list.filter(([name]) => !seen.has(name) && seen.add(name)).map(([name, sub]) => `<option value="${name.replace(/"/g, "&quot;")}">${sub}</option>`).join("");
    }
    function syncPlace(scope) {
      for (const f of $$('.sv-field[data-type="region"]', scope)) fillRegion(f, scope);
      for (const f of $$('.sv-field[data-type="city"]', scope)) fillCities(f, scope);
    }
    form.addEventListener("change", (e) => {
      const field = e.target.closest(".sv-field");
      if (field && ["country", "region"].includes(field.dataset.type)) syncPlace(scopeOf(field));
    });

    // ── Conditions: `data-if` holds {question: [options]}; any match shows the element ──
    function applies(el, answers) {
      if (!el.dataset.if) return true;
      return Object.entries(JSON.parse(el.dataset.if)).some(([q, options]) => [].concat(answers[q] ?? []).some((v) => options.includes(v)));
    }
    function refresh() {
      const answers = Object.assign({}, ...own.map((s) => read(s, true)));
      for (const el of $$(".sv-field[data-if]")) { const on = applies(el, answers); el.hidden = !on; el.dataset.off = on ? "" : "1"; }
      for (const s of steps) s.dataset.skip = applies(s, answers) ? "" : "1";
      drawSteps();
    }

    // ── Steps ──
    const active = () => steps.filter((s) => !s.dataset.skip);
    function drawSteps() {
      const list = document.getElementById("svSteps"), on = active();
      list.innerHTML = on.map((s, i) => `<li${s === steps[current] ? ' aria-current="step"' : ""}${on.indexOf(steps[current]) > i ? ' class="done"' : ""}><span>${String(i + 1).padStart(2, "0")}</span> ${s.dataset.title}</li>`).join("");
    }
    function show(step) {
      current = steps.indexOf(step);
      steps.forEach((s) => (s.hidden = s !== step));
      const on = active(), i = on.indexOf(step);
      document.getElementById("svBack").hidden = i === 0;
      const next = document.getElementById("svNext");
      next.hidden = i === on.length - 1;
      next.firstChild.textContent = i === 0 ? "Start " : on[i + 1]?.dataset.step === "send" ? "Review and submit " : "Next ";
      error.textContent = "";
      if (step.dataset.step === "send") {
        const a = Object.keys(personal()).length, [p, m] = REPEATS.map((r) => reports(r).length);
        document.getElementById("svSummary").textContent = `You answered ${a} question${a === 1 ? "" : "s"}, reported on ${p} place${p === 1 ? "" : "s"} and gave ${m} price${m === 1 ? "" : "s"}.`;
      }
      drawSteps();
      form.scrollIntoView({ block: "start" });
    }
    // a section may be left only when its required questions are answered
    function missing(step) {
      if (step.dataset.step === "start") return document.getElementById("svAdult").checked ? null : `Please confirm that you are ${cfg.min_age} or older.`;
      const r = repeat(step.dataset.step);
      const blocks = r ? blocksOf(r).filter((b) => Object.keys(read(b)).length) : [step];
      for (const b of blocks) {
        const got = read(b);
        const need = $$('.sv-field[data-required]', b).find((el) => !el.hidden && got[el.dataset.q] == null);
        if (need) { need.scrollIntoView({ block: "center" }); return `Please answer: ${need.dataset.label}`; }
      }
      return null;
    }
    document.getElementById("svNext").addEventListener("click", () => {
      const problem = missing(steps[current]);
      if (problem) { error.textContent = problem; return; }
      refresh();
      const on = active();
      show(on[on.indexOf(steps[current]) + 1]);
    });
    document.getElementById("svBack").addEventListener("click", () => { const on = active(); show(on[on.indexOf(steps[current]) - 1]); });

    // ── Repeatable blocks: places and prices ──
    let blockCount = 0;
    function add(r, answers, id) {
      const node = r.tpl.content.cloneNode(true);
      const n = ++blockCount;
      // radio groups and labels must not be shared between two blocks
      for (const i of $$("input[name], select[name], textarea[name]", node)) i.name = `${i.name}__${n}`;
      for (const i of $$("[id]", node)) i.id = `${i.id}__${n}`;
      for (const i of $$("[aria-labelledby]", node)) i.setAttribute("aria-labelledby", `${i.getAttribute("aria-labelledby")}__${n}`);
      for (const i of $$("input[list]", node)) i.setAttribute("list", `${i.getAttribute("list")}__${n}`);
      r.holder.append(node);
      const block = r.holder.lastElementChild;
      // the id under which this report is stored and, later, replaced
      block.dataset.id = id ?? [...crypto.getRandomValues(new Uint8Array(6))].map((b) => b.toString(16).padStart(2, "0")).join("");
      syncPlace(block);
      if (answers) { write(block, answers); syncPlace(block); const money = $('[data-type="currency"] select', block); if (money && answers.p_currency) money.dataset.chosen = "1"; }
      renumber(r);
      return block;
    }
    const renumber = (r) => blocksOf(r).forEach((b, i) => ($("[data-nr]", b).textContent = i + 1));
    form.addEventListener("click", (e) => {
      const adder = e.target.closest("[data-add]"), remover = e.target.closest("[data-remove]");
      if (adder) add(repeat(adder.dataset.add));
      if (remover) { const block = remover.closest(".sv-place"), r = repeat(block.dataset.kind); block.remove(); renumber(r); save(); }
    });
    // Options that cannot stand together ("I have never used it" beside "I use it"): ticking
    // one side unticks the other.
    form.addEventListener("change", (e) => {
      const field = e.target.closest(".sv-field[data-excludes]");
      if (!field || !e.target.checked) return;
      const v = e.target.value, untick = (values) => $$("input", field).forEach((i) => { if (values.includes(i.value)) i.checked = false; });
      for (const [one, others] of Object.entries(JSON.parse(field.dataset.excludes))) {
        if (v === one) untick(others);
        else if (others.includes(v)) untick([one]);
      }
    }, true);

    // ── Draft, in this browser only ──
    function save() {
      const blocks = Object.fromEntries(REPEATS.map((r) => [r.step, blocksOf(r).map((el) => ({ id: el.dataset.id, answers: read(el) }))]));
      try { localStorage.setItem(DRAFT, JSON.stringify({ adult: document.getElementById("svAdult").checked, answers: personal(), ...blocks })); } catch {}
    }
    // What was submitted from this browser before, if anything (written by survey-client.js).
    // A part whose deletion is still pending (see /survey/me/) is not brought back into the form.
    function submitted() { try { return (JSON.parse(localStorage.getItem(`cfi-survey-${cfg.edition}-mine`) ?? "null")?.items ?? []).filter((i) => !i.deleting); } catch { return []; } }
    function restore() {
      try {
        let d = JSON.parse(localStorage.getItem(DRAFT) ?? "null");
        const before = submitted();
        if (before.length) {
          // editing: start from what was submitted, unless a newer draft is in progress
          const of = (type) => before.filter((i) => i.type === type).map((i) => ({ id: i.id, answers: i.answers }));
          d ??= { adult: true, answers: before.find((i) => i.type === "response")?.answers ?? {}, places: of("observation"), prices: of("price") };
          const note = document.getElementById("svEditing");
          note.hidden = false;
          note.innerHTML = `You have already submitted from this browser. You are <strong>editing those answers</strong>: submitting again replaces them. <a href="../me/">Your submissions →</a>`;
        }
        if (!d) return;
        document.getElementById("svAdult").checked = Boolean(d.adult);
        for (const s of steps) write(s, d.answers ?? {});
        for (const r of REPEATS) for (const b of d[r.step] ?? []) add(r, b.answers ?? b, b.id);
      } catch {}
    }
    form.addEventListener("change", () => { refresh(); save(); });
    form.addEventListener("input", (e) => { if (e.target.matches("textarea, .sv-number, .sv-city")) save(); });
    // Choosing a country suggests its currency for the price, until the respondent picks one.
    const CURRENCY = JSON.parse(form.dataset.currency);
    form.addEventListener("change", (e) => {
      const block = e.target.closest(".sv-place"), money = block && $('[data-type="currency"] select', block);
      if (!money) return;
      if (e.target === money) money.dataset.chosen = "1";
      else if (e.target.name?.startsWith("p_country") && !money.dataset.chosen && !$(".sv-number", block).value) money.value = CURRENCY[e.target.value] ?? "USD";
    });

    // ── Submit ──
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const button = document.getElementById("svSubmit"), result = document.getElementById("svResult");
      button.disabled = true;
      result.textContent = "Signing…";
      try {
        const client = await import("../../lib/survey-client.js");
        const live = client.effective(cfg);
        const now = Math.floor(Date.now() / 1000);
        const items = [{ type: "response", id: "response", answers: personal() }, ...allReports()];
        // Reports that were sent before and are no longer in the form are deleted. Until a relay
        // confirms it, each stays stored as a pending deletion (client.deletionOutcome), so it is
        // not forgotten on the strength of a request nobody took; /survey/me/ can try it again.
        const before = client.mine(live).items;
        const gone = before.filter((old) => old.relays > 0 && !items.some((i) => i.id === old.id));
        const pendingAll = gone.map((g) => ({ ...g, deleting: { reached: 0, of: g.relays } }));
        for (const i of items) { i.event = client.sign(live, i); i.updated = now; i.relays = 0; }
        const removals = gone.map((old) => client.sign(live, old, true));
        client.remember(live, { items: [...items, ...pendingAll] });
        try { localStorage.removeItem(DRAFT); } catch {}
        const parts = `${items.length} part${items.length === 1 ? "" : "s"}`;
        if (!live.open) {
          result.innerHTML = `<p><strong>Saved in this browser. Nothing was sent.</strong> The survey is not open yet, so your ${parts} ${items.length === 1 ? "is" : "are"} signed and waiting here. You can send from your submissions once it opens.</p><p><a class="go solid" href="../me/">Your submissions →</a></p>`;
          button.hidden = true;
          return;
        }
        result.textContent = "Sending…";
        const sent = await client.publish(live, [...items.map((i) => i.event), ...removals, ...(gone.length ? [client.deletion(live, gone.map((g) => g.event))] : [])]);
        items.forEach((i, k) => (i.relays = sent[k].relays));
        const { pending } = client.deletionOutcome(gone, sent.slice(items.length));
        client.remember(live, { items: [...items, ...pendingAll.filter((g) => pending.some((p) => p.id === g.id)).map((g) => ({ ...g, deleting: { reached: pending.find((p) => p.id === g.id).reached, of: g.relays } }))] });
        if (items.every((i) => i.relays > 0)) {
          result.innerHTML = `<p><strong>Thank you.</strong> Your ${parts} ${items.length === 1 ? "is" : "are"} stored on ${Math.min(...items.map((i) => i.relays))} of ${live.relays.length} relay${live.relays.length === 1 ? "" : "s"}. You can change or delete what you sent at any time from this browser.</p><p><a class="go solid" href="../me/">Your submissions →</a> <a class="go" href="../">See the results</a></p>`;
          button.hidden = true;
        } else {
          // The relay's reason is its own free text: set as text, never as HTML.
          result.innerHTML = `<p><strong>Not sent.</strong> No relay accepted ${items.filter((i) => !i.relays).length} of the ${parts}<span data-reason></span>. They are saved in this browser; try again here or from <a href="../me/">your submissions</a>.</p>`;
          const reason = client.relayReason(sent);
          if (reason) result.querySelector("[data-reason]").textContent = ` (the relay said: ${reason})`;
          button.disabled = false;
        }
      } catch (err) {
        result.textContent = `Something went wrong: ${err.message}. Your answers are still in this browser.`;
        button.disabled = false;
      }
    });

    try { if (JSON.parse(localStorage.getItem("cfi-survey-test") ?? "null")?.relays?.length) { const b = document.getElementById("svClosed"); if (b) b.innerHTML = "<strong>Test mode.</strong> Answers are sent to the relays set under <code>cfi-survey-test</code> in this browser's storage."; } } catch {}
    restore();
    for (const r of REPEATS) if (!blocksOf(r).length) add(r);
    own.forEach(syncPlace);
    refresh();
    // "Edit" links from /survey/me/ open the form where the editing is to happen: #edit the first
    // section of the survey, #place-<id> or #price-<id> that report, #place-new or #price-new a fresh one.
    const [what, which] = location.hash.slice(1).split(/-(.*)/);
    const r = REPEATS.find((x) => x.noun === what);
    if (submitted().length && what === "edit") show(own[0]);
    else if (submitted().length && r) {
      show(steps.find((s) => s.dataset.step === r.step));
      let block = blocksOf(r).find((b) => b.dataset.id === which);
      if (which === "new") block = Object.keys(read(r.holder.lastElementChild)).length ? add(r) : r.holder.lastElementChild;
      block?.scrollIntoView({ block: "start" });
      block?.classList.add("sv-focus");
    } else show(steps[0]);
  </script>
</Base>
