---
// Research progress: how much of each country's profile and history has been filled in, and what
// is still missing. An internal working page: found through the site search, but not linked from
// the menu or the sitemap, and not indexed. The checks and their weights are in src/lib/research.js.
import Base from "../layouts/Base.astro";
import { research, researchTotals as T } from "../lib/research.js";
import ResearchGrowth from "../components/ResearchGrowth.astro";

const base = import.meta.env.BASE_URL;
const num = (n) => n.toLocaleString("en-US");
const example = research[0].checks;
const points = (part) => example.filter((c) => c.part === part).reduce((a, c) => a + c.of, 0);
const parts = [["profile", "Profile"], ["context", "Context"], ["history", "History"]];
const stats = [
  [`${T.average}%`, "Average"],
  [`${T.byPopulation}%`, "Weighted by population"],
  [num(T.complete), "Complete (100%)"],
  [num(T.good), "At 75% or more"],
  [num(T.poor), "Below 40%"],
  [num(T.estimates), "First ban only estimated"],
  [`${T.contexts.pct}%`, "Context categories covered"],
  [num(T.contexts.missing), "Context gaps"],
];
---
<Base title="Research progress" description="How much of each country's profile and history has been researched, and what is still missing." noindex>
  <main class="changes-page research-page">
    <section class="hero hero-sm">
      <p class="eyebrow">Internal</p>
      <h1>Research progress</h1>
      <p class="lede">For each of the {num(T.places)} countries and territories: how much of the profile and context is filled in and sourced, and how complete the history looks. The figure is the share of points a country has out of {points("profile")} for its profile, {points("context")} for context and {points("history")} for history.</p>
      <p class="lede">The context target is every category in every country: cited content, or a cited explanation of why it does not apply. Missing information and bare “None” placeholders remain gaps. The old Products section does not replace recreational, medical or hemp coverage.</p>
      <p class="lede">The checks only see what is in the files. They cannot know that nothing is missing, so they stop at 99%. A country shows 100% only when every check passes and someone has signed it off by hand, with <code>complete: YYYY-MM-DD</code> in its file.</p>
    </section>

    <dl class="hist-stats">
      {stats.map(([n, label]) => <div><dt>{label}</dt><dd>{n}</dd></div>)}
    </dl>

    <ResearchGrowth />

    <section class="section">
      <div class="section-head"><div>
        <h2>What is counted</h2>
        <p class="sub">Each check gives points; a partly met check gives part of them.</p>
      </div></div>
      <div class="rs-checks">
        {parts.map(([part, label]) => (
          <table class="src-table">
            <thead><tr><th>{label}</th><th class="num">Points</th></tr></thead>
            <tbody>{example.filter((c) => c.part === part).map((c) => <tr><td>{c.label}</td><td class="num">{c.of}</td></tr>)}</tbody>
          </table>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="contextCoverageTitle">
      <div class="section-head"><div>
        <h2 id="contextCoverageTitle">Context coverage</h2>
        <p class="sub">{num(T.contexts.filled)} filled sections and {num(T.contexts.notApplicable)} explained as not applicable, out of {num(T.contexts.total)} country-category pairs. The target is 100% coverage; unavailable evidence still needs research.</p>
      </div></div>
      <div class="rs-scroll"><table class="src-table rs-context-table">
        <thead><tr><th>Category</th><th class="num">Filled</th><th class="num">Not applicable, explained</th><th class="num">Gaps</th><th class="num">Covered</th></tr></thead>
        <tbody>{T.contexts.sections.map(s => <tr><th scope="row">{s.label}</th><td class="num">{s.filled}</td><td class="num">{s.notApplicable}</td><td class="num">{s.missing}</td><td class="num">{s.pct}%</td></tr>)}</tbody>
      </table></div>
    </section>

    <section class="section">
      <div class="section-head"><div>
        <h2>By country</h2>
        <p class="sub">Click a column to sort by it, and a row to see what is missing.</p>
      </div>
        <input type="search" id="rsFind" placeholder="Filter by name or region" aria-label="Filter countries" />
      </div>
      <div class="rs-scroll"><table class="src-table rs-table" id="rsTable">
        <thead><tr>
          <th data-sort="name">Country</th>
          <th class="num" data-sort="pct" aria-sort="descending">Research</th>
          <th class="num" data-sort="profile">Profile</th>
          <th class="num" data-sort="context" title="Cited content or a sourced not-applicable explanation for every context category">Context</th>
          <th class="num" data-sort="history">History</th>
          <th class="num" data-sort="entries">Entries</th>
          <th class="num" data-sort="scored" title="Entries that moved a score">Scored</th>
          <th class="num" data-sort="articles">Articles</th>
          <th class="num" data-sort="first" title="Year of the first recorded restriction">First ban</th>
          <th class="num" data-sort="silent" title="Decades since the first entry (1900 at the earliest) with no entry">Empty decades</th>
          <th class="num" data-sort="gap" title="Longest stretch of years between two entries">Longest gap</th>
          <th class="num" data-sort="reviewed">Reviewed</th>
        </tr></thead>
        {research.map((r) => (
          <tbody data-name={r.name.toLowerCase()} data-region={r.region.toLowerCase()} data-pct={r.pct} data-profile={r.profile} data-context={r.context} data-history={r.history} data-entries={r.entries} data-scored={r.scored} data-articles={r.articles} data-first={r.first === "est." ? 9998 : r.first === "—" ? 9999 : r.first} data-silent={r.silent} data-gap={r.gap ?? -1} data-reviewed={r.reviewed}>
            <tr class="rs-row" tabindex="0" aria-expanded="false">
              <th scope="row"><a href={`${base}country/${r.slug}/`}>{r.flag} {r.name}</a>{r.disputed && <small> territory</small>}</th>
              <td class="num"><span class="rs-bar" style={`--p:${r.pct}%`}><b>{r.pct}%</b></span></td>
              <td class="num">{r.profile}%</td>
              <td class="num rs-context-count" title={`${r.contextCoverage.filled} filled; ${r.contextCoverage.notApplicable} explained as not applicable; ${r.contextCoverage.missing} gaps`}>
                {r.context}% <small>{r.contextCoverage.covered}/{r.contextCoverage.total}</small>
              </td>
              <td class="num">{r.history}%</td>
              <td class="num">{r.entries}</td>
              <td class="num">{r.scored}</td>
              <td class="num">{r.articles}</td>
              <td class="num">{r.first}</td>
              <td class="num">{r.silent}</td>
              <td class="num">{r.gap ?? "—"}</td>
              <td class="num mono">{r.reviewed}</td>
            </tr>
            <tr class="rs-more" hidden><td colspan="12">
              <div class="rs-missing">
                {parts.map(([part, label]) => (
                  <div>
                    <h3>{label}</h3>
                    <ul>
                      {part === "context" ? r.contextCoverage.sections.map(s => (
                        <li class={s.state === "filled" || s.state === "not_applicable" ? "ok" : ""}>
                          <span>{s.state === "filled" || s.state === "not_applicable" ? "✓" : "·"} {s.label} <small>{s.state === "not_applicable" ? "Not applicable, explained" : s.state === "filled" ? "Filled" : "Gap"}</small></span>
                          {s.reason && <em>{s.reason}</em>}
                          {s.references.length > 0 && <span class="rs-context-sources">{s.references.map((source, i) => source.url ? <a href={source.url} target="_blank" rel="noopener noreferrer">Source {i + 1}: {source.title}</a> : <span>{source.title}</span>)}</span>}
                        </li>
                      )) : r.checks.filter((c) => c.part === part).map((c) => (
                        <li class={c.got >= c.of ? "ok" : ""}>
                          <span>{c.got >= c.of ? "✓" : "·"} {c.label} <small>{Math.round(c.got * 10) / 10} of {c.of}</small></span>
                          {c.missing.length > 0 && <em>{c.missing.slice(0, 12).join("; ")}{c.missing.length > 12 && `; and ${c.missing.length - 12} more`}</em>}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              <p class="rs-sign">{r.signed ? `Signed off as complete on ${r.signed}.` : "Not signed off as complete."} <a href={`${base}country/${r.slug}/`}>Open the country page</a></p>
            </td></tr>
          </tbody>
        ))}
      </table></div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const table = document.getElementById("rsTable");
      const bodies = () => [...table.tBodies];
      const open = (row) => {
        const more = row.nextElementSibling;
        more.hidden = !more.hidden;
        row.setAttribute("aria-expanded", String(!more.hidden));
      };
      table.addEventListener("click", (e) => {
        const th = e.target.closest("th[data-sort]");
        if (th) {
          const key = th.dataset.sort, text = key === "name" || key === "reviewed";
          const now = th.getAttribute("aria-sort");
          const down = now ? now === "ascending" : !text; // numbers start from the top, names from A
          table.querySelectorAll("th[aria-sort]").forEach((x) => x.removeAttribute("aria-sort"));
          th.setAttribute("aria-sort", down ? "descending" : "ascending");
          const val = (b) => (text ? b.dataset[key] : +b.dataset[key]);
          bodies().sort((a, b) => (val(a) < val(b) ? -1 : val(a) > val(b) ? 1 : 0) * (down ? -1 : 1)).forEach((b) => table.appendChild(b));
          return;
        }
        const row = e.target.closest(".rs-row");
        if (row && !e.target.closest("a")) open(row);
      });
      table.addEventListener("keydown", (e) => { if (e.key === "Enter" && e.target.classList.contains("rs-row")) open(e.target); });
      document.getElementById("rsFind").addEventListener("input", (e) => {
        const q = e.target.value.trim().toLowerCase();
        for (const b of bodies()) b.hidden = Boolean(q) && !b.dataset.name.includes(q) && !b.dataset.region.includes(q);
      });
    })();
  </script>
</Base>
