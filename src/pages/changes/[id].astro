---
import Base from "../../layouts/Base.astro";
import ScoreChange from "../../components/ScoreChange.astro";
import { changes, formatDate } from "../../lib/countries.js";
import { tierColor } from "../../lib/tiers.js";

export function getStaticPaths() {
  return changes.map((ch, i) => ({ params: { id: ch.id }, props: { ch, newer: changes[i - 1], older: changes[i + 1] } }));
}

const { ch, newer, older } = Astro.props;
const base = import.meta.env.BASE_URL;
const c = ch.country;
const diff = (seg) => seg.after - seg.before;
---
<Base title={ch.title} description={`${ch.title}: ${c.name} moved from ${ch.score.before} to ${ch.score.after} on the Cannabis Freedom Index. ${ch.description}`}>
  <main class="change-page">
    <div class="page-bar">
      <a class="back" href={`${base}changes/`}>← All changes</a>
      <a class="btn" href={`${base}country/${c.slug}/`}>{c.flag} {c.name} in full</a>
    </div>

    <article class="change-detail">
      <p class="eyebrow"><time datetime={ch.date}>{formatDate(ch.date)}</time> · {c.name}</p>
      <h1>{ch.title}</h1>
      <p class="lede">{ch.description}</p>

      <h2 class="d-h">Index score</h2>
      <ScoreChange score={ch.score} />

      <h2 class="d-h">Score by segment</h2>
      <table class="change-table">
        <thead>
          <tr><th scope="col">Segment</th><th scope="col">Before</th><th scope="col">After</th><th scope="col">Change</th></tr>
        </thead>
        <tbody>
          {ch.segments.map((seg) => (
            <tr class={diff(seg) === 0 ? "same" : ""}>
              <th scope="row">{seg.name}<small>{seg.weight}% of the index</small></th>
              <td><span class="dot" style={`background:${tierColor(seg.before * 10)}`}></span>{seg.before}</td>
              <td><span class="dot" style={`background:${tierColor(seg.after * 10)}`}></span>{seg.after}</td>
              <td>{diff(seg) === 0
                ? "—"
                : <span class={`delta ${diff(seg) > 0 ? "up" : "down"}`}>{diff(seg) > 0 ? "+" : "−"}{Math.abs(diff(seg))}</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="change-note">Segments are scored from 0 to 10. The scores after the change are {c.name}'s current scores.</p>

      <h2 class="d-h">Source</h2>
      <ul class="srcs">
        <li><a href={ch.source[1]} target="_blank" rel="noopener noreferrer">{ch.source[0]}</a></li>
      </ul>
    </article>

    <nav class="pager" aria-label="Other changes">
      {newer
        ? <a href={`${base}changes/${newer.id}/`}><small>Newer · {formatDate(newer.date)}</small><span>{newer.country.flag} {newer.title}</span></a>
        : <span></span>}
      {older
        ? <a class="next" href={`${base}changes/${older.id}/`}><small>Older · {formatDate(older.date)}</small><span>{older.country.flag} {older.title}</span></a>
        : <span></span>}
    </nav>
  </main>
</Base>
