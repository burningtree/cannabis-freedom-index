---
// The History overview in one low strip: one bar per decade counting the entries, with the count
// over it and the part that moved a score drawn lighter, and over them the world average score
// since 1860 as a line labelled at its two ends. No axes or grid. Each bar links to its decade's
// page; on the continuous list at /history/ a script jumps to that decade in place instead.
// `current` marks the decade being shown. With `only` (a set of entry ids) and `label`, the bars
// count only those entries, as on the page of a kind or a tag, and each bar jumps to its decade in
// the list below.
import { averageHistory, historyPeriods, HISTORY_FROM, dateTime, lastUpdated } from "../lib/countries.js";

const { current, only, label } = Astro.props;
const inView = (p) => (only ? p.items.filter((ch) => only.has(ch.id)) : p.items);
const base = import.meta.env.BASE_URL;
const num = (n) => n.toLocaleString("en-GB");

// one slot per decade on the time axis, the entries before 1860 in a slot of their own before it
const X0 = HISTORY_FROM - 10;
const X1 = historyPeriods[0].from + 10;
const x = (yearFraction) => ((yearFraction - X0) / (X1 - X0)) * 100;
const yearOf = (iso) => { const d = new Date(dateTime(iso)); return d.getUTCFullYear() + d.getUTCMonth() / 12 + (d.getUTCDate() - 1) / 365; };

// the line, as in AverageChart: a step at each recorded change
const points = averageHistory.filter((p) => +p.date.slice(0, 4) >= HISTORY_FROM);
const start = points[0].before;
const now = points.at(-1).after;
const values = points.flatMap((p) => [p.before, p.after]);
const yMin = Math.floor(Math.min(...values) / 10) * 10;
const yMax = Math.ceil(Math.max(...values) / 10) * 10;
const y = (v) => (1 - (v - yMin) / (yMax - yMin)) * 100;
const line = `M${x(HISTORY_FROM)},${y(start)}` + points.map((p) => `H${x(yearOf(p.date))}V${y(p.after)}`).join("") + `H${x(yearOf(lastUpdated))}`;

// the world average as it stood at a given moment, for the decades' tooltips
const scoreAt = (yearFraction) => points.filter((p) => yearOf(p.date) < yearFraction).at(-1)?.after ?? start;

// the tallest bar leaves room above it for its count
const most = Math.max(1, ...historyPeriods.map((p) => inView(p).length));
const countMax = most * 1.15;
const bars = [...historyPeriods].reverse().map((p) => {
  const slot = p.from < HISTORY_FROM ? X0 : p.from;
  const items = inView(p);
  const scored = items.filter((ch) => ch.score).length;
  // on a filtered page the bar leads to the decade's newest year in the list, if it has any entries
  const newest = items.find((ch) => !ch.estimate);
  const href = only ? (newest ? `#y${newest.date.slice(0, 4)}` : undefined) : `${base}history/period/${p.slug}/`;
  const from = Math.max(p.from, HISTORY_FROM);
  return {
    p, scored, all: items.length, href,
    // the world average at the start and end of the decade (the slot before 1860 has no line)
    scores: p.from < HISTORY_FROM ? null : [scoreAt(from), scoreAt(Math.min(p.to + 1, yearOf(lastUpdated)))],
    left: x(slot), width: x(slot + 10) - x(slot),
    height: (items.length / countMax) * 100,
    title: `${p.label}: ${num(items.length)} ${items.length === 1 ? "entry" : "entries"}, ${num(scored)} moved a score`,
  };
});
---
<section class="hy" aria-labelledby="hyTitle">
  <div class="hy-head">
    <h2 id="hyTitle">World average score <span>and {label ? <>{label} entries</> : "entries"} per decade</span></h2>
    <p class="hy-now"><b>{now.toFixed(1)}</b> <span>today, from {start.toFixed(1)} in {HISTORY_FROM}</span></p>
  </div>
  <div class="hy-plot">
    <nav class="hy-bars" aria-label="Decades">
      {bars.map((b, i) => (
        <a href={b.href} data-from={b.p.from} data-to={b.p.to} aria-label={b.title}
          aria-current={b.p === current ? "page" : undefined} style={`left:${b.left}%;width:${b.width}%`}>
          <span class="hy-n">{b.all}</span>
          <i style={`height:${Math.max(1, b.height)}%`}><i style={`height:${b.all ? (b.scored / b.all) * 100 : 0}%`}></i></i>
          <span class="hy-label">{b.p.short}</span>
          <span class={`hy-tip${i < 3 ? " at-start" : i >= bars.length - 3 ? " at-end" : ""}`} style={`bottom:calc(${Math.max(1, b.height)}% + 22px)`} aria-hidden="true">
            <b>{b.p.label}</b>
            <span>{num(b.all)} {label ? `${label} ` : ""}{b.all === 1 ? "entry" : "entries"}<em> · {num(b.scored)} moved a score</em></span>
            {b.scores && <span>World average {b.scores[0].toFixed(1)} → {b.scores[1].toFixed(1)}</span>}
            {b.href && <small>{only ? "Click to jump to this decade" : "Click to open this decade"}</small>}
          </span>
        </a>
      ))}
    </nav>
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path class="line" d={line} />
    </svg>
    <span class="hy-end hy-start" style={`left:${x(HISTORY_FROM)}%;top:${y(start)}%`} aria-hidden="true">{start.toFixed(0)}</span>
    <span class="hy-end hy-last" style={`left:${x(yearOf(lastUpdated))}%;top:${y(now)}%`} aria-hidden="true">{now.toFixed(1)}</span>
  </div>
  <p class="hy-key"><span class="k-line"></span> World average score, every country counted the same <span class="k-scored"></span> Entries that moved a score <span class="k-context"></span> Context only</p>
</section>
