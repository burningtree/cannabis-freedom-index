---
// One page of the History list, newest first and grouped by year. It shows either a period
// (`period`) or every entry of one kind (`kind`, a key of CHANGE_CATEGORIES). The period links
// and the kind filters above the list lead to the other pages.
import ScoreChange from "./ScoreChange.astro";
import { changes, historyPeriods, formatDate, CHANGE_CATEGORIES } from "../lib/countries.js";
import { tierColor } from "../lib/tiers.js";

const { period, kind } = Astro.props;
const base = import.meta.env.BASE_URL;
// the newest period lives at /history/ itself
const href = (p) => (p === historyPeriods[0] ? `${base}history/` : `${base}history/period/${p.slug}/`);
const index = historyPeriods.indexOf(period);
const newer = historyPeriods[index - 1];
const older = historyPeriods[index + 1];
// estimated entries have no real date, so they are not listed
const dated = changes.filter((ch) => !ch.estimate);
const items = kind ? dated.filter((ch) => ch.category === kind) : period.items;
const kindCount = (key) => dated.filter((ch) => ch.category === key).length;
const years = [...new Set(items.map((ch) => ch.date.slice(0, 4)))]
  .map((year) => ({ year, items: items.filter((ch) => ch.date.startsWith(year)) }));
---
<nav class="periods" aria-label="Periods">
  {historyPeriods.map((p) => (
    <a href={href(p)} aria-current={p === period ? "page" : undefined}>{p.label} <small>{p.items.length}</small></a>
  ))}
</nav>

<nav class="kinds" aria-label="Filter by kind of event">
  <a href={`${base}history/`} aria-current={kind ? undefined : "true"}>All kinds</a>
  {Object.entries(CHANGE_CATEGORIES).map(([key, k]) => (
    <a href={`${base}history/kind/${key}/`} title={k.help} aria-current={key === kind ? "page" : undefined}>
      <span aria-hidden="true">{k.emoji}</span> {k.label} <small>{kindCount(key)}</small>
    </a>
  ))}
</nav>

<div class="chlog">
  {years.map(({ year, items }) => (
    <section aria-labelledby={`y${year}`}>
      <h2 class="chl-year" id={`y${year}`}>{year}</h2>
      <ol class="chl-list">
        {items.map((ch) => (
          <li class="chl-item" style={`--c:${ch.score ? tierColor(ch.score.after) : "var(--muted)"}`}>
            <a class="card chl-card" href={`${base}history/${ch.id}/`}>
              <p class="change-meta">
                <time datetime={ch.date}>{formatDate(ch.date)}</time>
                <span>{ch.place.flag} {ch.place.name}</span>
              </p>
              <h3><span class="kind" title={ch.kind.label} aria-hidden="true">{ch.kind.emoji}</span><span class="visually-hidden">{ch.kind.label}: </span>{ch.title}</h3>
              <p class="chl-text">{ch.description}</p>
              {ch.score && <ScoreChange score={ch.score} />}
            </a>
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>

{period && <nav class="pager chl-pager" aria-label="Other periods">
  {newer
    ? <a href={href(newer)}><small>Newer</small><span>← {newer.label}</span></a>
    : <span></span>}
  {older
    ? <a class="next" href={href(older)}><small>Older</small><span>{older.label} →</span></a>
    : <span></span>}
</nav>}
