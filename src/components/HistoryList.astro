---
// One page of the History list, newest first and grouped by year. It shows either a period
// (`period`) or every entry of one kind (`kind`, a key of CHANGE_CATEGORIES).
// Top to bottom: the history in numbers, the periods as a small histogram that doubles as
// navigation, the kinds as filters, then the entries as a ledger with the year set large beside them.
import ScoreChange from "./ScoreChange.astro";
import { changes, articles, places, historyPeriods, formatDate, CHANGE_CATEGORIES } from "../lib/countries.js";
import { tierColor } from "../lib/tiers.js";

const { period, kind } = Astro.props;
const base = import.meta.env.BASE_URL;
// the newest period lives at /history/ itself
const href = (p) => (p === historyPeriods[0] ? `${base}history/` : `${base}history/period/${p.slug}/`);
const index = historyPeriods.indexOf(period);
const newer = historyPeriods[index - 1];
const older = historyPeriods[index + 1];
// estimated entries have no real date, so they are not listed
const dated = changes.filter((ch) => !ch.estimate);
const items = kind ? dated.filter((ch) => ch.category === kind) : period.items;
const kindCount = (key) => dated.filter((ch) => ch.category === key).length;
const years = [...new Set(items.map((ch) => ch.date.slice(0, 4)))]
  .map((year) => ({ year, items: items.filter((ch) => ch.date.startsWith(year)) }));
// The whole history in numbers, for the side panel. The same on every page of the list.
const num = (n) => n.toLocaleString("en-GB");
const perPlace = new Map();
for (const ch of changes) if (ch.country) perPlace.set(ch.country, (perPlace.get(ch.country) ?? 0) + 1);
const stats = {
  total: changes.length,
  scored: dated.filter((ch) => ch.score).length,
  context: dated.filter((ch) => !ch.score).length,
  estimated: changes.length - dated.length,
  checked: dated.filter((ch) => ch.checked).length,
  international: dated.filter((ch) => !ch.country).length,
  places: perPlace.size,
  oldest: dated.at(-1),
  newest: dated[0],
  top: [...perPlace].sort((x, y) => y[1] - x[1] || x[0].name.localeCompare(y[0].name)).slice(0, 8),
  // every place, also those with no entry at all
  fewest: places.map((c) => [c, perPlace.get(c) ?? 0]).sort((x, y) => x[1] - y[1] || x[0].name.localeCompare(y[0].name)).slice(0, 8),
};
// the tallest period sets the scale of the histogram
const most = Math.max(...historyPeriods.map((p) => p.items.length));
---
<div class="hist">
<dl class="hist-stats" aria-label="History in numbers">
  <div><dt>Entries in total</dt><dd>{num(stats.total)}</dd></div>
  <div><dt>{kind ? "Of this kind" : "In this period"}</dt><dd>{num(items.length)}</dd></div>
  <div><dt>Moved a score</dt><dd>{num(stats.scored)}</dd></div>
  <div><dt>Context only</dt><dd>{num(stats.context)}</dd></div>
  <div><dt>Countries and territories</dt><dd>{num(stats.places)}</dd></div>
  <div><dt>Tied to no country</dt><dd>{num(stats.international)}</dd></div>
</dl>
<p class="hist-note">{num(stats.checked)} of the {num(dated.length)} dated entries ({Math.round((stats.checked / dated.length) * 100)}%) were checked against a source that was read. Another {num(stats.estimated)} are estimated first bans with no known date; they are not listed here. The oldest entry is from <a href={`${base}history/${stats.oldest.id}/`}>{stats.oldest.date.slice(0, 4)}</a>, the newest from <a href={`${base}history/${stats.newest.id}/`}>{formatDate(stats.newest.date)}</a>.</p>

<nav class="hist-periods" aria-label="Periods">
  {[...historyPeriods].reverse().map((p) => (
    <a href={href(p)} aria-current={p === period ? "page" : undefined} title={`${p.label}: ${p.items.length} entries`}>
      <span class="hp-n">{p.items.length}</span>
      <i style={`height:${Math.max(3, (p.items.length / most) * 100)}%`}></i>
      <span class="hp-label">{p.label}</span>
    </a>
  ))}
</nav>

<nav class="hist-kinds" aria-label="Filter by kind of event">
  <a href={`${base}history/`} aria-current={kind ? undefined : "true"}>All kinds</a>
  {Object.entries(CHANGE_CATEGORIES).map(([key, k]) => (
    <a href={`${base}history/kind/${key}/`} title={k.help} aria-current={key === kind ? "page" : undefined}>
      <span aria-hidden="true">{k.emoji}</span> {k.label} <small>{kindCount(key)}</small>
    </a>
  ))}
</nav>

<div class="hist-tools">
  <div class="hist-order" role="group" aria-label="Order of the entries">
    <button type="button" data-order="newest" aria-pressed="true">Newest first</button>
    <button type="button" data-order="oldest" aria-pressed="false">Oldest first</button>
  </div>
  <div class="hist-order hist-only" role="group" aria-label="Which entries to show">
    <button type="button" data-only="all" aria-pressed="true">All entries <small>{items.length}</small></button>
    <button type="button" data-only="scored" aria-pressed="false">Score changes only <small>{items.filter((ch) => ch.score).length}</small></button>
  </div>
</div>

<div class="hist-years" data-order="newest" data-only="all">
  {years.map(({ year, items }) => (
    <section class="hist-year" aria-labelledby={`y${year}`} data-scored={items.some((ch) => ch.score) ? "" : undefined}>
      <h2 id={`y${year}`}>{year}<small class="n-all">{items.length === 1 ? "1 entry" : `${items.length} entries`}</small><small class="n-scored">{items.filter((ch) => ch.score).length === 1 ? "1 score change" : `${items.filter((ch) => ch.score).length} score changes`}</small></h2>
      <ol>
        {items.map((ch) => (
          <li data-scored={ch.score ? "" : undefined}>
            <a href={`${base}history/${ch.id}/`}>
              <time datetime={ch.date}>{ch.date.length === 4 ? "" : formatDate(ch.date).replace(` ${year}`, "")}</time>
              <div class="he-body">
                <p class="he-place">{ch.place.flag} {ch.place.name} <span class="he-kind"><span aria-hidden="true">{ch.kind.emoji}</span> {ch.kind.label}</span> <span class={`conf-mark c-${ch.confidence.key}`} title={`${ch.confidence.label}: ${ch.confidence.help}`}>{ch.confidence.mark}</span></p>
                <h3>{ch.title}{articles.has(ch.id) && <span class="he-article">Article</span>}</h3>
                <p class="he-text">{ch.description}</p>
              </div>
              {ch.score ? <ScoreChange score={ch.score} /> : <span></span>}
            </a>
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>

{period && <nav class="pager chl-pager" aria-label="Other periods">
  {newer
    ? <a href={href(newer)}><small>Newer</small><span>← {newer.label}</span></a>
    : <span></span>}
  {older
    ? <a class="next" href={href(older)}><small>Older</small><span>{older.label} →</span></a>
    : <span></span>}
</nav>}

<div class="hist-tops">
  {[["Most entries", stats.top], ["Fewest entries", stats.fewest]].map(([label, list]) => (
    <section aria-label={label}>
      <h2>{label}</h2>
      <ol>
        {list.map(([c, n]) => (
          <li><a href={`${base}country/${c.slug}/`}><span>{c.flag} {c.name}</span><b>{n}</b></a></li>
        ))}
      </ol>
    </section>
  ))}
</div>
</div>

<script>
  // Reading order: the page is written newest first; "Oldest first" turns the years and the
  // entries inside each year around, to read the period as it happened. The choice is kept in
  // this browser, and ?order=oldest in the address asks for it directly.
  const years = document.querySelector(".hist-years");
  const buttons = [...document.querySelectorAll(".hist-order button[data-order]")];
  function setOrder(order) {
    if (years.dataset.order !== order) {
      years.append(...[...years.children].reverse());
      for (const list of years.querySelectorAll("ol")) list.append(...[...list.children].reverse());
      years.dataset.order = order;
    }
    for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.order === order));
  }
  let wanted = new URLSearchParams(location.search).get("order");
  try { wanted ??= localStorage.getItem("histOrder"); } catch {}
  if (wanted === "oldest") setOrder("oldest");
  for (const b of buttons) b.addEventListener("click", () => {
    setOrder(b.dataset.order);
    try { localStorage.setItem("histOrder", b.dataset.order); } catch {}
  });

  // Which entries: all of them, or only those that moved a score. The rest is hidden by the
  // style sheet. Kept in this browser like the order, and ?only=scored asks for it directly.
  const only = [...document.querySelectorAll(".hist-order button[data-only]")];
  function setOnly(value) {
    years.dataset.only = value;
    for (const b of only) b.setAttribute("aria-pressed", String(b.dataset.only === value));
  }
  let show = new URLSearchParams(location.search).get("only");
  try { show ??= localStorage.getItem("histOnly"); } catch {}
  if (show === "scored") setOnly("scored");
  for (const b of only) b.addEventListener("click", () => {
    setOnly(b.dataset.only);
    try { localStorage.setItem("histOnly", b.dataset.only); } catch {}
  });
</script>
