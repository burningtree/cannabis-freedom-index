---
// Full write-up for one country. Rendered on its own page, and fetched into the
// drawer on the home page — so there is a single template for both views.
import { SEGMENTS, REC_LABEL, REC_HELP, MED_LABEL, countries, changes, segAvg, segmentPoints, segmentMax, subunitsOf, formatDate } from "../lib/countries.js";
import { tierOf, tierColor } from "../lib/tiers.js";
import CountryChanges from "./CountryChanges.astro";
import CountryChart from "./CountryChart.astro";
import { answersFor } from "../lib/answers.js";

// `sub` is optional: one state, province or territory of `c`. Without it the national view is shown.
const { c, sub } = Astro.props;
const base = import.meta.env.BASE_URL;
const group = subunitsOf(c.id);
const v = sub ?? c; // whichever entity's scores are on display
const d = sub ? null : c.details;
const countryUrl = `${base}country/${c.slug}/`;
const unitUrl = (x) => `${countryUrl}${x.id}/`;
// Date the entry was last reviewed, stored as YYYY-MM-DD and shown in full.
const updated = sub ? sub.reviewed : d?.reviewed;
const updatedText = updated && formatDate(updated);
const byName = group ? [...group.units].sort((a, b) => a.name.localeCompare(b.name)) : [];
// Recorded changes to the national score, newest first (not shown for a single state).
const history = sub ? [] : changes.filter((ch) => ch.country === c);
const scored = history.filter((ch) => ch.score); // the ones that moved the score
// 48,000,000 → "48 million", 770,000 → "770,000"
const people = (n) => (n >= 1e6 ? `${+(n / 1e6).toPrecision(2)} million` : n.toLocaleString("en-GB"));
const use = sub ? null : c.use;
// Crossing a border with cannabis. This is general guidance, the same rule almost everywhere,
// worded for the country's status; it is not country-specific research.
const SCHENGEN = new Set("AT BE BG HR CZ DK EE FI FR DE GR HU IS IT LV LI LT LU MT NL NO PL PT RO SK SI ES SE CH".split(" "));
const travel = sub ? null : [
  `Taking cannabis into or out of ${c.name} is a separate offence from possessing it, normally charged as smuggling or trafficking, with far heavier penalties. That holds almost everywhere, including between two places where cannabis is legal.`,
  ["legal", "partial", "decrim"].includes(c.rec) && `The rules that allow or tolerate small amounts inside ${c.name} do not cover the border, an airport or the post.`,
  c.rec === "death" && `In ${c.name} the heaviest penalties, up to the death penalty, are aimed at trafficking, and bringing drugs across the border is treated as trafficking.`,
  SCHENGEN.has(c.id)
    ? `A prescription from another country is not recognised by itself. Within the Schengen area a patient can carry prescribed medicine for up to 30 days with a certificate issued by their home health authority; whether cannabis qualifies depends on both countries.`
    : `A prescription or medical card from another country is generally not recognised. Travellers who need a cannabis-based medicine should ask ${c.name}'s embassy before travelling.`,
].filter(Boolean);
const answers = answersFor(v.s);
const r = 42;
const circ = 2 * Math.PI * r;
---
<article class="country" data-id={c.id}>
  <div class="c-side">
    <div class="d-head">
      <span class="d-flag">{c.flag}</span>
      <div>
        <h1>{v.name}</h1>
        <p class="sub">{sub ? `${group.label} · ${c.name}` : c.region}</p>
      </div>
    </div>
    <div class="d-score">
      <svg class="ring" width="104" height="104" viewBox="0 0 104 104" aria-hidden="true">
        <circle cx="52" cy="52" r={r} fill="none" stroke="var(--border)" stroke-width="9" />
        <circle cx="52" cy="52" r={r} fill="none" stroke={tierColor(v.raw)} stroke-width="9" stroke-linecap="round"
          stroke-dasharray={`${(v.raw / 100) * circ} ${circ}`} transform="rotate(-90 52 52)" />
        <text x="52" y="62" text-anchor="middle">{v.score}</text>
      </svg>
      <div>
        <div class="tier">{tierOf(v.raw).name}</div>
        {sub
          ? <p class="sub">#{sub.rank} of {group.units.length} in {c.name}<br>would rank #{sub.worldRank} among countries</p>
          : c.disputed
            ? <p class="sub">Not ranked: disputed territory<br>would rank #{c.worldRank} among countries</p>
            : <p class="sub">#{c.rank} of {countries.length} worldwide<br>#{c.regionRank} of {c.regionCount} in {c.region}</p>}
      </div>
    </div>
    <div class="d-chips">
      <span class={`chip s-${v.rec}`} title={REC_HELP[v.rec]}>Recreational: {REC_LABEL[v.rec]}</span>
      <span class={`chip s-${v.med}`}>Medical: {MED_LABEL[v.med]}</span>
    </div>
    <p class="d-note">{v.note}</p>
    {c.disputed && !sub && (
      <p class="c-disputed"><strong>Disputed territory.</strong> {c.disputed.note} See also <a href={`${base}country/${c.disputed.country.slug}/`} data-country={c.disputed.country.id}>{c.disputed.country.flag} {c.disputed.country.name}</a>.</p>
    )}
    <h2 class="d-h">In short <span><a href={`${base}can-i/`}>all countries →</a></span></h2>
    <dl class="answers">
      {answers.map((x) => (
        <div class={`answer a-${x.answer}`}>
          <dt>{x.q}</dt>
          <dd><b>{x.label}</b><span>{x.text}</span></dd>
        </div>
      ))}
    </dl>
    <p class="d-hint">A rough guide read from the scores below, not legal advice. The details and the exceptions are in each segment.</p>
    {use && (
      <dl class="c-use">
        <div>
          <dt>Cannabis users</dt>
          <dd>{use.estimate ? "about " : ""}{people(use.users)}</dd>
        </div>
        <div>
          <dt>Share aged 15–64</dt>
          <dd>{use.estimate ? "about " : ""}{use.prevalence}%</dd>
        </div>
        <p>{use.estimate
          ? `An estimate: there is no national survey, so the median rate of surveyed countries in ${c.region} is assumed.`
          : `People who used cannabis in the past year, from a ${use.year} survey applied to today's population.`}</p>
        <p class="c-use-src">Source: <a href="https://www.unodc.org/unodc/en/data-and-analysis/wdr2022_annex.html" target="_blank" rel="noopener noreferrer">UNODC World Drug Report</a> prevalence figures, as collected in <a href="https://en.wikipedia.org/wiki/List_of_countries_by_annual_cannabis_use" target="_blank" rel="noopener noreferrer">Wikipedia's list of annual cannabis use by country</a>; population aged 15–64 from the <a href="https://data.worldbank.org/indicator/SP.POP.1564.TO" target="_blank" rel="noopener noreferrer">World Bank</a>.</p>
      </dl>
    )}
    {scored.length > 0 && <CountryChart history={scored} />}
    {history.length > 0 && <CountryChanges history={history} place="side" />}
    {group && (
      <label class="field sub-select">
        <span>{group.label}</span>
        <select data-subunit-select aria-label={`Choose a ${group.label.toLowerCase()} of ${c.name}`}>
          <option value={countryUrl} selected={!sub}>All of {c.name} (national estimate)</option>
          {byName.map((x) => <option value={unitUrl(x)} selected={sub?.id === x.id}>{x.name} · {x.score}</option>)}
        </select>
      </label>
    )}
  </div>

  <div class="c-main">
    <h2 class="d-h">Score breakdown <span>▏world average</span></h2>
    {sub
      ? <p class="d-hint">{group.intro} Select a segment to show or hide the rules.</p>
      : <p class="d-hint">Select a segment to show or hide the exact rules and sources.</p>}
    {sub && SEGMENTS.map((s, i) => (
      <details class="segrow" open>
        <summary>
          <div class="segrow-top">
            <span>{s.name} <small>· {s.weight}%</small></span>
            <b>{sub.s[i]}/10 <small class="vs">{c.name}: {c.s[i]}</small><i class="chev" aria-hidden="true"></i></b>
          </div>
          <div class="bar" title={`World average ${segAvg[i].toFixed(1)}/10`}>
            <i style={`width:${sub.s[i] * 10}%;background:${tierColor(sub.s[i] * 10)}`}></i>
            <span class="avg-tick" style={`left:calc(${segAvg[i] * 10}% - 1px)`}></span>
          </div>
          <div class="pts">adds {segmentPoints(i, sub.s[i]).toFixed(1)} of {segmentMax(i).toFixed(0)} points</div>
        </summary>
        {sub.seg && <div class="why"><p>{sub.seg[i]}</p></div>}
      </details>
    ))}
    {sub && (
      <section class="c-unit-sources">
        <h2 class="d-h">Sources</h2>
        <ul class="srcs">
          {sub.sources.map(([label, url]) => <li><a href={url} target="_blank" rel="noopener noreferrer">{label}</a></li>)}
        </ul>
      </section>
    )}
    {!sub && SEGMENTS.map((s, i) => {
      const seg = d?.segments[i];
      return (
        <details class="segrow" open>
          <summary>
            <div class="segrow-top">
              <span>{s.name} <small>· {s.weight}%</small></span>
              <b>{c.s[i]}/10<i class="chev" aria-hidden="true"></i></b>
            </div>
            <div class="bar" title={`World average ${segAvg[i].toFixed(1)}/10`}>
              <i style={`width:${c.s[i] * 10}%;background:${tierColor(c.s[i] * 10)}`}></i>
              <span class="avg-tick" style={`left:calc(${segAvg[i] * 10}% - 1px)`}></span>
            </div>
            <div class="pts">adds {segmentPoints(i, c.s[i]).toFixed(1)} of {segmentMax(i).toFixed(0)} points</div>
          </summary>
          {seg && (
            <div class="why">
              <p>{seg.t}</p>
              <ul class="srcs">
                {seg.src.map(([label, url]) => (
                  <li><a href={url} target="_blank" rel="noopener noreferrer">{label}</a></li>
                ))}
              </ul>
            </div>
          )}
        </details>
      );
    })}
    {history.length > 0 && <CountryChanges history={history} place="main" />}

    {group && (
      <section class="c-units">
        <h2 class="d-h">{sub ? `Other ${group.plural}` : `By ${group.label.toLowerCase()}`} <span>{group.units.length} scored</span></h2>
        {!sub && <p class="d-hint">{group.intro}</p>}
        <ol class="units">
          {group.units.map((x) => (
            <li class={sub?.id === x.id ? "current" : undefined}>
              <a href={unitUrl(x)} data-subunit>
                <span class="u-rank">{x.rank}</span>
                <span class="u-name">{x.name}</span>
                <span class="u-score">{x.score}</span>
                <span class="bar"><i style={`width:${x.raw}%;background:${tierColor(x.raw)}`}></i></span>
              </a>
            </li>
          ))}
        </ol>
        {!sub && (
          <ul class="srcs">
            {group.sources.map(([label, url]) => <li><a href={url} target="_blank" rel="noopener noreferrer">{label}</a></li>)}
          </ul>
        )}
      </section>
    )}

    {d && (
      <>
        <h2 class="d-h">More context <span>not part of the score</span></h2>
        {d.context.filter(Boolean).map((x) => (
          <div class="segrow">
            <div class="segrow-top"><span>{x.name === "Death penalty" ? "☠️ " : ""}{x.name}</span></div>
            <p class="ctx">{x.t}</p>
            <ul class="srcs">
              {x.src.map(([label, url]) => (
                <li><a href={url} target="_blank" rel="noopener noreferrer">{label}</a></li>
              ))}
            </ul>
          </div>
        ))}
        {travel && (
          <div class="segrow">
            <div class="segrow-top"><span>🛂 Crossing the border</span></div>
            {travel.map((line) => <p class="ctx">{line}</p>)}
            <p class="ctx ctx-general">General guidance that applies to almost every country, not a check of {c.name}'s customs rules.</p>
            <ul class="srcs">
              <li><a href="https://www.incb.org/incb/en/travellers/index.html" target="_blank" rel="noopener noreferrer">International Narcotics Control Board — Travellers carrying medicines containing controlled substances</a></li>
            </ul>
          </div>
        )}

        <section class="c-sources">
          <h2 class="d-h">All sources</h2>
          <ol>
            {d.sources.map(([label, url]) => (
              <li><a href={url} target="_blank" rel="noopener noreferrer">{label}</a></li>
            ))}
          </ol>
        </section>
      </>
    )}
    {updated && <p class="c-updated">Last updated: <time datetime={updated}>{updatedText}</time>{d && ` · ${d.sources.length} sources`}{scored.length > 0 && ` · history: ${history.filter((ch) => ch.confidence.key === "checked").length} of ${history.length} entries checked`}</p>}
  </div>
</article>
