---
// Full write-up for one country. Rendered on its own page, and fetched into the
// drawer on the home page — so there is a single template for both views.
import { CONTEXT_ICONS, SEGMENTS, REC_LABEL, REC_HELP, MED_LABEL, MED_HELP, countries, changes, segAvg, segmentPoints, segmentMax, subunitsOf, formatDate } from "../lib/countries.js";
import { TIERS, tierOf, tierColor, tierIndex } from "../lib/tiers.js";
import { unitMap } from "../lib/unit-map.js";
import { short } from "../lib/short.js";
import CountryChanges from "./CountryChanges.astro";
import CountryChart from "./CountryChart.astro";
import CountryIntro from "./CountryIntro.astro";
import { theName } from "../lib/seo.js";
import CountryDatasetTab from "./CountryDatasetTab.astro";
import { datasetsOf } from "../lib/datasets.js";
import SourceTip from "./SourceTip.astro";
import SourceCitation from "./SourceCitation.astro";
import Cited from "./Cited.astro";
import { references, citeParts, citedKeys } from "../lib/cite.js";
import { PLANTING_STATUS, STATUS_SECTIONS, PLANTING_TRADE } from "../lib/segment-ids.js";
import { TREATMENT, punishmentText, punishmentExtra } from "../lib/penalties.js";
import { Icon } from "astro-icon/components";
import PenaltyTable from "./PenaltyTable.astro";
import { answersFor } from "../lib/answers.js";
import { Image } from "astro:assets";
import { cultureOf, cultureSection } from "../lib/culture.js";
import { factsOf } from "../lib/facts.js";
import { neighboursOf } from "../lib/borders.js";
import FactText from "./FactText.astro";

// `sub` is optional: one state, province or territory of `c`. Without it the national view is shown.
const { c, sub } = Astro.props;
const base = import.meta.env.BASE_URL;
const group = subunitsOf(c.id);
const v = sub ?? c; // whichever entity's scores are on display
const d = sub ? null : c.details;
const countryUrl = `${base}country/${c.slug}/`;
const unitUrl = (x) => `${countryUrl}${x.id}/`;
// Date the entry was last reviewed, stored as YYYY-MM-DD and shown in full.
const updated = sub ? sub.reviewed : d?.reviewed;
const updatedText = updated && formatDate(updated);
// the states or provinces on a map, coloured by score, above their list
const map = group ? unitMap(c.slug, group.units) : null;
// the tiers that appear on it, best first, for its legend
const mapTiers = map ? TIERS.filter((t, i) => group.units.some((x) => tierIndex(x.raw) === TIERS.length - 1 - i)) : [];
const byName = group ? [...group.units].sort((a, b) => a.name.localeCompare(b.name)) : [];
// the spread of the states' or provinces' scores, shown beside the national estimate
const unitRange = group ? `${Math.min(...group.units.map((x) => x.score))}–${Math.max(...group.units.map((x) => x.score))}` : "";
// The country's history, newest first; on a state's or province's page only the entries about it.
const history = changes.filter((ch) => ch.country === c && (!sub || ch.unit?.id === sub.id));
const nationalCount = sub ? changes.filter((ch) => ch.country === c).length : 0;
const scored = sub ? [] : history.filter((ch) => ch.score); // the ones that moved the score (the national one)
// Inline citations (src/lib/cite.js): the score breakdown and the context share one numbering, in
// reading order. A number shows its source in a card on hover (Base.astro); the list itself sits
// folded in the Sources section at the end, under a summary.
const refs = references("src");
// the words for cannabis in the opening come first in reading order, so they take the first numbers
const wordRefs = c.details.words.map((w) => w.src.map((x) => refs.cite(x)));
const partsOf = (block, refs, where) => citeParts(block.cite.text, refs, (k) => block.cite.keys.includes(k) && block.cite.of(k), block.cite.keys, `countries/${c.slug}.yaml: ${where}`);
const segParts = d ? d.segments.map((seg, i) => seg && partsOf(seg, refs, SEGMENTS[i].id)) : [];
const unitParts = sub ? sub.segCite.map((text, i) => citeParts(text, refs,
  (k) => /^[1-9]\d*$/.test(k) && sub.sources[+k - 1],
  citedKeys(text) ?? sub.sources.map((_, i) => String(i + 1)),
  `countries/${c.slug}/${sub.id}.yaml: ${SEGMENTS[i].id}`)) : [];
// The context shown: a country's sections, or for a state its own, with its country's sections in
// place of those it does not write (marked `national`). Its sources: the state's numbered list.
const ctxList = sub ? c.details.context.map((nat, i) => sub.context[i] ?? (nat && { ...nat, national: true })) : d?.context ?? null;
const srcList = sub ? sub.sources : d?.sources ?? [];
const ctxParts = ctxList ? Object.fromEntries(ctxList.filter(Boolean).map((x) => [x.key, x.items ? x.items.map((item, i) => partsOf(item, refs, `${x.key}[${i}]`)) : partsOf(x, refs, x.key)])) : {};
// a maximum fine in the profile's currency: "€5,500", "$300"
const money = (n, currency) => new Intl.NumberFormat("en-GB", { style: "currency", currency, maximumFractionDigits: 0 }).format(n);
// the recreational and medical status chips lead to their own context sections, where those exist
const ctxHas = (key) => Boolean(ctxList?.some((x) => x?.key === key));
const INCB = ["International Narcotics Control Board — Travellers carrying medicines containing controlled substances", "https://www.incb.org/incb/en/travellers/index.html", null, "https://www.incb.org/incb/en/travellers/index.html"];
const use = sub ? null : c.use;
const unitUse = sub?.use ?? null; // a state's or province's own survey figure
// Crossing a border with cannabis. This is general guidance, the same rule almost everywhere,
// worded for the country's status; it is not country-specific research.
const SCHENGEN = new Set("AT BE BG HR CZ DK EE FI FR DE GR HU IS IT LV LI LT LU MT NL NO PL PT RO SK SI ES SE CH".split(" "));
const travel = sub ? null : [
  `Taking cannabis into or out of ${c.name} is a separate offence from possessing it, normally charged as smuggling or trafficking, with far heavier penalties. That holds almost everywhere, including between two places where cannabis is legal.`,
  ["legal", "partial", "decrim"].includes(c.rec) && `The rules that allow or tolerate small amounts inside ${c.name} do not cover the border, an airport or the post.`,
  c.rec === "death" && `In ${c.name} the heaviest penalties, up to the death penalty, are aimed at trafficking, and bringing drugs across the border is treated as trafficking.`,
  SCHENGEN.has(c.id)
    ? `A prescription from another country is not recognised by itself. Within the Schengen area a patient can carry prescribed medicine for up to 30 days with a certificate issued by their home health authority; whether cannabis qualifies depends on both countries.`
    : `A prescription or medical card from another country is generally not recognised. Travellers who need a cannabis-based medicine should ask ${c.name}'s embassy before travelling.`,
].filter(Boolean);
const incbRef = travel ? refs.cite(INCB) : null; // the crossing-the-border note cites one guide
const answers = answersFor(v);
// The methodology lives on the home page: its section, or the description of one segment there.
const method = (segId) => `${base}#${segId ? `method-${segId}` : "methodology"}`;

// outside datasets with figures for the country, in their own section
// a state shows its country's datasets, marked as national
const datasetCount = Object.keys(datasetsOf(c.slug)).length;
// words and traditions of the cultural atlas that belong to this country; a state shows its country's
const culture = cultureOf(c);
const CULTURE_CARDS = 8;
const facts = sub ? [] : factsOf(c);
// "Cannabis in …": the people before the law, who use it and what they think (CountryIntro.astro)
const glance = Boolean(use || unitUse);
// The whole profile is one page; a sticky row of links under the masthead jumps to each part and
// marks the one in view: [id, label, count]. The ids are the old tab names, so links like #history
// still land.
const plural = group ? group.plural.split(" ")[0] : "";
const sections = [
  glance && ["overview", "Overview"],
  group && !sub && ["units", plural[0].toUpperCase() + plural.slice(1), group.units.length],
  ["score", group && !sub ? "National estimate" : "Score"],
  ctxList && ["context", "Context", ctxList.filter(Boolean).length + (travel ? 1 : 0)],
  culture.length > 0 && ["culture", "Culture", culture.length],
  facts.length > 0 && ["did-you-know", "Did you know", facts.length],
  datasetCount > 0 && ["datasets", "Datasets", datasetCount],
  // the history can run to hundreds of entries, so it comes after the shorter parts
  history.length > 0 && ["history", "History", history.length],
  group && sub && ["units", `Other ${plural}`, group.units.length - 1],
  refs.list.length > 0 && ["sources", "Sources", refs.list.length],
].filter(Boolean);

// Beside the score: the country among its land neighbours, by score. A country with none (an island)
// is shown among those nearest to it in rank in its region. A long list keeps the rows around the
// country itself. Not on a state's page.
const landNeighbours = sub ? [] : (neighboursOf.get(c.id) ?? []).map((id) => countries.find((x) => x.id === id)).filter(Boolean);
const around = (list, size) => { const at = list.indexOf(c), from = Math.max(0, Math.min(at - Math.floor(size / 2), list.length - size)); return list.slice(from, from + size); };
const nearby = sub || c.territory ? [] : landNeighbours.length
  ? around([c, ...landNeighbours].sort((a, b) => b.raw - a.raw || a.name.localeCompare(b.name)), 9)
  : around(countries.filter((x) => x.region === c.region), 5);
// the compare page takes up to six countries: this one and the nearest in score
const compareIds = [c, ...nearby.filter((x) => x !== c).sort((a, b) => Math.abs(a.raw - c.raw) - Math.abs(b.raw - c.raw))].slice(0, 4).map((x) => x.slug);

// The score's shape: the six segments as a radar, over the world average (and, for a state, its country).
const radarPt = (i, val, r = 40) => { const a = -Math.PI / 2 + (i * 2 * Math.PI) / SEGMENTS.length; return [50 + Math.cos(a) * r * (val / 10), 50 + Math.sin(a) * r * (val / 10)]; };
const radarPoly = (vals) => vals.map((val, i) => radarPt(i, val).map((n) => n.toFixed(2)).join(",")).join(" ");
// a label's side of the shape: right of the corner, left of it, or centred above or below
const radarSide = (i) => { const [lx] = radarPt(i, 10); return lx > 55 ? "r" : lx < 45 ? "l" : "c"; };

// The Sources section sums the list up: how many, from how many websites, and the most cited ones.
const hostOf = (url) => { try { return new URL(url).hostname.replace(/^www\./, ""); } catch { return null; } };
const hostCounts = [...refs.list.reduce((m, r) => { const h = r.source[1] && hostOf(r.source[1]); if (h) m.set(h, (m.get(h) ?? 0) + 1); return m; }, new Map())]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const printCount = refs.list.filter((r) => !r.source[1]).length;
// sources in the profile that no text cites, listed after the numbered ones
const refKey = (x) => x[3] ?? x[1] ?? x[0];
const citedSet = new Set(refs.list.map((r) => refKey(r.source)));
const uncited = srcList.filter((x) => !citedSet.has(refKey(x)));
---
<article class="country" data-id={c.id}>
  {/* The masthead: name, verdict and the one big number; then the five plain answers. */}
  <div class="c-top">
    <div class="d-head">
      <span class="d-flag">{c.flag}</span>
      <div>
        {/* a state or province is the page's subject: its name is the title, its country the line under it */}
        {sub
          ? <><h1>{sub.name}</h1><p class="sub">{group.label} of <a href={countryUrl}>{c.name}</a> · {c.region}</p></>
          : <><h1>{c.name}</h1><p class="sub">{c.region}</p></>}
      </div>
    </div>
    {group && (
      <label class="field sub-select">
        <span>{group.label}</span>
        <select id="subunit-choice" data-subunit-select aria-label={`Choose a ${group.label.toLowerCase()} of ${c.name}`}>
          <option value={countryUrl} selected={!sub}>All of {c.name} (national estimate)</option>
          {byName.map((x) => <option value={unitUrl(x)} selected={sub?.id === x.id}>{x.name} · {x.score}</option>)}
        </select>
      </label>
    )}
    <div class="d-score" style={`--c:${tierColor(v.raw)}`}>
      <p class="d-num" aria-label={`Score ${v.score} out of 100`}><b>{v.score}</b><span>/100</span></p>
      <div class="d-meter" aria-hidden="true"><i style={`width:${v.raw}%`}></i></div>
      <div>
        {group && !sub && <p class="d-estimate" title={`A separate estimate for the country as a whole, not an average of its ${group.plural}`}>National estimate · {group.plural} {unitRange}</p>}
        <div class="tier">{tierOf(v.raw).name}</div>
        {sub
          ? <p class="sub">#{sub.rank} of {group.units.length} in {c.name}<br>would rank #{sub.worldRank} among countries</p>
          : c.territory
            ? <p class="sub">Not ranked: {c.territory.label}<br>would rank #{c.worldRank} among countries</p>
            : <p class="sub">#{c.rank} of {countries.length} worldwide<br>#{c.regionRank} of {c.regionCount} in {c.region}</p>}
      </div>
    </div>
    <p class="d-note">{v.note}</p>
    <div class="d-chips">
      {ctxHas("recreational")
        ? <a class={`chip s-${v.rec}`} href="#seg-ctx-recreational" data-seg-link="ctx-recreational" title={REC_HELP[v.rec]}>Recreational: {REC_LABEL[v.rec]}</a>
        : <span class={`chip s-${v.rec}`} title={REC_HELP[v.rec]}>Recreational: {REC_LABEL[v.rec]}</span>}
      {ctxHas("medical")
        ? <a class={`chip s-${v.med}`} href="#seg-ctx-medical" data-seg-link="ctx-medical" title={MED_HELP[v.med]}>Medical: {MED_LABEL[v.med]}</a>
        : <span class={`chip s-${v.med}`} title={MED_HELP[v.med]}>Medical: {MED_LABEL[v.med]}</span>}
    </div>
    {ctxList && ctxList.some((x) => x && (x.status || x.seeds)) && (
      <div class="d-chips d-chips-ctx">
        {ctxList.filter((x) => x && (x.status || x.seeds)).map((x) => x.seeds ? (
          <>
            <a class={`chip s-${PLANTING_STATUS[x.seeds].tone}`} href={`#seg-ctx-${x.key}`} data-seg-link={`ctx-${x.key}`} title={PLANTING_STATUS[x.seeds].help[0]}>Seeds: {PLANTING_STATUS[x.seeds].label}</a>
            <a class={`chip s-${PLANTING_STATUS[x.clones].tone}`} href={`#seg-ctx-${x.key}`} data-seg-link={`ctx-${x.key}`} title={PLANTING_STATUS[x.clones].help[1]}>Clones: {PLANTING_STATUS[x.clones].label}</a>
          </>
        ) : (
          <a class={`chip s-${STATUS_SECTIONS[x.kind].statuses[x.status].tone}`} href={`#seg-ctx-${x.key}`} data-seg-link={`ctx-${x.key}`} title={STATUS_SECTIONS[x.kind].statuses[x.status].help}>{STATUS_SECTIONS[x.kind].chip}: {STATUS_SECTIONS[x.kind].statuses[x.status].label}</a>
        ))}
      </div>
    )}
    {c.territory && !sub && (
      <p class="c-disputed"><strong>{c.territory.kind}.</strong> {c.territory.note} See also <a href={`${base}country/${c.territory.country.slug}/`} data-country={c.territory.country.id}>{c.territory.country.flag} {c.territory.country.name}</a>.</p>
    )}
    <h2 class="d-h">In short <span><a href={`${base}can-i/`}>all countries →</a></span></h2>
    <ul class="answers">
      {answers.map((x) => (
        <li>
          <a class={`answer a-${x.answer}`} href={`#seg-${x.seg}`} data-seg-link={x.seg} title="Show the rules and sources">
            <span class="q">{x.q}</span>
            <b>{x.label}</b>
            <span class="t">{x.text}</span>
          </a>
        </li>
      ))}
    </ul>
    {group && !sub && <p class="d-hint"><a href="#subunit-choice">Choose a {group.label.toLowerCase()} for its local rules ↑</a></p>}
    <p class="d-hint">A rough guide read from the scores and the rules below, not legal advice. The details and the exceptions are in each segment: select an answer to jump to it.</p>
  </div>

  {/* The rest is one page: a row of links to every part, then the parts in order. */}
  {sections.length > 2 && (
    <nav class="c-nav" aria-label={`${c.name}: on this page`}>
      <ol>
        {sections.map(([id, label, count]) => (
          <li><a href={`#${id}`} data-nav={id}>{label}{count != null && <small>{count}</small>}</a></li>
        ))}
      </ol>
    </nav>
  )}

  {glance && (
    <section class="c-sec c-intro" id="overview">
      <h2 class="d-h">Cannabis in {theName(sub ? sub.name : c.name)} <span>not part of the score{datasetCount > 0 && <> · <a href="#datasets">all {datasetCount} datasets ↓</a></>}</span></h2>
      <CountryIntro c={c} sub={sub} wordRefs={wordRefs} />
    </section>
  )}

  {group && !sub && (
      <section class="c-sec c-units" id="units">
        <h2 class="d-h">{sub ? `Other ${group.plural}` : `By ${group.label.toLowerCase()}`} <span>{group.units.length} scored · national estimate {c.score}</span></h2>
        {!sub && <p class="d-hint">{group.intro}</p>}
        {map && (
          <figure class="unit-map">
            <svg viewBox={map.viewBox} role="group" aria-label={`Map of ${c.name}: ${group.plural} coloured by score`}>
              {map.shapes.map(({ unit: x, d }) => (
                <a href={unitUrl(x)} data-subunit data-tip={x.id} class={sub?.id === x.id ? "current" : undefined} aria-label={`${x.name}: ${x.score}, ${tierOf(x.raw).name}`}>
                  <path d={d} style={`fill:${tierColor(x.raw)}`} />
                </a>
              ))}
              {map.dots.map(({ unit: x, x: cx, y: cy }) => (
                <a href={unitUrl(x)} data-subunit data-tip={x.id} class={sub?.id === x.id ? "current" : undefined} aria-hidden="true" tabindex="-1">
                  <circle cx={cx} cy={cy} r="5" style={`fill:${tierColor(x.raw)}`} />
                </a>
              ))}
            </svg>
            {/* the hover box of each, as on the home page's map with its states shown (src/lib/unit-map-tip.js) */}
            <div class="tooltip" hidden></div>
            {group.units.map((x) => (
              <template data-tip-for={x.id}>
                <div class="tip-head"><strong><span class="tip-flag">{c.flag}</span>{x.name}</strong><span class="tip-chip" style={`--chip:${tierColor(x.raw)}`}>{x.score}</span></div>
                <div class="tip-meta">{tierOf(x.raw).name} · #{x.rank} of {group.units.length} in {c.name}</div>
                <div class="tip-bar"><i style={`width:${Math.max(2, Math.min(100, x.raw))}%;background:${tierColor(x.raw)}`}></i></div>
                {short(x.note) && <p class="tip-note">{short(x.note)}</p>}
                <div class="tip-foot">Click for the full profile</div>
              </template>
            ))}
            <figcaption class="unit-legend">
              {mapTiers.map((t) => <span><i style={`background:${tierColor(t.min)}`}></i>{t.name}</span>)}
            </figcaption>
          </figure>
        )}
        <ol class="units">
          {group.units.map((x) => (
            <li class={sub?.id === x.id ? "current" : undefined}>
              <a href={unitUrl(x)} data-subunit>
                <span class="u-rank">{x.rank}</span>
                <span class="u-name">{x.name}</span>
                <span class="u-score">{x.score}</span>
                <span class="bar"><i style={`width:${x.raw}%;background:${tierColor(x.raw)}`}></i></span>
              </a>
            </li>
          ))}
        </ol>
        {!sub && (
          <ul class="srcs">
            {group.sources.map((source) => <SourceCitation source={source} />)}
          </ul>
        )}
      </section>
  )}

  <section class="c-sec c-score" id="score">
    <h2 class="d-h">{group && !sub ? "National estimate" : "Score breakdown"} <span>{v.score}/100 · <a href={method()}>how the scores are made</a></span></h2>
    {sub
      ? <p class="d-hint">{group.intro}</p>
      : group && <p class="d-hint">One estimate for {c.name} as a whole: federal law and what holds in most {group.plural}. It is not an average of the {group.plural}, which run from {unitRange}.</p>}
    <div class="score-grid">
      <div class="score-side">
        <figure class="c-radar" aria-label={`The six segments of ${sub ? sub.name : c.name}'s score`}>
          <div class="c-radar-box">
            <svg viewBox="0 0 100 100" aria-hidden="true">
              {[2.5, 5, 7.5, 10].map((r) => <polygon class="c-radar-ring" points={radarPoly(SEGMENTS.map(() => r))} />)}
              {SEGMENTS.map((_, i) => { const [x2, y2] = radarPt(i, 10); return <line class="c-radar-ring" x1="50" y1="50" x2={x2} y2={y2} />; })}
              <polygon class="c-radar-avg" points={radarPoly(segAvg)} />
              {sub && <polygon class="c-radar-nat" points={radarPoly(c.s)} />}
              <polygon class="c-radar-shape" points={radarPoly(v.s)} style={`--c:${tierColor(v.raw)}`} />
              {SEGMENTS.map((s, i) => { const [cx, cy] = radarPt(i, v.s[i]); return <circle class="c-radar-dot" data-seg-dot={s.id} cx={cx} cy={cy} r="1.6" style={`--c:${tierColor(v.s[i] * 10)}`} />; })}
            </svg>
            {SEGMENTS.map((s, i) => { const [lx, ly] = radarPt(i, 11.5); return (
              <a class={`c-radar-label side-${radarSide(i)}`} href={`#seg-${s.id}`} data-seg-link={s.id} style={`left:${lx.toFixed(1)}%;top:${ly.toFixed(1)}%`}>{s.name} <b class="own">{v.s[i]}</b><b class="avg">{segAvg[i].toFixed(1)}</b></a>
            ); })}
          </div>
          <figcaption class="c-radar-key">
            <span><i class="sw-shape" style={`--c:${tierColor(v.raw)}`}></i>{sub ? sub.name : c.name}</span>
            {sub && <span><i class="sw-nat"></i>{c.name}</span>}
            <span class="key-avg" tabindex="0" title="Show the world average alone"><i class="sw-avg"></i>World average</span>
          </figcaption>
        </figure>
        {scored.length > 0 && <CountryChart history={scored} context={history.filter((ch) => !ch.score)} />}
        {nearby.length > 1 && (
          <div class="c-near">
            <h2>{landNeighbours.length ? `Neighbours${landNeighbours.length + 1 > nearby.length ? ` · ${nearby.length} of ${landNeighbours.length + 1}` : ""}` : `Similar scores in ${c.region}`}</h2>
            <ol>
              {nearby.map((x) => (
                <li class={x === c ? "on" : undefined}>
                  {x === c ? <span>{x.flag} {x.name}</span> : <a href={`${base}country/${x.slug}/`}>{x.flag} {x.name}</a>}
                  <i style={`--w:${x.raw}%;--c:${tierColor(x.raw)}`}></i>
                  <b>{x.score}</b>
                </li>
              ))}
            </ol>
            <p><a href={`${base}compare/?c=${compareIds.join(",")}`}>Compare {landNeighbours.length ? "with neighbours" : "them"} →</a></p>
          </div>
        )}
      </div>
      <div class="score-rows">
        {SEGMENTS.map((s, i) => {
          const text = sub ? sub.seg && unitParts[i] : d?.segments[i] && segParts[i];
          const penalties = sub ? sub.segPenalties[i] : d?.segments[i]?.penalties;
          return (
            <div class="segrow" data-seg={s.id} id={`seg-${s.id}`}>
              <div class="segrow-top">
                <span>{s.name} <small>· {s.weight}%</small></span>
                <b>{v.s[i]}/10{sub && <small class="vs">{c.name}: {c.s[i]}</small>}</b>
              </div>
              <div class="bar" title={`World average ${segAvg[i].toFixed(1)}/10`}>
                <i style={`width:${v.s[i] * 10}%;background:${tierColor(v.s[i] * 10)}`}></i>
                <span class="avg-tick" style={`left:calc(${segAvg[i] * 10}% - 1px)`}></span>
              </div>
              <div class="pts">adds {segmentPoints(i, v.s[i]).toFixed(1)} of {segmentMax(i).toFixed(0)} points · world average {segAvg[i].toFixed(1)}</div>
              {(text || penalties) && (
                <div class="why">
                  {text && <p><Cited parts={text} /></p>}
                  {penalties && <PenaltyTable penalties={penalties} />}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </section>

  {ctxList && (
    <section class="c-sec c-context" id="context">
      <h2 class="d-h">Context <span>not part of the score · <a href={`${base}context/`}>every country, by topic&nbsp;→</a></span></h2>
      {sub && <p class="d-hint">Sections written for {sub.name} come first in their place; the others hold for all of {c.name} and are marked so.</p>}
      {[ctxList.filter((x) => x && !x.items), ctxList.filter((x) => x && x.items)].map((list, g) => (list.length > 0 || (g === 0 && travel)) && (
        <div class={g ? "ctx-wide" : "ctx-grid"}>
          {list.map((x) => (
            <div class="segrow ctx-tile" data-seg={`ctx-${x.key}`} id={`seg-ctx-${x.key}`}>
              <div class="segrow-top"><span>{CONTEXT_ICONS[x.key] && <Icon name={CONTEXT_ICONS[x.key]} class="ctx-icon" aria-hidden="true" />}<span class="src-tip src-tip-inline ctx-topic-tip">{x.key === "products" ? x.name : <a class="ctx-topic" href={`${base}context/${x.key.replace(/_/g, "-")}/`}>{x.name}</a>}<span class="src-tip-pop" role="tooltip"><b>What this covers</b> {x.help}{x.key !== "products" && <i>Select for every country</i>}</span></span></span></div>
              {x.national && <p class="ctx ctx-general">For all of {c.name}; nothing written for {sub.name} yet.</p>}
              {x.key === "recreational" && (
                <div class="d-chips"><span class={`chip s-${v.rec}`} title={REC_HELP[v.rec]}>Recreational: {REC_LABEL[v.rec]}</span></div>
              )}
              {x.key === "medical" && (
                <div class="d-chips"><span class={`chip s-${v.med}`} title={MED_HELP[v.med]}>Medical: {MED_LABEL[v.med]}</span></div>
              )}
              {x.status && (
                <div class="d-chips">
                  <span class={`chip s-${STATUS_SECTIONS[x.kind].statuses[x.status].tone}`} title={STATUS_SECTIONS[x.kind].statuses[x.status].help}>{STATUS_SECTIONS[x.kind].chip}: {STATUS_SECTIONS[x.kind].statuses[x.status].label}</span>
                </div>
              )}
              {x.seeds && (
                <div class="d-chips">
                  <span class={`chip s-${PLANTING_STATUS[x.seeds].tone}`} title={PLANTING_STATUS[x.seeds].help[0]}>Seeds: {PLANTING_STATUS[x.seeds].label}</span>
                  <span class={`chip s-${PLANTING_TRADE[x.seeds_trade].tone}`} title={PLANTING_TRADE[x.seeds_trade].help[0]}>Seed sales: {PLANTING_TRADE[x.seeds_trade].label}</span>
                  <span class={`chip s-${PLANTING_STATUS[x.clones].tone}`} title={PLANTING_STATUS[x.clones].help[1]}>Clones: {PLANTING_STATUS[x.clones].label}</span>
                  <span class={`chip s-${PLANTING_TRADE[x.clones_trade].tone}`} title={PLANTING_TRADE[x.clones_trade].help[1]}>Clone sales: {PLANTING_TRADE[x.clones_trade].label}</span>
                </div>
              )}
              {x.items
                ? x.items.map((item, i) => (
                    <div class="ctx-spot">
                      <h3 class="ctx-spot-h">{item.title}</h3>
                      <p class="ctx"><Cited parts={ctxParts[x.key][i]} /></p>
                    </div>
                  ))
                : <p class="ctx"><Cited parts={ctxParts[x.key]} /></p>}
            </div>
          ))}
          {g === 0 && travel && (
            <div class="segrow ctx-tile">
              <div class="segrow-top"><span><Icon name={CONTEXT_ICONS.border} class="ctx-icon" aria-hidden="true" />Crossing the border</span></div>
              {travel.map((line, k) => <p class="ctx">{line}{k === travel.length - 1 && <Cited parts={[{ refs: [incbRef] }]} />}</p>)}
              <p class="ctx ctx-general">General guidance that applies to almost every country, not a check of {c.name}'s customs rules.</p>
            </div>
          )}
        </div>
      ))}
    </section>
  )}

  {culture.length > 0 && (
    <section class="c-sec c-atlas" id="culture">
      <h2 class="d-h">Culture <span><a href={`${base}culture/`}>the atlas →</a></span></h2>
      {sub && <p class="d-hint">These belong to the whole country, not to {sub.name} alone.</p>}
      {/* cards with the entry's picture; past the first eight they wait behind "Show all" */}
      {[culture.slice(0, CULTURE_CARDS), culture.slice(CULTURE_CARDS)].map((list, g) => list.length > 0 && (() => {
        const cards = (
          <ul class="atlas-cards">
            {list.map((e) => (
              <li>
                <a href={`${base}${e.url}`}>
                  {e.image
                    ? <Image src={e.image.src} alt="" width={480} height={360} fit="cover" loading="lazy" />
                    : <span class="atlas-none" aria-hidden="true">{e.title.slice(0, 1)}</span>}
                  <span class="atlas-body">
                    <small>{cultureSection(e.section).name}</small>
                    <b>{e.title}</b>
                    {e.summary && <span class="atlas-sum">{e.summary}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        );
        return g === 0 ? cards : <details class="atlas-more"><summary>Show all {culture.length}</summary>{cards}</details>;
      })())}
    </section>
  )}

  {facts.length > 0 && (
    <section class="c-sec c-dyk" id="did-you-know">
      <h2 class="d-h">Did you know? <span><a href={`${base}did-you-know/`}>all cases →</a></span></h2>
      <ol class="dyk-facts dyk-all">
        {facts.map((f) => (
          <li class="dyk-fact">
            <p class="dyk-kicker">{f.kicker}</p>
            <p class="dyk-text"><FactText parts={f.parts} here={c.id} /></p>
            {f.culture ? <a class="dyk-more" href={`${base}${f.culture.url}`}>Read the entry →</a> : f.history && <a class="dyk-more" href={`${base}history/${f.history.id}/`}>The full story →</a>}
          </li>
        ))}
      </ol>
    </section>
  )}

  {datasetCount > 0 && (
    <section class="c-sec" id="datasets">
      {sub && <p class="d-hint">These figures are for all of {c.name}; no dataset here is broken down by {group.label.toLowerCase()} yet.</p>}
      <CountryDatasetTab c={c} />
    </section>
  )}

  {history.length > 0 && (
    <section class="c-sec" id="history">
      <CountryChanges history={history} unitLabel={!sub && group ? group.label : null} showUnit={!sub} scoreLine={!sub}
        more={sub ? <>Only the entries about {sub.name}. <a href={`${countryUrl}#history`}>All {nationalCount} entries on the national page →</a></> : null} />
    </section>
  )}

  {group && sub && (
      <section class="c-sec c-units" id="units">
        <h2 class="d-h">{sub ? `Other ${group.plural}` : `By ${group.label.toLowerCase()}`} <span>{group.units.length} scored · national estimate {c.score}</span></h2>
        {!sub && <p class="d-hint">{group.intro}</p>}
        {map && (
          <figure class="unit-map">
            <svg viewBox={map.viewBox} role="group" aria-label={`Map of ${c.name}: ${group.plural} coloured by score`}>
              {map.shapes.map(({ unit: x, d }) => (
                <a href={unitUrl(x)} data-subunit data-tip={x.id} class={sub?.id === x.id ? "current" : undefined} aria-label={`${x.name}: ${x.score}, ${tierOf(x.raw).name}`}>
                  <path d={d} style={`fill:${tierColor(x.raw)}`} />
                </a>
              ))}
              {map.dots.map(({ unit: x, x: cx, y: cy }) => (
                <a href={unitUrl(x)} data-subunit data-tip={x.id} class={sub?.id === x.id ? "current" : undefined} aria-hidden="true" tabindex="-1">
                  <circle cx={cx} cy={cy} r="5" style={`fill:${tierColor(x.raw)}`} />
                </a>
              ))}
            </svg>
            {/* the hover box of each, as on the home page's map with its states shown (src/lib/unit-map-tip.js) */}
            <div class="tooltip" hidden></div>
            {group.units.map((x) => (
              <template data-tip-for={x.id}>
                <div class="tip-head"><strong><span class="tip-flag">{c.flag}</span>{x.name}</strong><span class="tip-chip" style={`--chip:${tierColor(x.raw)}`}>{x.score}</span></div>
                <div class="tip-meta">{tierOf(x.raw).name} · #{x.rank} of {group.units.length} in {c.name}</div>
                <div class="tip-bar"><i style={`width:${Math.max(2, Math.min(100, x.raw))}%;background:${tierColor(x.raw)}`}></i></div>
                {short(x.note) && <p class="tip-note">{short(x.note)}</p>}
                <div class="tip-foot">Click for the full profile</div>
              </template>
            ))}
            <figcaption class="unit-legend">
              {mapTiers.map((t) => <span><i style={`background:${tierColor(t.min)}`}></i>{t.name}</span>)}
            </figcaption>
          </figure>
        )}
        <ol class="units">
          {group.units.map((x) => (
            <li class={sub?.id === x.id ? "current" : undefined}>
              <a href={unitUrl(x)} data-subunit>
                <span class="u-rank">{x.rank}</span>
                <span class="u-name">{x.name}</span>
                <span class="u-score">{x.score}</span>
                <span class="bar"><i style={`width:${x.raw}%;background:${tierColor(x.raw)}`}></i></span>
              </a>
            </li>
          ))}
        </ol>
        {!sub && (
          <ul class="srcs">
            {group.sources.map((source) => <SourceCitation source={source} />)}
          </ul>
        )}
      </section>
  )}




  {refs.list.length > 0 && (
    <section class="c-sec c-sources" id="sources">
      <h2 class="d-h">Sources <span>hover a number in the text to see its source</span></h2>
      <div class="src-sum">
        <dl class="src-figs">
          <div><dt>Cited</dt><dd>{refs.list.length}</dd></div>
          <div><dt>Websites</dt><dd>{hostCounts.length}</dd></div>
          {printCount > 0 && <div><dt>Print</dt><dd>{printCount}</dd></div>}
          {updated && <div><dt>Last reviewed</dt><dd class="src-date"><time datetime={updated}>{updatedText}</time></dd></div>}
          {scored.length > 0 && <div><dt>History checked</dt><dd>{history.filter((ch) => ch.confidence.key === "checked").length}<small>/{history.length}</small></dd></div>}
        </dl>
        {hostCounts.length > 0 && (
          <div class="src-hosts">
            <h3>Most cited</h3>
            <ol>
              {hostCounts.slice(0, 6).map(([h, n]) => (
                <li><span>{h}</span><i style={`--w:${(n / hostCounts[0][1]) * 100}%`}></i><b>{n}</b></li>
              ))}
            </ol>
          </div>
        )}
      </div>
      <details class="src-all">
        <summary>All {refs.list.length + uncited.length} sources</summary>
        <ol class="srcs refs" data-archive>
          {refs.list.map((r) => <SourceCitation source={r.source} id={r.id} n={r.n} archive />)}
        </ol>
        {uncited.length > 0 && (
          <>
            <h3>Also consulted</h3>
            <ul class="srcs">{uncited.map((x) => <SourceCitation source={x} archive />)}</ul>
          </>
        )}
      </details>
    </section>
  )}
</article>
<script>
  import "../lib/unit-map-tip.js";

  // The row of links over the profile marks the part in view, and on a phone keeps that link in
  // sight. Only on the full page: in the home page's drawer the row is hidden.
  const nav = document.querySelector(".country-page .c-nav");
  if (nav) {
    const row = nav.querySelector("ol");
    const links = [...nav.querySelectorAll("a[data-nav]")];
    const parts = links.map((a) => document.getElementById(a.dataset.nav));
    let current = null, queued = false;
    const mark = () => {
      queued = false;
      // a part counts as being read once its heading is in the upper third of the window
      const line = Math.max(nav.getBoundingClientRect().bottom + 24, innerHeight * 0.3);
      let i = -1;
      parts.forEach((el, k) => { if (el && el.getBoundingClientRect().top <= line) i = k; });
      // at the very end of the page the last part is the one being read, however short it is
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) i = parts.length - 1;
      const link = links[i] ?? null;
      if (link === current) return;
      current?.removeAttribute("aria-current");
      link?.setAttribute("aria-current", "true");
      current = link;
      if (link) row.scrollTo({ left: link.offsetLeft - row.clientWidth / 2 + link.offsetWidth / 2, behavior: "smooth" });
    };
    addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(mark); } }, { passive: true });
    mark();
  }
</script>
