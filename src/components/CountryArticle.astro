---
// Full write-up for one country. Rendered on its own page, and fetched into the
// drawer on the home page — so there is a single template for both views.
import { useAges, SEGMENTS, REC_LABEL, REC_HELP, MED_LABEL, MED_HELP, countries, changes, segAvg, segmentPoints, segmentMax, subunitsOf, formatDate } from "../lib/countries.js";
import { TIERS, tierOf, tierColor, tierIndex } from "../lib/tiers.js";
import { unitMap } from "../lib/unit-map.js";
import { short } from "../lib/short.js";
import CountryChanges from "./CountryChanges.astro";
import CountryChart from "./CountryChart.astro";
import PricePanel from "./PricePanel.astro";
import CountryDatasets from "./CountryDatasets.astro";
import CountryDatasetTab from "./CountryDatasetTab.astro";
import { datasetsOf } from "../lib/datasets.js";
import SourceTip from "./SourceTip.astro";
import SourceCitation from "./SourceCitation.astro";
import Cited from "./Cited.astro";
import References from "./References.astro";
import { references, citeParts, citedKeys } from "../lib/cite.js";
import { SHOW_PRICES } from "../lib/config.js";
import { PLANTING_STATUS, STATUS_SECTIONS, PLANTING_TRADE } from "../lib/segment-ids.js";
import { answersFor } from "../lib/answers.js";
import CultureList from "./CultureList.astro";
import { cultureOf } from "../lib/culture.js";

// `sub` is optional: one state, province or territory of `c`. Without it the national view is shown.
const { c, sub } = Astro.props;
const base = import.meta.env.BASE_URL;
const group = subunitsOf(c.id);
const v = sub ?? c; // whichever entity's scores are on display
const d = sub ? null : c.details;
const countryUrl = `${base}country/${c.slug}/`;
const unitUrl = (x) => `${countryUrl}${x.id}/`;
// Date the entry was last reviewed, stored as YYYY-MM-DD and shown in full.
const updated = sub ? sub.reviewed : d?.reviewed;
const updatedText = updated && formatDate(updated);
// the states or provinces on a map, coloured by score, above their list
const map = group ? unitMap(c.slug, group.units) : null;
// the tiers that appear on it, best first, for its legend
const mapTiers = map ? TIERS.filter((t, i) => group.units.some((x) => tierIndex(x.raw) === TIERS.length - 1 - i)) : [];
const byName = group ? [...group.units].sort((a, b) => a.name.localeCompare(b.name)) : [];
// the spread of the states' or provinces' scores, shown beside the national estimate
const unitRange = group ? `${Math.min(...group.units.map((x) => x.score))}–${Math.max(...group.units.map((x) => x.score))}` : "";
// The country's history, newest first; on a state's or province's page only the entries about it.
const history = changes.filter((ch) => ch.country === c && (!sub || ch.unit?.id === sub.id));
const nationalCount = sub ? changes.filter((ch) => ch.country === c).length : 0;
const scored = sub ? [] : history.filter((ch) => ch.score); // the ones that moved the score (the national one)
// Inline citations (src/lib/cite.js): the score breakdown and the context each number their sources
// in reading order, and list them at their end.
const scoreRefs = references("sc"), ctxRefs = references("cx");
const partsOf = (block, refs, where) => citeParts(block.cite.text, refs, (k) => block.cite.keys.includes(k) && block.cite.of(k), block.cite.keys, `countries/${c.slug}.yaml: ${where}`);
const segParts = d ? d.segments.map((seg, i) => seg && partsOf(seg, scoreRefs, SEGMENTS[i].id)) : [];
const unitRefs = references("unit");
const unitParts = sub ? sub.segCite.map((text, i) => citeParts(text, unitRefs,
  (k) => /^[1-9]\d*$/.test(k) && sub.sources[+k - 1],
  citedKeys(text) ?? sub.sources.map((_, i) => String(i + 1)),
  `countries/${c.slug}/${sub.id}.yaml: ${SEGMENTS[i].id}`)) : [];
const ctxParts = d ? Object.fromEntries(d.context.filter(Boolean).map((x) => [x.key, partsOf(x, ctxRefs, x.key)])) : {};
const INCB = ["International Narcotics Control Board — Travellers carrying medicines containing controlled substances", "https://www.incb.org/incb/en/travellers/index.html", null, "https://www.incb.org/incb/en/travellers/index.html"];
// 48,000,000 → "48 million", 770,000 → "770,000"
const people = (n) => (n >= 1e6 ? `${+(n / 1e6).toPrecision(2)} million` : n.toLocaleString("en-GB"));
const use = sub ? null : c.use;
const unitUse = sub?.use ?? null; // a state's or province's own survey figure
// a disputed territory with no survey takes the figure of the country it is part of
const useFrom = use?.estimate_from ? countries.find((x) => x.id === use.estimate_from.toUpperCase()) : null;
// Crossing a border with cannabis. This is general guidance, the same rule almost everywhere,
// worded for the country's status; it is not country-specific research.
const SCHENGEN = new Set("AT BE BG HR CZ DK EE FI FR DE GR HU IS IT LV LI LT LU MT NL NO PL PT RO SK SI ES SE CH".split(" "));
const travel = sub ? null : [
  `Taking cannabis into or out of ${c.name} is a separate offence from possessing it, normally charged as smuggling or trafficking, with far heavier penalties. That holds almost everywhere, including between two places where cannabis is legal.`,
  ["legal", "partial", "decrim"].includes(c.rec) && `The rules that allow or tolerate small amounts inside ${c.name} do not cover the border, an airport or the post.`,
  c.rec === "death" && `In ${c.name} the heaviest penalties, up to the death penalty, are aimed at trafficking, and bringing drugs across the border is treated as trafficking.`,
  SCHENGEN.has(c.id)
    ? `A prescription from another country is not recognised by itself. Within the Schengen area a patient can carry prescribed medicine for up to 30 days with a certificate issued by their home health authority; whether cannabis qualifies depends on both countries.`
    : `A prescription or medical card from another country is generally not recognised. Travellers who need a cannabis-based medicine should ask ${c.name}'s embassy before travelling.`,
].filter(Boolean);
const incbRef = travel ? ctxRefs.cite(INCB) : null; // the crossing-the-border note cites one guide
const answers = answersFor(v);
// The methodology lives on the home page: its section, or the description of one segment there.
const method = (segId) => `${base}#${segId ? `method-${segId}` : "methodology"}`;

// outside datasets with figures for the country, listed in their own tab
const datasetCount = sub ? 0 : Object.keys(datasetsOf(c.slug)).length;
// The right-hand side is split into tabs so that the history is one click away instead of at
// the bottom of a long page: [id, label, count]. Labels are kept short so that the row fits; the
// panels' headings say it in full ("provinces and territories", "national estimate"). A single state has only its score breakdown.
// A federation opens on its states or provinces, the national estimate after them; a single state
// or province has its own breakdown, its history and the others of its country.
const tabs = (sub
  ? [
      ["score", "Score breakdown"],
      history.length > 0 && ["history", "History", history.length],
      ["units", `Other ${group.plural.split(" ")[0]}`, group.units.length - 1],
    ]
  : [
      group && ["units", group.plural[0].toUpperCase() + group.plural.split(" ")[0].slice(1), group.units.length],
      ["score", group ? "National" : "Score breakdown"],
      d && ["context", "Context"],
      history.length > 0 && ["history", "History", history.length],
      d && datasetCount > 0 && ["datasets", "Datasets", datasetCount],
      d && ["sources", "Sources", d.sources.length],
    ]).filter(Boolean);
const firstTab = tabs[0][0];
// words and traditions of the cultural atlas that belong to this country; a state shows its country's
const culture = cultureOf(c);
---
<article class="country" data-id={c.id} data-default-tab={firstTab}>
  {/* The masthead: name, verdict and the one big number; then the five plain answers. */}
  <div class="c-top">
    <div class="d-head">
      <span class="d-flag">{c.flag}</span>
      <div>
        {/* a state or province is the page's subject: its name is the title, its country the line under it */}
        {sub
          ? <><h1>{sub.name}</h1><p class="sub">{group.label} of <a href={countryUrl}>{c.name}</a> · {c.region}</p></>
          : <><h1>{c.name}</h1><p class="sub">{c.region}</p></>}
      </div>
    </div>
    {group && (
      <label class="field sub-select">
        <span>{group.label}</span>
        <select data-subunit-select aria-label={`Choose a ${group.label.toLowerCase()} of ${c.name}`}>
          <option value={countryUrl} selected={!sub}>All of {c.name} (national estimate)</option>
          {byName.map((x) => <option value={unitUrl(x)} selected={sub?.id === x.id}>{x.name} · {x.score}</option>)}
        </select>
      </label>
    )}
    <div class="d-score" style={`--c:${tierColor(v.raw)}`}>
      <p class="d-num" aria-label={`Score ${v.score} out of 100`}><b>{v.score}</b><span>/100</span></p>
      <div class="d-meter" aria-hidden="true"><i style={`width:${v.raw}%`}></i></div>
      <div>
        {group && !sub && <p class="d-estimate" title={`A separate estimate for the country as a whole, not an average of its ${group.plural}`}>National estimate · {group.plural} {unitRange}</p>}
        <div class="tier">{tierOf(v.raw).name}</div>
        {sub
          ? <p class="sub">#{sub.rank} of {group.units.length} in {c.name}<br>would rank #{sub.worldRank} among countries</p>
          : c.territory
            ? <p class="sub">Not ranked: {c.territory.label}<br>would rank #{c.worldRank} among countries</p>
            : <p class="sub">#{c.rank} of {countries.length} worldwide<br>#{c.regionRank} of {c.regionCount} in {c.region}</p>}
      </div>
    </div>
    <p class="d-note">{v.note}</p>
    <div class="d-chips">
      <span class={`chip s-${v.rec}`} title={REC_HELP[v.rec]}>Recreational: {REC_LABEL[v.rec]}</span>
      <span class={`chip s-${v.med}`} title={MED_HELP[v.med]}>Medical: {MED_LABEL[v.med]}</span>
    </div>
    {d && d.context.some((x) => x && (x.status || x.seeds)) && (
      <div class="d-chips d-chips-ctx">
        {d.context.filter((x) => x && (x.status || x.seeds)).map((x) => x.seeds ? (
          <>
            <a class={`chip s-${PLANTING_STATUS[x.seeds].tone}`} href={`#seg-ctx-${x.key}`} data-seg-link={`ctx-${x.key}`} title={PLANTING_STATUS[x.seeds].help[0]}>Seeds: {PLANTING_STATUS[x.seeds].label}</a>
            <a class={`chip s-${PLANTING_STATUS[x.clones].tone}`} href={`#seg-ctx-${x.key}`} data-seg-link={`ctx-${x.key}`} title={PLANTING_STATUS[x.clones].help[1]}>Clones: {PLANTING_STATUS[x.clones].label}</a>
          </>
        ) : (
          <a class={`chip s-${STATUS_SECTIONS[x.kind].statuses[x.status].tone}`} href={`#seg-ctx-${x.key}`} data-seg-link={`ctx-${x.key}`} title={STATUS_SECTIONS[x.kind].statuses[x.status].help}>{STATUS_SECTIONS[x.kind].chip}: {STATUS_SECTIONS[x.kind].statuses[x.status].label}</a>
        ))}
      </div>
    )}
    {c.territory && !sub && (
      <p class="c-disputed"><strong>{c.territory.kind}.</strong> {c.territory.note} See also <a href={`${base}country/${c.territory.country.slug}/`} data-country={c.territory.country.id}>{c.territory.country.flag} {c.territory.country.name}</a>.</p>
    )}
    <h2 class="d-h">In short <span><a href={`${base}can-i/`}>all countries →</a></span></h2>
    <ul class="answers">
      {answers.map((x) => (
        <li>
          <a class={`answer a-${x.answer}`} href={`#seg-${x.seg}`} data-seg-link={x.seg} title="Show the rules and sources">
            <span class="q">{x.q}</span>
            <b>{x.label}</b>
            <span class="t">{x.text}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="d-hint">A rough guide read from the scores and the rules below, not legal advice. The details and the exceptions are in each segment: select an answer to jump to it.</p>
  </div>

  {/* Figures at a glance: the score over time, users, other datasets and prices. A sticky rail on the full page. */}
  <div class="c-rail">
    {scored.length > 0 && <CountryChart history={scored} context={history.filter((ch) => !ch.score)} />}
    {use && (
      <dl class="c-use">
        {use.users != null && (
          <div>
            <dt>Cannabis users</dt>
            <dd>{use.estimate || use.users_approximate ? "about " : ""}{people(use.users)}</dd>
          </div>
        )}
        <div>
          <dt>Share aged {useAges(use)}</dt>
          <dd>{use.estimate ? "about " : ""}{use.prevalence}%</dd>
        </div>
        <p>{useFrom
          ? `This site's figure: there is no survey of ${c.name} alone, so ${useFrom.name}'s rate from its ${useFrom.use.period ?? useFrom.use.year} survey is applied to an estimate of the people aged 15–64 here.`
          : use.estimate
          ? `This site's figure: there is no national survey, so the median rate of surveyed countries in ${c.region} is applied to people aged 15–64.`
          : `People who used cannabis in the past year, from a ${use.period ?? use.year} survey${use.users != null ? `, applied to today's population aged ${useAges({ ages: use.population_ages || use.ages })}` : ""}${use.users_approximate ? ". The population is approximate: the survey ages cut through an age group, or were not recorded and ages 15–64 are used" : ""}${use.source === "earlier" ? ". An earlier figure: UNODC's 2026 table has none for this country" : ""}.`}</p>
        <SourceTip>{use.source === "wdr2026"
          ? <><a href="https://www.unodc.org/unodc/en/data-and-analysis/world-drug-report-2026-annex.html" target="_blank" rel="noopener noreferrer">UNODC World Drug Report 2026</a>, annex table 1.2</>
          : use.source === "earlier"
            ? <>An earlier UNODC figure, as collected in <a href="https://en.wikipedia.org/wiki/List_of_countries_by_annual_cannabis_use" target="_blank" rel="noopener noreferrer">Wikipedia's list of annual cannabis use by country</a></>
            : useFrom
            ? <>{useFrom.name}'s figure from the <a href="https://www.unodc.org/unodc/en/data-and-analysis/world-drug-report-2026-annex.html" target="_blank" rel="noopener noreferrer">UNODC World Drug Report 2026</a>; the population aged 15–64 is this place's total times {useFrom.name}'s share of those ages</>
            : <>A median computed on this site from surveyed countries in {c.region}, using <a href="https://www.unodc.org/unodc/en/data-and-analysis/world-drug-report-2026-annex.html" target="_blank" rel="noopener noreferrer">UNODC World Drug Report 2026</a> figures</>}{use.users != null && <>. Population from the <a href="https://data.worldbank.org/" target="_blank" rel="noopener noreferrer">World Bank</a>, aged {useAges({ ages: use.population_ages || use.ages })}</>}. <a href={`${base}sources/#dataset-cannabis_use`}>The whole dataset →</a></SourceTip>
      </dl>
    )}
    {unitUse && (
      <dl class="c-use">
        {unitUse.users && (
          <div>
            <dt>Cannabis users</dt>
            <dd>{people(unitUse.users)}</dd>
          </div>
        )}
        <div>
          <dt>Share aged {unitUse.ages}</dt>
          <dd>{unitUse.share}%</dd>
        </div>
        <p>People who used cannabis in the past year, {unitUse.year}.{unitUse.note && ` ${unitUse.note}`} The survey's own age band, so not directly comparable with the national figures.</p>
        <SourceTip>{unitUse.source[1] ? <a href={unitUse.source[1]} target="_blank" rel="noopener noreferrer">{unitUse.source[0]}</a> : unitUse.source[0]}</SourceTip>
      </dl>
    )}
    {!sub && <CountryDatasets c={c} all={datasetCount} />}
    {SHOW_PRICES && !sub && <PricePanel id={c.id} />}
    {culture.length > 0 && <CultureList entries={culture} heading="Culture" more={["The atlas →", `${base}culture/`]} limit={6} note={sub ? `These belong to the whole country, not to ${sub.name} alone.` : null} />}
  </div>

  <div class="c-main">
    {tabs.length > 1 && (
      <nav class="c-tabs" role="tablist" aria-label={`${c.name}: parts of the profile`}>
        {tabs.map(([id, label, count], i) => (
          <button type="button" role="tab" id={`tab-${id}`} data-tab={id} aria-controls={`panel-${id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{label}{count != null && <small> {count}</small>}</button>
        ))}
      </nav>
    )}
    {group && (
      <div class="c-panel" id="panel-units" data-panel="units" role="tabpanel" aria-labelledby="tab-units" hidden={firstTab !== "units"}>
      <section class="c-units">
        <h2 class="d-h">{sub ? `Other ${group.plural}` : `By ${group.label.toLowerCase()}`} <span>{group.units.length} scored · national estimate {c.score}</span></h2>
        {!sub && <p class="d-hint">{group.intro}</p>}
        {map && (
          <figure class="unit-map">
            <svg viewBox={map.viewBox} role="group" aria-label={`Map of ${c.name}: ${group.plural} coloured by score`}>
              {map.shapes.map(({ unit: x, d }) => (
                <a href={unitUrl(x)} data-subunit data-tip={x.id} class={sub?.id === x.id ? "current" : undefined} aria-label={`${x.name}: ${x.score}, ${tierOf(x.raw).name}`}>
                  <path d={d} style={`fill:${tierColor(x.raw)}`} />
                </a>
              ))}
              {map.dots.map(({ unit: x, x: cx, y: cy }) => (
                <a href={unitUrl(x)} data-subunit data-tip={x.id} class={sub?.id === x.id ? "current" : undefined} aria-hidden="true" tabindex="-1">
                  <circle cx={cx} cy={cy} r="5" style={`fill:${tierColor(x.raw)}`} />
                </a>
              ))}
            </svg>
            {/* the hover box of each, as on the home page's map with its states shown (src/lib/unit-map-tip.js) */}
            <div class="tooltip" hidden></div>
            {group.units.map((x) => (
              <template data-tip-for={x.id}>
                <div class="tip-head"><strong><span class="tip-flag">{c.flag}</span>{x.name}</strong><span class="tip-chip" style={`--chip:${tierColor(x.raw)}`}>{x.score}</span></div>
                <div class="tip-meta">{tierOf(x.raw).name} · #{x.rank} of {group.units.length} in {c.name}</div>
                <div class="tip-bar"><i style={`width:${Math.max(2, Math.min(100, x.raw))}%;background:${tierColor(x.raw)}`}></i></div>
                {short(x.note) && <p class="tip-note">{short(x.note)}</p>}
                <div class="tip-foot">Click for the full profile</div>
              </template>
            ))}
            <figcaption class="unit-legend">
              {mapTiers.map((t) => <span><i style={`background:${tierColor(t.min)}`}></i>{t.name}</span>)}
            </figcaption>
          </figure>
        )}
        <ol class="units">
          {group.units.map((x) => (
            <li class={sub?.id === x.id ? "current" : undefined}>
              <a href={unitUrl(x)} data-subunit>
                <span class="u-rank">{x.rank}</span>
                <span class="u-name">{x.name}</span>
                <span class="u-score">{x.score}</span>
                <span class="bar"><i style={`width:${x.raw}%;background:${tierColor(x.raw)}`}></i></span>
              </a>
            </li>
          ))}
        </ol>
        {!sub && (
          <ul class="srcs">
            {group.sources.map((source) => <SourceCitation source={source} />)}
          </ul>
        )}
      </section>
      </div>
    )}
    <div class="c-panel" id="panel-score" data-panel="score" role={tabs.length > 1 ? "tabpanel" : undefined} aria-labelledby={tabs.length > 1 ? "tab-score" : undefined} hidden={firstTab !== "score"}>
    <h2 class="d-h">{group && !sub ? "National estimate" : "Score breakdown"} <span>▏world average <button type="button" class="seg-toggle" data-seg-toggle aria-expanded="false">Open all</button></span></h2>
    {sub
      ? <p class="d-hint">{group.intro} Select a segment to show or hide the rules. <a href={method()}>How the scores are made →</a></p>
      : <p class="d-hint">{group && `One estimate for ${c.name} as a whole: federal law and what holds in most ${group.plural}. It is not an average of the ${group.plural}, which run from ${unitRange}. `}Select a segment to show or hide the exact rules and sources. <a href={method()}>How the scores are made →</a></p>}
    {sub && SEGMENTS.map((s, i) => (
      <details class="segrow" data-seg={s.id}>
        <summary>
          <div class="segrow-top">
            <span>{s.name} <small>· {s.weight}%</small></span>
            <b>{sub.s[i]}/10 <small class="vs">{c.name}: {c.s[i]}</small><i class="chev" aria-hidden="true"></i></b>
          </div>
          <div class="bar" title={`World average ${segAvg[i].toFixed(1)}/10`}>
            <i style={`width:${sub.s[i] * 10}%;background:${tierColor(sub.s[i] * 10)}`}></i>
            <span class="avg-tick" style={`left:calc(${segAvg[i] * 10}% - 1px)`}></span>
          </div>
          <div class="pts">adds {segmentPoints(i, sub.s[i]).toFixed(1)} of {segmentMax(i).toFixed(0)} points</div>
        </summary>
        <div class="why">
          {sub.seg && <p><Cited parts={unitParts[i]} /></p>}
        </div>
      </details>
    ))}
    {sub && (
      <section class="c-unit-sources">
        <References refs={unitRefs} />
      </section>
    )}
    {!sub && SEGMENTS.map((s, i) => {
      const seg = d?.segments[i];
      return (
        <details class="segrow" data-seg={s.id}>
          <summary>
            <div class="segrow-top">
              <span>{s.name} <small>· {s.weight}%</small></span>
              <b>{c.s[i]}/10<i class="chev" aria-hidden="true"></i></b>
            </div>
            <div class="bar" title={`World average ${segAvg[i].toFixed(1)}/10`}>
              <i style={`width:${c.s[i] * 10}%;background:${tierColor(c.s[i] * 10)}`}></i>
              <span class="avg-tick" style={`left:calc(${segAvg[i] * 10}% - 1px)`}></span>
            </div>
            <div class="pts">adds {segmentPoints(i, c.s[i]).toFixed(1)} of {segmentMax(i).toFixed(0)} points</div>
          </summary>
          {seg && (
            <div class="why">
              <p><Cited parts={segParts[i]} /></p>
            </div>
          )}
        </details>
      );
    })}
    {d && <References refs={scoreRefs} title="References" level="h3" />}

    </div>

    {d && (
      <div class="c-panel" id="panel-context" data-panel="context" role="tabpanel" aria-labelledby="tab-context" hidden>
        <h2 class="d-h">More context <span>not part of the score</span></h2>
        {d.context.filter(Boolean).map((x) => (
          <div class="segrow" data-seg={`ctx-${x.key}`} id={`seg-ctx-${x.key}`}>
            <div class="segrow-top"><span>{x.name === "Death penalty" ? "☠️ " : ""}{x.name}</span></div>
            {x.status && (
              <div class="d-chips">
                <span class={`chip s-${STATUS_SECTIONS[x.kind].statuses[x.status].tone}`} title={STATUS_SECTIONS[x.kind].statuses[x.status].help}>{STATUS_SECTIONS[x.kind].chip}: {STATUS_SECTIONS[x.kind].statuses[x.status].label}</span>
              </div>
            )}
            {x.seeds && (
              <div class="d-chips">
                <span class={`chip s-${PLANTING_STATUS[x.seeds].tone}`} title={PLANTING_STATUS[x.seeds].help[0]}>Seeds: {PLANTING_STATUS[x.seeds].label}</span>
                <span class={`chip s-${PLANTING_TRADE[x.seeds_trade].tone}`} title={PLANTING_TRADE[x.seeds_trade].help[0]}>Seed sales: {PLANTING_TRADE[x.seeds_trade].label}</span>
                <span class={`chip s-${PLANTING_STATUS[x.clones].tone}`} title={PLANTING_STATUS[x.clones].help[1]}>Clones: {PLANTING_STATUS[x.clones].label}</span>
                <span class={`chip s-${PLANTING_TRADE[x.clones_trade].tone}`} title={PLANTING_TRADE[x.clones_trade].help[1]}>Clone sales: {PLANTING_TRADE[x.clones_trade].label}</span>
              </div>
            )}
            <p class="ctx"><Cited parts={ctxParts[x.key]} /></p>
          </div>
        ))}
        {travel && (
          <div class="segrow">
            <div class="segrow-top"><span>🛂 Crossing the border</span></div>
            {travel.map((line, k) => <p class="ctx">{line}{k === travel.length - 1 && <Cited parts={[{ refs: [incbRef] }]} />}</p>)}
            <p class="ctx ctx-general">General guidance that applies to almost every country, not a check of {c.name}'s customs rules.</p>
          </div>
        )}
        <References refs={ctxRefs} title="References" level="h3" />
      </div>
    )}
    {history.length > 0 && (
      <div class="c-panel" id="panel-history" data-panel="history" role="tabpanel" aria-labelledby="tab-history" hidden>
        <CountryChanges history={history} unitLabel={!sub && group ? group.label : null} showUnit={!sub} scoreLine={!sub}
          more={sub ? <>Only the entries about {sub.name}. <a href={`${countryUrl}#history`}>All {nationalCount} entries on the national page →</a></> : null} />
      </div>
    )}
    {d && datasetCount > 0 && (
      <div class="c-panel" id="panel-datasets" data-panel="datasets" role="tabpanel" aria-labelledby="tab-datasets" hidden>
        <CountryDatasetTab c={c} />
      </div>
    )}
    {d && (
      <div class="c-panel" id="panel-sources" data-panel="sources" role="tabpanel" aria-labelledby="tab-sources" hidden>
        <section class="c-sources">
          <h2 class="d-h">All sources <span>{d.sources.length} cited in this profile</span></h2>
          <ol>
            {d.sources.map((source) => <SourceCitation source={source} />)}
          </ol>
        </section>
      </div>
    )}
    {tabs.length > 1 && <noscript><style>{`.c-panel[hidden]{display:block}.c-tabs{display:none}`}</style></noscript>}
    {updated && <p class="c-updated">Last updated: <time datetime={updated}>{updatedText}</time>{d && ` · ${d.sources.length} sources`}{scored.length > 0 && ` · history: ${history.filter((ch) => ch.confidence.key === "checked").length} of ${history.length} entries checked`}</p>}
  </div>
</article>
<script>
  import "../lib/unit-map-tip.js";
</script>
