---
// "Did you know?": curious cases from the scores, the country write-ups and the history,
// three at a time. Every case is in the HTML and its links work without JavaScript; the
// script only decides which three are showing. Country links open the drawer on the home page.
import { getFacts } from "../lib/facts.js";

const base = import.meta.env.BASE_URL;
const facts = getFacts();
const PER_PAGE = 3;
---
<section class="dyk" id="dyk" aria-label="Did you know?" data-per-page={PER_PAGE}>
  <div class="dyk-top">
    <h2>Did you know?</h2>
    <div class="dyk-nav">
      <span class="dyk-count" id="dykCount">1 / {Math.ceil(facts.length / PER_PAGE)}</span>
      <button type="button" id="dykPrev" aria-label="Previous three">←</button>
      <button type="button" id="dykNext" aria-label="Next three">→</button>
    </div>
  </div>
  <ol class="dyk-facts" aria-live="polite">
    {facts.map((f, i) => (
      <li class="dyk-fact" hidden={i >= PER_PAGE}>
        <p class="dyk-kicker">{f.kicker}</p>
        <p class="dyk-text">
          {f.parts.map((part) => typeof part === "string" ? part
            : part.country ? <a href={`${base}country/${part.country.slug}/`} data-country={part.country.id}>{part.label}</a>
            : <a href={`${base}history/${part.change.id}/`}>{part.label}</a>)}
        </p>
        {f.history && <a class="dyk-more" href={`${base}history/${f.history.id}/`}>The full story →</a>}
      </li>
    ))}
  </ol>
</section>

<script>
  const root = document.getElementById("dyk");
  const facts = [...root.querySelectorAll(".dyk-fact")];
  const count = document.getElementById("dykCount");
  const per = +root.dataset.perPage;
  // shuffle once per visit, so every page of three is a different mix
  for (let k = facts.length - 1; k > 0; k--) {
    const j = Math.floor(Math.random() * (k + 1));
    [facts[k], facts[j]] = [facts[j], facts[k]];
  }
  const list = root.querySelector(".dyk-facts");
  facts.forEach((el) => list.append(el));
  const pages = Math.ceil(facts.length / per);
  let page = 0;
  function show(n) {
    page = (n + pages) % pages;
    facts.forEach((el, k) => (el.hidden = Math.floor(k / per) !== page));
    count.textContent = `${page + 1} / ${pages}`;
  }
  document.getElementById("dykPrev").addEventListener("click", () => show(page - 1));
  document.getElementById("dykNext").addEventListener("click", () => show(page + 1));
  show(0);
</script>
