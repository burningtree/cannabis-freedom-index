    const timeScale = () => (timeKey() === "freedom" ? FREEDOM : timeKey() ? DATA_SCALES[dataKey()] : null);
    const yearsEl = $("#mapYears"), range = $("#mapYearRange");
    const pageView = "page" in $("#metric").dataset; // a map page of its own keeps the year in its address
    let playing = null;
    function showYears() {
