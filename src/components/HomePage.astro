          const rows = key === "pew_marijuana"
            ? `<div class="tip-meta">Using marijuana is…</div>` + row("Morally unacceptable", `${d.unacceptable}%`, dataColor(c)) + row("Morally acceptable", `${d.acceptable}%`) + row("Not a moral issue", `${d.not_moral}%`)
