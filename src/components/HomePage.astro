      const win = timeScale().window;
      yearsEl.title = timeKey() === "freedom"
        ? (dataYear == null ? `Today's scores. Drag back to ${years[0]}; the bars count the countries whose score changed each year.` : `Scores at the end of ${dataYear}, rebuilt from each country's history`)
        : dataYear == null ? `Each country's latest figure. Drag back to ${years[0]} to see earlier years.` : `${dataYear}, or a country's latest figure from the ${win} years before it`;
      drawBars(years, timeScale().coverage);
      if (pageView) {
        const url = new URL(location.href);
        if (dataYear == null) url.searchParams.delete("year"); else url.searchParams.set("year", dataYear);
        history.replaceState(null, "", url);
        // the links to the other Freedom views keep the year
        if (timeKey() === "freedom") for (const link of $("#metric").querySelectorAll("a[data-metric]")) {
