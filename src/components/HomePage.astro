        svg.setAttribute("viewBox", `0 0 ${n} 1`);
        svg.innerHTML = coverage.map((k, i) => `<rect x="${i + 0.15}" width="0.7" y="${1 - Math.max(k / top, k ? 0.06 : 0)}" height="${Math.max(k / top, k ? 0.06 : 0)}"></rect>`).join("");
      }
