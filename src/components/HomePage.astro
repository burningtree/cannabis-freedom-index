---
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";
import DidYouKnow from "../components/DidYouKnow.astro";
import Changes from "../components/Changes.astro";
import AboutHint from "../components/AboutHint.astro";
import Tools from "./Tools.astro";
import { survey } from "../lib/survey.js";
import AverageChart from "../components/AverageChart.astro";
import { useShareLabel, USE_COMPARISON_NOTE } from "../lib/use-labels.js";
import { useAges, SEGMENTS, DATA_SNAPSHOT, REC_LABEL, REC_ORDER, REC_HELP, MED_LABEL, MED_HELP, countries, regions, worldAvg, lastUpdated, formatDate, subunitsOf, places, trendOf, changeDate, TREND_YEARS, estimateNote } from "../lib/countries.js";
import { TIERS, tierColor, tierOf } from "../lib/tiers.js";
import { PLANTING_STATUS, PLANTING_TRADE, STATUS_SECTIONS } from "../lib/segment-ids.js";
import { PRICE_MARKETS, PRICE_MARKET_LABEL, flatLatestPricesFor, latestPricesFor } from "../lib/prices.js";
import { SHOW_PRICES } from "../lib/config.js";
import { homeSeo } from "../lib/seo.js";
import { viewByMetric } from "../lib/map-views.js";
import { cultureOf, cultureEntries } from "../lib/culture.js";
import { panelRows, mapRows, PANEL_FROM, MAP_FROM } from "../lib/exports.js";
import { MAPPED, datasetScales, datasetMapValues } from "../lib/datasets.js";

// Rankings by year: for each place, the years in which its index score changed and the score from
// then on ([[1900, 100], [1937, 11.2], …]), taken from the yearly panel. The table reads it when
// another year is chosen.
const yearScores = {};
for (const r of panelRows) {
  const list = (yearScores[r.id] ??= []);
  if (!list.length || list.at(-1)[1] !== r.score) list.push([r.year, r.score]);
}
// For the year control on the Freedom views: the years of the panel and, for each, how many places'
// scores changed in it by a recorded change (an assumed window spreading a first ban does not count).
const FREEDOM_YEARS = (() => {
  const counts = new Array(+DATA_SNAPSHOT - MAP_FROM + 1).fill(0);
  const before = {};
  for (const r of mapRows) {
    if (before[r.id] != null && before[r.id] !== r.score && r.basis === "recorded") counts[r.year - MAP_FROM]++;
    before[r.id] = r.score;
  }
  return { years: [MAP_FROM, +DATA_SNAPSHOT], coverage: counts };
})();
const rankYears = Array.from({ length: +DATA_SNAPSHOT - PANEL_FROM + 1 }, (_, i) => +DATA_SNAPSHOT - i);

// The home page, or, with `view`, just the map on a page of its own (see /map/).
const { view = null } = Astro.props;

const base = import.meta.env.BASE_URL;
// The hero's "cannabis" cycles through other names for the plant from the atlas, each with the
// language it comes from and a link to its entry. Only names for the plant itself, not for a
// joint, a strain or a deal.
const HERO_WORDS = ["cannabis", "ganja", "marijuana", "dagga", "kif", "maconha", "esrar", "mota", "anasha", "chamba", "wiet", "zatla", "pakalolo", "mbanje", "hashish", "matekoane", "zamal", "bangi", "diamba", "charas", "bhang", "grass", "pot", "dope"];
const heroWords = HERO_WORDS.map((slug) => {
  const e = cultureEntries.find((x) => x.url === `culture/language/${slug}/`);
  if (!e) throw new Error(`HomePage: no atlas entry "language/${slug}" for the hero`);
  return { word: e.title.toLowerCase(), note: e.origin ? e.origin.split(",")[0] : e.countries[0].name, href: `${base}${e.url}` };
});
// where each map option lives: its own page, or the home page for the overall index
const viewHref = (metric) => `${base}map/${viewByMetric[metric].slug ? viewByMetric[metric].slug + "/" : ""}`;
const current = view ? view.metric : "index";
// one option of the map: on the home page it recolours the map in place; on a map page it is a
// plain link to that view's page
const viewAttrs = (metric) => ({ href: viewHref(metric), "data-metric": metric, "aria-current": current === metric ? "true" : undefined });
const count = (fn) => countries.filter(fn).length;
// 48,000,000 → "48M", 770,000 → "770k"
const compact = (n) => (n >= 1e6 ? `${+(n / 1e6).toPrecision(2)}M` : n >= 1e3 ? `${+(n / 1e3).toPrecision(2)}k` : String(n));
const useDetail = (c) => {
  const from = c.use.estimate_from && places.find((x) => x.id === c.use.estimate_from.toUpperCase());
  if (from) return `This site's figure: no survey of ${c.name} alone, so ${from.name}'s rate, ${c.use.prevalence}% of people aged 15–64, is applied to an estimate of the people here of those ages.`;
  if (c.use.estimate) return `This site's figure: no national survey, so the median rate in ${c.region}, ${c.use.prevalence}% of people aged 15–64, is used.`;
  const ages = useAges(c.use), when = c.use.period ?? c.use.year;
  if (c.use.users == null) return `${c.use.prevalence}% of people aged ${ages} (${when}). No user count: the population for that age band is missing.`;
  if (c.use.users_approximate) return `About ${compact(c.use.users)}: ${c.use.prevalence}% aged ${ages} (${when}), on an approximate population of those ages.`;
  return `${useShareLabel(c.use)} used cannabis in the past year (${when} survey)`;
};
const useNote = (c) => `${useDetail(c)}. Source: ${c.use.source === "wdr2026" ? "UNODC World Drug Report 2026" : c.use.source === "earlier" ? "earlier UNODC figure" : "this site’s estimate"}. ${USE_COMPARISON_NOTE}`;
const stats = [
  [places.length, "territories scored"],
  [count((c) => c.raw >= 60), "reach the “Free” tier (60+)"],
  [count((c) => c.raw >= 40), "score 40+: legal to possess and grow, with limits"],
  [count((c) => c.raw < 15), "score under 15: prison is a real risk"],
  [count((c) => c.rec === "death"), "keep the death penalty for cannabis offences", "danger"],
];
const legend = [...TIERS].reverse().map((t, i, arr) => ({
  name: t.name, min: t.min, max: i < arr.length - 1 ? arr[i + 1].min - 1 : 100, i,
}));
const MED_ORDER = ["yes", "limited", "no"];
// What the browser needs for the map: scores only, no prose.
// `ratio` is the share of people who use cannabis divided by the index score: how far use runs
// ahead of freedom. A zero score has no defined quotient and is shown as unavailable.
// `culture` is how many atlas entries a country appears in, with the names of the first few
// (most important first), for the map's Culture view.
// `ds` holds the country's figures from the outside datasets (datasets.js), for the Society views.
import { useFreedomRatio } from "../lib/use-freedom-ratio.js";
const mapData = places.map((c) => {
  const { id, num, name, flag, raw, score, rank, s, use, planting, rec, med } = c;
  const atlas = cultureOf(c);
  // one value per section in STATUS_SECTIONS (clubs, driving, visitors, hemp, production, research)
  const statuses = Object.fromEntries(Object.keys(STATUS_SECTIONS).map((key) => [key, c[key]]));
  return { id, num, name, flag, raw, score, rank, s, planting, ...statuses, rec, med, fe: estimateNote(c), prices: SHOW_PRICES ? flatLatestPricesFor(id) : {},
    use: { ...use, ages: useAges(use), ratio: useFreedomRatio(use.prevalence, raw), culture: atlas.length },
    atlas: atlas.slice(0, 4).map((e) => e.title), ds: datasetMapValues(c) };
});
// States, provinces and territories of the federations, for the map's "show states" switch.
// Keyed like the shapes in src/data/subunits.geo.json: "us/ca".
const unitData = Object.fromEntries(countries.flatMap((c) => {
  const group = subunitsOf(c.id);
  return group ? group.units.map((u) => [`${c.slug}/${u.id}`, { id: u.id, country: c.id, name: u.name, raw: u.raw, score: u.score, s: u.s, rank: u.rank, of: group.units.length }]) : [];
}));
// Cannabis use on the map: one hue from light to dark, in five steps. Each step starts at `min`.
const USE_SCALES = {
  users: { label: "Cannabis users", steps: [[0, "Under 10k"], [1e4, "10k–100k"], [1e5, "100k–1M"], [1e6, "1M–10M"], [1e7, "10M or more"]],
    note: "Each survey rate applied to a population of the same age band. A ~ is this site's estimate for a place with no survey (the regional median, or for a disputed territory the rate of the country it is part of), or a count whose ages were estimated." },
  prevalence: { label: "Share who use cannabis", steps: [[0, "Under 1%"], [1, "1–3%"], [3, "3–7%"], [7, "7–15%"], [15, "15% or more"]] },
  ratio: {
    label: "Use relative to freedom",
    steps: [[0, "Under 0.15"], [0.15, "0.15–0.3"], [0.3, "0.3–0.5"], [0.5, "0.5–1"], [1, "1 or more"]],
    note: "Survey-age cannabis-use share divided by the unrounded index score. Undefined at score zero (hatched on the map). Ages and survey years vary. Rates are not age-standardised; do not compare countries directly.",
  },
  culture: {
    label: "Entries in the cultural atlas",
    steps: [[0, "None yet"], [1, "1"], [2, "2–3"], [4, "4–6"], [7, "7 or more"]],
    note: "Words, traditions and people in the cultural atlas that belong to each country. The atlas is growing: a pale country may simply not have been written about yet.",
  },
};
const PRICE_SCALE = {
  steps: [[0, "Under $5/g"], [5, "$5–10/g"], [10, "$10–15/g"], [15, "$15–20/g"], [20, "$20/g or more"]],
  note: "Latest sourced flower price, normalised to US dollars per gram. Street and medical markets are kept separate.",
};
// Seeds and clones on the map: one option per field, coloured by the status' tone.
const PLANTING_FIELDS = { seeds: "Seeds", seeds_trade: "Seed sales", clones: "Clones", clones_trade: "Clone sales" };
// Each status gets its own step of the tier colours, so that no two legend entries look alike.
// `regulated-sale-plus-gifts` shares step 4 with `regulated`: the scale has no step between open and regulated.
const PLANTING_COLOR = { legal: 5, conditional: 4, licensed: 4, grey: 3, illegal: 0, open: 5, "regulated-sale-plus-gifts": 4, regulated: 4, gift: 3, unclear: 2, banned: 0 };
const plantingScale = (statuses) => Object.fromEntries(Object.entries(statuses).map(([k, v]) => [k, { label: v.label, help: v.help, color: `var(--t${PLANTING_COLOR[k]})` }]));
const PLANTING_SCALES = { status: plantingScale(PLANTING_STATUS), trade: plantingScale(PLANTING_TRADE) };
// Sections with one status (clubs, driving, visitors, hemp, production, research) on the map: one option each.
// The two headline statuses of every profile, offered on the map the same way. `complete` marks
// sections every country has, so their legend needs no "not researched" entry.
const LAW_SECTIONS = {
  rec: { name: "Recreational status", complete: true, statuses: Object.fromEntries(REC_ORDER.map((k) => [k, { label: REC_LABEL[k], help: REC_HELP[k] }])),
    tiers: { legal: 5, partial: 4, decrim: 3, illegal: 1, death: 0 },
    sub: "Green means adults may legally have cannabis, yellow that small amounts bring at most a fine, red that it is a crime; the darkest red marks laws with a death penalty.",
    note: "The legal status of cannabis for adults. The index score measures much more than this one label." },
  med: { name: "Medical status", complete: true, statuses: Object.fromEntries(MED_ORDER.map((k) => [k, { label: MED_LABEL[k], help: MED_HELP[k] }])),
    tiers: { yes: 5, limited: 3, no: 0 },
    sub: "Green means an established patient route, yellow a restricted or unimplemented patient route, red that no patient route is verified.",
    note: "Documented patient treatment routes. Research/export licences alone do not qualify. Medical status is not part of the score." },
};
const MAP_SECTIONS = { ...LAW_SECTIONS, ...STATUS_SECTIONS };
const STATUS_SCALES = Object.fromEntries(Object.entries(MAP_SECTIONS).map(([key, section]) => [key, { name: section.name,
  scale: Object.fromEntries(Object.entries(section.statuses).map(([k, v]) => [k, { label: v.label, help: v.help, color: section.tiers[k] == null ? "url(#hatch)" : `var(--t${section.tiers[k]})` }])) }]));
// The map's views in three groups, the tabs of the view picker: the score (Freedom), what each
// profile explains beyond it (Context, as on /context/), and what others count (Datasets, in the
// groups of /datasets/). A group's views are [metric, label]; Datasets has rows with a label each.
const datasetViews = (group) => MAPPED.filter((ds) => ds.map.group === group).map((ds) => [`data:${ds.id}`, ds.map.label]);
const MAP_GROUPS = [
  { name: "Freedom", views: [["index", "Overall index"], ...SEGMENTS.map((s, i) => [String(i), s.name])] },
  { name: "Context", page: ["context/", "All topics"], views: [...Object.entries(LAW_SECTIONS).map(([key, section]) => [`status:${key}`, section.name]),
    ...Object.entries(PLANTING_FIELDS).map(([field, label]) => [`plant:${field}`, label]),
    ...Object.entries(STATUS_SECTIONS).map(([key, section]) => [`status:${key}`, section.name]), ["culture", "Atlas entries"]] },
  { name: "Datasets", page: ["datasets/", "All datasets"], rows: [
    { name: "Use", views: [["users", "Number of users"], ["prevalence", "Survey share"], ["ratio", "Share of users ÷ index"], ...datasetViews("Use")] },
    { name: "Law", views: datasetViews("Law") },
    { name: "Society", views: datasetViews("Society") },
    { name: "Plant and market", views: [...datasetViews("Plant and market"), ...(SHOW_PRICES ? PRICE_MARKETS.map((market) => [`price:${market}`, PRICE_MARKET_LABEL[market]]) : [])] },
  ].filter((r) => r.views.length) },
].map((g) => ({ ...g, views: g.views ?? g.rows.flatMap((r) => r.views) }));
const currentGroup = (MAP_GROUPS.find((g) => g.views.some(([m]) => m === current)) ?? MAP_GROUPS[0]).name;
const streetFlower = (c) => latestPricesFor(c.id).street;

// Rankings columns the reader can switch on and off. `on` marks the ones shown by default.
// Extra columns sort on a number kept on the row: higher means freer (or bigger), -1 means no data.
const order = (keys) => Object.fromEntries(keys.map((k, i) => [k, keys.length - i]));
const STATUS_RANK = { ...order(Object.keys(PLANTING_STATUS)), ...order(["open", "regulated-sale-plus-gifts", "conditional", "regulated", "gift", "unclear", "banned"]) };
const statusCol = (key, label, vocab, helpIndex) => ({
  key, label, group: "Context",
  sort: (c) => STATUS_RANK[c.planting?.[key]] ?? -1,
  chip: (c) => c.planting && { ...vocab[c.planting[key]], help: vocab[c.planting[key]].help[helpIndex] },
});
const BASE_COLUMNS = [
  { key: "region", label: "Region" }, { key: "users", label: "Users" }, { key: "share", label: "Survey share" },
  ...(SHOW_PRICES ? [{ key: "price", label: "Price per gram" }] : []),
  { key: "rec", label: "Recreational" }, { key: "med", label: "Medical" },
];
const EXTRA_COLUMNS = [
  ...SEGMENTS.map((s, i) => ({ key: `s${i}`, label: s.name, group: "Score segments", sort: (c) => c.s[i], score: (c) => c.s[i] })),
  { key: "pop", label: "Population", group: "People", sort: (c) => c.population, text: (c) => compact(c.population) },
  statusCol("seeds", "Seeds", PLANTING_STATUS, 0),
  statusCol("seeds_trade", "Seed sales", PLANTING_TRADE, 0),
  statusCol("clones", "Clones", PLANTING_STATUS, 1),
  statusCol("clones_trade", "Clone sales", PLANTING_TRADE, 1),
  ...Object.entries(STATUS_SECTIONS).map(([key, section]) => ({ key, label: section.name, group: "Context",
    sort: (c) => order(Object.keys(section.statuses))[c[key]] ?? -1, chip: (c) => c[key] && section.statuses[c[key]] })),
];
const columnGroups = [["Shown by default", BASE_COLUMNS], ...["Score segments", "People", "Context"].map((g) => [g, EXTRA_COLUMNS.filter((x) => x.group === g)])];
---
<Base
  title={view ? view.title : undefined}
  description={view ? view.lede : `Where is cannabis legal? Cannabis laws in ${countries.length} countries, each scored from 0 to 100 for possession, home growing, penalties and legal access, with a world map, rankings${SHOW_PRICES ? ", retail prices" : ""} and legal history.`}
  jsonld={view ? undefined : homeSeo(Astro.site, countries.length)}>
  <main id="top" class:list={{ "map-page": view }}>
    {view && (
      <section class="hero hero-sm">
        <p class="eyebrow"><a href={base}>← Cannabis Freedom Index</a> <span>World map</span></p>
        <h1>{view.title}</h1>
        <p class="lede">{view.lede}</p>
      </section>
    )}
    {/* The opening: the question, the answer in one number with its history, then what just changed. */}
    {!view && <section class="front">
      {/* While the yearly survey is open, the page starts with an invitation to it. A browser that
          has already answered is shown the way back to its answers instead (see the script). */}
      {survey.open && (
        <a class="front-call" id="frontCall" href={`${base}survey/take/`} data-edition={survey.edition}>
          <span class="fc-tag">New · {survey.edition}</span>
          <span class="fc-text"><strong>State of Cannabis is open.</strong> <span data-fc-more>Tell us how cannabis really is where you live: ten minutes, no account, answers encrypted.</span></span>
          <span class="fc-go"><span data-fc-go>Take the survey</span> <span aria-hidden="true">→</span></span>
        </a>
      )}
      <p class="eyebrow">Cannabis Freedom Index <span>{DATA_SNAPSHOT} edition</span></p>
      <h1>How free is <span class="visually-hidden">cannabis</span><a class="hero-word" id="heroWord" href={heroWords[0].href} aria-hidden="true" tabindex="-1" data-words={JSON.stringify(heroWords)}><span class="hw-w">{heroWords[0].word}</span><small class="hw-note">{heroWords[0].note}</small></a> <em>in every country?</em></h1>
      <div class="front-grid">
        <div class="front-intro">
          <p class="lede">Every country gets a score from 0 to 100 for how free you are to carry, grow, share and use cannabis. Below: the map, the rankings{SHOW_PRICES && ", sourced retail prices"} and how each country's law got where it is.</p>
          <p class="front-go">
            <a class="go solid" href="#map">See the map <span aria-hidden="true">↓</span></a>
            <a class="go" href="#rankings">Rankings <span aria-hidden="true">↓</span></a>
          </p>
          <dl class="front-stats">
            {stats.map(([n, label, tone]) => <div class={tone ?? ""}><dt>{n}</dt><dd>{label}</dd></div>)}
          </dl>
          <p class="front-how"><a href="#methodology">How the scores are made <span aria-hidden="true">→</span></a></p>
        </div>
        <AverageChart />
      </div>
      {/* The two ends of the ranking, side by side: the leader of each list is set largest. */}
      <div class="extremes">
        {[["Freest", countries.slice(0, 5), "asc", "Full rankings"], ["Least free", countries.slice(-5).reverse(), "desc", "Full rankings, least free first"]].map(([label, list, order, more]) => (
          <section aria-label={label}>
            <h2>{label}</h2>
            <ol>
              {list.map((c) => (
                <li>
                  <a href={`${base}country/${c.slug}/`} style={`--c:${tierColor(c.score)}`}>
                    <span class="ext-rank">{String(c.rank).padStart(2, "0")}</span>
                    <span class="ext-name"><span class="flag">{c.flag}</span>{c.name}</span>
                    <span class="ext-tier">{tierOf(c.raw).name}</span>
                    <b>{c.score}</b>
                  </a>
                </li>
              ))}
            </ol>
            {/* down to the rankings table, sorted the way this list reads (see the table script) */}
            <p class="ext-more"><a class="go" href="#rankings" data-rank-order={order}>{more} <span aria-hidden="true">↓</span></a></p>
          </section>
        ))}
      </div>
      <DidYouKnow />
      <Changes />
    </section>}

    <section class="section" id="map">
      {!view && (
        <div class="section-head">
          <div>
            <h2>World map</h2>
          </div>
          <div class="map-links">
            <a class="map-expand" href={`${base}map/poster/`}>Print or share →</a>
            <a class="map-expand" id="mapExpand" href={viewHref(current)} title="Open this map on a page of its own">Expand <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      )}
      {/* The views of the map in groups: a row of group tabs, then the chosen group's views in
          one row. The group of the current view is open; the others are a click away. */}
      <nav class="metric-bar" id="metric" aria-label="Colour the map by" data-initial={current} data-page={view ? "" : undefined}>
        <div class="metric-tabs" role="tablist" aria-label="Groups of map views">
          {MAP_GROUPS.map((g) => <button type="button" role="tab" data-group-tab={g.name} aria-selected={g.name === currentGroup ? "true" : "false"}>{g.name}</button>)}
        </div>
        {MAP_GROUPS.map((g) => (
          <div class:list={["metric-group", { "metric-rows": g.rows }]} data-group={g.name} role="tabpanel" aria-label={g.name} hidden={g.name !== currentGroup}>
            {g.rows
              ? g.rows.map((r) => <div class="metric-row"><span class="metric-row-h">{r.name}</span>{r.views.map(([metric, label]) => <a {...viewAttrs(metric)}>{label}</a>)}</div>)
              : g.views.map(([metric, label]) => <a {...viewAttrs(metric)}>{label}</a>)}
            {g.page && <a class="metric-page" href={`${base}${g.page[0]}`}>{g.page[1]}&nbsp;→</a>}
          </div>
        ))}
      </nav>
      <p class="sub map-sub" id="mapSub" data-score="Red means prison risk, green means free. Select a country for its full breakdown." data-use="The stronger the blue, the more people use cannabis. Select a country for its full breakdown." data-ratio="The stronger the blue, the further cannabis use runs ahead of the freedom to use it. Select a country for its full breakdown." data-culture="The stronger the blue, the more of the country's words, customs and people the cultural atlas covers. Select a country for its entries." data-price="Pale yellow means cheaper, violet means more expensive. Countries without a sourced price are hatched." data-planting="Green means legal or sold freely, red means illegal or banned. Hatched countries have not been researched yet. Not part of the score.">Red means prison risk, green means free. Select a country for its full breakdown.</p>
      <div class="card map-card">
        <div class="map-wrap" id="mapWrap">
          <svg id="mapSvg" viewBox="0 0 960 480" role="img" aria-label="World map coloured by Cannabis Freedom Index"></svg>
          <div class="map-zoom">
            <button class="icon-btn" id="zoomIn" aria-label="Zoom in">+</button>
            <button class="icon-btn" id="zoomOut" aria-label="Zoom out">−</button>
            <button class="icon-btn" id="zoomReset" aria-label="Reset zoom">⟲</button>
          </div>
          {/* the year of a dataset view with several years: play, a scrubber over bars that show how
              many countries have a figure each year, and the year shown (the latest by default) */}
          <div class="map-time" id="mapYears" hidden>
            <button type="button" class="mt-play" id="mapYearPlay" aria-label="Play through the years" title="Play through the years">▶</button>
            <div class="mt-scrub">
              <svg class="mt-bars" id="mapYearBars" preserveAspectRatio="none" aria-hidden="true"></svg>
              <input type="range" id="mapYearRange" step="1" aria-label="Year shown on the map" />
            </div>
            <output id="mapYearOut" for="mapYearRange"></output>
          </div>
          <div class="tooltip" id="tooltip" hidden></div>
          <p class="map-msg" id="mapMsg">Loading map…</p>
        </div>
        <div class="legend" data-legend="score">
          {legend.map((t) => <span><i class="sw" style={`background:var(--t${t.i})`}></i>{t.name} · {t.min}–{t.max}</span>)}
          <span><i class="sw sw-nodata"></i>No data</span>
          {view && <a class="legend-poster" href={`${base}map/poster/`}>Print or share this map →</a>}
        </div>
        {Object.entries(USE_SCALES).map(([key, scale]) => (
          <div class="legend" data-legend={key} hidden>
            {scale.steps.map(([, text], i) => <span><i class="sw" style={`background:var(--u${i})`}></i>{text}</span>)}
            <span><i class="sw sw-nodata"></i>No data</span>
            <span class="legend-note">{scale.note ?? "People who used cannabis in the past year, within each survey’s age band. Ages and years vary; rates are not age-standardised. Do not compare countries directly. A ~ is this site's estimate where a place has no survey of its own: the median of surveyed countries in the region, or for a disputed territory the rate of the country it is part of."}</span>
          </div>
        ))}
        {Object.entries(datasetScales).map(([key, scale]) => (
          <div class="legend" data-legend={`data:${key}`} hidden>
            {scale.steps.map(([, text], i) => <span><i class="sw" style={`background:var(--u${i})`}></i>{text}</span>)}
            <span><i class="sw sw-nodata"></i>Not covered</span>
            <span class="legend-note">{scale.note}</span>
          </div>
        ))}
        {SHOW_PRICES && <div class="legend" data-legend="price" hidden>
          {PRICE_SCALE.steps.map(([, text], i) => <span><i class="sw" style={`background:var(--p${i})`}></i>{text}</span>)}
          <span><i class="sw sw-nodata"></i>No data</span>
          <span class="legend-note">{PRICE_SCALE.note}</span>
        </div>}
        {Object.entries(MAP_SECTIONS).map(([key, section]) => (
          <div class="legend" data-legend={`status:${key}`} hidden>
            {Object.values(STATUS_SCALES[key].scale).map((v) => <span title={v.help || undefined}><i class="sw" style={`background:${v.color}`}></i>{v.label}</span>)}
            {!section.complete && <span><i class="sw sw-nodata"></i>Not researched yet</span>}
            <span class="legend-note">{section.complete ? section.note : `${section.note} Shown for context and not part of the score.`}</span>
          </div>
        ))}
        {Object.entries(PLANTING_SCALES).map(([key, scale]) => (
          <div class="legend" data-legend={`plant-${key}`} hidden>
            {Object.values(scale).map((v) => <span><i class="sw" style={`background:${v.color}`}></i>{v.label}</span>)}
            <span><i class="sw sw-nodata"></i>Not researched yet</span>
            <span class="legend-note">Seed and clone rules are shown for context and are not part of the score.</span>
          </div>
        ))}
        <div class="map-under" id="mapUnder">
          <label class="map-toggle" title="Show the United States, Canada and Australia state by state">
            <input type="checkbox" id="showUnits"> States and provinces
          </label>
        </div>
      </div>
    </section>

    <section class="section" id="rankings" hidden={!!view}>
      <div class="section-head">
        <div>
          <h2>Rankings</h2>
          <p class="sub"><span id="resultCount">{places.length} of {places.length} countries and territories</span></p>
        </div>
        <div class="filters">
          <select id="rankYear" aria-label="Year of the ranking" title="Show the ranking as it stood at the end of a year">
            {rankYears.map((y, i) => <option value={y}>{i === 0 ? `${y} (latest)` : y}</option>)}
          </select>
          <select id="region" aria-label="Filter by region">
            <option value="">All regions</option>
            {regions.map((r) => <option>{r}</option>)}
          </select>
          <select id="recFilter" aria-label="Filter by recreational status">
            <option value="">Any status</option>
            {REC_ORDER.map((k) => <option value={k}>{REC_LABEL[k]}</option>)}
          </select>
          <details class="col-menu" id="colMenu">
            <summary>Columns</summary>
            <div class="col-panel">
              {columnGroups.map(([group, cols], g) => (
                <fieldset>
                  <legend>{group}</legend>
                  {cols.map((col) => <label><input type="checkbox" data-col={col.key} checked={g === 0}> {col.label}</label>)}
                </fieldset>
              ))}
              <button type="button" class="btn" id="colReset">Reset</button>
            </div>
          </details>
        </div>
      </div>
      <p class="year-note" id="yearNote" hidden>Scores and ranks as they stood at the end of <b></b>, rebuilt from each country's history. Before a country's first recorded change the table shows its starting scores, and where the first ban has no known date the score is spread across the estimated period. Columns that describe today are hidden. <a href="#rankings" id="yearBack">Back to the latest year</a></p>
      <script type="application/json" id="rankYears" set:html={JSON.stringify(yearScores)}></script>
      <div class="card table-card">
        <table id="table">
          <thead>
            <tr>
              <th data-sort="rank" class="num" aria-sort="ascending">#</th>
              <th data-sort="name">Country</th>
              <th data-sort="region" data-col="region" class="hide-sm">Region</th>
              <th data-sort="users" data-col="users" class="num-col hide-md" title="People who used cannabis in the past year">Users</th>
              <th data-sort="share" data-col="share" class="num-col hide-md" title="Past-year use in each survey’s age band. Ages and years vary; not age-standardised.">Share</th>
              {SHOW_PRICES && <th data-sort="price" data-col="price" class="num-col hide-md" title="Latest sourced street-flower price, normalised to US dollars per gram">Price/g</th>}
              <th data-sort="rec" data-col="rec" class="hide-sm">Recreational</th>
              <th data-sort="med" data-col="med" class="hide-md">Medical</th>
              {EXTRA_COLUMNS.map((col) => <th data-sort={col.key} data-col={col.key} class:list={["col-off", { "num-col": !col.chip }]}>{col.label}</th>)}
              <th data-sort="score" class="score-col">Index</th>
            </tr>
          </thead>
          <tbody>
            {places.map((c) => (
              <tr data-id={c.id} data-rank={c.rank ?? c.worldRank - 0.5} data-territory={c.rank ? undefined : ""} data-name={c.name} data-region={c.region}
                  data-rec={REC_ORDER.indexOf(c.rec)} data-med={MED_ORDER.indexOf(c.med)} data-reckey={c.rec} data-users={c.use.users ?? -1} data-share={c.use.prevalence} data-price={SHOW_PRICES ? streetFlower(c)?.usd ?? -1 : undefined}
                  {...Object.fromEntries(EXTRA_COLUMNS.map((col) => [`data-${col.key}`, col.sort(c)]))}>
                <td class="num">{c.rank ?? "–"}</td>
                <td><a class="cname" href={`${base}country/${c.slug}/`}><span class="flag">{c.flag}</span>{c.name}{trendOf(c) && ((t) => <span class={`trend ${t.delta > 0 ? "up" : "down"}`} title={`${t.delta > 0 ? "+" : "−"}${Math.abs(t.delta)} ${Math.abs(t.delta) === 1 ? "point" : "points"} since ${t.since}. Latest change: ${t.last.title} (${changeDate(t.last)})`}>{t.delta > 0 ? "▲" : "▼"}{Math.abs(t.delta)}</span>)(trendOf(c))}</a>{c.territory && <span class="tag-disputed" title={`${c.territory.kind}. ${c.territory.note}`}>{c.territory.tag}</span>}{estimateNote(c) && <span class="tag-disputed" title={estimateNote(c)}>national estimate</span>}</td>
                <td class="hide-sm" data-col="region">{c.region}</td>
                <td class="num-col hide-md" data-col="users" title={useNote(c)}>{(c.use.estimate || c.use.users_approximate) && c.use.users != null && <span class="approx">~</span>}{c.use.users != null ? compact(c.use.users) : "—"}</td>
                <td class="num-col hide-md" data-col="share" title={useNote(c)}>{c.use.estimate && <span class="approx">~</span>}{c.use.prevalence.toFixed(1)}%</td>
                {SHOW_PRICES && <td class="num-col hide-md" data-col="price">{streetFlower(c) ? `$${streetFlower(c).usd.toFixed(2)}` : "—"}</td>}
                <td class="hide-sm" data-col="rec"><span class={`chip s-${c.rec}`} title={REC_HELP[c.rec]}>{REC_LABEL[c.rec]}</span></td>
                <td class="hide-md" data-col="med"><span class={`chip s-${c.med}`} title={MED_HELP[c.med]}>{MED_LABEL[c.med]}</span></td>
                {EXTRA_COLUMNS.map((col) => {
                  const chip = col.chip?.(c);
                  return (
                    <td data-col={col.key} class:list={["col-off", { "num-col": !col.chip }]}>
                      {col.score ? <span class="pill" style={`--c:${tierColor(col.score(c) * 10)}`}>{col.score(c)}</span>
                        : col.text ? col.text(c)
                        : chip ? <span class={`chip s-${chip.tone}`} title={chip.help}>{chip.label}</span>
                        : <span class="muted">—</span>}
                    </td>
                  );
                })}
                <td>
                  <div class="score-cell">
                    <span class="score-val">{c.score}</span>
                    <div class="bar"><i style={`width:${c.raw}%;background:${tierColor(c.raw)}`}></i></div>
                  </div>
                </td>
              </tr>
            ))}
            <tr id="emptyRow" hidden><td colspan="40" class="empty">No countries match these filters.</td></tr>
          </tbody>
        </table>
      </div>
      <p class="table-updated trend-note"><span class="trend up">▲</span> <span class="trend down">▼</span> after a name: points the score gained or lost since {+lastUpdated.slice(0, 4) - TREND_YEARS}. No mark means it did not move. Hover a mark to see the latest change.</p>
      <p class="table-updated">Last updated: <time datetime={lastUpdated}>{formatDate(lastUpdated)}</time></p>
    </section>

    {!view && (
      <script is:inline>
        // Arriving from a country's score breakdown at #method-<segment> (or #methodology): the map
        // and charts above change the page's height as they load, so scroll again once they have.
        if (/^#method/.test(location.hash)) window.addEventListener("load", function () {
          var t = document.getElementById(location.hash.slice(1));
          if (t) requestAnimationFrame(function () { t.scrollIntoView({ block: "start" }); });
        });
      </script>
    )}
    {!view && <section class="section" id="methodology">
      <div class="section-head">
        <div>
          <h2>Methodology</h2>
          <p class="sub">Six segments, each scored 0–10 against fixed levels, combined by weight into a 0–100 index. Half the score is simply whether you may possess and grow; a fifth is how hard users are punished. Rules for industry, products and medical programmes are not scored.</p>
        </div>
      </div>
      {/* The rule behind every score, said large; then how the 100 points are divided. */}
      <div class="tomato">
        <p class="tomato-label">🍅 The tomato standard</p>
        <p class="tomato-big">A 10 means <em>no cannabis-specific rule at all</em>: carry any amount, grow a whole field, give it away, buy it anywhere.</p>
        <p>Every cap, licence, registry and restricted zone costs points, because regulation is counted as unfreedom. Canada lets you carry 30 g and grow four plants — that is legal, but it is not unlimited, so it scores 6 and 4, not 9 and 8. This is why even the most liberal countries land around 50 and the “Free” tier is empty.</p>
      </div>
      <div class="weights" aria-hidden="true">
        {SEGMENTS.map((s) => <div style={`flex:${s.weight}`} title={`${s.name} — ${s.weight}%`}><b>{s.weight}</b><span>{s.name}</span></div>)}
      </div>
      <div class="seg-grid">
        {SEGMENTS.map((s) => (
          <div class="seg" id={`method-${s.id}`}>
            <div class="seg-top"><h3>{s.name}</h3><span class="seg-w">{s.weight}%</span></div>
            <p>{s.desc}</p>
            <ul class="anchors">{s.levels.map(([n, t]) => <li><b>{n}</b>{t}</li>)}</ul>
          </div>
        ))}
      </div>
      <div class="note-card">
        <h3>Scores over time: starting at 100</h3>
        <p>The history rebuilds every country's score year by year from its recorded changes. Before a country's first rule on cannabis, it scores <strong>100</strong>: with no rule at all, cannabis met the tomato standard. The first rule that limited it is recorded as the first change, even when it was not a law about cannabis as such: a poisons or pharmacy act that named it, licences to sell or grow it, a state monopoly, a ban on growing, or a colonial power's drug law extended to a territory. Where no first law is known at all, the first restriction is assumed to have come between the 1925 Geneva convention and the 1961 Single Convention and is spread across those years.</p>
      </div>
      <div class="note-card">
        <h3>Read this before relying on it</h3>
        <p>Scores are editorial estimates that blend the written law with how it is enforced in practice. Federal countries (United States, Australia, India) get a single national estimate that hides large internal differences. Scores between the listed levels mean a country sits between two descriptions. Every country has a written explanation and linked sources for each segment — select a country to read them. For many smaller countries the only sources available are secondary summaries, and the explanations say so where a figure could not be confirmed.</p>
        <p>Laws change quickly and this is <strong>not legal advice</strong>. Always check current local law before travelling with, buying or growing cannabis.</p>
      </div>
    </section>}

    {!view && survey.open && (
      <script is:inline>
        // Someone who has already answered the survey gets a link to their answers, not an invitation.
        (function () {
          var a = document.getElementById("frontCall");
          try {
            var items = (JSON.parse(localStorage.getItem("cfi-survey-" + a.dataset.edition + "-mine") || "null") || {}).items || [];
            if (!items.length) return;
            a.href = a.href.replace(/take\/$/, "me/");
            a.querySelector("strong").textContent = "Thank you for answering State of Cannabis.";
            a.querySelector("[data-fc-more]").textContent = "You can add places and prices, or change your answers, at any time.";
            a.querySelector("[data-fc-go]").textContent = "Your submissions";
            a.querySelector(".fc-tag").textContent = "Survey · " + a.dataset.edition;
          } catch (e) {}
        })();
      </script>
    )}

    {!view && <Tools />}

    {!view && <AboutHint />}

  </main>

  <dialog id="detail" class="drawer" aria-label="Country details">
    <div class="drawer-bar">
      <a class="icon-btn" id="dCompare" href={`${base}compare/`} aria-label="Compare with other countries" title="Compare with other countries">
        <Icon name="iconoir:stats-report" class="ico" aria-hidden="true" />
      </a>
      <button class="icon-btn" id="dClose" aria-label="Close"><Icon name="iconoir:xmark" class="ico" aria-hidden="true" /></button>
    </div>
    <div class="drawer-inner" id="detailBody"></div>
  </dialog>

  <script type="application/json" id="cfi-data" set:html={JSON.stringify(mapData)} />
  <script type="application/json" id="cfi-units" set:html={JSON.stringify(unitData)} />
  <script type="application/json" id="cfi-use-scales" set:html={JSON.stringify(USE_SCALES)} />
  <script type="application/json" id="cfi-datasets" set:html={JSON.stringify(datasetScales)} />
  <script type="application/json" id="cfi-freedom-years" set:html={JSON.stringify(FREEDOM_YEARS)} />
  <script type="application/json" id="cfi-price-scale" set:html={JSON.stringify(PRICE_SCALE)} />
  <script type="application/json" id="cfi-planting" set:html={JSON.stringify({ fields: PLANTING_FIELDS, scales: PLANTING_SCALES, sections: STATUS_SCALES, subs: Object.fromEntries(Object.entries(MAP_SECTIONS).map(([key, section]) => [key, section.complete ? section.sub : `${section.sub} ${key === "driving" ? "Hatched countries have an unverified trigger or have not been researched yet." : "Hatched countries have not been researched yet."} Not part of the score.`])) })} />
  <script type="application/json" id="cfi-segments" set:html={JSON.stringify(SEGMENTS.map((s) => ({ name: s.name, desc: s.desc, levels: s.levels })))} />

  <script>
    import { select, selectAll } from "d3-selection";
    import { geoNaturalEarth1, geoPath } from "d3-geo";
    import { zoom, zoomIdentity } from "d3-zoom";
    import "d3-transition";
    import { feature } from "topojson-client";
    import atlasUrl from "world-atlas/countries-50m.json?url";
    import unitsUrl from "../data/subunits.geo.json?url";
    import territoryShapes from "../data/territories.geo.json";
    import { tierOf, tierColor } from "../lib/tiers.js";
    import "../lib/unit-map-tip.js"; // the hover box of a federation's map, in the drawer

    const base = import.meta.env.BASE_URL;
    const $ = (sel, root = document) => root.querySelector(sel);
    const COUNTRIES = JSON.parse($("#cfi-data").textContent);
    const SEGMENT_INFO = JSON.parse($("#cfi-segments").textContent); // [{ name, desc, levels: [[score, text], …] }]
    const SEGMENT_NAMES = SEGMENT_INFO.map((s) => s.name);
    const byId = new Map(COUNTRIES.map((c) => [c.id, c]));
    const byNum = new Map(COUNTRIES.filter((c) => c.num != null).map((c) => [c.num, c]));
    // Map features that inherit another entry's score (atlas name or numeric id → country id).
    const ALIASES = { Kosovo: "XK", Somaliland: "XS", "N. Cyprus": "XN" };

    // ── Map ───────────────────────────────────────────────
    let metric = $("#metric").dataset.initial; // the view this page opens on
    let paths = null;
    let dots = null; // a dot on each place too small to see on the map (Malta, Singapore, the islands)
    const USE_SCALES = JSON.parse($("#cfi-use-scales").textContent);
    const PRICE_SCALE = JSON.parse($("#cfi-price-scale").textContent);
    const isUse = () => metric in USE_SCALES; // coloured by cannabis use, not by a score
    const isPrice = () => metric.startsWith("price:");
    const PLANTING = JSON.parse($("#cfi-planting").textContent);
    const isPlant = () => metric.startsWith("plant:"); // coloured by a seed or clone status
    const plantField = () => metric.split(":")[1];
    const plantScale = (field) => PLANTING.scales[field.endsWith("_trade") ? "trade" : "status"];
    const plantOf = (c, field = plantField()) => plantScale(field)[c.planting?.[field]];
    const plantColor = (c) => plantOf(c)?.color ?? "url(#hatch)";
    const isClubs = () => metric.startsWith("status:"); // coloured by a section's one status (STATUS_SECTIONS)
    const statusKey = () => metric.split(":")[1];
    const clubsOf = (c) => PLANTING.sections[statusKey()].scale[c[statusKey()]];
    const clubsColor = (c) => clubsOf(c)?.color ?? "url(#hatch)";
    // coloured by a figure from an outside dataset (Pew, Human Freedom Index): see datasets.js
    const DATA_SCALES = JSON.parse($("#cfi-datasets").textContent);
    const isData = () => metric.startsWith("data:");
    const dataKey = () => metric.split(":")[1];
    // The year slider: null shows each country's latest figure; a year shows the figure of that
    // year, or the latest of the `window` years before it. Each dataset's years load on first use.
    let dataYear = null;
    const yearSeries = {}, yearLoading = {};
    const loadYears = (key) => (yearLoading[key] ??= fetch(`${base}map-series/${key}.json`).then((r) => r.json()).then((j) => { yearSeries[key] = j; }).catch(() => { delete yearLoading[key]; }));
    const dataPoint = (c) => {
      const key = dataKey();
      if (!c) return null;
      if (dataYear == null) return c.ds[key] ?? null;
      const points = yearSeries[key]?.[c.id];
      if (!points) return null;
      const win = DATA_SCALES[key].window;
      for (let i = points.length - 1; i >= 0; i--) {
        const [year, v, t] = points[i];
        if (year <= dataYear) return year > dataYear - win ? { year, v, t } : null;
      }
      return null;
    };
    const dataColor = (c) => {
      const d = dataPoint(c);
      if (!d) return "url(#hatch)";
      const steps = DATA_SCALES[dataKey()].steps;
      let i = 0;
      while (i < steps.length - 1 && d.v >= steps[i + 1][0]) i++;
      return `var(--u${i})`;
    };
    const priceMarket = () => metric.split(":")[1];
    const priceOf = (c) => c.prices[priceMarket()];
    // The Freedom views (the index and its six segments) have a time series too: the scores at the
    // end of each year, rebuilt from the history. At a chosen year a place takes its score then.
    const FREEDOM = JSON.parse($("#cfi-freedom-years").textContent);
    const isFreedom = () => metric === "index" || /^\d$/.test(metric);
    const freedomPast = (c) => {
      if (dataYear == null || !isFreedom() || !c?.id) return null;
      const points = yearSeries.freedom?.[c.id];
      if (!points) return null;
      let at = points[0];
      for (const p of points) { if (p[0] > dataYear) break; at = p; }
      return at;
    };
    const metricValue = (c) => {
      const past = freedomPast(c);
      if (past) return metric === "index" ? past[1] : past[2 + +metric] * 10;
      return metric === "index" ? c.raw : c.s[+metric] * 10;
    };
    const titleCase = (s) => s[0].toUpperCase() + s.slice(1);
    const metricLabel = () => isPrice() ? `${titleCase(priceMarket())} flower` : metric === "index" ? "Index" : SEGMENT_NAMES[+metric];
    const metricText = (c) => isPrice() ? (priceOf(c) ? `$${priceOf(c).usd.toFixed(2)} / g` : "No data") : metric === "index" ? `${c.score} / 100` : `${c.s[+metric]} / 10`;
    const compact = (n) => (n >= 1e6 ? `${+(n / 1e6).toPrecision(2)}M` : n >= 1e3 ? `${+(n / 1e3).toPrecision(2)}k` : String(n));
    // the darkest step whose threshold the country reaches
    const useColor = (c) => {
      const steps = USE_SCALES[metric].steps;
      const v = c.use[metric];
      if (v == null || Number.isNaN(v)) return "url(#hatch)";
      let i = 0;
      while (i < steps.length - 1 && v >= steps[i + 1][0]) i++;
      return `var(--u${i})`;
    };
    const priceColor = (c) => {
      const v = priceOf(c)?.usd;
      if (v == null) return "url(#hatch)";
      let i = 0;
      while (i < PRICE_SCALE.steps.length - 1 && v >= PRICE_SCALE.steps[i + 1][0]) i++;
      return `var(--p${i})`;
    };

    // States and provinces: drawn on request, in place of their federation's single shape.
    const UNITS = JSON.parse($("#cfi-units").textContent);
    const FEDERATIONS = new Set(Object.values(UNITS).map((u) => u.country));
    let unitPaths = null;   // the state shapes, once loaded
    let showUnits = false;
    let drawUnits = null;   // set by initMap: loads and draws the shapes

    // states and provinces carry scores only, so they are offered on the Freedom options alone
    const isScore = () => !isData() && !isClubs() && !isPlant() && !isPrice() && !isUse();
    // states and provinces have no history of their own, so they show only the latest year
    const unitsOn = () => showUnits && isScore() && dataYear == null;

    // a country's colour in the current view; its dot (a place too small to see) takes the same
    const fillOf = (d) => (d.id === "010" ? "var(--land)" : !d.c ? "url(#hatch)" : isData() ? dataColor(d.c) : isClubs() ? clubsColor(d.c) : isPlant() ? plantColor(d.c) : isPrice() ? priceColor(d.c) : isUse() ? useColor(d.c) : tierColor(metricValue(d.c)));
    function paintMap() {
      if (paths) {
        paths.attr("fill", fillOf);
        if (dots) dots.attr("fill", fillOf);
        // a federation's own shape steps aside while its states are shown
        paths.style("display", (d) => (unitsOn() && unitPaths && d.c && FEDERATIONS.has(d.c.id) ? "none" : null));
      }
      if (unitPaths) {
        unitPaths.style("display", unitsOn() ? null : "none");
        // cannabis use is only known nationally, so a state takes its country's colour for those
        unitPaths.attr("fill", (d) => (isData() ? dataColor(byId.get(d.u.country)) : isClubs() ? clubsColor(byId.get(d.u.country)) : isPlant() ? plantColor(byId.get(d.u.country)) : isPrice() ? priceColor(byId.get(d.u.country)) : isUse() ? useColor(byId.get(d.u.country)) : tierColor(metricValue(d.u))));
      }
      $("#mapUnder").hidden = !isScore() || dataYear != null;
      showYears();
      const shown = isData() || isClubs() ? metric : isPlant() ? (plantField().endsWith("_trade") ? "plant-trade" : "plant-status") : isPrice() ? "price" : isUse() ? metric : "score";
      document.querySelectorAll("[data-legend]").forEach((el) => { el.hidden = el.dataset.legend !== shown; });
      const sub = $("#mapSub");
      sub.textContent = isData() ? DATA_SCALES[dataKey()].sub : isClubs() ? PLANTING.subs[statusKey()] : isPlant() ? sub.dataset.planting : isPrice() ? sub.dataset.price : metric === "ratio" ? sub.dataset.ratio : metric === "culture" ? sub.dataset.culture : isUse() ? sub.dataset.use : sub.dataset.score;
    }
    // On the home page an option recolours the map in place, and "Expand" then points at that
