---
import { archivedUrl } from "../lib/archive.js";

// one source in a list; `id` and `n` when it is a numbered reference that the text links to
const { source, archive = false, id, n } = Astro.props;
const [label, url, bibliography] = source;
---
<li class:list={{ "source-print": !url }} id={id} value={n}>
  {url
    ? <a href={url} target="_blank" rel="noopener noreferrer">{label}</a>
    : <cite>{label}</cite>}
  {bibliography && <small class="src-meta">{bibliography}</small>}
  {archive && url && archivedUrl(url) && <a class="src-archived" href={archivedUrl(url)} target="_blank" rel="noopener noreferrer" title="A copy saved in the Internet Archive">archived</a>}
</li>
