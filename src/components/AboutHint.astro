---
// The last section of the home page: what the project is for, in two sentences, and the way
// to the About page, where its numbers, aims and commitments are set out.
const base = import.meta.env.BASE_URL;
---
<section class="section about-hint" id="about">
  <div class="section-head">
    <div>
      <h2>About the project</h2>
    </div>
  </div>
  <div class="about-hint-body">
    <p class="about-hint-lede">The aim is larger than a ranking: to become the most complete and most trustworthy source of knowledge on cannabis law and cannabis freedom anywhere.</p>
    <div>
      <p>The law as written, the law as enforced, its history and the lives lived under it. Every claim sourced, every file open, every mistake corrected in public.</p>
      <p class="front-go"><a class="go solid" href={`${base}about/`}>What this is, and what it commits to <span aria-hidden="true">→</span></a></p>
    </div>
  </div>
</section>
