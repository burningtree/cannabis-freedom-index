---
// Overall index score before → after, with the difference in points.
import { tierColor } from "../lib/tiers.js";

const { score } = Astro.props;
const delta = score.after - score.before;
---
<p class="change-score" aria-label={`Score changed from ${score.before} to ${score.after}`}>
  <span class="pill" style={`--c:${tierColor(score.before)}`}>{score.before}</span>
  <span class="arrow" aria-hidden="true">→</span>
  <span class="pill" style={`--c:${tierColor(score.after)}`}>{score.after}</span>
  <span class={`delta ${delta >= 0 ? "up" : "down"}`}>{delta >= 0 ? "+" : "−"}{Math.abs(delta)} {Math.abs(delta) === 1 ? "point" : "points"}</span>
</p>
