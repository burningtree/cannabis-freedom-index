---
// The world over time in one chart: stacked bands, the share of countries (or of people) in each
// score tier year by year, with the world average score drawn over them as a line. The bands and
// the score share one 0–100 scale. Four views: the whole history or the last fifteen years, each
// per country or weighted by population; two switches pick which one is shown. All four are in
// the page, as they are small.
// The plot is a stretched SVG; labels are HTML so they stay readable at any width.
import { averageHistory, averageHistoryByPopulation, bandHistory, bandHistoryByPopulation, countries, dateTime, lastUpdated } from "../lib/countries.js";
import { TIERS, tierOf, tierColor } from "../lib/tiers.js";

// `note` adds the caveat under the chart.
const { note = false } = Astro.props;
const fmt = (v) => v.toFixed(1);
const time = dateTime;
const endYear = +lastUpdated.slice(0, 4);

const RANGES = [
  { id: "all", label: "All", startYear: 1860 }, // the handful of older bans are already counted in the starting value
  { id: "15y", label: "Last 15 years", startYear: endYear - 15 },
];
const WEIGHTS = [
  { id: "country", label: "By country", title: "Every country counts the same", history: averageHistory, bands: bandHistory },
  { id: "people", label: "By population", title: "Each country counts in proportion to its population", history: averageHistoryByPopulation, bands: bandHistoryByPopulation },
];
const TIER_ORDER = [...TIERS].reverse(); // severe … free, as in bandHistory
// a date as a fractional year, so the line's steps fall where the bands' years do
const yearOf = (iso) => { const t = time(iso), y = new Date(t).getUTCFullYear(); return y + (t - Date.UTC(y, 0, 1)) / (Date.UTC(y + 1, 0, 1) - Date.UTC(y, 0, 1)); };

function view(range, weighting) {
  const rows = weighting.bands.filter(([yr]) => yr >= range.startYear);
  const [y0, y1] = [rows[0][0], rows.at(-1)[0]];
  const x = (yr) => Math.min(100, ((yr - y0) / (y1 - y0)) * 100);

  // the bands, freest at the bottom and strictest on top, one point per year
  const layers = [];
  let below = rows.map(() => 0);
  for (let k = TIER_ORDER.length - 1; k >= 0; k--) {
    const top = below.map((b, i) => b + rows[i][1][k]);
    const pts = top.map((v, i) => `${x(rows[i][0]).toFixed(2)},${(100 - v * 100).toFixed(2)}`)
      .concat(below.map((v, i) => `${x(rows[i][0]).toFixed(2)},${(100 - v * 100).toFixed(2)}`).reverse());
    layers.push({ color: tierColor(TIER_ORDER[k].min), points: pts.join(" ") });
    below = top;
  }

  // the world average, a step at each recorded change
  const steps = weighting.history.filter((p) => yearOf(p.date) >= y0);
  const start = steps[0].before, now = weighting.history.at(-1).after;
  const line = `M0,${(100 - start).toFixed(2)}` + steps.map((p) => `H${x(yearOf(p.date)).toFixed(2)}V${(100 - p.after).toFixed(2)}`).join("") + "H100";
  // the average at the end of each year, for the readout
  const avgAt = rows.map(([yr]) => { let v = start; for (const p of steps) { if (yearOf(p.date) >= yr + 1) break; v = p.after; } return Math.round(v * 10); });

  const span = y1 - y0;
  const step = span > 120 ? 20 : span > 50 ? 10 : span > 20 ? 5 : span > 14 ? 2 : 1;
  const years = rows.map(([yr]) => yr).filter((yr) => yr % step === 0).map((yr) => ({ yr, x: x(yr) }));

  // the two red tiers: prohibition and severe prohibition
  const banned = (r) => r[1][0] + r[1][1];
  const bannedNow = banned(rows.at(-1)), bannedThen = banned(rows[0]);
  const sub = { big: `${Math.round(bannedNow * 100)}%`, label: weighting.id === "country" ? "Countries under prohibition or worse" : "People under prohibition or worse",
    text: weighting.id === "country" ? `${Math.round(bannedNow * countries.length)} of ${countries.length}` : "of the world's people", delta: Math.round((bannedNow - bannedThen) * 100) };
  // for the readout: each year's shares in tenths of a per cent, and the average in tenths
  const data = JSON.stringify({ y0, unit: weighting.id === "country" ? countries.length : 0, avg: avgAt, rows: rows.map(([, sh]) => sh.map((v) => Math.round(v * 1000))) });
  return { range: range.id, weight: weighting.id, startYear: range.startYear, now, delta: now - start, layers, line, years, sub, data };
}

const views = WEIGHTS.flatMap((w) => RANGES.map((r) => view(r, w)));
const shown = (v) => v.range === RANGES[0].id && v.weight === WEIGHTS[0].id; // the view visible before any click
const signed = (n, unit = "") => `${n > 0 ? "+" : n < 0 ? "−" : "±"}${Math.abs(n)}${unit}`;
---
<section class="card avg" id="avgChart" aria-labelledby="avgTitle">
  {/* two figures: the world average score, and the share under prohibition or worse */}
  <div class="avg-head">
    <h2 id="avgTitle" class="visually-hidden">Cannabis freedom in the world over time</h2>
    <div class="avg-stat">
      <p class="avg-label">World average score</p>
      <p class="avg-now">
        {views.map((v) => (
          <span class="avg-figure" data-range={v.range} data-weight={v.weight} hidden={!shown(v)}>
            <b>{fmt(v.now)}</b>
            <span class="avg-tier" style={`--c:${tierColor(v.now)}`}>{tierOf(v.now).name}</span>
            <span class={`delta ${v.delta >= 0 ? "up" : "down"}`}>{v.delta >= 0 ? "+" : "−"}{fmt(Math.abs(v.delta))} since {v.startYear}</span>
          </span>
        ))}
      </p>
    </div>
    <div class="avg-stat">
      {views.map((v) => <p class="avg-label avg-figure" data-range={v.range} data-weight={v.weight} hidden={!shown(v)}>{v.sub.label}</p>)}
      <p class="avg-now">
        {views.map((v) => (
          <span class="avg-figure" data-range={v.range} data-weight={v.weight} hidden={!shown(v)}>
            <b>{v.sub.big}</b>
            <span class="avg-tier avg-tier-plain">{v.sub.text}</span>
            <span class={`delta ${v.sub.delta <= 0 ? "up" : "down"}`}>{signed(v.sub.delta, " points")} since {v.startYear}</span>
          </span>
        ))}
      </p>
    </div>
  </div>
  <div class="avg-controls">
    <div class="avg-switch" role="group" aria-label="Period shown" data-switch="range">
      {RANGES.map((r, i) => <button type="button" data-value={r.id} aria-pressed={i === 0 ? "true" : "false"}>{r.label}</button>)}
    </div>
    <div class="avg-switch" role="group" aria-label="How countries are weighted" data-switch="weight">
      {WEIGHTS.map((w, i) => <button type="button" data-value={w.id} title={w.title} aria-pressed={i === 0 ? "true" : "false"}>{w.label}</button>)}
    </div>
  </div>

  <div class="avg-views">
  {views.map((v) => (
    <div class="avg-chart avg-bands" data-range={v.range} data-weight={v.weight} hidden={!shown(v)}>
      <div class="avg-y" aria-hidden="true">
        {[0, 20, 40, 60, 80, 100].map((t) => <span style={`top:${100 - t}%`}>{t}</span>)}
      </div>
      <div class="avg-plot" data-bands={v.data}>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" role="img" aria-label={`World average score and the share of ${v.weight === "country" ? "countries" : "the world's people"} in each score band, ${v.startYear} to ${endYear}`}>
          {v.layers.map((l) => <polygon points={l.points} style={`fill:${l.color}`} />)}
          <path class="avg-over" d={v.line} />
        </svg>
        <span class="bands-seek" hidden></span>
        <div class="bands-tip" hidden></div>
      </div>
      <div class="avg-x" aria-hidden="true">
        {v.years.map(({ yr, x }) => <span style={`left:${x}%`}>{yr}</span>)}
      </div>
    </div>
  ))}
  </div>
  <p class="avg-legend" aria-hidden="true">
    <span><i class="avg-over-key"></i>World average score</span>
    {TIERS.map((t) => <span><i style={`background:${tierColor(t.min)}`}></i>{t.name}</span>)}
  </p>
  {note && <p class="avg-note">Rebuilt from the recorded changes, so it is only as complete as that list. The colours show the share of countries, or of people, in each band; the line is the world average score on the same 0–100 scale. The population view uses each year's population.</p>}
</section>

<script>
  const chart = document.querySelector("#avgChart");

  // Two switches, period and weighting: show the chart and figures that match both.
  const state = { range: "all", weight: "country" };
  const show = () => chart.querySelectorAll(".avg-chart, .avg-figure").forEach((el) => {
    el.hidden = el.dataset.range !== state.range || el.dataset.weight !== state.weight;
  });
  chart?.querySelectorAll(".avg-switch").forEach((group) => {
    group.querySelectorAll("button").forEach((btn) => {
      btn.addEventListener("click", () => {
        state[group.dataset.switch] = btn.dataset.value;
        group.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        show();
      });
    });
  });

  // The year under the pointer: the world average, and the share in each band.
  const NAMES = ["Severe prohibition", "Prohibition", "Restrictive", "Tolerant", "Legal with limits", "Free"];
  chart?.querySelectorAll(".avg-plot[data-bands]").forEach((plot) => {
    const d = JSON.parse(plot.dataset.bands), tip = plot.querySelector(".bands-tip"), seek = plot.querySelector(".bands-seek");
    const at = (e) => {
      const box = plot.getBoundingClientRect();
      const f = Math.min(1, Math.max(0, (e.clientX - box.left) / box.width));
      const i = Math.round(f * (d.rows.length - 1));
      const shares = d.rows[i], year = d.y0 + i;
      const amount = (v) => (d.unit ? `${Math.round((v / 1000) * d.unit)}` : `${(v / 10).toFixed(v < 100 ? 1 : 0)}%`);
      tip.innerHTML = `<b>${year}</b><span class="tip-avg">World average<em>${(d.avg[i] / 10).toFixed(1)}</em></span>`
        + NAMES.map((n, k) => [n, shares[k], k]).reverse().filter(([, v]) => v > 0)
          .map(([n, v, k]) => `<span><i style="background:var(--t${k})"></i>${n}<em>${amount(v)}</em></span>`).join("");
      const x = (i / (d.rows.length - 1)) * 100;
      seek.style.left = `${x}%`;
      seek.hidden = tip.hidden = false;
      // beside the line, on whichever side has room, and never past the chart's edges
      const px = (x / 100) * box.width, w = tip.offsetWidth;
      const left = px + 12 + w <= box.width ? px + 12 : px - 12 - w >= 0 ? px - 12 - w : Math.max(0, Math.min(box.width - w, px - w / 2));
      tip.style.left = `${left}px`;
    };
    plot.addEventListener("pointermove", at);
    plot.addEventListener("pointerleave", () => { seek.hidden = tip.hidden = true; });
  });
</script>
