---
// World average score over time: a step line that moves at each recorded change.
// Four views are rendered: the whole history or the last fifteen years, each averaged per country
// or weighted by population. Two switches pick which one is shown.
// The plot is a stretched SVG; labels and markers are HTML so they stay readable at any width.
import { averageHistory, averageHistoryByPopulation, formatDate, dateTime, lastUpdated } from "../lib/countries.js";

// `note` adds the caveat under the chart.
const { note = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const fmt = (v) => v.toFixed(1);
const time = dateTime;

const endYear = +lastUpdated.slice(0, 4);
const t1 = time(lastUpdated);

// one chart for each combination of period and weighting
const RANGES = [
  { id: "all", label: "All", startYear: 1900 }, // a few bans are older; they are already counted in the starting value
  { id: "15y", label: "Last 15 years", startYear: endYear - 15 },
];
const WEIGHTS = [
  { id: "country", label: "By country", title: "Every country counts the same", history: averageHistory },
  { id: "people", label: "By population", title: "Each country counts in proportion to its population today", history: averageHistoryByPopulation },
];

function view(range, weighting) {
  const { startYear } = range;
  const history = weighting.history;
  const now = history.at(-1).after;
  const t0 = Date.UTC(startYear, 0, 1);
  const x = (t) => ((t - t0) / (t1 - t0)) * 100;
  const inRange = history.filter((p) => time(p.date) >= t0);
  const start = inRange[0].before; // the average when the view begins

  // y axis: round steps that enclose the data (the range is small, so it does not start at zero)
  const values = inRange.flatMap((p) => [p.before, p.after]);
  const spread = Math.max(...values) - Math.min(...values);
  const tick = spread > 50 ? 20 : spread > 25 ? 10 : spread > 12 ? 5 : spread > 6 ? 2 : spread > 3 ? 1 : 0.5;
  const yMin = Math.floor(Math.min(...values) / tick) * tick;
  const yMax = Math.ceil(Math.max(...values) / tick) * tick;
  const y = (v) => (1 - (v - yMin) / (yMax - yMin)) * 100;
  const ticks = Array.from({ length: Math.round((yMax - yMin) / tick) + 1 }, (_, i) => yMin + i * tick);

  // at most about a dozen year labels, on round steps
  const span = endYear - startYear;
  const step = span > 50 ? 10 : span > 20 ? 5 : span > 14 ? 2 : 1;
  const years = Array.from({ length: span + 1 }, (_, i) => startYear + i)
    .filter((yr) => yr % step === 0)
    .map((yr) => ({ yr, x: x(Date.UTC(yr, 0, 1)) }));

  const steps = inRange.map((p) => ({ ...p, x: x(time(p.date)), y: y(p.after) }));
  const line = `M0,${y(start)}` + steps.map((p) => `H${p.x}V${p.y}`).join("") + "H100";
  const points = steps.filter((p) => p.change); // estimated changes move the line but get no dot
  // for the seeker (the script is in Base.astro): the axis and the steps of the line; the entries
  // it lists are read from the dots
  const seek = JSON.stringify({ t0, t1, start, unit: "average", dp: 1, dots: true, y: [yMin, yMax], steps: steps.map((p) => [p.x, p.x, p.before, p.after]) });
  return { seek, range: range.id, weight: weighting.id, startYear, now, whole: tick >= 1, delta: now - start, ticks: ticks.map((t) => ({ t, y: y(t) })), years, points, line };
}

const views = WEIGHTS.flatMap((w) => RANGES.map((r) => view(r, w)));
const shown = (v) => v.range === RANGES[0].id && v.weight === WEIGHTS[0].id; // the view visible before any click
---
<section class="card avg" id="avgChart" aria-labelledby="avgTitle">
  <div class="avg-head">
    <h2 id="avgTitle">World average score</h2>
    <p class="avg-now">
      {views.map((v) => (
        <span class="avg-figure" data-range={v.range} data-weight={v.weight} hidden={!shown(v)}>
          <b>{fmt(v.now)}</b>
          <span class={`delta ${v.delta >= 0 ? "up" : "down"}`}>{v.delta >= 0 ? "+" : "−"}{fmt(Math.abs(v.delta))} since {v.startYear}</span>
        </span>
      ))}
    </p>
  </div>
  <div class="avg-controls">
    <div class="avg-switch" role="group" aria-label="Period shown" data-switch="range">
      {RANGES.map((r, i) => <button type="button" data-value={r.id} aria-pressed={i === 0 ? "true" : "false"}>{r.label}</button>)}
    </div>
    <div class="avg-switch" role="group" aria-label="How countries are weighted" data-switch="weight">
      {WEIGHTS.map((w, i) => <button type="button" data-value={w.id} title={w.title} aria-pressed={i === 0 ? "true" : "false"}>{w.label}</button>)}
    </div>
  </div>

  {views.map((v) => (
    <div class="avg-chart" data-range={v.range} data-weight={v.weight} hidden={!shown(v)}>
      <div class="avg-y" aria-hidden="true">
        {v.ticks.map(({ t, y }) => <span style={`top:${y}%`}>{v.whole ? t : fmt(t)}</span>)}
      </div>
      <div class="avg-plot" data-seek={v.seek}>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          {v.ticks.map(({ y }) => <line class="grid" x1="0" x2="100" y1={y} y2={y} />)}
          <path class="line" d={v.line} />
        </svg>
        {v.points.map((p) => (
          <a class="avg-dot" href={`${base}history/${p.change.id}/`} style={`left:${p.x}%;top:${p.y}%`}
            data-date={formatDate(p.date)} data-title={`${p.change.country.flag} ${p.change.title}`}
            data-avg={`World average ${fmt(p.before)} → ${fmt(p.after)}`}
            aria-label={`${formatDate(p.date)}: ${p.change.title}. World average ${fmt(p.before)} to ${fmt(p.after)}.`}></a>
        ))}
        <span class="c-seek" hidden></span>
        <div class="c-seek-tip" hidden></div>
      </div>
      <div class="avg-x" aria-hidden="true">
        {v.years.map(({ yr, x }) => <span style={`left:${x}%`}>{yr}</span>)}
      </div>
    </div>
  ))}
  {note && <p class="avg-note">Rebuilt from the recorded changes, so it is only as complete as that list. The population-weighted line uses today's populations for every year. The scale does not start at zero.</p>}
</section>

<script>
  const chart = document.querySelector("#avgChart");

  // Two switches, period and weighting: show the one chart and figure that match both.
  const state = { range: "all", weight: "country" };
  chart?.querySelectorAll(".avg-switch").forEach((group) => {
    group.querySelectorAll("button").forEach((btn) => {
      btn.addEventListener("click", () => {
        state[group.dataset.switch] = btn.dataset.value;
        group.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        chart.querySelectorAll(".avg-chart, .avg-figure").forEach((el) => {
          el.hidden = el.dataset.range !== state.range || el.dataset.weight !== state.weight;
        });
      });
    });
  });
</script>
