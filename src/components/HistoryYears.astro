---
// Years of the History ledger, newest first: the year set large, its entries ruled beside it.
// Used by the decade and kind pages, and by the year fragments that the continuous list at
// /history/ loads as the reader scrolls (src/pages/fragments/history/[year].astro).
import ScoreChange from "./ScoreChange.astro";
import { Icon } from "astro-icon/components";
import { articles, formatDate } from "../lib/countries.js";

const { years } = Astro.props; // [{ year, items }]
const base = import.meta.env.BASE_URL;
const scoredIn = (items) => items.filter((ch) => ch.score).length;
---
{years.map(({ year, items }) => (
  <section class="hist-year" id={`y${year}`} data-year={year} aria-labelledby={`yh${year}`} data-scored={scoredIn(items) ? "" : undefined}>
    <h2 id={`yh${year}`}><a href={`${base}history/?from=${year}`} title={`Link to ${year}`}>{year}</a><small class="n-all">{items.length === 1 ? "1 entry" : `${items.length} entries`}</small><small class="n-scored">{scoredIn(items) === 1 ? "1 score change" : `${scoredIn(items)} score changes`}</small></h2>
    <ol>
      {items.map((ch) => (
        <li data-scored={ch.score ? "" : undefined}>
          <a href={`${base}history/${ch.id}/`}>
            <time datetime={ch.date}>{ch.date.length === 4 ? "" : formatDate(ch.date).replace(` ${year}`, "")}</time>
            <div class="he-body">
              <p class="he-place">{ch.place.flag} {ch.place.name} <span class="he-kind"><Icon name={ch.kind.icon} class="ico" aria-hidden="true" /> {ch.kind.label}</span> <span class={`conf-mark c-${ch.confidence.key}`} title={`${ch.confidence.label}: ${ch.confidence.help}`}>{ch.confidence.mark}</span> {articles.has(ch.id) && <span class="he-article">Article</span>}</p>
              <h3>{ch.title}</h3>
              <p class="he-text">{ch.description}</p>
            </div>
            {ch.score ? <ScoreChange score={ch.score} /> : <span></span>}
          </a>
        </li>
      ))}
    </ol>
  </section>
))}
