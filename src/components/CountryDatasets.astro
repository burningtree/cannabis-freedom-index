---
// What the most important outside datasets say about a country (src/lib/datasets.js, `rail` in
// datasets.yaml), beside the index: how its people judge using marijuana (Pew) and how free it is
// by the Human Freedom Index. Every dataset is in the profile's Datasets section. Each is placed
// among the countries the dataset covers. Two tiles in the profile's "At a glance"; nothing here is scored.
import { places } from "../lib/countries.js";
import { DATASETS } from "../lib/datasets.js";
import { viewByMetric } from "../lib/map-views.js";
import SourceTip from "./SourceTip.astro";
import { theName } from "../lib/seo.js";

const { c } = Astro.props;
const base = import.meta.env.BASE_URL;
const mapHref = (key) => `${base}map/${viewByMetric[`data:${key}`].slug}/`;
const covered = (key) => places.filter((x) => x.datasets[key]);
// 1 for the highest value among `list`; ties share a place
const placeOf = (list, value, own) => 1 + list.filter((x) => value(x) > own).length;
const ord = (n) => n + (n % 100 >= 11 && n % 100 <= 13 ? "th" : ["th", "st", "nd", "rd"][n % 10] ?? "th");
// "the most", "the 2nd most"
const rankWord = (n, word) => (n === 1 ? word : `${ord(n)} ${word}`);
const median = (xs) => { const s = [...xs].sort((a, b) => a - b), m = s.length >> 1; return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2; };

const pew = c.datasets.pew_marijuana;
const PEW = DATASETS.pew_marijuana;
const pewList = covered("pew_marijuana");
const pewPlace = pew && placeOf(pewList, (x) => x.datasets.pew_marijuana.unacceptable, pew.unacceptable);
const pewLeast = pew && 1 + pewList.filter((x) => x.datasets.pew_marijuana.unacceptable < pew.unacceptable).length;
const pewMedian =median(pewList.map((x) => x.datasets.pew_marijuana.unacceptable));
// the answers left to right, from approval to disapproval
const pewParts = pew && [
  ["Acceptable", pew.acceptable, "var(--t5)"],
  ["Not a moral issue", pew.not_moral, "var(--t4)"],
  ["Depends or no answer", pew.depends + pew.unsure, "var(--muted)"],
  ["Unacceptable", pew.unacceptable, "var(--t1)"],
];

const hfi = c.datasets.hfi;
const HFI = DATASETS.hfi;
// the two indexes ranked among the same places: those the Human Freedom Index covers
const hfiList = covered("hfi");
const hfiPlace = hfi && placeOf(hfiList, (x) => x.datasets.hfi.human, hfi.human);
const cannabisPlace = hfi && placeOf(hfiList, (x) => x.raw, c.raw);
const gap = hfi ? hfiPlace - cannabisPlace : 0; // above zero: freer for cannabis than in general
// one short verdict on the gap between the two ranks
const gapText = !hfi ? "" : Math.abs(gap) < hfiList.length / 8 ? "about as expected"
  : gap > 0 ? "freer than its general freedom suggests" : "less free than its general freedom suggests";
---
{(pew || hfi) && (
  <>
    {pew && (
      <div class="cd-block">
        <h3>{PEW.name}</h3>
        <p class="cd-big"><b>{pew.unacceptable}%</b> of adults say it is morally unacceptable</p>
        <div class="cd-stack" role="img" aria-label={pewParts.map(([label, v]) => `${label}: ${v}%`).join(", ")}>
          {pewParts.map(([label, v, color]) => v > 0 && <i style={`width:${v}%;background:${color}`} title={`${label}: ${v}%`}></i>)}
        </div>
        <ul class="cd-key">
          {pewParts.map(([label, v, color]) => <li><i class="sw" style={`background:${color}`}></i>{label} <b>{v}%</b></li>)}
        </ul>
        <p>The {pewPlace <= pewList.length / 2 ? rankWord(pewPlace, "most") : rankWord(pewLeast, "least")} disapproving of the {pewList.length} countries surveyed, where the median is {pewMedian}%.{PEW.notes[c.slug] && ` ${PEW.notes[c.slug]}`}</p>
        <p class="cd-more"><a href={mapHref("pew_marijuana")}>All {PEW.total} on the map →</a></p>
        <SourceTip><a href={PEW.url} target="_blank" rel="noopener noreferrer">{PEW.publisher}</a>, {PEW.when}, {pew.sample.toLocaleString("en-GB")} adults (<a href={PEW.data_url} target="_blank" rel="noopener noreferrer">{PEW.data_label}</a>).</SourceTip>
      </div>
    )}
    {hfi && (
      <div class="cd-block">
        <h3>{HFI.name}</h3>
        <p class="cd-big"><b>{hfi.human.toFixed(2)}</b>/10{hfi.human_rank && <> · #{hfi.human_rank} of {HFI.total}</>}</p>
        <p>Cannabis freedom: {ord(cannabisPlace)} of the same {hfiList.length}, {gapText}.</p>
        <p class="cd-more"><a href={mapHref("hfi")}>See the map →</a></p>
        <SourceTip><a href={HFI.url} target="_blank" rel="noopener noreferrer">{HFI.title}</a>, {HFI.when}.</SourceTip>
      </div>
    )}
  </>
)}
