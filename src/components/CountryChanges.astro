---
// A country's recorded changes, newest first, at the end of the country article.
// Drawn as the same timeline as the History page.
import ScoreChange from "./ScoreChange.astro";
import { changeDate } from "../lib/countries.js";
import { tierColor } from "../lib/tiers.js";

const { history } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<div class="c-changes">
  <h2 class="d-h">History <span>{history.filter((ch) => ch.confidence.key === "checked").length} of {history.length} checked against a source</span></h2>
  <ol class="chl-list">
    {history.map((ch) => (
      <li class="chl-item" style={`--c:${ch.score ? tierColor(ch.score.after) : "var(--muted)"}`}>
        <a class="card chl-card" href={`${base}history/${ch.id}/`}>
          <p class="change-meta">
            <time datetime={ch.date}>{changeDate(ch)}</time>
            <span class={`conf-mark c-${ch.confidence.key}`} title={`${ch.confidence.label}: ${ch.confidence.help}`}>{ch.confidence.mark}</span>
          </p>
          <h3><span class="kind" title={ch.kind.label} aria-hidden="true">{ch.kind.emoji}</span><span class="visually-hidden">{ch.kind.label}: </span>{ch.title}</h3>
          <p class="chl-text">{ch.description}</p>
          {ch.score && <ScoreChange score={ch.score} />}
        </a>
      </li>
    ))}
  </ol>
</div>
