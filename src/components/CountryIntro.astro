---
// "Cannabis in <country>": the opening of a profile, about the people rather than the law. How many
// use it (as "1 in N", with a row of dots), what they think of it (Pew; Gallup for the United
// States), the words they have for it (`words` in the country file, each linked to its atlas entry
// where there is one), how use compares across its region, and a few cannabis datasets as one row
// each (offences, seizures, potency, shops, research: where it stands among the countries). The parts are
// tiles in two equal columns, the same for every country. Nothing here is scored;
// every dataset is in the profile's Datasets section.
import { countries, places, useAges } from "../lib/countries.js";
import { DATASETS } from "../lib/datasets.js";
import { viewByMetric } from "../lib/map-views.js";
import { headline, headField, standing, POLARITY, toneAt } from "../lib/dataset-text.js";
import { USE_COMPARISON_NOTE } from "../lib/use-labels.js";
import { SHOW_PRICES } from "../lib/config.js";
import Cited from "./Cited.astro";
import SourceTip from "./SourceTip.astro";
import PricePanel from "./PricePanel.astro";
import { theName } from "../lib/seo.js";
import { priceHistoryFor } from "../lib/prices.js";

// `sub`: a state or province, shown with its own survey figure where it has one. `wordRefs`: each
// word's citation numbers in the profile's references (CountryArticle.astro numbers them first).
const { c, sub, wordRefs = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const mapHref = (key) => `${base}map/${viewByMetric[`data:${key}`].slug}/`;
const covered = (key) => places.filter((x) => x.datasets[key]);
// 1 for the highest value among `list`; ties share a place
const placeOf = (list, value, own) => 1 + list.filter((x) => value(x) > own).length;
const ord = (n) => n + (n % 100 >= 11 && n % 100 <= 13 ? "th" : ["th", "st", "nd", "rd"][n % 10] ?? "th");
// "the most", "the 2nd most"
const rankWord = (n, word) => (n === 1 ? word : `${ord(n)} ${word}`);
const median = (xs) => { const s = [...xs].sort((a, b) => a - b), m = s.length >> 1; return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2; };
// 48,000,000 → "48 million", 770,000 → "770,000"
const people = (n) => (n >= 1e6 ? `${+(n / 1e6).toPrecision(2)} million` : n.toLocaleString("en-GB"));
const name = theName(sub ? sub.name : c.name);

// Who uses it: the national survey, or a state's own
const use = sub ? null : c.use;
const unitUse = sub?.use ?? null;
// a disputed territory with no survey takes the figure of the country it is part of
const useFrom = use?.estimate_from ? countries.find((x) => x.id === use.estimate_from.toUpperCase()) : null;
const share = use ? use.prevalence : unitUse?.share;
const pct = (n) => `${(+n).toFixed(1)}%`; // 26.38 → "26.4%", 9 → "9.0%"
const ages = use ? useAges(use) : unitUse?.ages;
const users = use ? use.users : unitUse?.users;
// "1 in 11"; with fewer than one in thirty the dots would be too many, so a bar stands in for them
const oneIn = share > 0 ? Math.max(1, Math.round(100 / share)) : null;
const dots = oneIn && oneIn <= 30 ? oneIn : 0;
// the median of the surveyed countries in the same region, as a yardstick
const surveyed = use ? countries.filter((x) => x.region === c.region && !x.use.estimate && x.use.prevalence != null).sort((a, b) => b.use.prevalence - a.use.prevalence || a.name.localeCompare(b.name)) : [];
const regionMedian = surveyed.length >= 3 ? +median(surveyed.map((x) => x.use.prevalence)).toFixed(1) : null;
// its place among them, and the five rows around it for a short ranked list
const regionAt = surveyed.findIndex((x) => x.id === c.id);
const near = regionAt < 0 ? [] : surveyed.slice(Math.max(0, Math.min(regionAt - 2, surveyed.length - 5)), Math.max(0, Math.min(regionAt - 2, surveyed.length - 5)) + 5);
const regionTop = surveyed[0]?.use.prevalence ?? 1;
const youth = sub ? null : c.datasets.youth_use;

// What they think of it
const pew = sub ? null : c.datasets.pew_marijuana;
const PEW = DATASETS.pew_marijuana;
const pewList = covered("pew_marijuana");
const pewPlace = pew && placeOf(pewList, (x) => x.datasets.pew_marijuana.unacceptable, pew.unacceptable);
const pewLeast = pew && 1 + pewList.filter((x) => x.datasets.pew_marijuana.unacceptable < pew.unacceptable).length;
const pewMedian = median(pewList.map((x) => x.datasets.pew_marijuana.unacceptable));
// the answers left to right, from approval to disapproval
const pewParts = pew && [
  ["Acceptable", pew.acceptable, "var(--t5)"],
  ["Not a moral issue", pew.not_moral, "var(--t4)"],
  ["Depends or no answer", pew.depends + pew.unsure, "var(--muted)"],
  ["Unacceptable", pew.unacceptable, "var(--t1)"],
];
const gallup = !sub && c.series.gallup_us;
const GALLUP = DATASETS.gallup_us;
const gallupNow = gallup && gallup.at(-1), gallupFirst = gallup && gallup[0];

// The words they have for it, as written for the country (a state shows its country's)
const words = c.details.words;

// Cannabis in figures: the first five cannabis datasets the country has, one row each, the figure
// and where it stands among the countries the dataset covers (dataset-text.js), linked to its card
// in Datasets. In this order of interest: enforcement, the market, then science and attention.
const HIGHLIGHTS = ["cannabis_offences", "police_possession", "seizures", "potency_europe", "prices_europe", "osm_shops", "wastewater", "espad_availability", "treatment", "hemp", "research_papers", "clinical_trials", "wikipedia_views", "news"];
const highlights = sub ? [] : HIGHLIGHTS.filter((id) => DATASETS[id] && c.series[id]).map((id) => {
  const d = DATASETS[id], data = c.series[id];
  const row = Array.isArray(data) ? data.findLast((r) => r[headField(d)] != null) ?? data.at(-1) : data;
  return { d, head: headline(c, d, row), year: row?.year, stand: standing(c, d) };
}).filter((h) => h.head[0] && h.stand).slice(0, 5);
// how many tiles beside the words, for the grid: two equal columns, and with an odd number the
// last runs across the whole width
const tiles = 1 + [near.length >= 3, pew, gallup, highlights.length > 0, SHOW_PRICES && !sub && priceHistoryFor(c.id).length > 0].filter(Boolean).length;
---
{(use || unitUse) && (
  <div class={`intro intro-${Math.min(tiles, 5)}`}>
    <div class="intro-block intro-use">
      <p class="intro-kicker">Who uses it</p>
      <p class="intro-big">{use?.estimate ? "Perhaps " : "About "}<b>1 in {oneIn}</b></p>
      <p class="intro-lede">people aged {ages} in {name} used cannabis in the past year{users != null && <>: {use?.estimate || use?.users_approximate ? "about " : ""}<strong>{people(users)}</strong> people</>}.</p>
      {dots > 0
        ? <div class="intro-dots" role="img" aria-label={`One in ${oneIn}`}>{Array.from({ length: dots }, (_, i) => <i class={i === 0 ? "on" : undefined}></i>)}</div>
        : <div class="intro-share" aria-hidden="true"><i style={`width:${Math.max(1, share)}%`}></i></div>}
      <dl class="intro-figs">
        <div><dt>Past year</dt><dd>{pct(share)}</dd></div>
        {regionMedian != null && <div><dt>{c.region} median</dt><dd>{regionMedian}%</dd></div>}
        {youth?.past_year != null && <div><dt>Aged 15–16{youth.year ? `, ${youth.year}` : ""}</dt><dd>{pct(youth.past_year)}</dd></div>}
      </dl>
      <p class="intro-note">{use
        ? (use.estimate ? "This site’s estimate: there is no national survey." : `UNODC · survey ${use.period ?? use.year}`)
        : <>Survey {unitUse.year}, its own age band.{unitUse.note && ` ${unitUse.note}`}</>}</p>
      {use
        ? <SourceTip><span>Past-year cannabis use among people aged {useAges(use)}. </span>{useFrom
              ? `This site's figure: there is no survey of ${c.name} alone, so ${useFrom.name}'s rate from its ${useFrom.use.period ?? useFrom.use.year} survey is applied to an estimate of the people aged 15–64 here.`
              : use.estimate
              ? `This site's figure: there is no national survey, so the median rate of surveyed countries in ${c.region} is applied to people aged 15–64.`
              : `People who used cannabis in the past year, from a ${use.period ?? use.year} survey${use.users != null ? `, applied to today's population aged ${useAges({ ages: use.population_ages || use.ages })}` : ""}${use.users_approximate ? ". The population is approximate: the survey ages cut through an age group, or were not recorded and ages 15–64 are used" : ""}${use.source === "earlier" ? ". An earlier figure: UNODC's 2026 table has none for this country" : ""}.`}<br />{USE_COMPARISON_NOTE}<br />{use.source === "wdr2026"
              ? <><a href="https://www.unodc.org/unodc/en/data-and-analysis/world-drug-report-2026-annex.html" target="_blank" rel="noopener noreferrer">UNODC World Drug Report 2026</a>, annex table 1.2</>
              : use.source === "earlier"
                ? <>An earlier UNODC figure, as collected in <a href="https://en.wikipedia.org/wiki/List_of_countries_by_annual_cannabis_use" target="_blank" rel="noopener noreferrer">Wikipedia's list of annual cannabis use by country</a></>
                : useFrom
                ? <>{useFrom.name}'s figure from the <a href="https://www.unodc.org/unodc/en/data-and-analysis/world-drug-report-2026-annex.html" target="_blank" rel="noopener noreferrer">UNODC World Drug Report 2026</a>; the population aged 15–64 is this place's total times {useFrom.name}'s share of those ages</>
                : <>A median computed on this site from surveyed countries in {c.region}, using <a href="https://www.unodc.org/unodc/en/data-and-analysis/world-drug-report-2026-annex.html" target="_blank" rel="noopener noreferrer">UNODC World Drug Report 2026</a> figures</>}{use.users != null && <>. Population from the <a href="https://data.worldbank.org/" target="_blank" rel="noopener noreferrer">World Bank</a>, aged {useAges({ ages: use.population_ages || use.ages })}</>}. <a href={`${base}sources/#dataset-cannabis_use`}>The whole dataset →</a></SourceTip>
        : <SourceTip>{unitUse.source[1] ? <a href={unitUse.source[1]} target="_blank" rel="noopener noreferrer">{unitUse.source[0]}</a> : unitUse.source[0]}</SourceTip>}
    </div>
    {near.length >= 3 && (
      <div class="intro-block intro-region">
        <p class="intro-kicker">Use across {c.region}</p>
        <p class="intro-mid"><b>{ord(regionAt + 1)}</b>highest of {surveyed.length} surveyed countries</p>
        <ol class="intro-rank">
          {near.map((x) => (
            <li class={x.id === c.id ? "on" : undefined} value={surveyed.indexOf(x) + 1}>
              {x.id === c.id ? <span>{x.flag} {x.name}</span> : <a href={`${base}country/${x.slug}/`}>{x.flag} {x.name}</a>}
              <i style={`--w:${(x.use.prevalence / regionTop) * 100}%`}></i>
              <b>{pct(x.use.prevalence)}</b>
            </li>
          ))}
        </ol>
        <p class="intro-note">Past-year use, latest survey of each. Survey years and ages differ. <a href={`${base}map/${viewByMetric.prevalence.slug}/`}>On the map →</a></p>
      </div>
    )}
    {pew && (
      <div class="intro-block intro-view">
        <p class="intro-kicker">What they think of it</p>
        <p class="intro-q">“Is using marijuana morally acceptable?”</p>
        <p class="intro-mid"><b>{pew.unacceptable}%</b> say it is morally unacceptable</p>
        <div class="cd-stack" role="img" aria-label={pewParts.map(([label, v]) => `${label}: ${v}%`).join(", ")}>
          {pewParts.map(([label, v, color]) => v > 0 && <i style={`width:${v}%;background:${color}`} title={`${label}: ${v}%`}></i>)}
        </div>
        <ul class="cd-key">
          {pewParts.map(([label, v, color]) => <li><i class="sw" style={`background:${color}`}></i>{label} <b>{v}%</b></li>)}
        </ul>
        <p class="intro-note">The {pewPlace <= pewList.length / 2 ? rankWord(pewPlace, "most") : rankWord(pewLeast, "least")} disapproving of the {pewList.length} countries surveyed, where the median is {pewMedian}%.{PEW.notes[c.slug] && ` ${PEW.notes[c.slug]}`} <a href={mapHref("pew_marijuana")}>On the map →</a></p>
        <SourceTip><a href={PEW.url} target="_blank" rel="noopener noreferrer">{PEW.publisher}</a>, {PEW.when}, {pew.sample.toLocaleString("en-GB")} adults (<a href={PEW.data_url} target="_blank" rel="noopener noreferrer">{PEW.data_label}</a>).</SourceTip>
      </div>
    )}
    {gallup && (
      <div class="intro-block intro-view">
        <p class="intro-kicker">What they think of it</p>
        <p class="intro-q">“Should the use of marijuana be made legal?”</p>
        <p class="intro-mid"><b>{gallupNow.legal}%</b> say yes, up from {gallupFirst.legal}% in {gallupFirst.year}</p>
        <div class="cd-stack" role="img" aria-label={`Yes: ${gallupNow.legal}%`}>
          <i style={`width:${gallupNow.legal}%;background:var(--t5)`}></i>
        </div>
        <p class="intro-note">Gallup poll of {gallupNow.date}. <a href={`${base}charts/#opinion-gap`}>The whole trend →</a></p>
        <SourceTip><a href={GALLUP.url} target="_blank" rel="noopener noreferrer">{GALLUP.title}</a>.</SourceTip>
      </div>
    )}
    {highlights.length > 0 && (
      <div class="intro-block intro-compare">
        <p class="intro-kicker">Cannabis in figures</p>
        <ul class="intro-hl">
          {highlights.map(({ d, head, year, stand }) => (
            <li style={`--ds:${POLARITY[d.id] ? toneAt(stand.at, POLARITY[d.id]) : "var(--u3)"}`}>
              <a href={`#ds-${d.id}`} title={`Higher than ${stand.below}% of the ${stand.n} countries with a figure${year ? ` · ${year}` : ""}`}>
                <span class="hl-name">{d.name}</span>
                <b>{head[0]}</b>
                {head[1] && <small class="hl-unit">{head[1]}{year ? ` · ${year}` : ""}</small>}
                <span class="hl-track"><i style={`left:${stand.at * 100}%`}></i></span>
              </a>
            </li>
          ))}
        </ul>
        <p class="intro-note">The dot: where it stands among the countries each dataset covers, lowest to highest. <a href="#datasets">All datasets ↓</a></p>
      </div>
    )}
    {SHOW_PRICES && !sub && <PricePanel id={c.id} />}
    {words.length > 0 && (
      <div class="intro-block intro-words">
        <p class="intro-kicker">What they call it{sub && ` · in all of ${theName(c.name)}`}</p>
        <ul>
          {words.map((w, i) => (
            <li>
              <b>{w.word}<Cited parts={[{ refs: wordRefs[i] ?? [] }]} /></b>
              <small>{w.lang}{w.say && <> · <span class="intro-say">{w.say}</span></>}</small>
              {w.meaning && <span class="intro-means">{w.meaning}</span>}
              {w.atlas && <a class="intro-atlas" href={`${base}culture/language/${w.atlas}/`}>In the atlas →</a>}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
)}
