---
// Home page: the four most recent changes as a ledger, one row each: date, country, what
// happened, and the score before and after. See /changes.yaml.
import { changes } from "../lib/countries.js";
import { tierColor } from "../lib/tiers.js";
import ScoreChange from "./ScoreChange.astro";

const base = import.meta.env.BASE_URL;
// "1 Jan 2026", or "Feb 2026" when the day is not known
const shortDate = (iso) =>
  iso.length === 4 ? iso : new Date(`${iso.length === 7 ? iso + "-01" : iso}T00:00:00Z`).toLocaleDateString("en-GB", { day: iso.length === 7 ? undefined : "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---
<section class="ledger" aria-labelledby="changesTitle">
  <div class="ledger-head">
    <h2 id="changesTitle">Latest changes</h2>
    <a href={`${base}history/`}>Full history →</a>
  </div>
  <ol>
    {changes.filter((ch) => ch.score).slice(0, 4).map((ch) => (
      <li style={`--c:${tierColor(ch.score.after)}`}>
        <a href={`${base}history/${ch.id}/`}>
          <time datetime={ch.date}>{shortDate(ch.date)}</time>
          <span class="ledger-place">{ch.country.flag} {ch.country.name}</span>
          <b><span class="visually-hidden">{ch.kind.label}: </span>{ch.title}</b>
          <ScoreChange score={ch.score} />
        </a>
      </li>
    ))}
  </ol>
</section>
