---
// Home page: the four most recent changes as a small vertical timeline (date on the left,
// details on the right), next to the world average chart. See /changes.yaml.
import { changes } from "../lib/countries.js";
import { tierColor } from "../lib/tiers.js";
import AverageChart from "./AverageChart.astro";
import ScoreChange from "./ScoreChange.astro";

const base = import.meta.env.BASE_URL;
// "1 Jan 2026", or "Feb 2026" when the day is not known
const shortDate = (iso) =>
  iso.length === 4 ? iso : new Date(`${iso.length === 7 ? iso + "-01" : iso}T00:00:00Z`).toLocaleDateString("en-GB", { day: iso.length === 7 ? undefined : "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---
<div class="home-split">
  <section class="card changes" aria-labelledby="changesTitle">
    <div class="changes-head">
      <h2 class="changes-title" id="changesTitle">Latest changes</h2>
      <a href={`${base}history/`}>Full history →</a>
    </div>
    <ol class="mini-tl">
      {changes.filter((ch) => ch.score).slice(0, 4).map((ch) => (
        <li style={`--c:${tierColor(ch.score.after)}`}>
          <a href={`${base}history/${ch.id}/`}>
            <time datetime={ch.date}>{shortDate(ch.date)}</time>
            <span class="mini-tl-body">
              <span class="mini-tl-country">{ch.country.flag} {ch.country.name}</span>
              <b>{ch.title}</b>
              <ScoreChange score={ch.score} />
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>
  <AverageChart />
</div>
