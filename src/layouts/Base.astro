---
import "../styles/fonts.css";
import "../styles/global.css";
// the three font files every page needs at once: preloaded so text does not wait for the stylesheet
import fontText from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import fontDisplay from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";
import fontDisplayItalic from "@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url";
import Leaf from "../components/Leaf.astro";
import { Icon } from "astro-icon/components";
import { SEARCH_ICONS, RESULT_KIND_ICONS } from "../lib/search-icons.js";

// `seoTitle` replaces the whole <title> (search-result wording); `jsonld` is one schema.org
// object or a list of them; `type` is the Open Graph type of the page.
// `noindex` keeps a page out of search engines (hidden utility pages)
// `image` replaces the drawn preview with another image of the site: [path after the base, width, height]
const { title, seoTitle, description, jsonld, type = "website", noindex = false, image } = Astro.props;
const base = import.meta.env.BASE_URL;
const repo = "https://github.com/burningtree/cannabis-freedom-index";
const siteName = "Cannabis Freedom Index";
const fullTitle = seoTitle ?? (title ? `${title} — ${siteName}` : `${siteName}: cannabis laws and legality in every country`);
// the address search engines should index: no query string, no hash
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://cannabisfreedom.fyi").href;
// the page's social preview image, drawn at build time by src/pages/og/[...path].png.js:
// /country/de/ → /og/country/de.png, the home page → /og/index.png
const ogPath = Astro.url.pathname.slice(base.length).replace(/\/$/, "") || "index";
const ogImage = new URL(image ? `${base}${image[0]}` : `${base}og/${ogPath}.png`, Astro.site ?? "https://cannabisfreedom.fyi").href;
const [ogW, ogH] = image ? image.slice(1) : [1200, 630];
const schemas = jsonld ? [jsonld].flat() : [];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1"}>
  <meta property="og:site_name" content={siteName}>
  <meta property="og:type" content={type}>
  <meta property="og:title" content={seoTitle ?? title ?? fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:locale" content="en">
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content={ogW}>
  <meta property="og:image:height" content={ogH}>
  <meta property="og:image:alt" content={seoTitle ?? title ?? fullTitle}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:title" content={seoTitle ?? title ?? fullTitle}>
  <meta name="twitter:description" content={description}>
  <link rel="sitemap" type="application/xml" href={`${base}sitemap.xml`}>
  {schemas.map((x) => <script type="application/ld+json" is:inline set:html={JSON.stringify(x).replace(/</g, "\\u003c")} />)}
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}>
  <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`}>
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`}>
  <link rel="alternate" type="application/rss+xml" title="Cannabis Freedom Index: score changes" href={`${base}rss.xml`}>
  {[fontText, fontDisplay, fontDisplayItalic].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin>)}
  <script is:inline>
    // Set the theme before first paint to avoid a flash.
    (function () {
      var saved = null;
      try { saved = localStorage.getItem("cfi-theme"); } catch (e) {}
      document.documentElement.dataset.theme = saved || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
    })();
  </script>
  <!-- Privacy-friendly analytics by Plausible -->
  <script is:inline async src="https://x.pp0.co/js/pa-LxLKhe9xGLn3XR6DEkvlN.js"></script>
  <script is:inline>
    window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
    plausible.init()
  </script>
</head>
<body>
  <header class="topbar">
    <a class="brand" href={base}>
      <span class="brand-mark" aria-hidden="true">
        <Leaf size={24} />
      </span>
      <span class="brand-name">Cannabis Freedom Index</span>
    </a>
    {/* On a country page: who this is, shown once its own heading has scrolled away. */}
    <slot name="here" />
    {/* Search comes first in the bar, with the keys that open it from anywhere. */}
    <button class="icon-btn search-btn" id="searchOpen" aria-label="Search" title="Search (⌘K)" aria-keyshortcuts="Meta+K Control+K">
      <Icon name="iconoir:search" class="ico" aria-hidden="true" />
      <kbd class="search-key" id="searchKey">⌘K</kbd>
    </button>
    <nav class="nav" id="siteNav" aria-label="Main">
      <a href={`${base}#map`}>Map</a>
      <a href={`${base}#rankings`}>Rankings</a>
      <a href={`${base}history/`}>History</a>
      <a href={`${base}charts/`}>Charts</a>
      <a href={`${base}culture/`}>Culture</a>
      <a href={`${base}survey/`}>Survey</a>
    </nav>
    <a class="icon-btn" href={repo} target="_blank" rel="noopener noreferrer" aria-label="Source code on GitHub" title="Source code on GitHub">
      <Icon name="iconoir:github" class="ico" aria-hidden="true" />
    </a>
    <button class="icon-btn" id="themeToggle" aria-label="Switch colour theme" title="Switch colour theme">
      <Icon name="iconoir:half-moon" class="ico theme-moon" aria-hidden="true" /><Icon name="iconoir:sun-light" class="ico theme-sun" aria-hidden="true" />
    </button>
    {/* Phones and narrow windows: the links fold into a panel opened by this button. */}
    <button class="icon-btn nav-toggle" id="navToggle" aria-label="Menu" aria-controls="siteNav" aria-expanded="false">
      <Icon name="iconoir:menu" class="ico nt-open" aria-hidden="true" /><Icon name="iconoir:xmark" class="ico nt-close" aria-hidden="true" />
    </button>
  </header>

  <slot />

  {/* Search: ⌘K or Ctrl+K anywhere, or the magnifier in the top bar. The index is /search.json. */}
  <dialog class="search" id="siteSearch" aria-label="Search" data-index={`${base}search.json`} data-base={base}>
    <form method="dialog" class="search-box">
      <Icon name="iconoir:search" class="ico" aria-hidden="true" />
      <input id="searchInput" type="search" placeholder="Search countries, laws and events" autocomplete="off" spellcheck="false" aria-controls="searchResults" />
      <kbd>esc</kbd>
    </form>
    <ol class="search-results" id="searchResults" role="listbox"></ol>
    <p class="search-none" id="searchNone" hidden></p>
    {/* Every icon the results use (lib/search-icons.js), copied by the script below. */}
    <template id="searchIcons" data-kinds={JSON.stringify(RESULT_KIND_ICONS)}>
      {SEARCH_ICONS.map((name) => <Icon name={name} class="ico" aria-hidden="true" data-k={name} />)}
    </template>
    <p class="search-hint" id="searchHint"><span id="searchCount" aria-live="polite"></span> <span><kbd>↑</kbd><kbd>↓</kbd> to move, <kbd>↵</kbd> to open.</span></p>
  </dialog>

  <footer class="footer">
    <p>Cannabis Freedom Index · Informational only, not legal advice · Map data © Natural Earth</p>
    <p class="footer-links"><a href={`${base}about/`}>About</a> · <a href={`${base}can-i/`}>Can I?</a> · <a href={`${base}compare/`}>Compare</a> · <a href={`${base}changelog/`}>Changelog</a> · <a href={`${base}rss.xml`}>RSS</a> · <a href={`${base}data/`}>Download the data</a> · <a href={`${base}llms.txt`} title="A plain-text guide to this site for language models">For AI: llms.txt</a> · <a href={`${base}data/#licence`}>Licence: data CC BY 4.0, code MIT</a></p>
    <p>Open source — the scores, explanations and code are on <a href={repo} target="_blank" rel="noopener noreferrer">GitHub</a>. Spotted a mistake or a law that changed? <a href={`${repo}/issues`} target="_blank" rel="noopener noreferrer">Open an issue</a> or send a pull request.</p>
  </footer>

  <script is:inline>
    // Source notes (SourceTip.astro): a click or tap on the "i" keeps its note open until a click
    // elsewhere. Listens on the document, so it also works in articles loaded into the drawer.
    document.addEventListener("click", function (e) {
      var btn = e.target.closest && e.target.closest(".src-tip-btn");
      document.querySelectorAll(".src-tip.open").forEach(function (t) {
        if (btn && t.contains(btn)) return;
        if (!t.contains(e.target)) { t.classList.remove("open"); t.firstElementChild.setAttribute("aria-expanded", "false"); }
      });
      if (btn) {
        var open = btn.parentNode.classList.toggle("open");
        btn.setAttribute("aria-expanded", open ? "true" : "false");
      }
    });
  </script>
  <script>
    // Fuse.js is bundled as its own file and fetched only when the search dialog is first opened.
    window.cfiFuse = () => import("fuse.js").then((m) => m.default);
  </script>
  <script is:inline>
    // Search dialog. The index and Fuse.js (fuzzy matching, so a typo or a missing accent still
    // finds its row) are loaded on first use. Every word typed must match a row's name or its
    // second line; the closest matches come first, and among equals countries and pages lead,
    // then entries with an article, then the rest of the history, newest first.
    (function () {
      var dialog = document.getElementById("siteSearch"), input = document.getElementById("searchInput");
      var list = document.getElementById("searchResults"), hint = document.getElementById("searchHint"), none = document.getElementById("searchNone"), count = document.getElementById("searchCount");
      var rows = null, fuse = null, loading = null, shown = [], active = 0;
      var KIND = { c: "Country", p: "Page", u: "Culture", a: "Article", h: "History" }, ORDER = { c: 0, p: 1, u: 1, a: 2, h: 3 };
      var icons = document.getElementById("searchIcons"), KIND_ICON = JSON.parse(icons.dataset.kinds), ICON = {};
      icons.content.querySelectorAll("[data-k]").forEach(function (el) { ICON[el.dataset.k] = el.outerHTML; });
      function fold(s) { return s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, ""); }
      function esc(s) { return String(s).replace(/[&<>"]/g, function (ch) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[ch]; }); }
      function load() {
        if (!loading) loading = Promise.all([fetch(dialog.dataset.index).then(function (r) { return r.json(); }), window.cfiFuse()]).then(function (got) {
          rows = got[0].map(function (r, i) { r.i = i; r.k = fold(r.n); r.h = r.k + " " + fold(r.s) + (r.g ? " " + fold(r.g) : ""); return r; });
          // `k` is the name, `h` the name, second line and hidden words (an entry's tags) together, so words may be spread over them
          fuse = new got[1](rows, { keys: [{ name: "k", weight: 2 }, { name: "h", weight: 1 }], useExtendedSearch: true, ignoreLocation: true, threshold: 0.3, minMatchCharLength: 2, includeScore: true });
          render();
        }).catch(function () { none.textContent = "The search index could not be loaded."; none.hidden = false; });
        return loading;
      }
      function render() {
        var words = fold(input.value).split(/\s+/).filter(Boolean);
        if (!fuse || !words.length) { shown = []; list.innerHTML = ""; count.textContent = ""; if (fuse) none.hidden = true; return; }
        // In Fuse's extended search, words separated by spaces must all match (each one fuzzily).
        var q = words.join(" ");
        function rank(x) { var r = x.item; return x.score + ORDER[r.t] * 0.05 + (r.k === q ? -1 : r.k.indexOf(q) === 0 ? -0.5 : 0); }
        var found = fuse.search(q).sort(function (a, b) { return rank(a) - rank(b) || a.item.i - b.item.i; });
        shown = found.slice(0, 40).map(function (x) { return x.item; }); active = 0;
        // the line under the box appears only when a search comes back empty; the key hints stay put
        none.hidden = shown.length > 0;
        count.textContent = !found.length ? "" : found.length > shown.length ? "First " + shown.length + " of " + found.length + " results" : found.length + (found.length === 1 ? " result" : " results");
        if (!shown.length) none.textContent = "Nothing found for “" + input.value + "”.";
        list.innerHTML = shown.map(function (r, i) {
          return '<li role="option" id="sr' + i + '"' + (i === 0 ? ' aria-selected="true"' : "") + '><a href="' + esc(dialog.dataset.base + r.u) + '" tabindex="-1">' +
            (r.img ? '<img class="sr-img" src="' + esc(r.img) + '" alt="" width="48" height="48" loading="lazy">' : r.ic ? '<span class="sr-flag sr-icon">' + ICON[r.ic] + (r.f ? '<span class="sr-badge" aria-hidden="true">' + esc(r.f) + '</span>' : "") + '</span>' : '<span class="sr-flag" aria-hidden="true">' + esc(r.f || "") + '</span>') + '<span class="sr-name">' + esc(r.n) + '</span>' +
            '<span class="sr-sub">' + esc(r.s) + '</span><span class="sr-kind">' + ICON[KIND_ICON[r.t]] + KIND[r.t] + "</span></a></li>";
        }).join("");
      }
      function move(step) {
        if (!shown.length) return;
        list.children[active].removeAttribute("aria-selected");
        active = (active + step + shown.length) % shown.length;
        var li = list.children[active]; li.setAttribute("aria-selected", "true"); li.scrollIntoView({ block: "nearest" });
        input.setAttribute("aria-activedescendant", li.id);
      }
      // show the shortcut as this machine types it: ⌘K on Apple devices, Ctrl K elsewhere
      if (!/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) { document.getElementById("searchKey").textContent = "Ctrl K"; document.getElementById("searchOpen").title = "Search (Ctrl K)"; }
      function open() { if (dialog.open) return; dialog.showModal(); input.value = ""; render(); input.focus(); load(); }
      document.getElementById("searchOpen").addEventListener("click", open);
      document.addEventListener("keydown", function (e) {
        if ((e.metaKey || e.ctrlKey) && !e.altKey && !e.shiftKey && e.key.toLowerCase() === "k") { e.preventDefault(); dialog.open ? dialog.close() : open(); }
      });
      input.addEventListener("input", render);
      input.addEventListener("keydown", function (e) {
        if (e.key === "ArrowDown") { e.preventDefault(); move(1); }
        else if (e.key === "ArrowUp") { e.preventDefault(); move(-1); }
        else if (e.key === "Enter") { e.preventDefault(); if (shown.length) { dialog.close(); location.href = list.children[active].firstChild.href; } }
      });
      // a click on the backdrop closes it; a click on a result is an ordinary link
      dialog.addEventListener("click", function (e) { if (e.target === dialog) dialog.close(); });
      list.addEventListener("click", function (e) { if (e.target.closest("a")) dialog.close(); });
    })();

    // The menu on narrow screens: the button opens the links as a panel under the top bar.
    // It closes on a link, on Escape, and on a click anywhere else.
    (function () {
      var bar = document.querySelector(".topbar"), btn = document.getElementById("navToggle");
      function set(open) { bar.classList.toggle("nav-open", open); btn.setAttribute("aria-expanded", open ? "true" : "false"); btn.setAttribute("aria-label", open ? "Close menu" : "Menu"); }
      btn.addEventListener("click", function () { set(!bar.classList.contains("nav-open")); });
      document.getElementById("siteNav").addEventListener("click", function (e) { if (e.target.closest("a")) set(false); });
      document.addEventListener("keydown", function (e) { if (e.key === "Escape" && bar.classList.contains("nav-open")) { set(false); btn.focus(); } });
      document.addEventListener("click", function (e) { if (bar.classList.contains("nav-open") && !bar.contains(e.target)) set(false); });
    })();

    document.getElementById("themeToggle").addEventListener("click", function () {
      var root = document.documentElement;
      root.dataset.theme = root.dataset.theme === "light" ? "dark" : "light";
      try { localStorage.setItem("cfi-theme", root.dataset.theme); } catch (e) {}
    });

    // "In short" answers on a country article: go to the segment they were read from,
    // open it and light it up. Works on the country page and inside the home page drawer,
    // so the address is left alone (the drawer uses it to know which country is open).
    function showSegment(article, id) {
      var row = article && article.querySelector('.segrow[data-seg="' + id + '"]');
      if (!row) return;
      var panel = row.closest(".c-panel");
      if (panel) showTab(article, panel.dataset.panel);
      row.open = true;
      row.classList.remove("flash");
      void row.offsetWidth; // restart the animation when the same answer is chosen twice
      row.classList.add("flash");
      row.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" });
    }
    // The tabs of a country article: score breakdown, more context, history, sources. One panel
    // shows at a time. On the country's own page the tab is kept in the address (#history), so it
    // can be linked and survives a reload; in the drawer the address belongs to the drawer.
    function showTab(article, id, focus) {
      var tab = article && article.querySelector('.c-tabs [data-tab="' + id + '"]');
      if (!tab) return false;
      article.querySelectorAll(".c-tabs [data-tab]").forEach(function (t) {
        var on = t === tab;
        t.setAttribute("aria-selected", String(on)); t.tabIndex = on ? 0 : -1;
      });
      article.querySelectorAll(".c-panel").forEach(function (p) { p.hidden = p.dataset.panel !== id; });
      if (focus) tab.focus();
      return true;
    }
    document.addEventListener("click", function (e) {
      var tab = e.target.closest(".c-tabs [data-tab]");
      if (!tab) return;
      var article = tab.closest("article.country");
      showTab(article, tab.dataset.tab);
      if (!article.closest("dialog")) history.replaceState(null, "", tab.dataset.tab === (article.dataset.defaultTab || "score") ? location.pathname + location.search : "#" + tab.dataset.tab);
      // a tab chosen from far down a long panel: bring the top of the new one into view
      var main = article.querySelector(".c-main");
      if (main.getBoundingClientRect().top < 0) main.scrollIntoView({ block: "start" });
    });
    // a link to a tab from elsewhere in the article ("All datasets →" in the side column)
    document.addEventListener("click", function (e) {
      var link = e.target.closest && e.target.closest("a[data-tab-link]");
      if (!link || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      var article = link.closest("article.country");
      if (!showTab(article, link.dataset.tabLink)) return;
      e.preventDefault();
      if (!article.closest("dialog")) history.replaceState(null, "", "#" + link.dataset.tabLink);
      article.querySelector(".c-main").scrollIntoView({ block: "start" });
    });
    document.addEventListener("keydown", function (e) {
      var tab = e.target.closest && e.target.closest(".c-tabs [data-tab]");
      if (!tab || (e.key !== "ArrowRight" && e.key !== "ArrowLeft")) return;
      var all = Array.prototype.slice.call(tab.parentElement.children), next = all[(all.indexOf(tab) + (e.key === "ArrowRight" ? 1 : all.length - 1)) % all.length];
      e.preventDefault(); showTab(tab.closest("article.country"), next.dataset.tab, true);
    });
    document.addEventListener("click", function (e) {
      var link = e.target.closest("a[data-seg-link]");
      if (!link || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      showSegment(link.closest("article.country"), link.dataset.segLink);
    });
    // "Open all" above the score breakdown opens or closes every segment at once.
    document.addEventListener("click", function (e) {
      var btn = e.target.closest("[data-seg-toggle]");
      if (!btn) return;
      var open = btn.getAttribute("aria-expanded") !== "true";
      btn.closest("article.country").querySelectorAll(".segrow[data-seg]").forEach(function (row) { row.open = open; });
      btn.setAttribute("aria-expanded", String(open));
      btn.textContent = open ? "Close all" : "Open all";
    });
    // "Score over time" on a country article and the world average on the home page: a vertical seeker follows the pointer and says
    // what the score was then and which history entries sit at that point. It snaps to an entry
    // that is close. Works in the drawer too, since it listens on the document.
    var seekPlot = null;
    function hideSeek() {
      if (!seekPlot) return;
      seekPlot.querySelector(".c-seek").hidden = seekPlot.querySelector(".c-seek-tip").hidden = true;
      seekPlot.querySelectorAll(".avg-dot.on").forEach(function (dot) { dot.classList.remove("on"); });
      seekPlot = null;
    }
    function seek(e) {
      var plot = e.target.closest && e.target.closest(".avg-plot[data-seek]");
      if (plot !== seekPlot) hideSeek();
      if (!plot) return;
      seekPlot = plot;
      var data = plot._seek || (plot._seek = JSON.parse(plot.dataset.seek));
      var dots = plot._dots || (plot._dots = Array.prototype.slice.call(plot.querySelectorAll(".avg-dot")));
      // the world chart keeps its entries on the dots themselves
      if (data.dots && !data.events) data.events = dots.map(function (dot) { return { x: parseFloat(dot.style.left), d: dot.dataset.date, t: dot.dataset.title, own: dot.dataset.avg }; });
      var box = plot.getBoundingClientRect();
      var px = Math.max(0, Math.min(100, ((e.clientX - box.left) / box.width) * 100));
      // snap to the nearest entry within 7 pixels, and list the ones that share its place
      var near = null;
      data.events.forEach(function (ev) { if (!near || Math.abs(ev.x - px) < Math.abs(near.x - px)) near = ev; });
      var here = [];
      if (near && (Math.abs(near.x - px) * box.width) / 100 <= 7) {
        px = near.x;
        here = data.events.filter(function (ev) { return (Math.abs(ev.x - px) * box.width) / 100 <= (data.dots ? 1.5 : 4); }); // the world chart is dense
      }
      dots.forEach(function (dot) { dot.classList.toggle("on", here.length > 0 && Math.abs(parseFloat(dot.style.left) - px) < 0.001); });
      var score = data.start;
      for (var i = 0; i < data.steps.length; i++) {
        var s = data.steps[i]; // [start of the step, end, score before, score after]
        if (px >= s[1]) score = s[3];
        else { if (px > s[0]) score = s[2] + ((s[3] - s[2]) * (px - s[0])) / (s[1] - s[0]); break; }
      }
      var year = new Date(data.t0 + ((data.t1 - data.t0) * px) / 100).getUTCFullYear();
      var line = plot.querySelector(".c-seek"), tip = plot.querySelector(".c-seek-tip");
      tip.replaceChildren();
      var head = document.createElement("b");
      head.textContent = year + " · " + (data.unit || "score") + " " + (data.dp ? score.toFixed(data.dp) : Math.round(score));
      tip.append(head);
      here.slice(0, data.dots ? 3 : 4).forEach(function (ev) {
        var p = document.createElement("p"), when = document.createElement("small");
        when.textContent = ev.d + " · " + (ev.own || (ev.s ? "score " + ev.s : "no change in score"));
        p.append(when, (ev.k ? ev.k + " " : "") + ev.t);
        tip.append(p);
      });
      if (here.length > (data.dots ? 3 : 4)) {
        var more = document.createElement("p");
        more.textContent = "and " + (here.length - (data.dots ? 3 : 4)) + " more";
        tip.append(more);
      }
      line.style.left = px + "%";
      tip.style.left = px + "%";
      tip.style.transform = "translateX(-" + px + "%)"; // slides from left- to right-aligned, so it stays inside
      if (data.y) {
        // a tall plot: keep the box inside it, under the line where the line runs high and above it elsewhere
        var at = (1 - (score - data.y[0]) / (data.y[1] - data.y[0])) * 100;
        tip.style.top = at < 50 ? "calc(" + at + "% + 12px)" : "auto";
        tip.style.bottom = at < 50 ? "auto" : "calc(" + (100 - at) + "% + 12px)";
      }
      line.hidden = tip.hidden = false;
    }
    document.addEventListener("pointermove", seek);
    document.addEventListener("pointerdown", seek);
    document.addEventListener("pointerleave", hideSeek);

    // A link straight to a segment, e.g. /country/de/#seg-possession
    // or to a tab: /country/de/#history
    if (/^#(context|history|datasets|sources)$/.test(location.hash) && showTab(document.querySelector("article.country"), location.hash.slice(1))) document.querySelector("article.country .c-main").scrollIntoView({ block: "start" });
    if (/^#seg-[a-z_-]+$/.test(location.hash)) showSegment(document.querySelector("article.country"), location.hash.slice(5));
  </script>
  <script is:inline>
    // Hover previews. A link in the page to a country, a history entry or a culture entry shows a
    // small card with what is behind it. The data is /previews/<kind>.json, fetched the first time a
    // link of that kind is hovered or focused. Not on touch, not in the menus, and not on cards or list rows that already show the same.
    (function () {
      var base = (document.getElementById("siteSearch") || {}).dataset ? document.getElementById("siteSearch").dataset.base : "/";
      var cache = {}, tip = null, timer = 0, current = null;
      var esc = function (t) { return String(t == null ? "" : t).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); };
      function kindOf(a) {
        if (!a || a.closest("header, footer, nav, svg, .cu-cards, .reads, .search, .hc, .avg-chart, .c-chart, [data-no-preview]")) return null;
        // A row of a list (history, changes, the side lists) already shows what the card would show:
        // only links in running text and short labels get a preview.
        if (a.querySelector("h1, h2, h3, h4, p, div, time, ul, ol, figure, img")) return null;
        var u; try { u = new URL(a.href, location.href); } catch (e) { return null; }
        if (u.origin !== location.origin || u.pathname.indexOf(base) !== 0 || u.pathname === location.pathname) return null;
        var p = u.pathname.slice(base.length);
        if (/^country\/[a-z]{2}\/$/.test(p)) return ["country", p];
        if (/^history\/[^/]+\/$/.test(p)) return ["history", p];
        if (/^culture\/(language|traditions|people)\/[^/]+\/$/.test(p)) return ["culture", p];
        return null;
      }
      function load(kind) {
        return cache[kind] || (cache[kind] = fetch(base + "previews/" + kind + ".json").then(function (r) { return r.json(); }).catch(function () { delete cache[kind]; return {}; }));
      }
      function card(kind, d) {
        if (kind === "country") return '<p class="hc-eyebrow">' + esc(d.r) + ' · ' + (d.k ? "#" + d.k + " of " + d.of : "not ranked") + '</p>' +
          '<div class="hc-head"><span class="hc-flag">' + d.f + '</span><b class="hc-title">' + esc(d.n) + '</b><span class="hc-score" style="--c:' + d.c + '">' + d.s + '<small>/100</small></span></div>' +
          '<div class="hc-meter" style="--c:' + d.c + '"><i style="width:' + d.s + '%"></i></div>' + (d.fe ? '<p class="hc-est">' + esc(d.fe) + '</p>' : '') +
          '<p class="hc-chips"><span class="chip s-' + d.rec[1] + '">Recreational: ' + esc(d.rec[0]) + '</span><span class="chip s-' + d.med[1] + '">Medical: ' + esc(d.med[0]) + '</span></p>' +
          '<p class="hc-text">' + esc(d.x) + '</p><p class="hc-foot">' + esc(d.t) + (d.h ? " · " + d.h + " history entries" : "") + '</p>';
        if (kind === "history") return '<p class="hc-eyebrow">' + esc(d.k) + ' · ' + esc(d.d) + '</p>' +
          '<p class="hc-place">' + esc(d.p) + '</p><b class="hc-title">' + esc(d.t) + '</b>' +
          (d.b ? '<p class="hc-move"><b style="--c:' + d.b[1] + '">' + d.b[0] + '</b><span>→</span><b style="--c:' + d.a[1] + '">' + d.a[0] + '</b><small>index score</small></p>' : '') +
          '<p class="hc-text">' + esc(d.x) + '</p><p class="hc-foot"><span class="conf-mark c-' + d.cf[2] + '">' + esc(d.cf[0]) + '</span> ' + esc(d.cf[1]) + (d.ar ? ' · <span class="he-article">Article</span>' : '') + '</p>';
        return (d.i ? '<img class="hc-img" src="' + esc(d.i) + '" alt="" width="360" height="180">' : '') +
          '<p class="hc-eyebrow">Culture · ' + esc(d.sec) + (d.o ? ' · ' + esc(d.o) : '') + '</p>' +
          '<b class="hc-title">' + esc(d.t) + (d.sp ? ' <span class="hc-native">' + esc(d.sp) + '</span>' : '') + '</b>' +
          '<p class="hc-text">' + esc(d.x) + '</p><p class="hc-foot hc-flags">' + d.fl + (d.n > 10 ? " +" + (d.n - 10) : "") + '</p>';
      }
      // Place the card under the line of the link that the pointer is on, starting where the pointer
      // is, so that a link spanning a whole row (as in the lists of changes) does not throw the card
      // to the row's far edge. A tall block link uses the pointer's height instead of its bottom.
      // Keyboard focus has no pointer, so then the card goes under the start of the link.
      var pt = null;
      document.addEventListener("pointermove", function (e) { pt = { x: e.clientX, y: e.clientY }; }, { passive: true });
      function place(a, byPointer) {
        var rects = a.getClientRects(), r = null, i, w = tip.offsetWidth, h = tip.offsetHeight, m = 10;
        if (byPointer && pt) for (i = 0; i < rects.length; i++) if (pt.y >= rects[i].top - 2 && pt.y <= rects[i].bottom + 2) r = rects[i];
        r = r || rects[0] || a.getBoundingClientRect();
        var top = r.top, bottom = r.bottom, x = r.left;
        if (byPointer && pt) {
          x = pt.x - 24;
          if (r.height > 48) { top = pt.y - 14; bottom = pt.y + 18; }
        }
        x = Math.min(Math.max(m, x), window.innerWidth - w - m);
        var below = bottom + 8 + h < window.innerHeight || top - 8 - h < 0;
        tip.style.left = x + "px";
        tip.style.top = (below ? bottom + 8 : top - 8 - h) + "px";
      }
      function show(a, byPointer) {
        var k = kindOf(a); if (!k) return;
        current = a;
        load(k[0]).then(function (data) {
          var d = data[k[1]]; if (!d || current !== a) return;
          if (!tip) { tip = document.createElement("div"); tip.className = "hc"; tip.setAttribute("role", "tooltip"); }
          (a.closest("dialog[open]") || document.body).appendChild(tip);
          tip.className = "hc hc-" + k[0];
          tip.innerHTML = card(k[0], d);
          tip.hidden = false;
          place(a, byPointer);
          var img = tip.querySelector("img"); if (img) img.onload = function () { if (current === a) place(a, byPointer); };
        });
      }
      function hide() { clearTimeout(timer); current = null; if (tip) tip.hidden = true; }
      document.addEventListener("pointerover", function (e) {
        if (e.pointerType === "touch") return;
        var a = e.target.closest && e.target.closest("a[href]");
        if (!a || a === current) return;
        clearTimeout(timer); hide();
        if (kindOf(a)) timer = setTimeout(function () { show(a, true); }, 220);
      });
      document.addEventListener("pointerout", function (e) {
        var a = e.target.closest && e.target.closest("a[href]");
        if (a && !a.contains(e.relatedTarget)) hide();
      });
      document.addEventListener("focusin", function (e) { var a = e.target.closest && e.target.closest("a[href]"); if (a && kindOf(a) && !a.matches(":hover")) { hide(); show(a, false); } });
      document.addEventListener("focusout", hide);
      document.addEventListener("keydown", function (e) { if (e.key === "Escape") hide(); });
      window.addEventListener("scroll", hide, { passive: true, capture: true });
    })();
  </script>
  <script is:inline>
    // Side panes stick beside the text only when the whole pane fits the window; otherwise its end
    // could never be reached until the page ends.
    (() => {
      const here = document.querySelector(".topbar-here"), head = document.querySelector(".d-head");
      if (!here || !head || !window.IntersectionObserver) return;
      new IntersectionObserver(([e]) => document.body.classList.toggle("past-head", !e.isIntersecting && e.boundingClientRect.top < 0)).observe(head);
      here.addEventListener("click", (e) => { e.preventDefault(); scrollTo({ top: 0, behavior: "smooth" }); });
    })();
  </script>
</body>
</html>
