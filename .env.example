# Local settings. Copy to .env (which is not committed).

# Show the incomplete flower-price data in the interface. Leave unset in production.
PUBLIC_SHOW_PRICES=true

# Internet Archive keys from archive.org/account/s3.php. With them, `archive-sources.cjs save` uses the
# logged-in Save Page Now, which allows far more captures than the anonymous one.
IA_ACCESS_KEY=
IA_SECRET_KEY=
